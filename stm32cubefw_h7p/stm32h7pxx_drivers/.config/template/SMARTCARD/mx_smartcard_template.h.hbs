{{#if (eq @root.strategy "SW")}}
{{assign 'file_name' 'SMARTCARD'~}}
{{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:SMARTCARD')~}}
{{else}}
{{#get_myctx~}}
{{#with _myctx~}}
{{!log "I2C template _myctx:" this~}}
{{assign 'current_resource' resource~}}
{{assign 'file_name' resource~}}
{{assign 'instances' instances~}}
{{/with~}}
{{/get_myctx~}}
{{/if}}
