  "grammarVersion": "3.1",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "STCryptoLib_Profile": {
          "title": "STCryptoLib Profile",
          "type": "string",
          "oneOf": [
            {
              "const": "fast_and_high",
              "title": "Fast and High",
              "description": "(by default): fasted configurations possible"
            },
            {
              "const": "small_and_low",
              "title": "Small and Low",
              "description": "smallest configurations possible"
            },
            {
              "const": "custom",
              "title": "Custom",
              "description": "To customize each item of the library"
            }
          ],
          "default": "fast_and_high",
          "description": "Optimizations and memory footprint of the library"
        },
