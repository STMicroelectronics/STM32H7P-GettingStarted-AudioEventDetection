{{assign 'gpio_port' gpio_port~}}
{{assign 'gpio_pin' gpio_pin~}}
{{#if (eq fct 'exti_gpio_variables')}}
  {{! ~}}
  {{! Generate the EXTI handle variable in mx_gpio_template.c.hbs~}}
  {{! > EXTI fct='exti_gpio_variables' layer=@root.layer exti_list=@root.exti_object.list_exti~}}
  {{! ~}}
  {{log "EXTI_Partial (exti_gpio_variables): layer=" layer "exti_list=" exti_list~}}
  {{#if (eq layer 'HAL')}}
    {{#each exti_list}}
static hal_exti_handle_t h{{this}};
    {{/each}}
  {{/if}}
{{else if (eq fct 'exti_variables')}}
  {{! ~}}
  {{! Warning: This function is obsolete and will be removed in future versions.~}}
  {{! Please use 'exti_get_variables' instead.~}}
  {{! Generate the EXTI handle variable other than requested by GPIO~}}
  {{! > EXTI fct='exti_variables' layer=@root.layer exti_line='23'~}}
  {{! ~}}
  {{log "EXTI_Partial (exti_variables): layer=" layer "exti_line=" exti_line~}}
  {{#if (eq layer 'HAL')}}
static hal_exti_handle_t hEXTI{{exti_line}};
  {{/if}}
{{else if (eq fct 'exti_get_variables')}}
