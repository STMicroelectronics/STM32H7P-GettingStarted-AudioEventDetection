{{~else if (eq fct 'include_rcc')}}
{{!     Generate the mx_rcc.h include inside mx_pppi.h ~}}
{{!> RCC fct='include_rcc'~}}
  {{~assign 'rcc_config' (helper_rcc_get_rcc_main_config) ~}}
  {{#unless (eq hw_resource 'AES')}}
    {{#if (helper_rcc_is_controlled_by_periph @root.rcc_config)}}
#include "mx_rcc.h"
    {{/if}}
  {{/unless~}}

{{~else if (eq fct 'generate_kernel_clock')}}
{{!     Generate the set kernel clock source function for a given peripheral~}}
{{!> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='I2C'~}}
  {{#if (helper_rcc_has_kernel_clock_mux hw_resource)}}
    {{~assign 'rcc_config' (helper_rcc_get_rcc_main_config) ~}}
    {{#if (helper_rcc_is_controlled_by_periph @root.rcc_config)}}
  if (mx_rcc_{{lowercase hw_resource}}_clock_config() != SYSTEM_OK)
  {
    return NULL;
  }
    {{else}}
      {{! Clock source controlled is centralized or customized~}}
      {{~assign 'clock_source_object' (helper_rcc_get_clock_source_object hw_resource)~}}
      {{#if @root.clock_source_object}}
        {{~assign 'clock_source' (helper_rcc_remap_clock_source @root.clock_source_object.value)~}}
        {{~assign 'ppp_name' (helper_rcc_remap_kernel_clock_source hw_resource)~}}
        {{#if (eq @root.current_layer 'HAL')}}
  if (HAL_RCC_{{@root.ppp_name}}_SetKernelClkSource(HAL_RCC_{{@root.ppp_name}}_CLK_SRC_{{@root.clock_source}}) != HAL_OK)
  {
          {{#if (eq hw_resource 'RTC')}}
    return SYSTEM_CLOCK_ERROR;
          {{else}}
    return NULL;
          {{/if}}
  }
        {{else}}
  LL_RCC_Set{{helper_rcc_remap_sw_resource sw_resource}}ClockSource(LL_RCC_{{@root.ppp_name}}_CLKSOURCE_{{@root.clock_source}});
        {{/if}}
      {{/if~}}

      {{#if (helper_rcc_is_dac hw_resource)}}
        {{~assign 'dac_sh_clock' (helper_rcc_get_dac_sh_clock hw_resource)~}}
        {{#unless (eq @root.dac_sh_clock '')}}
          {{#if (eq @root.current_layer 'HAL')}}
  if (HAL_RCC_{{hw_resource}}SH_SetKernelClkSource(HAL_RCC_{{hw_resource}}_SH_CLK_SRC_{{@root.dac_sh_clock}}) != HAL_OK)
  {
    return NULL;
  }
          {{else}}
  LL_RCC_SetDACSHClockSource(LL_RCC_{{hw_resource}}SH_CLKSOURCE_{{@root.dac_sh_clock}});
          {{/if}}
        {{/unless}}
      {{/if}}
    {{/if}}
  {{/if~}}

{{~else if (eq fct 'generate_kernel_clock_controlled')}}
{{!     Generate the set kernel clock source function for a given peripheral~}}
{{!> RCC fct='generate_kernel_clock_controlled' hw_resource=@root.current_resource sw_resource='I2C'~}}
  {{log "RCC_partial generate_kernel_clock_controlled: hw_resource=" hw_resource ", sw_resource=" sw_resource~}}
  {{#if (helper_rcc_has_kernel_clock_mux hw_resource)}}
    {{~assign 'clock_source_object' (helper_rcc_get_clock_source_object hw_resource)~}}
    {{#if @root.clock_source_object}}
      {{~assign 'clock_source' (helper_rcc_remap_clock_source @root.clock_source_object.value)~}}
      {{~assign 'kernel_clock' (helper_rcc_remap_kernel_clock_source hw_resource)~}}
      {{#if (eq @root.current_layer 'HAL')}}
  if (HAL_RCC_{{@root.kernel_clock}}_SetKernelClkSource(HAL_RCC_{{@root.kernel_clock}}_CLK_SRC_{{@root.clock_source}}) != HAL_OK)
  {
    return SYSTEM_CLOCK_ERROR;
  }

      {{else}}
  LL_RCC_Set{{sw_resource}}ClockSource(LL_RCC_{{hw_resource}}_CLKSOURCE_{{@root.clock_source}});

      {{/if}}
    {{/if}}
  {{/if~}}
  {{#if (helper_rcc_is_dac hw_resource)}}
    {{~assign 'dac_sh_clock' (helper_rcc_get_dac_sh_clock hw_resource)~}}

      {{log "4"}}
    {{#unless (eq @root.dac_sh_clock '')}}
      {{#if (eq @root.current_layer 'HAL')}}
  if (HAL_RCC_{{hw_resource}}_SetSampleAndHoldClkSource(HAL_RCC_{{hw_resource}}SH_CLK_SRC_{{@root.dac_sh_clock}}) != HAL_OK)
  {
    return SYSTEM_CLOCK_ERROR;
  }

      {{else}}
  LL_RCC_SetDACSHClockSource(LL_RCC_{{hw_resource}}SH_CLKSOURCE_{{@root.dac_sh_clock}});

      {{/if}}
    {{/unless}}
  {{/if}}


{{~else if (eq fct 'kernel_clock_deinit')}}
{{!     Generate the kernel clock deinit for a resource ~}}
{{!> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource~}}

  {{~log "RCC_partial kernel_clock_deinit: hw_resource=" hw_resource~}}
  {{#unless (eq hw_resource 'AES')}}
    {{~assign 'rcc_config' (helper_rcc_get_rcc_main_config) ~}}
    {{#if (helper_rcc_is_controlled_by_periph @root.rcc_config)}}
  (void)mx_rcc_{{lowercase hw_resource}}_clock_deactivate();

    {{/if}}
  {{/unless~}}

{{~else if (eq fct 'generate_peripheral_clock_activation')}}
{{!     Generate the bus clock activation function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_clock_activation' hw_resource='SPI1'~}}
  {{~log "RCC_partial generate_peripheral_clock_activation: hw_resource="hw_resource~}}
  {{#if (eq (helper_rcc_get_clk_enable_mode hw_resource) 0)}}
    {{#if (helper_rcc_has_enable hw_resource)}}
      {{#if (eq @root.current_layer 'HAL')}}
  HAL_RCC_{{helper_rcc_remap_hw_resource hw_resource}}_EnableClock();
        {{#if (eq hw_resource 'RTC')}}
  HAL_RCC_RTC_EnableKernelClock();
        {{/if}}
      {{else}}
        {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
  LL_{{@root.periph_bus}}_EnableClock(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});
        {{#if (eq hw_resource 'RTC')}}
  LL_RCC_EnableRTC();
        {{/if}}
      {{/if}}
    {{/if}}
  {{/if}}

{{~else if (eq fct 'generate_peripheral_clock_deactivation')}}
{{!     Generate the bus clock activation function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_clock_deactivation' hw_resource='SPI1'~}}
  {{log "RCC_partial generate_peripheral_clock_deactivation: hw_resource="hw_resource~}}
  {{!assign 'current_layer' layer}}
  {{#and (helper_rcc_has_enable hw_resource) (helper_rcc_is_not_shared_ppp hw_resource)}}
    {{#if (eq @root.current_layer 'HAL')}}
        {{#if (eq hw_resource 'RTC')}}
  HAL_RCC_RTC_DisableKernelClock();
        {{/if}}
  HAL_RCC_{{helper_rcc_remap_hw_resource hw_resource}}_DisableClock();

    {{else}}
      {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
      {{#if (eq hw_resource 'RTC')}}
  LL_RCC_DisableRTC();
      {{/if}}
  LL_{{@root.periph_bus}}_DisableClock(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});
    {{/if}}
  {{/and}}

{{~else if (eq fct 'generate_peripheral_clock_reset')}}
{{!     Generate the bus clock reset function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_clock_reset' hw_resource='SPI1'~}}
  {{~log "RCC_partial generate_peripheral_clock_reset: hw_resource="hw_resource @root.current_layer~}}
  {{#if (helper_rcc_is_not_shared_ppp hw_resource)}}
    {{#if (eq @root.current_layer 'HAL')}}
  HAL_RCC_{{helper_rcc_remap_hw_resource hw_resource}}_Reset();
    {{else}}
      {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
  LL_{{@root.periph_bus}}_ForceReset(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});
  LL_{{@root.periph_bus}}_ReleaseReset(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});
    {{/if}}
  {{/if}}

{{~else if (eq fct 'generate_peripheral_kernel_clock_activation')}}
{{!     Generate the kernel clock activation function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_kernel_clock_activation' hw_resource='PLAY1'~}}
  {{~log "RCC_partial generate_peripheral_kernel_clock_activation: hw_resource="hw_resource~}}
  {{#if (eq (helper_rcc_get_clk_enable_mode hw_resource) 0)}}
    {{#if (helper_rcc_has_enable hw_resource)}}
      {{~assign "hw_resource_kernel" (helper_rcc_remap_hw_resource_kernel hw_resource)}}
      {{#if (eq @root.current_layer 'HAL')}}
        {{#if (eq hw_resource 'RTC')}}
  HAL_RCC_RTC_EnableKernelClock();
        {{else}}
  HAL_RCC_{{@root.hw_resource_kernel}}_EnableClock();
        {{/if}}
      {{else}}
        {{#if (eq hw_resource 'RTC')}}
  LL_RCC_EnableRTC();
        {{else}}
          {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
  LL_{{@root.periph_bus}}_EnableClock(LL_{{@root.periph_bus}}_PERIPH_{{@root.hw_resource_kernel}});
        {{/if}}

      {{/if}}
    {{/if}}
  {{/if}}

{{~else if (eq fct 'generate_peripheral_kernel_clock_deactivation')}}
{{!     Generate the kernel clock activation function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_kernel_clock_deactivation' hw_resource='PLAY1'~}}
  {{~log "RCC_partial generate_peripheral_kernel_clock_deactivation: hw_resource="hw_resource~}}
  {{#and (helper_rcc_has_enable hw_resource) (helper_rcc_is_not_shared_ppp hw_resource)}}
    {{~assign "hw_resource_kernel" (helper_rcc_remap_hw_resource_kernel hw_resource)}}
    {{#if (eq @root.current_layer 'HAL')}}
      {{#if (eq hw_resource 'RTC')}}
  HAL_RCC_RTC_DisableKernelClock();
      {{else}}
  HAL_RCC_{{@root.hw_resource_kernel}}_DisableClock();
      {{/if}}
    {{else}}
      {{#if (eq hw_resource 'RTC')}}
  LL_RCC_DisableRTC();
      {{else}}
        {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
  LL_{{@root.periph_bus}}_DisableClock(LL_{{@root.periph_bus}}_PERIPH_{{@root.hw_resource_kernel}});
      {{/if}}
    {{/if}}
  {{/and}}

{{~else if (eq fct 'generate_backup_domain_reset')}}
{{!  Generate the Backup Domain Reset function(s)~}}
{{!  PWR_HAL fct='generate_write_protection_enable is called in case of LSE re-abling error ~}}
{{!> RCC fct='generate_backupdomain_reset'~}}
  {{~log "RCC_partial generate_backup_domain_reset - re_able LSE if it was enable"~}}
  {{~assign 'all_resources' (helper_rcc_get_all_resources) ~}}
  {{~assign 'all_clock_configs' (helper_rcc_get_all_perifs_clock_config @root.all_resources) ~}}
  {{~assign 'main_config' (helper_rcc_get_rcc_main_config) ~}}
  {{#if (eq @root.current_layer 'HAL')}}
  /* Reset backup domain and if needed re-able LSE and LSE CSS */
  HAL_RCC_ResetBackupDomain();
    {{#if @root.all_clock_configs.LSE}}

  if (HAL_RCC_LSE_Enable(HAL_RCC_LSE_{{@root.main_config.additional.lse.state}}, HAL_RCC_LSE_DRIVE_{{@root.main_config.additional.lse.drive_capability}})!= HAL_OK)
  {
  {{>PWR_HAL fct='generate_write_protection_enable'}}
    return SYSTEM_CLOCK_ERROR;
  }
      {{~#if @root.main_config.additional.lse.enable_css}}
  /* Enable the LSE Clock Security System */
  HAL_RCC_LSE_EnableCSS();
      {{/if}}
    {{/if~}}

  {{else}}
  /* Reset backup domain and if needed re-able LSE and LSE CSS */
  LL_RCC_ForceBackupDomainReset();
  LL_RCC_ReleaseBackupDomainReset();
    {{#if @root.all_clock_configs.LSE}}
      {{#if (eq @root.main_config.additional.lse.state "BYPASS")}}
  LL_RCC_LSE_ConfigBypass(LL_RCC_LSE_ANALOG_MODE);
      {{else}}
        {{#if (eq @root.main_config.additional.lse.state "BYPASS_DIGITAL")}}
  LL_RCC_LSE_ConfigBypass(LL_RCC_LSE_DIGITAL_MODE);
        {{/if}}
      {{/if}}

  LL_RCC_LSE_SetDriveCapability(LL_RCC_LSEDRIVE_{{@root.main_config.additional.lse.drive_capability}});
  LL_RCC_LSE_Enable();
      {{#if @root.main_config.additional.lse.enable_css}}
  LL_RCC_LSE_EnableCSS();
      {{/if}}
    {{/if}}
  {{/if}}

{{~else if (eq fct 'generate_pll_src_enable')}}
{{!     Generate the pll src enable ~}}
{{!> RCC fct='generate_pll_src_enable' pll_src=@root.system_config.pll_list[x].config.src ~}}

  {{#if (eq pll_src 'HSI')}}
    {{#if (not (helper_rcc_is_resource_enabled 'hsi'))}}
  HAL_RCC_HSI_Enable(HAL_RCC_HSI_DIV_{{@root.system_config.divider.hsi}});{{helper_rcc_set_resource_enabled 'hsi'}}
    {{/if}}
    {{#unless (helper_rcc_is_central @root.main_config)}}
  RCC_CONSUME_RESOURCE(hsi, 1);
    {{/unless}}
  {{/if~}}

  {{#if (eq pll_src 'HSE')}}
    {{~assign "enabled" (helper_rcc_is_resource_enabled 'hse')}}
    {{~assign "central" (helper_rcc_is_central @root.main_config)}}
    {{#unless (and @root.enabled @root.central)}}
      {{#unless @root.enabled}}
  HAL_RCC_HSE_Enable(HAL_RCC_HSE_{{@root.main_config.additional.hse.state}});{{helper_rcc_set_resource_enabled 'hse'}}
      {{/unless}}
      {{#unless @root.central}}
  RCC_CONSUME_RESOURCE(hse, 1);
      {{/unless}}
    {{/unless}}
  {{/if~}}

{{else if (eq fct 'generate_pll_config')}}
{{!  Generate the pll config code ~}}
{{!> RCC fct='generate_pll_config' pll_info=@root.system_config.pll_list.[x] }}
  hal_rcc_pll_config_t config_pll{{pll_info.idx}} = {0};
  config_pll{{pll_info.idx}}.pll_source      = HAL_RCC_PLL_SRC_{{pll_info.config.src}};
  config_pll{{pll_info.idx}}.pll_m           = {{pll_info.config.m}};
  config_pll{{pll_info.idx}}.pll_n           = {{pll_info.config.n}};
  config_pll{{pll_info.idx}}.pll_p           = {{pll_info.config.p}};
  config_pll{{pll_info.idx}}.pll_q           = {{pll_info.config.q}};
  config_pll{{pll_info.idx}}.pll_r           = {{pll_info.config.r}};
  config_pll{{pll_info.idx}}.pll_s           = {{pll_info.config.s}};
  config_pll{{pll_info.idx}}.pll_t           = {{pll_info.config.t}};
  config_pll{{pll_info.idx}}.pll_fracn       = {{pll_info.config.fracn}};

  HAL_RCC_PLL{{pll_info.idx}}_SetConfig(&config_pll{{pll_info.idx}});

{{else if (eq fct 'generate_pll_enable')}}
{{!     Generate the pll enable code ~}}
{{!> RCC fct='generate_pll_enable' pll_idx=IDX }}


  if (HAL_RCC_PLL{{pll_idx}}_Enable() != HAL_OK){{helper_rcc_set_resource_enabled (concat 'pll' pll_idx)}}
  {
    return SYSTEM_CLOCK_ERROR;
  }
  {{#unless (helper_rcc_is_central @root.main_config)}}
  RCC_CONSUME_RESOURCE(pll{{pll_idx}}, 1);
  {{/unless}}

{{else if (eq fct 'generate_pll_output_enable')}}
{{!     Generate the pll output enable code ~}}
{{!> RCC fct='generate_pll_output_enable' output_config = PLL1P pll_idx='1' pll_output='P'}}
  {{#if @root.central}}
  if (HAL_RCC_PLL{{pll_idx}}_EnableOutput(HAL_RCC_PLL{{pll_idx}}_OUTPUT_{{pll_output}}) != HAL_OK)
  {
    return SYSTEM_CLOCK_ERROR;
  }
  {{else}}
  if (mx_rcc_pll{{pll_idx}}_output_{{lowercase pll_output}}_config({{length output_config.resources}}) != SYSTEM_OK) { return SYSTEM_CLOCK_ERROR; }
  {{/if}}

{{~else if (eq fct 'generate_clock_source_info')}}
  /* Peripherals clocked with {{clock_source}} ({{helper_rcc_display_frequency frequency}}):
        {{#each resources}}
     {{this}}
        {{/each}}
  */
{{else}}
#warning "RCC partial called but wrong step {{fct}}"
{{/if~}}
