{{!
  Partial used for LL TAMP:
  how to use
  > TAMP_LL fct='xxxx' with xxxx:
    * exported_functions_init
~}}

{{!
############################
##  exported_functions_init
############################
~}}
{{#with basic}}
{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_tamper}}
{{#if (eq mode "Passive")}}
{{#unless @root.found_passive_tamper}}
{{assign 'found_passive_tamper' true~}}
{{/unless}}
{{/if}}{{!Passive~}}
{{#if (eq mode "Active")}}
{{#unless @root.found_active_tamper}}
{{assign 'found_active_tamper' true~}}
{{/unless}}
{{/if}}{{!Active~}}
{{/if}}{{!use_tamper~}}
{{/each}}{{!tampers~}}
{{/with}}{{!tamper_indiv_config~}}
{{/with}}{{!basic~}}

{{#if (eq fct 'exported_functions_init')}}
{{!
    Generation of initialization function used in LL
~}}
system_status_t {{@root.fct_name}}_init(void)
{

{{> PWR_LL fct='generate_write_protection_disable'}}

  LL_RCC_ForceBackupDomainReset();
  LL_RCC_ReleaseBackupDomainReset();

{{#with basic}}
{{#with tamper_global_config}}
{{#with passive}}
{{#if (eq @root.found_passive_tamper true)}}
  LL_TAMP_SetConfig(LL_TAMP_PULL_UP_{{#if precharge}}ENABLE{{else}}DISABLE{{/if}},
                    LL_TAMP_DURATION_{{#if precharge}}{{precharge_duration}}RTCCLK{{else}}1RTCCLK{{/if}},
                    LL_TAMP_FILTER_{{#if passive_filter}}{{filter_type_activation}}SAMPLES{{else}}DISABLE{{/if}},
                    LL_TAMP_SAMPLFREQDIV_{{sample_frequency_div}});

{{/if}}
{{/with}}{{!passive~}}

{{#with active}}
{{#if (eq @root.found_active_tamper true)}}
  LL_TAMP_ATAMP_SetConfig(LL_TAMP_ATAMP_FILTERING_{{#if active_filter}}ENABLE{{else}}DISABLE{{/if}},
                          {{output_periode}},
                          LL_TAMP_ATAMP_SHARING_{{#if output_shared}}ENABLE{{else}}DISABLE{{/if}},
                          LL_TAMP_ATAMP_ASYNCPRES_RTCCLK{{#if (eq asynchronous_prescaler 1)}}{{else}}_{{asynchronous_prescaler}}{{/if}});

{{/if}}
{{/with}}{{!active~}}
{{/with}}{{!tamper_global_config~}}

{{#with tamper_indiv_config}}
{{#each tampers}}
{{#if use_tamper}}
{{#if (eq mode "Passive")}}
  LL_TAMP_SetConfigTampers({{#if tamper_label_name}}{{tamper_label_name}}{{else}}LL_{{helper_tamp_convert _foreignKey}}{{/if}},
                           LL_TAMP_ACTIVELEVEL_{{helper_tamp_passive_trigger_convert  trigger}},
                           LL_TAMP_{{#if (eq erase 'ERASE')}}ERASE_ACTIVATE_ALL{{else}}NOERASE_TAMPER{{/if}},
                           LL_TAMP_MASK_{{#if (eq mask 'UNMASKED')}}NONE{{else}}TAMPER{{/if}});

{{/if}}{{!Passive~}}
{{#if (eq mode "Active")}}
  LL_TAMP_SetConfigTampers({{#if tamper_label_name}}{{tamper_label_name}}{{else}}LL_{{helper_tamp_convert _foreignKey}}{{/if}}, 0, LL_TAMP_{{#if (eq erase 'ERASE')}}ERASE_ACTIVATE_ALL{{else}}NOERASE_TAMPER{{/if}}, 0);

{{/if}}{{!Active~}}
{{/if}}{{!use_tamper~}}
{{/each}}{{!tampers~}}

{{#each internal_tampers}}
{{#if use_internal_tamper}}
  LL_TAMP_SetConfigInternalTampers({{#if int_tamper_label_name}}{{int_tamper_label_name}}{{else}}LL_{{helper_tamp_internal_convert _foreignKey}}{{/if}}, LL_TAMP_ITAMP_{{#if (eq erase 'ERASE')}}ERASE_ACTIVE_ALL{{else}}NOERASE_TAMPER{{/if}});

{{/if}}{{!use_internal_tamper~}}
{{/each}}{{!internal_tampers~}}
{{/with}}{{!tamper_indiv_config~}}
{{/with}}{{!basic~}}

{{#with additional}}
{{#if hw_boot_key_block}}
  LL_TAMP_EnableHardwareBootkeyBlock();

{{/if}}{{!hw_boot_key_block~}}

{{#if use_resource_protection}}
  LL_TAMP_EnableResourceProtection(LL_TAMP_RESOURCE_{{resource}});

{{/if}}{{!use_resource_protection~}}
{{/with}}{{!additional~}}

{{#if (and System.nvic_settings.EnableInterruption (eq System.nvic_settings.EnableInterruption true))}}
  /* Enable the interruption for TAMP */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context System.nvic_settings.nvicConfig.needs @root.current_resource false)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=System.nvic_settings.nvicConfig.needs}}

{{/if}}
{{> PWR_LL fct='generate_write_protection_enable'}}

  return SYSTEM_OK;
}

void {{@root.fct_name}}_deinit(void)
{
{{#if (and System.nvic_settings.EnableInterruption (eq System.nvic_settings.EnableInterruption true))}}
  /* Disable the interuption for TAMP */
{{> CORTEX fct='deinit' layer=@root.current_layer needs=System.nvic_settings.nvicConfig.needs}}
{{/if}}
}
{{else}}
#warning "Function {{fct}} not present in partial TAMP_partial.hbs"
{{/if}}
