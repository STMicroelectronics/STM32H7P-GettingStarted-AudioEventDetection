{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:USART",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/usart_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "title": "Label",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$"
              }
            },
            "layer": {
              "title": "Software Layer",
              "type": "string",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "title": "resource initialization code generation",
              "type": "string",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "description": "Generate or not the USART init code, call it or not at boot",
              "$comment": "Generate the init code of your USART or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "default": "USART"
            }
          }
        },

        "main_peripheral_configuration": {
          "title": "Main peripheral configuration",
          "type": "object",
          "properties": {
            "clock_source": {
              "type": "string",
              "title": "Clock source",
              "description": "Clock source can be modified in clock tree",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$get('clock.input', $resource.id)"
                  }
                }
              ],
              "default": ""
            },
            "clock_source_frequency": {
              "type": "string",
              "title": "Clock source frequency",
              "description": "Input clock frequency can be modified in clock tree",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) < 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000 + ' kHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($get('clock.frequency',$resource.id)) >= 1000000",
                  "computed": {
                    "const": "$get('clock.frequency',$resource.id) / 1000000 + ' MHz'"
                  }
                }
              ],
              "default": ""
            },
            "clock_prescaler": {
              "type": "integer",
              "title": "Clock Prescaler",
              "description": "Specifies the prescaler value used to divide the USART clock source",
              "oneOf": [
                {
                  "title": "DIV1",
                  "const": 1
                },
                {
                  "title": "DIV2",
                  "const": 2
                },
                {
                  "title": "DIV4",
                  "const": 4
                },
                {
                  "title": "DIV6",
                  "const": 6
                },
                {
                  "title": "DIV8",
                  "const": 8
                },
                {
                  "title": "DIV10",
                  "const": 10
                },
                {
                  "title": "DIV12",
                  "const": 12
                },
                {
                  "title": "DIV16",
                  "const": 16
                },
                {
                  "title": "DIV32",
                  "const": 32
                },
                {
                  "title": "DIV64",
                  "const": 64
                },
                {
                  "title": "DIV128",
                  "const": 128
                },
                {
                  "title": "DIV256",
                  "const": 256
                }
              ],
              "default": 1
            },
            "baud_rate": {
              "type": "integer",
              "description": "Specifies the baudrate to be used on TX and RX lines",
              "minimum": 0,
              "maximum": 20000000,
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "minimum": "$common.helper_usart_get_min_baudrate($get('clock.frequency', $resource.id), 2)",
                    "maximum": "$common.helper_usart_get_max_baudrate($get('clock.frequency', $resource.id), 2)"
                  }
                }
              ],
              "default": 115200
            },
            "word_length": {
              "type": "string",
              "description": "Specifies the number of data bits transmitted or received in a frame",
              "oneOf": [
                {
                  "title": "7-bit long USART frame",
                  "const": "7"
                },
                {
                  "title": "8-bit long USART frame",
                  "const": "8"
                },
                {
                  "title": "9-bit long USART frame",
                  "const": "9"
                }
              ],
              "default": "7"
            },
            "stop_bit": {
              "type": "string",
              "description": "Specifies the number of stop bits transmitted",
              "oneOf": [
                {
                  "title": "0_5 stop bit USART frame",
                  "const": "0_5",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.smartcard_sel==true"
                    }
                  ]
                },
                {
                  "title": "1 stop bit USART frame",
                  "const": "1"
                },
                {
                  "title": "1_5 stop bit USART frame",
                  "const": "1_5",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.smartcard_sel==true"
                    }
                  ]
                },
                {
                  "title": "2 stop bit USART frame",
                  "const": "2"
                }
              ],
              "default": "1"
            },
            "parity": {
              "type": "string",
              "description": "Specifies the parity mode. When parity is enabled, the computed parity is inserted at the MSB position of the transmitted data (9th bit when the word length is set to 9 data bits; 8th bit when the word length is set to 8 data bits).",
              "oneOf": [
                {
                  "title": "NONE",
                  "const": "NONE"
                },
                {
                  "title": "EVEN",
                  "const": "EVEN"
                },
                {
                  "title": "ODD",
                  "const": "ODD"
                }
              ],
              "default": "NONE"
            },
            "mode": {
              "title": "Mode",
              "type": "string",
              "oneOf": [
                {
                  "title": "Master",
                  "const": "MASTER"
                },
                {
                  "title": "Slave",
                  "const": "SLAVE"
                }
              ],
              "default": "MASTER"
            },
            "direction": {
              "title": "Data direction",
              "type": "string",
              "description": "Specifies whether the Receive or Transmit mode is enabled or disabled..",
              "oneOf": [
                {
                  "title": "Receive",
                  "const": "RX"
                },
                {
                  "title": "Transmit",
                  "const": "TX"
                },
                {
                  "title": "Transmit and Receive",
                  "const": "TX_RX"
                }
              ],
              "default": "TX_RX"
            },
            "clock_polarity": {
              "type": "string",
              "description": "USART Clock Polarity",
              "oneOf": [
                {
                  "title": "LOW",
                  "const": "LOW"
                },
                {
                  "title": "HIGH",
                  "const": "HIGH"
                }
              ],
              "default": "LOW"
            },
            "clock_phase": {
              "type": "string",
              "description": "USART Clock Phase",
              "oneOf": [
                {
                  "title": "First edge",
                  "const": "1"
                },
                {
                  "title": "Second edge",
                  "const": "2"
                }
              ],
              "default": "1"
            },
            "clock_last_bit": {
              "type": "boolean",
              "description": "Last bit clock pulse output",
              "default": false
            }
          },
          "description": "USART Init Structure definition."
        },
        "additional_features_configuration": {
          "title": "Additional features configuration",
          "type": "object",
          "properties": {
            "autonomous_mode": {
              "title": "Autonomous mode",
              "type": "object",
              "actions": [
                      {
                        "type": "include",
                        "condition": "($resource.features.auton)"
                      },
                      {
                        "type": "disable",
                        "condition": "($main_peripheral_configuration.mode != 'MASTER')"
                      }
                    ],
              "properties": {
                "AM_EnablePacketTrigger": {
                  "type": "boolean",
                  "title": "Autonomous mode",
                  "description": "Enable autonomous (available in master mode only)",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($resource.features.auton)"
                    },
                    {
                      "type": "set",
                      "condition": "($main_peripheral_configuration.mode != 'MASTER')",
                      "attributes": {
                        "const": false
                      }
                    }
                  ],
                  "default": false
                },
                "trigger_polarity": {
                  "type": "string",
                  "title": "Trigger Polarity",
                  "oneOf": [
                    {
                      "title": "Rising",
                      "const": "RISING"
                    },
                    {
                      "title": "Falling",
                      "const": "FALLING"
                    }
                  ],
                  "default": "RISING",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional_features_configuration.autonomous_mode.AM_EnablePacketTrigger"
                    }
                  ]
                },
                "packet_size_byte": {
                  "type": "integer",
                  "title": "Data Size",
                  "description": "Data size (bytes)",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional_features_configuration.autonomous_mode.AM_EnablePacketTrigger"
                    }
                  ],
                  "minimum": 0,
                  "maximum": 65535,
                  "default": 0
                },
                "source": {
                  "type": "object",
                  "title": "Trigger Source Selection",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional_features_configuration.autonomous_mode.AM_EnablePacketTrigger"
                    }
                  ],
                  "objectType": "query",
                  "query": {
                    "entity": "peripheral.interconnect.input trigger",
                    "parent": "$resource.id",
                    "title": "{{source}} ({{id}})"
                  }
                },
                "AM_EnableIdle": {
                  "type": "boolean",
                  "title": "Idle Frame",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional_features_configuration.autonomous_mode.AM_EnablePacketTrigger"
                    }
                  ],
                  "default": false
                }
              }
            },
            "slave_select": {
              "type": "boolean",
              "title": "Slave selection method ",
              "description": "Choose if SPI slave selection depends on NSS input pin or if NSS pin is ignored",
              "actions": [
                {
                  "type": "include",
                  "condition": "($resource.features.spi_slave == 1) && ($main_peripheral_configuration.mode == 'SLAVE')"
                }
              ],
              "default": false
            },
            "EnableFifoMode": {
              "type": "boolean",
              "title": "FIFO Mode",
              "default": false,
              "variables": [
                      {
                        "on": "update-value",
                        "name": "USART_CORE_USE_HAL_USART_FIFO",
                        "value": true
                      }
                    ]
            },
            "SetTxFifoThreshold": {
              "type": "string",
              "title": "TX FIFO Threshold",
              "oneOf": [
                {
                  "title": "1/8 empty configuration",
                  "const": "1_8"
                },
                {
                  "title": "1/4 empty configuration",
                  "const": "1_4"
                },
                {
                  "title": "1/2 empty configuration",
                  "const": "1_2"
                },
                {
                  "title": "3/4 empty configuration",
                  "const": "3_4"
                },
                {
                  "title": "7/8 empty configuration",
                  "const": "7_8"
                },
                {
                  "title": "8/8 empty configuration (empty)",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional_features_configuration.EnableFifoMode"
                }
              ]
            },
            "SetRxFifoThreshold": {
              "type": "string",
              "title": "RX FIFO Threshold",
              "oneOf": [
                {
                  "title": "1/8 full configuration",
                  "const": "1_8"
                },
                {
                  "title": "1/4 full configuration",
                  "const": "1_4"
                },
                {
                  "title": "1/2 full configuration",
                  "const": "1_2"
                },
                {
                  "title": "3/4 full configuration",
                  "const": "3_4"
                },
                {
                  "title": "7/8 full configuration",
                  "const": "7_8"
                },
                {
                  "title": "8/8 full configuration (full)",
                  "const": "8_8"
                }
              ],
              "default": "1_8",
              "actions": [
                {
                  "type": "include",
                  "condition": "$additional_features_configuration.EnableFifoMode"
                }
              ]
            }
          }
        },
        "System": {
          "type": "object",
          "title": "System configuration",
          "properties": {
            "GPIO_Settings": {
              "type": "object",
              "description": "GPIO settings",
              "properties": {
                "gpio_clk": {
                  "title": "GPIOs CLK configuration",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_tx": {
                  "title": "GPIOs TX configuration",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($main_peripheral_configuration.mode!='half_duplex_single_wire_mode' && (($main_peripheral_configuration.direction == 'RX' && (!$additional_features_configuration.EnableTxRxSwap)) || ($main_peripheral_configuration.direction == 'TX' && $additional_features_configuration.EnableTxRxSwap))) || ($main_peripheral_configuration.mode=='half_duplex_single_wire_mode' && $additional_features_configuration.EnableTxRxSwap)"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_rx": {
                  "title": "GPIOs RX configuration",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($main_peripheral_configuration.mode!='half_duplex_single_wire_mode'  && (($main_peripheral_configuration.direction == 'RX' && $additional_features_configuration.EnableTxRxSwap) || ($main_peripheral_configuration.direction == 'TX' && (!$additional_features_configuration.EnableTxRxSwap)))) || ($main_peripheral_configuration.mode=='half_duplex_single_wire_mode' && (!$additional_features_configuration.EnableTxRxSwap))"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "gpio_cts": {
                  "title": "GPIOs CTS configuration",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($additional_features_configuration.slave_select)"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CTS",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "EnableInterruption": {
              "type": "boolean",
              "title": "Global interrupt",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$System.EnableDMA_TX"
                },
                {
                  "type": "set",
                  "condition": "$System.EnableDMA_TX",
                  "attributes": {
                    "const": true
                  }
                }
              ],
              "default": false
            },
            "irq_handler_generation": {
            "type": "boolean",
            "title": "IRQ Handler generation",
            "default": true,
            "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableInterruption && $info.layer === 'HAL'"
                }
              ]
            },
            "nvicConfig": {
              "title": "NVIC USART global configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableInterruption"
                }
              ],
              "type": "object",
              "objectType": "need.interrupt.lines",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*"
                }
              ]
            },
            "EnableDMA_TX": {
              "title": "DMA TX",
              "type": "boolean",
              "description": "Enable Tx DMA",
              "actions": [
                {
                  "type": "include",
                  "condition": "$main_peripheral_configuration.direction === 'TX' || $main_peripheral_configuration.direction === 'TX_RX'"
                }
              ],
              "default": false
            },
            "dmaConfigTx": {
              "title": "DMA Tx configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableDMA_TX"
                }
              ],
              "type": "object",
              "objectType": "need.dma.channels",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "TX",
                  "constraints": {
                    "direction": {
                      "const": "MEMORY_TO_PERIPH"
                    },
                    "src_inc": {
                      "const": "INCREMENTED"
                    },
                    "dest_inc": {
                      "const": "FIXED"
                    },
                    "dest_data_width": {
                      "const": "BYTE"
                    }
                  }
                }
              ]
            },
            "EnableDMA_RX": {
              "title": "DMA RX",
              "type": "boolean",
              "description": "Enable Rx DMA",
              "actions": [
                {
                  "type": "include",
                  "condition": "$main_peripheral_configuration.direction === 'RX' || $main_peripheral_configuration.direction === 'TX_RX'"
                }
              ],
              "default": false
            },
            "dmaConfigRx": {
              "title": "DMA Rx configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableDMA_RX"
                }
              ],
              "type": "object",
              "objectType": "need.dma.channels",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "RX",
                  "constraints": {
                    "direction": {
                      "const": "PERIPH_TO_MEMORY"
                    },
                    "src_inc": {
                      "const": "FIXED"
                    },
                    "dest_inc": {
                      "const": "INCREMENTED"
                    },
                    "dest_data_width": {
                      "const": "BYTE"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
