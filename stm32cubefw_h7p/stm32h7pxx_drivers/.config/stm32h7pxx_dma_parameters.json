{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:DMA",
  "grammarVersion": "3.1",
  "functions": [
    {
      "path": ".config/template/helpers/dma_helpers.js",
      "accessor": "dma_helpers"
    }
  ],
  "properties": {
    "parameters": {
      "configFor": [
        "need.dma.channels"
      ],
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label",
              "$comment": "label associated to the instance of the peripheral, can be overridden at sample level. In this case it becomes read-only.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "default": ""
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$isNeed"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_DMA_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "generate or not the DMA init code, call it or not at boot",
              "$comment": "generate the init code of your DMA or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$isNeed"
                }
              ]
            }
          }
        },
        "Main_configuration": {
          "title": "Main configuration",
          "type": "object",
          "properties": {
            "DMA_Mode": {
              "title": "DMA Mode",
              "type": "integer",
              "oneOf": [
                {
                  "title": "Direct transfer mode",
                  "const": 0
                },
                {
                  "title": "Linked list transfer mode",
                  "const": 1,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(!$isNeed)"
                    },
                    {
                      "type": "exclude",
                      "condition": "($config.info.layer=='LL')"
                    }
                  ]
                },
                {
                  "title": "Circular transfer mode",
                  "const": 2,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($isNeed)"
                    },
                    {
                      "type": "exclude",
                      "condition": "($config.info.layer=='LL')"
                    }
                  ]
                }
              ],
              "default": 0
            },
            "Linked_list_xfer": {
              "title": "DMA channel linked list transfer",
              "type": "object",
              "description": "DMA channel port",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$config.Main_configuration.DMA_Mode != 1"
                }
              ],
              "properties": {
                "priority": {
                  "title": "Priority",
                  "type": "string",
                  "description": "Specifies the priority level for the DMA channel",
                  "oneOf": [
                    {
                      "title": "Low weight low",
                      "const": "LOW_WEIGHT_LOW"
                    },
                    {
                      "title": "Low weight medium",
                      "const": "LOW_WEIGHT_MID"
                    },
                    {
                      "title": "Low weight high",
                      "const": "LOW_WEIGHT_HIGH"
                    },
                    {
                      "title": "High",
                      "const": "HIGH"
                    }
                  ],
                  "default": "LOW_WEIGHT_LOW"
                },
                "fetch_port": {
                  "title": "Node fetch port",
                  "type": "integer",
                  "description": "Channel fetch node port",
                  "oneOf": [
                    {
                      "title": "Port 0",
                      "const": 0
                    },
                    {
                      "title": "Port 1",
                      "const": 1
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.master_ports.length>1"
                    }
                  ],
                  "default": 0
                }
              }
            },
            "Basic_xfer": {
              "title": "DMA channel basic transfer",
              "type": "object",
              "description": "DMA channel transfer configuration structure definition",
              "actions": [
                {
                  "type": "include",
                  "condition": "$config.Main_configuration.DMA_Mode != 1"
                }
              ],
              "properties": {
                "request_type": {
                  "title": "Request",
                  "type": "string",
                  "description": "Specifies the transfer request for DMA channel",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "!$isNeed"
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Software",
                      "const": "SW"
                    }
                  ],
                  "default": "SW"
                },
                "request": {
                  "title": "Request",
                  "type": "object",
                  "description": "Specifies the DMA channel transfer request",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$isNeed"
                    }
                  ],
                  "objectType": "query",
                  "query": {
                    "entity": "dma.channel.interconnect.request",
                    "parent": "$resource.id",
                    "where": "$entity.instance === $owner"
                  }
                },
                "direction": {
                  "title": "Direction",
                  "type": "string",
                  "description": "Specifies the transfer direction for DMA channel",
                  "oneOf": [
                    {
                      "title": " Memory to memory",
                      "const": "MEMORY_TO_MEMORY"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "$isNeed"
                        }
                      ],
                      "title": "Peripheral to memory",
                      "const": "PERIPH_TO_MEMORY"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "$isNeed"
                        }
                      ],
                      "title": "Memory to peripheral",
                      "const": "MEMORY_TO_PERIPH"
                    }
                  ],
                  "default": "MEMORY_TO_MEMORY"
                },
                "src_inc": {
                  "title": "Source address incrementing",
                  "type": "string",
                  "description": "Specifies the source increment mode for the DMA channel",
                  "oneOf": [
                    {
                      "title": "Fixed",
                      "const": "FIXED"
                    },
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    }
                  ],
                  "default": "FIXED"
                },
                "dest_inc": {
                  "title": "Destination address incrementing",
                  "type": "string",
                  "description": "Specifies the destination increment mode for the DMA channel",
                  "oneOf": [
                    {
                      "title": "Fixed",
                      "const": "FIXED"
                    },
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    }
                  ],
                  "default": "FIXED"
                },
                "src_data_width": {
                  "title": "Source data width",
                  "type": "string",
                  "description": "Specifies the source data width for the DMA channel",
                  "oneOf": [
                    {
                      "title": "Byte",
                      "const": "BYTE"
                    },
                    {
                      "title": "Half word",
                      "const": "HALFWORD"
                    },
                    {
                      "title": "Word",
                      "const": "WORD"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($resource.features.master_ports.length==1) && ($resource.features.master_ports[0].data_width == 64) || ($resource.features.master_ports.length==2) && ($resource.features.master_ports[0].data_width == 64) && ($resource.features.master_ports[1].data_width == 64)"
                        }
                      ],
                      "title": "Double word",
                      "const": "DOUBLEWORD"
                    }
                  ],
                  "default": "BYTE"
                },
                "dest_data_width": {
                  "title": "Destination data width",
                  "type": "string",
                  "description": "Specifies the destination data width for the DMA channel",
                  "oneOf": [
                    {
                      "title": "Byte",
                      "const": "BYTE"
                    },
                    {
                      "title": "Half word",
                      "const": "HALFWORD"
                    },
                    {
                      "title": "Word",
                      "const": "WORD"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($resource.features.master_ports.length==1) && ($resource.features.master_ports[0].data_width == 64) || ($resource.features.master_ports.length==2) && ($resource.features.master_ports[0].data_width == 64) && ($resource.features.master_ports[1].data_width == 64)"
                        }
                      ],
                      "title": "Double word",
                      "const": "DOUBLEWORD"
                    }
                  ],
                  "default": "BYTE"
                },
                "priority": {
                  "title": "Priority",
                  "type": "string",
                  "description": "Specifies the priority level for the DMA channel",
                  "oneOf": [
                    {
                      "title": "Low weight low",
                      "const": "LOW_WEIGHT_LOW"
                    },
                    {
                      "title": "Low weight medium",
                      "const": "LOW_WEIGHT_MID"
                    },
                    {
                      "title": "Low weight high",
                      "const": "LOW_WEIGHT_HIGH"
                    },
                    {
                      "title": "High",
                      "const": "HIGH"
                    }
                  ],
                  "default": "LOW_WEIGHT_LOW"
                },
                "fetch_port_circular_mode": {
                  "title": "Node fetch port in circular mode",
                  "type": "integer",
                  "description": "Channel fetch node port",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($config.Main_configuration.DMA_Mode != 2) || ($resource.features.master_ports.length == 1)"
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Port 0",
                      "const": 0
                    },
                    {
                      "title": "Port 1",
                      "const": 1
                    }
                  ],
                  "default": 0
                }
              }
            }
          }
        },
        "Additional_configuration": {
          "title": "Additonal configuration",
          "type": "object",
          "actions": [
            {
              "type": "include",
              "condition": "$config.Main_configuration.DMA_Mode != 1"
            }
          ],
          "properties": {
            "Access_ports_xfer": {
              "title": "DMA channel access ports transfer",
              "type": "object",
              "description": "DMA channel access ports",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.master_ports.length>1"
                }
              ],
              "properties": {
                "configuration": {
                  "title": "Set access port configuration",
                  "type": "boolean",
                  "default": false
                },
                "DMA_channel_source_port": {
                  "title": "Source access port",
                  "type": "integer",
                  "description": "DMA channel source port",
                  "oneOf": [
                    {
                      "title": "Port 0",
                      "const": 0
                    },
                    {
                      "title": "Port 1",
                      "const": 1
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Access_ports_xfer.configuration==true"
                    }
                  ],
                  "default": 0
                },
                "DMA_channel_destination_port": {
                  "title": "Destination access port",
                  "type": "integer",
                  "description": "Channel destination port",
                  "oneOf": [
                    {
                      "title": "Port 0",
                      "const": 0
                    },
                    {
                      "title": "Port 1",
                      "const": 1
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Access_ports_xfer.configuration==true"
                    }
                  ],
                  "default": 0
                }
              }
            },
            "Burst_xfer": {
              "title": "DMA channel burst transfer",
              "type": "object",
              "description": "Burst transfer",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.g_transfers.burst==true"
                }
              ],
              "properties": {
                "configuration": {
                  "title": "Set burst configuration",
                  "type": "boolean",
                  "default": false
                },
                "DMA_channel_source_burst": {
                  "title": "Source burst length",
                  "type": "integer",
                  "description": "DMA channel source burst length",
                  "minimum": 1,
                  "unit": "Beat",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Burst_xfer.configuration"
                    },
                    {
                      "type": "set",
                      "computed": {
                        "maximum": "$resource.features.g_fifo_size / $dma_helpers.helper_dma_convert_data_width($config.Main_configuration.Basic_xfer.src_data_width)"
                      }
                    }
                  ],
                  "default": 1
                },
                "DMA_channel_destination_burst": {
                  "title": "Destination burst length",
                  "type": "integer",
                  "description": "DMA channel destination burst",
                  "minimum": 1,
                  "maximum": 32,
                  "unit": "Beat",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Burst_xfer.configuration"
                    }
                  ],
                  "default": 1
                }
              }
            },
            "Trigger_xfer": {
              "title": "DMA channel trigger transfer",
              "type": "object",
              "description": "Trigger transfer",
              "properties": {
                "configuration": {
                  "title": "Set trigger configuration",
                  "type": "boolean",
                  "default": false
                },
                "DMA_channel_trigger_source": {
                  "title": "Source trigger signal",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Trigger_xfer.configuration"
                    }
                  ],
                  "type": "object",
                  "description": "DMA channel trigger source",
                  "objectType": "query",
                  "query": {
                    "entity": "dma.channel.interconnect.trigger",
                    "parent": "$resource.id"
                  }
                },
                "DMA_channel_trigger_polarity": {
                  "title": "Source trigger polarity",
                  "type": "string",
                  "description": "DMA channel trigger polarity",
                  "oneOf": [
                    {
                      "title": "Rising",
                      "const": "RISING"
                    },
                    {
                      "title": "Falling",
                      "const": "FALLING"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Trigger_xfer.configuration"
                    }
                  ],
                  "default": "RISING"
                },
                "DMA_channel_trigger_mode": {
                  "title": "Source trigger mode",
                  "type": "string",
                  "description": "DMA channel trigger mode",
                  "oneOf": [
                    {
                      "title": "Block transfer at each trigger hit detected",
                      "const": "BLOCK_TRANSFER"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($resource.features.g_addressing.programmable2D==true) && ($config.Additional_configuration.Repeated_block_xfer.configuration==true)"
                        }
                      ],
                      "title": "Repeated block transfer at each trigger hit detected",
                      "const": "REPEATED_BLOCK_TRANSFER"
                    },
                    {
                      "actions": [
                        {
                          "type": "include",
                          "condition": "$config.Main_configuration.DMA_Mode==1"
                        }
                      ],
                      "title": "Node transfer at each trigger hit detected",
                      "const": "NODE_TRANSFER"
                    },
                    {
                      "title": "Single transfer at each trigger hit detected",
                      "const": "SINGLE_BURST_TRANSFER",
                      "actions": [
                        {
                          "type": "set",
                          "condition": "($resource.features.g_transfers.burst==false) || (($config.Additional_configuration.Burst_xfer.configuration==true) && ($config.Additional_configuration.Burst_xfer.DMA_channel_source_burst==1))",
                          "attributes": {
                            "title": "Single transfer at each trigger hit detected"
                          }
                        },
                        {
                          "type": "set",
                          "condition": "($resource.features.g_transfers.burst==true) && ($config.Additional_configuration.Burst_xfer.configuration==true) && ($config.Additional_configuration.Burst_xfer.DMA_channel_source_burst>1)",
                          "attributes": {
                            "title": "Burst transfer at each trigger hit detected"
                          }
                        }
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Trigger_xfer.configuration"
                    }
                  ],
                  "default": "SINGLE_BURST_TRANSFER"
                }
              }
            },
            "Data_handling_xfer": {
              "title": "DMA channel data handling transfer",
              "type": "object",
              "description": "DMA channel data handling configuration structure definition",
              "properties": {
                "configuration": {
                  "title": "Set data handling configuration",
                  "type": "boolean",
                  "default": false
                },
                "src_byte_exchange": {
                  "title": "Source byte exchange",
                  "type": "string",
                  "description": "Specifies the DMA channel source byte exchange mode.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($config.Additional_configuration.Data_handling_xfer.configuration) && ($resource.features.g_fifo_size>0)"
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "dest_byte_exchange": {
                  "title": "Destination byte exchange",
                  "type": "string",
                  "description": "Specifies the DMA channel destination byte exchange mode.",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($config.Additional_configuration.Data_handling_xfer.configuration) && ($resource.features.g_fifo_size>0)"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "dest_halfword_exchange": {
                  "title": "Destination half word exchange",
                  "type": "string",
                  "description": "Specifies the DMA channel destination half-word exchange mode.",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($config.Additional_configuration.Data_handling_xfer.configuration) && ($resource.features.g_fifo_size>0)"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "dest_word_exchange": {
                  "title": "Destination word exchange",
                  "type": "string",
                  "description": "Specifies the DMA channel destination word exchange mode.",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Exchanged",
                      "const": "EXCHANGED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($config.Additional_configuration.Data_handling_xfer.configuration) && (($resource.features.g_fifo_size>0) && (($resource.features.master_ports.length==1) && ($resource.features.master_ports[0].data_width == 64) || ($resource.features.master_ports.length==2) && ($resource.features.master_ports[0].data_width == 64) && ($resource.features.master_ports[1].data_width == 64)))"
                    }
                  ],
                  "default": "PRESERVED"
                },
                "trunc_padd": {
                  "title": "Truncation and padding",
                  "type": "string",
                  "description": "Specifies the DMA channel data truncation or padding mode.",
                  "oneOf": [
                    {
                      "title": "Left padding zero extended",
                      "const": "LEFT_PADD_ZERO"
                    },
                    {
                      "title": "Right padding zero extended",
                      "const": "RIGHT_PADD_SIGN"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Data_handling_xfer.configuration"
                    }
                  ],
                  "default": "LEFT_PADD_ZERO"
                },
                "pack": {
                  "title": "Packing",
                  "type": "string",
                  "description": "Specifies the DMA channel data packing or unpacking mode.",
                  "oneOf": [
                    {
                      "title": "Preserved",
                      "const": "PRESERVED"
                    },
                    {
                      "title": "Packed or unpacked",
                      "const": "PACKED_UNPACKED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($config.Additional_configuration.Data_handling_xfer.configuration) && ($resource.features.g_fifo_size>0)"
                    }
                  ],
                  "default": "PRESERVED"
                }
              }
            },
            "Repeated_block_xfer": {
              "title": "DMA channel repeated block transfer",
              "type": "object",
              "description": "DMA channel repeated block configuration structure definition",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.g_addressing.programmable2D==true"
                }
              ],
              "properties": {
                "configuration": {
                  "title": "Set repeated block configuration",
                  "type": "boolean",
                  "default": false
                },
                "block_count": {
                  "title": "Block count",
                  "type": "integer",
                  "description": "Specifies the DMA channel block count",
                  "unit": "Block",
                  "minimum": 1,
                  "maximum": 2048,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration==true"
                    }
                  ],
                  "default": 1
                },
                "burst_src_inc": {
                  "title": "Source single address incrementing",
                  "type": "string",
                  "description": "Specifies the DMA channel single source address increment",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration==true"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.Additional_configuration.Burst_xfer.configuration==true) && ($config.Additional_configuration.Burst_xfer.DMA_channel_source_burst>1)",
                      "attributes": {
                        "title": "Source burst address incrementing",
                        "description": "Specifies the DMA channel burst source address increment"
                      }
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "burst_src_offset_byte": {
                  "title": "Source single address offset",
                  "type": "integer",
                  "description": "Specifies the DMA channel single source address offset",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 8191,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.Additional_configuration.Burst_xfer.configuration==true) && ($config.Additional_configuration.Burst_xfer.DMA_channel_source_burst>1)",
                      "attributes": {
                        "title": "Source burst address offset",
                        "description": "Specifies the DMA channel burst source address offset"
                      }
                    }
                  ],
                  "default": 0
                },
                "burst_dest_inc": {
                  "title": "Destination single address incrementing",
                  "type": "string",
                  "description": "Specifies the DMA channel single destination address increment",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.Additional_configuration.Burst_xfer.configuration==true) && ($config.Additional_configuration.Burst_xfer.DMA_channel_destination_burst>1)",
                      "attributes": {
                        "title": "Destination burst address incrementing",
                        "description": "Specifies the DMA channel burst destination address increment"
                      }
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "burst_dest_offset_byte": {
                  "title": "Destination single address offset",
                  "type": "integer",
                  "description": "Specifies the DMA channel single destination address offset",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 8191,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    },
                    {
                      "type": "set",
                      "condition": "($resource.features.g_transfers.burst==true) && ($config.Additional_configuration.Burst_xfer.configuration==true) && ($config.Additional_configuration.Burst_xfer.DMA_channel_destination_burst>1)",
                      "attributes": {
                        "title": "Destination burst address offset",
                        "description": "Specifies the DMA channel burst destination address offset"
                      }
                    }
                  ],
                  "default": 0
                },
                "block_src_inc": {
                  "title": "Source block address incrementing",
                  "type": "string",
                  "description": "Specifies the DMA channel block source address increment",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "block_src_offset_byte": {
                  "title": "Source block address offset",
                  "type": "integer",
                  "description": "Specifies the DMA channel block source address offset",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 65535,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    }
                  ],
                  "default": 0
                },
                "block_dest_inc": {
                  "title": "Destination block address incrementing",
                  "type": "string",
                  "description": "Specifies the DMA channel block destination address increment",
                  "oneOf": [
                    {
                      "title": "Incremented",
                      "const": "INCREMENTED"
                    },
                    {
                      "title": "Decremented",
                      "const": "DECREMENTED"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    }
                  ],
                  "default": "INCREMENTED"
                },
                "block_dest_offset_byte": {
                  "title": "Destination block address offset",
                  "type": "integer",
                  "description": "Specifies the DMA channel block destination address offset",
                  "unit": "Byte",
                  "minimum": 0,
                  "maximum": 65535,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    }
                  ],
                  "default": 0
                },
                "event_mode": {
                  "title": "Event mode generation",
                  "type": "string",
                  "description": "Specifies the DMA channel block destination address increment",
                  "oneOf": [
                    {
                      "title": "Events generated at each block transfer",
                      "const": "BLOCK"
                    },
                    {
                      "title": "Events generated at each repeated block transfer",
                      "const": "REPEATED_BLOCK"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$config.Additional_configuration.Repeated_block_xfer.configuration"
                    }
                  ],
                  "default": "BLOCK"
                }
              }
            }
          }
        },
        "System_configuration": {
          "title": "System configuration",
          "type": "object",
          "description": "System configuration",
          "properties": {
            "enable_interrupt": {
              "type": "boolean",
              "description": "Enable interruption mode for the DMA channel.",
              "default": false,
              "actions": [
                {
                  "type": "disable",
                  "condition": "$isNeed"
                },
                {
                  "type": "set",
                  "computed": {
                    "const": true
                  },
                  "condition": "$isNeed"
                }
              ]
            },
            "irq_handler_generation_dma": {
              "type": "boolean",
              "title": "IRQ Handler generation",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$config.System_configuration.enable_interrupt"
                }
              ]
            },
            "nvicConfig": {
              "title": "NVIC Event configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$isNeed ||$config.System_configuration.enable_interrupt"
                }
              ],
              "type": "object",
              "objectType": "need.interrupt.lines",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_PROJECT_USE_HAL",
                  "condition": "$info.layer === 'HAL'",
                  "semaphore": true
                }
              ],
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*"
                }
              ]
            }
          }
        }
      }
    }
  }
}