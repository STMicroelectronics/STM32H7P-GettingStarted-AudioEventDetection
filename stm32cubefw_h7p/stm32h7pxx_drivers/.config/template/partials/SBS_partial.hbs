      {{/if}}
      {{#if ADC_IN2_to_PC4~}}
      {{assign 'adc_pin_remap' (helper_sbs_concatenate_selections @root.adc_pin_remap @root.layer '_SBS_REMAP_ADC_IN2_TO_PC4' )~}}
      {{assign 'act' true~}}
      {{/if}}

  /* Enable channel pin remap */
  {{@root.layer}}_SBS_ADC_EnableChannelPinRemap({{@root.adc_pin_remap}});
    {{/with}}
  {{/if~}}
{{else}}
#warning "SBS partial called but wrong step '{{fct}}'"
{{/if}}