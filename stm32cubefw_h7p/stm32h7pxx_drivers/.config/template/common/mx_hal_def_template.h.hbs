{{assign "strategy" (@root.EnvVarAPI.getVariableValue 'SYSTEM_PROJECT_CODEGEN_STRATEGY')~}}
{{~assign 'object_cxt' (helper_common_get_sw_config_ctxt @root.SWProjectAPI @root.DmaAPI @root.SWConfigurationAPI @root.pinoutAPI @root.peripheralsResourceManagerAPI @root.strategy)~}}
{{log "MX_HAL_DEF template object_cxt:" @root.object_cxt~}}
