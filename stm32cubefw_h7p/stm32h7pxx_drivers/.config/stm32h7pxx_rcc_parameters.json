{
  "$schema": "http://json-schema.org/draft-07/schema",
  "componentid": "::Device:STM32CubeMX2 Config:RCC",
  "grammarVersion": "3.1",
  "version": "1.0.0",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/rcc_helpers.js",
      "accessor": "rcc_helpers"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label",
              "$comment": "label associated to the instance of the peripheral, can be overridden at sample level. In this case it becomes read-only.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software Layer",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "true",
                      "message": "Not available"
                    }
                  ]
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_RCC_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "resource initialization code generation",
              "type": "string",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "description": "generate or not the RCC init code, call it or not at boot",
              "$comment": "generate the init code of your RCC or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "default": "called"
            }
          }
        },
        "main": {
          "type": "object",
          "title": "Main configuration",
          "properties": {
            "periph_clocks_init": {
              "type": "integer",
              "title": "Peripherals clock Init",
              "description": "Peripherals clock sources initializion strategy",
              "oneOf": [
                {
                  "title": "Central (Default) - Initialization in mx_system_init",
                  "description": "The peripherals clock sources are configured and activated at once in mx_system_init",
                  "const": 0
                },
                {
                  "title": "Controlled by peripherals - Initialization in the mx_pppi_init",
                  "description": "The peripherals clock sources are configured and activated on demand within the mx_pppi_init generated functions",
                  "const": 1,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "true",
                      "message": "Not available"
                    }
                  ]
                },
                {
                  "title": "Controlled by user - User should called initialization functions",
                  "description": "The peripherals clock sources configuration and activation functions are generated but not called within the mx_system_init",
                  "const": 2,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "true",
                      "message": "Not available"
                    }
                  ]
                }
              ],
              "default": 0
            },
            "flash_latency": {
              "type": "integer",
              "title": "Flash Latency wait states",
              "description": "Possible flash latencies for selected system clock",
              "actions": [
                {
                  "type": "set",
                  "condition": true,
                  "computed": {
                    "default": "$rcc_helpers.helper_rcc_get_optimal_latency($get('clock.frequency','System_Clock_Frequency'))"
                  }
                },
                {
                  "type": "set",
                  "condition": "!($rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), $value))",
                  "computed": {
                    "const": "$rcc_helpers.helper_rcc_get_optimal_latency($get('clock.frequency','System_Clock_Frequency'))"
                  }
                },
                {
                  "type": "warning",
                  "condition": "(($rcc_helpers.helper_rcc_get_optimal_latency($get('clock.frequency','System_Clock_Frequency'))) != $value)",
                  "message": "Selected flash latency is not optimal"
                }
              ],
              "default": 1,
              "oneOf": [
                {
                  "const": 0,
                  "title": "0WS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), 0)"
                    }
                  ]
                },
                {
                  "const": 1,
                  "title": "1WS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), 1)"
                    }
                  ]
                },
                {
                  "const": 2,
                  "title": "2WS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), 2)"
                    }
                  ]
                },
                {
                  "const": 3,
                  "title": "3WS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), 3)"
                    }
                  ]
                },
                {
                  "const": 4,
                  "title": "4WS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), 4)"
                    }
                  ]
                },
                {
                  "const": 5,
                  "title": "5WS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), 5)"
                    }
                  ]
                },
                {
                  "const": 6,
                  "title": "6WS",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','System_Clock_Frequency'), 6)"
                    }
                  ]
                },
                {
                  "const": 7,
                  "title": "7WS"
                },
                {
                  "const": 8,
                  "title": "8WS"
                },
                {
                  "const": 9,
                  "title": "9WS"
                },
                {
                  "const": 10,
                  "title": "10WS"
                },
                {
                  "const": 11,
                  "title": "11WS"
                },
                {
                  "const": 12,
                  "title": "12WS"
                },
                {
                  "const": 13,
                  "title": "13WS"
                },
                {
                  "const": 14,
                  "title": "14WS"
                },
                {
                  "const": 15,
                  "title": "15WS"
                }
              ]
            },
            "flash_programming_delay": {
              "type": "integer",
              "title": "Flash programming delay",
              "description": "Possible flash programming delays for selected system clock",
              "actions": [
                {
                  "type": "set",
                  "condition": true,
                  "computed": {
                    "default": "$rcc_helpers.helper_rcc_get_optimal_programming_delay($get('clock.frequency','System_Clock_Frequency'))"
                  }
                },
                {
                  "type": "warning",
                  "condition": "($rcc_helpers.helper_rcc_get_optimal_programming_delay($get('clock.frequency','System_Clock_Frequency')) !== $value)",
                  "message": "Selected programming delay is not optimal"
                }
              ],
              "oneOf": [
                {
                  "const": 0,
                  "title": "0",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','System_Clock_Frequency'), 0)"
                    }
                  ]
                },
                {
                  "const": 1,
                  "title": "1",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','System_Clock_Frequency'), 1)"
                    }
                  ]
                },
                {
                  "const": 2,
                  "title": "2",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','System_Clock_Frequency'), 2)"
                    }
                  ]
                },
                {
                  "const": 3,
                  "title": "3",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','System_Clock_Frequency'), 3)"
                    }
                  ]
                }
              ]
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Additional features configuration",
          "properties": {
            "hse": {
              "type": "object",
              "title": "HSE (High Speed external Clock)",
              "properties": {
                "state": {
                  "type": "string",
                  "title": "Source",
                  "trackUpdatesFor": [
                    "dry-run"
                  ],
                  "oneOf": [
                    {
                      "title": "Disable",
                      "const": "OFF"
                    },
                    {
                      "title": "Crystal/Ceramic Resonator",
                      "const": "ON"
                    },
                    {
                      "title": "BYPASS Clock Source",
                      "const": "BYPASS"
                    },
                    {
                      "title": "DIGBYPASS Clock Source",
                      "const": "BYPASS_DIGITAL"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "$value !== 'OFF'",
                      "name": "RCC_PROJECT_HSE",
                      "value": true
                    }
                  ],
                  "default": "OFF"
                },
                "startup_time": {
                  "type": "integer",
                  "title": "Startup Timeout Value (ms)",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 100,
                  "variables": [
                    {
                      "on": "include",
                      "name": "RCC_PROJECT_HSE_STARTUP_TIME",
                      "computed_value": "$value"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.hse.state!=='OFF'"
                    },
                    {
                      "type": "set",
                      "condition": "$rcc_helpers.helper_rcc_is_startup_time_available($get('hwPlatform.board'))",
                      "attributes": {
                        "title": "Startup time available in the board"
                      },
                      "computed": {
                        "const": "$rcc_helpers.helper_rcc_get_startup_time($get('hwPlatform.board'), 'hse')"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "$rcc_helpers.helper_rcc_is_startup_time_available($get('hwPlatform.board'))"
                    }
                  ]
                },
                "enable_css": {
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$additional.hse.state==='OFF'"
                    }
                  ],
                  "title": "Enable the Clock Security System.",
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "($value === true)",
                      "name": "NMI_RCC_IRQ_HANDLER",
                      "value": true
                    }
                  ],
                  "default": false
                }
              }
            },
            "lse": {
              "type": "object",
              "title": "LSE (Low Speed External Clock)",
              "properties": {
                "state": {
                  "type": "string",
                  "title": "Source",
                  "trackUpdatesFor": [
                    "dry-run"
                  ],
                  "oneOf": [
                    {
                      "title": "Disable",
                      "const": "OFF"
                    },
                    {
                      "title": "Crystal/Ceramic Resonator",
                      "const": "ON"
                    },
                    {
                      "title": "BYPASS Clock Source",
                      "const": "BYPASS"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "$value !== 'OFF'",
                      "name": "RCC_PROJECT_LSE",
                      "value": true
                    }
                  ],
                  "default": "OFF"
                },
                "startup_time": {
                  "type": "integer",
                  "title": "Startup Timeout Value (ms)",
                  "minimum": 1,
                  "maximum": 50000,
                  "default": 5000,
                  "variables": [
                    {
                      "on": "include",
                      "name": "RCC_PROJECT_LSE_STARTUP_TIME",
                      "computed_value": "$value"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.lse.state!=='OFF'"
                    },
                    {
                      "type": "set",
                      "condition": "$rcc_helpers.helper_rcc_is_startup_time_available($get('hwPlatform.board'))",
                      "attributes": {
                        "title": "Startup time avaialble in the board"
                      },
                      "computed": {
                        "const": "$rcc_helpers.helper_rcc_get_startup_time($get('hwPlatform.board'), 'lse')"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "$rcc_helpers.helper_rcc_is_startup_time_available($get('hwPlatform.board'))"
                    }
                  ]
                },
                "drive_capability": {
                  "type": "string",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$additional.lse.state==='OFF'"
                    }
                  ],
                  "title": "Drive Capability",
                  "oneOf": [
                    {
                      "title": "medium low drive",
                      "const": "MEDIUMLOW"
                    },
                    {
                      "title": "medium high drive",
                      "const": "MEDIUMHIGH"
                    },
                    {
                      "title": "high drive",
                      "const": "HIGH"
                    }
                  ],
                  "default": "MEDIUMLOW"
                },
                "enable_css": {
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$additional.lse.state==='OFF'"
                    }
                  ],
                  "title": "Enable the Clock Security System.",
                  "default": false
                }
              }
            },
            "hsi": {
              "type": "object",
              "title": "HSI (High Speed Internal Clock)",
              "properties": {
                "enable_in_stop_mode": {
                  "type": "boolean",
                  "title": "Enable HSI even in stop mode.",
                  "default": false
                }
              }
            },
            "clk_outputs": {
              "type": "object",
              "title": "Clock Outputs",
              "properties": {
                "mco1": {
                  "type": "boolean",
                  "title": "MCO1",
                  "description": "Master Clock Output 1",
                  "default": false
                },
                "mco2": {
                  "type": "boolean",
                  "title": "MCO2",
                  "description": "Master Clock Output 2",
                  "default": false
                }
              }
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "hse_in": {
                  "type": "object",
                  "title": "HSE In",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$additional.hse.state==='OFF'"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC_IN",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ]
                },
                "hse_out": {
                  "type": "object",
                  "title": "HSE Out",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.hse.state==='ON'"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC_OUT",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ]
                },
                "lse_in": {
                  "type": "object",
                  "title": "LSE In",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$additional.lse.state==='OFF'"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC32_IN",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ]
                },
                "lse_out": {
                  "type": "object",
                  "title": "LSE Out",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($additional.lse.state==='ON')"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC32_OUT",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ]
                },
                "mco1": {
                  "type": "object",
                  "title": "MCO1",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.clk_outputs.mco1"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "MCO1",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "mco2": {
                  "type": "object",
                  "title": "MCO2",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.clk_outputs.mco2"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "MCO2",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "hse_css_interruption": {
                  "title": "HSE CSS configuration",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.hse.enable_css"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "system:NMI"
                    }
                  ]
                }
              }
            },
            "exti": {
              "type": "object",
              "title": "EXTI",
              "properties": {
                "lse_css_interruption": {
                  "type": "object",
                  "title": "LSE CSS configuration",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.lse.enable_css"
                    }
                  ],
                  "objectType": "need.exti.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_EXTI_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}