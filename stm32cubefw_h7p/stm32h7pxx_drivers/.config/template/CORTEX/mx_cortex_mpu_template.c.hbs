system_status_t {{@root.fct_name}}_init(void)
{
  /* Disables the MPU */
  HAL_CORTEX_MPU_Disable();
      {{~#with Basic}}
        {{~#if MPUEnabled}}
          {{~assign 'found_region' false}}
          {{~#each Regions}}
            {{~#if use_region}}
              {{~#unless @root.found_region}}
                {{~assign 'found_region' true}}

  /*
     Initializes and configures the MPU Region
  */
  hal_cortex_mpu_region_config_t p_region_config = {0};
              {{~/unless}}
              {{~assign 'disable_subregion' (helper_cortex_mpu_get_disable_subregion Subregions 'HAL')}}


  p_region_config.base_addr = 0x{{#if (eq BaseAddress 0)}}00000000{{else}}{{uppercase (dec2hex BaseAddress)}}{{/if}};
  p_region_config.size = {{Size}};
  p_region_config.access_attr = HAL_CORTEX_MPU_REGION_{{AccessPermission}};
  p_region_config.mem_attr = HAL_CORTEX_MPU_{{Attributes.MemoryType}}_MEM_{{Attributes.Shareability}}{{Attributes.WritePolicy}}{{Attributes.AllocationPolicy}};
  p_region_config.exec_attr = HAL_CORTEX_MPU_EXECUTION_ATTR_{{InstructionAccess}};
              {{~#if @root.disable_subregion}}
  p_region_config.sub_region = {{@root.disable_subregion}};
              {{~else}}
  p_region_config.sub_region = HAL_CORTEX_MPU_SUB_REGION_ENABLE_ALL;
              {{~/if}}
  HAL_CORTEX_MPU_SetConfigRegion(HAL_CORTEX_MPU_{{_foreignKey}}, &p_region_config);

  HAL_CORTEX_MPU_EnableRegion(HAL_CORTEX_MPU_{{_foreignKey}});
            {{~/if}}
          {{~/each}}


  /* Enables the MPU */
  HAL_CORTEX_MPU_Enable(HAL_CORTEX_MPU_HARDFAULT_NMI_{{DuringHardfault}}, HAL_CORTEX_MPU_ACCESS_FAULT_{{DefaultMapEnabled}});
        {{~/if}}
      {{~/with}}


  return SYSTEM_OK;
}

