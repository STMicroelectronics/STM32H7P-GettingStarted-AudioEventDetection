{{/with}}{{!max_config~}}

{{~#if ../basic.ctrl_role_config.hand_off_activity_state~}}
{{#if (not (eq ../basic.ctrl_role_config.hand_off_activity_state "0"))~}}{{assign 'hand_off_activity_state_found' true~}}{{/if~}}
{{/if~}}
{{#if max_config.speed~}}{{#if (not (eq max_config.speed_limit "HAL_I3C_GETMXDS_FORMAT_1"))~}}{{assign 'speed_found' true~}}{{/if~}}{{/if~}}
{{#if (not (eq turn_around.ta_duration "LESS_12NS"))~}}{{assign 'ta_duration_found' true~}}{{/if~}}
