  if (HAL_I2S_SetFifoThreshold(&h{{@root.current_resource}}, HAL_I2S_FIFO_THRESHOLD_{{SetFifoThreshold}}_DATA) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if I2S_IO_configuration.EnableMasterKeepIOState}}
  {{assign 'found_i2s_master_keep_io' true~}}
