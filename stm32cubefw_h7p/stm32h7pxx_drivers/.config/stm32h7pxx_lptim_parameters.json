{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:LPTIM",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/lptim_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "Software information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Software information",
              "$comment": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 4,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_LPTIM_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "type": "string",
              "title": "resource initialization code generation",
              "description": "generate or not the LPTIM init code, call it or not at boot",
              "$comment": "generate the init code of your LPTIM or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main peripheral configuration",
          "properties": {
            "time_base": {
              "type": "object",
              "description": "LPTIM Time Base Configuration Structure definition.",
              "properties": {
                "frequency": {
                  "type": "integer",
                  "title": "Timer output frequency in Hz (using Internal clock source)",
                  "description": "Calculate Timer output frequency depending on LPTIM kernel clock, Prescaler and Period",
                  "display_format": [
                    "dec"
                  ],
                  "unit": "Hz",
                  "default": 10000,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.time_base.clock_source_configuration.clock_source === 'INTERNAL'"
                    },
                    {
                      "type": "disable",
                      "condition": "true"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_lptim_compute_frequency($get('clock.frequency',$resource.id), $basic.time_base.clock_source_configuration.prescaler, $basic.time_base.clock_source_configuration.period)"
                      }
                    }
                  ]
                },
                "clock_source_configuration": {
                  "type": "object",
                  "description": "LPTIM Time Base Clock Configuration Structure definition.",
                  "properties": {
                    "clock_source": {
                      "type": "string",
                      "description": "Origin of the clock signal feeding  the low power timer prescaler which by turn feeds the low power timer counter.",
                      "actions": [
                        {
                          "type": "disable",
                          "condition": "$resource.features.nb_cc === 0"
                        }
                      ],
                      "oneOf": [
                        {
                          "title": "Internal clock source",
                          "description": "Kernel clock (lptim_ker_ck) selected as clock source",
                          "const": "INTERNAL"
                        },
                        {
                          "title": "External clock source (Synchronous)",
                          "const": "EXTERNAL_SYNCHRONOUS"
                        },
                        {
                          "title": "External clock source (Asynchronous)",
                          "const": "EXTERNAL_ASYNCHRONOUS"
                        },
                        {
                          "title": "Encoder submode 1",
                          "const": "ENCODER_SUBMODE_1"
                        },
                        {
                          "title": "Encoder submode 2",
                          "const": "ENCODER_SUBMODE_2"
                        },
                        {
                          "title": "Encoder submode 3",
                          "const": "ENCODER_SUBMODE_3"
                        }
                        
                      ],
                      "default": "INTERNAL"
                    },
                    "input1": {
                      "type": "object",
                      "title": "LPTIM input 1 sources",
                      "actions": [
                        {
                          "type": "exclude",
                          "condition": "($basic.time_base.clock_source_configuration.clock_source === 'INTERNAL')"
                        },
                        {
                           "type": "info",
                           "condition": "true",
                           "message": "The selected interconnect must be configured manually"
                        }
                      ],
                      "objectType": "query",
                      "query": {
                        "entity": "peripheral.interconnect.external input clock",
                        "parent": "$resource.id",
                        "where": "$entity.ip_signal.includes('in1')",
                        "title": "{{source}}"
                      }
                    },
                    "input2": {
                      "type": "object",
                      "title": "LPTIM input 2 sources",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($basic.time_base.clock_source_configuration.clock_source === 'ENCODER_SUBMODE_1') || ($basic.time_base.clock_source_configuration.clock_source === 'ENCODER_SUBMODE_2') || ($basic.time_base.clock_source_configuration.clock_source === 'ENCODER_SUBMODE_3')"
                        },
                        {
                           "type": "info",
                           "condition": "true",
                           "message": "The selected interconnect must be configured manually"
                        }
                      ],
                      "objectType": "query",
                      "query": {
                        "entity": "peripheral.interconnect.external input clock",
                        "parent": "$resource.id",
                        "where": "$entity.ip_signal.includes('in2')",
                        "title": "{{source}}"
                      }
                    },
                    "in1_polarity": {
                      "type": "string",
                      "title": "LPTIM input1 polarity",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($basic.time_base.clock_source_configuration.clock_source === 'EXTERNAL_ASYNCHRONOUS') || ($basic.time_base.clock_source_configuration.clock_source === 'EXTERNAL_SYNCHRONOUS')"
                        }
                      ],
                      "oneOf": [
                        {
                          "title": "Rising",
                          "description": "Rising edges are detected on input1",
                          "const": "RISING"
                        },
                        {
                          "title": "Falling",
                          "description": "Falling edges are detected on input1",
                          "const": "FALLING"
                        },
                        {
                          "title": "Rising and Falling",
                          "description": "Both Rising and Falling edges are detected on input1",
                          "const": "RISING_FALLING"
                        }
                      ],
                      "default": "RISING"
                    },
                    "in_filter": {
                      "type": "string",
                      "title": "LPTIM input filter",
                      "actions": [
                        {
                          "type": "exclude",
                          "condition": "($basic.time_base.clock_source_configuration.clock_source === 'INTERNAL')"
                        }
                      ],
                      "oneOf": [
                        {
                          "title": "No filter",
                          "const": "FDIV1"
                        },
                        {
                          "title": "No division, Length=2 clocks",
                          "const": "FDIV1_N2"
                        },
                        {
                          "title": "No division, Length=4 clocks",
                          "const": "FDIV1_N4"
                        },
                        {
                          "title": "No division, Length=8 clocks",
                          "const": "FDIV1_N8"
                        }
                      ],
                      "default": "FDIV1"
                    },
                    "prescaler": {
                      "type": "string",
                      "oneOf": [
                        {
                          "title": "No Prescaler",
                          "const": "DIV1"
                        },
                        {
                          "title": "Division by 2",
                          "const": "DIV2"
                        },
                        {
                          "title": "Division by 4",
                          "const": "DIV4"
                        },
                        {
                          "title": "Division by 8",
                          "const": "DIV8"
                        },
                        {
                          "title": "Division by 16",
                          "const": "DIV16"
                        },
                        {
                          "title": "Division by 32",
                          "const": "DIV32"
                        },
                        {
                          "title": "Division by 64",
                          "const": "DIV64"
                        },
                        {
                          "title": "Division by 128",
                          "const": "DIV128"
                        }
                      ],
                      "default": "DIV1"
                    },
                    "period": {
                      "type": "integer",
                      "title": "Counter period",
                      "description": "LPTIM counter period.",
                      "display_format": [
                        "hex",
                        "dec"
                      ],
                      "minimum": 1,
                      "maximum": 65535,
                      "default": 65535
                    },
                    "repetition_counter": {
                      "type": "integer",
                      "display_format": [
                        "hex",
                        "dec"
                      ],
                      "minimum": 0,
                      "maximum": 255,
                      "default": 0
                    }
                  }
                }
              }
            },
            "counter_mode": {
              "type": "string",
              "title": "LPTIM Counter Mode Configuration",
              "oneOf": [
                {
                  "title": "CONTINUOUS",
                  "description": "The timer is free running. Counter starts from triger event and never stops.",
                  "const": "CONTINUOUS"
                },
                {
                  "title": "ONE SHOT",
                  "description": "Counter stopped on update event",
                  "const": "ONE_SHOT"
                },
                {
                  "title": "SET ONCE",
                  "description": "Counter starts after a trigger event for a single one-shot cycle.",
                  "const": "SET_ONCE"
                },
                {
                  "title": "TIMEOUT",
                  "description": "The detection of an active edge on one selected trigger input can be used to reset the LPTIM counter.",
                  "const": "TIMEOUT"
                }
              ],
              "default": "CONTINUOUS"
            },
            "input_output_channels": {
              "type": "object",
              "title": "Input/Output channel(s) configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.nb_cc > 0"
                }
              ],
              "properties": {
                "channels": {
                  "type": "array",
                  "rendering": "channels-tabs",
                  "title": "Input/Output channel(s) configuration",
                  "source": "Array.from({ length: ($resource.features.nb_cc)}, (_, i) => ({ id: ('CH' + (i + 1) ) }))",
                  "itemId": "id",
                  "itemTitle": "name",
                  "itemVar": "channel",
                  "items": {
                    "type": "object",
                    "properties": {
                      "use_channel": {
                        "type": "boolean",
                        "description": "Use and configure the channel",
                        "default": false
                      },
                      "channel_direction": {
                        "type": "string",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "$item.use_channel == true"
                          },
                          {
                            "type": "set",
                            "condition": "(($channel.id === 'CH1') || ($channel.id === 'CH2')) && ($basic.time_base.clock_source_configuration.clock_source.includes('ENCODER')",
                            "computed": {
                              "const": "Input"
                            }
                          }
                        ],
                        "oneOf": [
                          {
                            "title": "Input",
                            "const": "Input"
                          },
                          {
                            "title": "Output",
                            "const": "Output"
                          }
                        ],
                        "default": "Output"
                      },
                      "input_configuration": {
                        "type": "object",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "$item.use_channel && ($item.channel_direction === 'Input')"
                          }
                        ],
                        "properties": {
                          "ic_source": {
                            "type": "object",
                            "title": "LPTIM Channel sources",
                             "actions": [
                            {
                             "type": "info",
                             "condition": "true",
                             "message": "The selected interconnect must be configured manually"
                             }
                            ],
                            "objectType": "query",
                            "query": {
                              "entity": "peripheral.interconnect.input capture trigger",
                              "parent": "$resource.id",
                              "where": "$entity.ip_signal.includes('ic' + $common.helper_lptim_get_channel_id($item._foreignKey))",
                              "title": "{{source}}"
                            }
                          },
                          "ic_polarity": {
                            "type": "string",
                            "title": "LPTIM input polarity",
                            "oneOf": [
                              {
                                "title": "Rising",
                                "description": "Rising edges are detected on input channel",
                                "const": "RISING"
                              },
                              {
                                "title": "Falling",
                                "description": "Falling edges are detected on input channel",
                                "const": "FALLING"
                              },
                              {
                                "title": "Rising and Falling",
                                "description": "Both Rising and Falling edges are detected on input channel",
                                "const": "RISING_FALLING"
                              }
                            ],
                            "default": "RISING"
                          },
                          "ic_prescaler": {
                            "type": "string",
                            "title": "LPTIM prescaler",
                            "oneOf": [
                              {
                                "title": "Capture performed each time an edge is detected",
                                "const": "DIV1"
                              },
                              {
                                "title": "Capture performed once every 2 events",
                                "const": "DIV2"
                              },
                              {
                                "title": "Capture performed once every 4 events",
                                "const": "DIV4"
                              },
                              {
                                "title": "Capture performed once every 8 events",
                                "const": "DIV8"
                              }
                            ],
                            "default": "DIV1"
                          },
                          "ic_filter": {
                            "type": "string",
                            "title": "LPTIM input filter",
                            "oneOf": [
                              {
                                "title": "No filter",
                                "const": "FDIV1"
                              },
                              {
                                "title": "No division, Length=2 clocks",
                                "const": "FDIV1_N2"
                              },
                              {
                                "title": "No division, Length=4 clocks",
                                "const": "FDIV1_N4"
                              },
                              {
                                "title": "No division, Length=8 clocks",
                                "const": "FDIV1_N8"
                              }
                            ],
                            "default": "FDIV1"
                          }
                        }
                      },
                      "output_configuration": {
                        "type": "object",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "$item.use_channel && ($item.channel_direction === 'Output')"
                          }
                        ],
                        "properties": {
                          "oc_pulse": {
                            "type": "integer",
                            "title": "LPTIM output pulse",
                            "display_format": [
                              "hex",
                              "dec"
                            ],
                            "minimum": 0,
                            "maximum": 65535,
                            "default": 1
                          },
                          "oc_polarity": {
                            "type": "string",
                            "title": "LPTIM output polarity",
                            "oneOf": [
                              {
                                "title": "Regular",
                                "description": "Output channel active high",
                                "const": "OC_HIGH"
                              },
                              {
                                "title": "Inverse",
                                "description": "Output channel active low",
                                "const": "OC_LOW"
                              }
                            ],
                            "default": "OC_HIGH"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "preload_enable": {
              "title": "Auto-Reload register (ARR) preload",
              "description": "If enabled, registers are updated at next LPTIM update event",
              "type": "boolean",
              "default": false
            },
            "external_trigger_config": {
              "type": "object",
              "title": "External Trigger configuration",
              "properties": {
                "use_external_trigger": {
                  "type": "boolean",
                  "description": "Use and configure the external trigger",
                  "default": false
                },
                "source": {
                  "type": "object",
                  "title": "LPTIM external trigger sources",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.external_trigger_config.use_external_trigger == true"
                    },
                    {
                      "type": "info",
                      "condition": "true",
                      "message": "The selected interconnect must be configured manually"
                    }
                  ],
                  "objectType": "query",
                  "query": {
                    "entity": "peripheral.interconnect.external input trigger",
                    "parent": "$resource.id",
                    "title": "{{source}}"
                  }
                },
                "polarity": {
                  "type": "string",
                  "title": "LPTIM external trigger polarity",
                  "actions": [
                    {
                      "type": "enable",
                      "message": "Need to have \"Use external trigger\" activated",
                      "condition": "$basic.external_trigger_config.use_external_trigger == true"
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Rising",
                      "description": "Counter starts when a rising edge is detected",
                      "const": "RISING"
                    },
                    {
                      "title": "Falling",
                      "description": "Counter starts when a falling edge is detected",
                      "const": "FALLING"
                    },
                    {
                      "title": "Rising and Falling",
                      "description": "Counter starts when a rising or a falling edge is detected",
                      "const": "RISING_FALLING"
                    }
                  ],
                  "default": "RISING"
                },
                "filter": {
                  "type": "string",
                  "title": "LPTIM external trigger filter",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$basic.external_trigger_config.use_external_trigger == true"
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "No filter",
                      "const": "FDIV1"
                    },
                    {
                      "title": "No division, Length=2 clocks",
                      "const": "FDIV1_N2"
                    },
                    {
                      "title": "No division, Length=4 clocks",
                      "const": "FDIV1_N4"
                    },
                    {
                      "title": "No division, Length=8 clocks",
                      "const": "FDIV1_N8"
                    }
                  ],
                  "default": "FDIV1"
                }
              }
            }
          }
        },
        "System": {
          "type": "object",
          "title": "System configuration",
          "properties": {
            "gpio_settings": {
              "type": "object",
              "description": "GPIO settings",
              "actions": [
                {
                  "type": "include",
                  "condition": "($basic.external_trigger_config.use_external_trigger && $basic.external_trigger_config.source.source === 'GPIO') || $common.helper_lptim_need_gpio_input($basic.time_base.clock_source_configuration.input1) == true || $common.helper_lptim_need_gpio_input($basic.time_base.clock_source_configuration.input2) == true || $common.helper_lptim_need_gpio_channel($basic.input_output_channels, 'CH1') == true || $common.helper_lptim_need_gpio_channel($basic.input_output_channels, 'CH2') == true"
                }
              ],
              "properties": {
                "in1_gpio_setting": {
                  "type": "object",
                  "title": "IN1 GPIO setting",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$common.helper_lptim_need_gpio_input($basic.time_base.clock_source_configuration.input1)"
                    }
                  ],
                  "properties": {
                    "in1_gpio": {
                      "type": "object",
                      "objectType": "need.pinout.signals",
                      "variables": [
                        {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                        }
                      ],
                      "owner": "$resource.id",
                      "needs": [
                        {
                          "selector": "IN1",
                          "constraints": {
                            "mode": {
                              "const": "ALTERNATE"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "in2_gpio_setting": {
                  "type": "object",
                  "title": "IN2 GPIO setting",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$common.helper_lptim_need_gpio_input($basic.time_base.clock_source_configuration.input2)"
                    }
                  ],
                  "properties": {
                    "in2_gpio": {
                      "type": "object",
                      "objectType": "need.pinout.signals",
                      "variables": [
                        {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                        }
                      ],
                      "owner": "$resource.id",
                      "needs": [
                        {
                          "selector": "IN2",
                          "constraints": {
                            "mode": {
                              "const": "ALTERNATE"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "channel1_gpio": {
                  "type": "object",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($common.helper_lptim_need_gpio_channel($basic.input_output_channels, 'CH1') == true)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CH1",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "channel2_gpio": {
                  "type": "object",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($common.helper_lptim_need_gpio_channel($basic.input_output_channels, 'CH2') == true)"
                    }
                  ],
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CH2",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                },
                "etr_gpio": {
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($basic.external_trigger_config.use_external_trigger == true) && ($basic.external_trigger_config.source.source === 'GPIO')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "ETR",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "dma_settings": {
              "type": "object",
              "description": "DMA settings",
              "properties": {
                "enable_dma_ch1": {
                  "type": "boolean",
                  "title": "enable dma for LPTIM channel1",
                  "description": "Enable CH1 (channel 1) DMA requests",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.nb_cc > 0"
                    },
                    {
                      "type": "enable",
                      "condition": "$common.helper_lptim_find_channel_config($basic.input_output_channels.channels, 'CH1')"
                    },
                    {
                      "type": "exclude",
                      "condition": "!$common.helper_lptim_find_channel_config($basic.input_output_channels.channels, 'CH1')"
                    }
                  ],
                  "default": false
                },
                "dma_config_ch1": {
                  "title": "DMA LPTIM Channel1 configuration",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$System.dma_settings.enable_dma_ch1 == true"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "IC1",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "const": "FIXED"
                        },
                        "dest_inc": {
                          "default": "INCREMENTED"
                        },
                        "src_data_width": {
                          "allow": [
                            "WORD",
                            "HALFWORD",
                            "BYTE"
                          ],
                          "default": "WORD"
                        },
                        "dest_data_width": {
                          "allow": [
                            "WORD",
                            "HALFWORD",
                            "BYTE"
                          ],
                          "default": "WORD"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_ch2": {
                  "type": "boolean",
                  "title": "enable dma for LPTIM channel2",
                  "description": "Enable CH2 (channel 2) DMA requests",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.nb_cc > 0"
                    },
                    {
                      "type": "enable",
                      "condition": "$common.helper_lptim_find_channel_config($basic.input_output_channels.channels, 'CH2')"
                    },
                    {
                      "type": "exclude",
                      "condition": "!$common.helper_lptim_find_channel_config($basic.input_output_channels.channels, 'CH2')"
                    }
                  ],
                  "default": false
                },
                "dma_config_ch2": {
                  "title": "DMA LPTIM Channel2 configuration",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$System.dma_settings.enable_dma_ch2 == true"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "IC2",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "const": "FIXED"
                        },
                        "dest_inc": {
                          "default": "INCREMENTED"
                        },
                        "src_data_width": {
                          "allow": [
                            "WORD",
                            "HALFWORD",
                            "BYTE"
                          ],
                          "default": "WORD"
                        },
                        "dest_data_width": {
                          "allow": [
                            "WORD",
                            "HALFWORD",
                            "BYTE"
                          ],
                          "default": "WORD"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_update": {
                  "type": "boolean",
                  "description": "Enable Update DMA requests",
                  "default": false
                },
                "dma_config_update": {
                  "title": "Update DMA requests configuration",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$System.dma_settings.enable_dma_update == true"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "UE",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_inc": {
                          "default": "FIXED"
                        },
                        "src_data_width": {
                          "allow": [
                            "WORD",
                            "HALFWORD",
                            "BYTE"
                          ],
                          "default": "WORD"
                        },
                        "dest_data_width": {
                          "allow": [
                            "WORD",
                            "HALFWORD",
                            "BYTE"
                          ],
                          "default": "WORD"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "EnableInterruption": {
              "type": "boolean",
              "description": "Enable interruption mode for the peripheral.",
              "default": false
            },
            "irq_handler_generation": {
              "type": "boolean",
              "title": "IRQ Handler generation",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableInterruption && $info.layer === 'HAL'"
                }
              ]
            },
            "nvicConfig": {
              "title": "NVIC configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableInterruption"
                }
              ],
              "type": "object",
              "objectType": "need.interrupt.lines",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_PROJECT_USE_HAL",
                  "condition": "$info.layer === 'HAL'",
                  "semaphore": true
                }
              ],
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*"
                }
              ]
            }
          }
        }
      }
    }
  }
}