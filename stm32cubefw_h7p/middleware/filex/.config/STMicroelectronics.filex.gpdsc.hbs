<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- ******************************************************************************
 * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
 * Description : Generator PDSC File generated by CodeGen
 ****************************************************************************** -->
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0"
  xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updated--}}
  <releases>
    <release version="0.0.1" date="2025-02-05">
      - First GPDSC FileX Model Release
    </release>
  </releases>
  <conditions>
    {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="USE FAULT TOLERANCE ENV,USE SD DMA OS ENV,USE SD DMA NO OS ENV,USE SD POLLING ENV,USE MMC DMA OS ENV,USE MMC DMA NO OS ENV,USE MMC POLLING ENV,USE NOR ENV,USE NAND ENV")~}}
    {{{@root.conditions}}}
    <condition id="USE FAULT TOLERANCE ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'Fault_tolerance_support')}}
      <require Cclass="File System" Cgroup="FileX" Csub="Fault Tolerance Support"/>
      {{/if}}
    </condition>
    <condition id="USE SD DMA OS ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_sd_dma_os')}}
      <require Cclass="File System" Cgroup="FileX" Csub="sd_dma_os_itf"/>
      {{/if}}
    </condition>

    <condition id="USE SD POLLING ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_sd_polling')}}
      <require Cclass="File System" Cgroup="FileX" Csub="sd_polling_itf"/>
      {{/if}}
    </condition>

    <condition id="USE SD DMA NO OS ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_sd_dma_no_os')}}
      <require Cclass="File System" Cgroup="FileX" Csub="sd_dma_no_os_itf"/>
      {{/if}}
    </condition>

    <condition id="USE MMC DMA OS ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_mmc_dma_os')}}
      <require Cclass="File System" Cgroup="FileX" Csub="mmc_dma_os_itf"/>
      {{/if}}
    </condition>

    <condition id="USE MMC POLLING ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_mmc_polling')}}
      <require Cclass="File System" Cgroup="FileX" Csub="mmc_polling_itf"/>
      {{/if}}
    </condition>

    <condition id="USE MMC DMA NO OS ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_mmc_dma_no_os')}}
      <require Cclass="File System" Cgroup="FileX" Csub="mmc_dma_no_os_itf"/>
      {{/if}}
    </condition>

    <condition id="USE NOR ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_nor')}}
      <require Cclass="File System" Cgroup="FileX" Csub="nor_flash_itf"/>
      {{/if}}
    </condition>

    <condition id="USE NAND ENV">
      {{#if (@root.EnvVarAPI.getVariableValue 'generated_nand')}}
      <require Cclass="File System" Cgroup="FileX" Csub="nand_flash_itf"/>
      {{/if}}
    </condition>
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
   {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="FileX"'))}}
        <Pre_Include_Global_h>
          #define FX_INCLUDE_USER_DEFINE_FILE
        </Pre_Include_Global_h>
      {{/if}}
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>