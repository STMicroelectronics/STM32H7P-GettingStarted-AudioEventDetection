/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{uppercase @root.file_name}}_H
#define MX_{{uppercase @root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
#include "stm32_hal.h"
#include "mx_def.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{!log "GPIO template - instance:" (toJSON this)~}}
  {{#if (eq @root.strategy "HW")}}
    {{! ~}}
    {{assign 'current_layer' info.layer~}}
    {{assign 'name' name~}}
  {{else}}
    {{! ~}}
    {{assign 'gpio_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{assign 'current_layer' @root.gpio_cxt.info.layer~}}
    {{assign 'current_resource' @root.gpio_cxt.settings.resources.instance.label~}}
    {{assign 'name' @root.gpio_cxt.name~}}
  {{/if}}
/******************************************************************************/
/* Exported defines for {{@root.current_resource}} in {{@root.current_layer}} layer (SW instance {{@root.name}}) */
/******************************************************************************/
  {{#with @root.configs}}
    {{#each pins}}
      {{#with basic}}
        {{~assign 'current_port' port~}}
        {{~assign 'current_pin' pin~}}
        {{~assign 'output_init_state' 'undefined'~}}
        {{#if output_init_state}}
          {{~assign 'output_init_state' output_init_state~}}
          {{~assign 'output_active_state' output_active_state~}}
        {{/if}}
        {{~assign 'current_exti' EnableEXTI~}}
        {{~assign 'aliases' (helper_gpio_create_aliases labels ../label_name)~}}
        {{#if @root.aliases.master_label}}
/* Primary aliases for GPIO P{{@root.current_port}}{{@root.current_pin}} pin */
        {{#if (eq @root.current_layer 'HAL')}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PORT") 47}} HAL_GPIO{{@root.current_port}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PIN") 47}} HAL_GPIO_PIN_{{@root.current_pin}}
          {{#if (not (eq @root.output_init_state 'undefined'))}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INIT_STATE") 47}} HAL_GPIO_PIN_{{#if (eq @root.output_init_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_ACTIVE_STATE") 47}} HAL_GPIO_PIN_{{#if (eq @root.output_active_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INACTIVE_STATE") 47}} HAL_GPIO_PIN_{{#if (eq @root.output_active_state 'LOW')}}SET{{else}}RESET{{/if}}
          {{/if}}
        {{else}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PORT") 47}} GPIO{{@root.current_port}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PIN") 47}} LL_GPIO_PIN_{{@root.current_pin}}
          {{#if (not (eq @root.output_init_state 'undefined'))}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INIT_STATE") 47}} LL_GPIO_PIN_{{#if (eq @root.output_init_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_ACTIVE_STATE") 47}} LL_GPIO_PIN_{{#if (eq @root.output_active_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_INACTIVE_STATE") 47}} LL_GPIO_PIN_{{#if (eq @root.output_active_state 'LOW')}}SET{{else}}RESET{{/if}}
          {{/if}}
        {{/if}}
        {{~assign 'found_other_labels' false}}
        {{#each @root.aliases.other_labels}}
          {{#if (not @root.found_other_labels)}}
/* Secondary aliases for GPIO P{{@root.current_port}}{{@root.current_pin}} pin */
            {{~assign 'found_other_labels' true}}
          {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_GPIO_PORT") 47}} HAL_GPIO{{@root.current_port}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_GPIO_PIN") 47}} HAL_GPIO_PIN_{{@root.current_pin}}
            {{#if (not (eq @root.output_init_state 'undefined'))}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_INIT_STATE") 47}} HAL_GPIO_PIN_{{#if (eq @root.output_init_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_ACTIVE_STATE") 47}} HAL_GPIO_PIN_{{#if (eq @root.output_active_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_INACTIVE_STATE") 47}} HAL_GPIO_PIN_{{#if (eq @root.output_active_state 'LOW')}}SET{{else}}RESET{{/if}}
            {{/if}}
          {{else}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_GPIO_PORT") 47}} GPIO{{@root.current_port}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_GPIO_PIN") 47}} LL_GPIO_PIN_{{@root.current_pin}}
            {{#if (not (eq @root.output_init_state 'undefined'))}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_INIT_STATE") 47}} LL_GPIO_PIN_{{#if (eq @root.output_init_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_ACTIVE_STATE") 47}} LL_GPIO_PIN_{{#if (eq @root.output_active_state 'HIGH')}}SET{{else}}RESET{{/if}}
#define {{helper_gpio_add_pad_right (concat (uppercase this) "_INACTIVE_STATE") 47}} LL_GPIO_PIN_{{#if (eq @root.output_active_state 'LOW')}}SET{{else}}RESET{{/if}}
            {{/if}}
          {{/if}}

        {{/each}}
        {{/if}}
        {{#if @root.current_exti}}
{{> EXTI fct='exti_gpio_generate_aliases' layer=@root.current_layer needs=extiConfig.needs}}
        {{/if}}
      {{/with}}
    {{/each}}
  {{/with}}

{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "HW")}}
    {{! ~}}
    {{assign 'current_layer' info.layer~}}
    {{assign 'configs' this~}}
    {{assign 'name' name~}}
  {{else}}
    {{! ~}}
    {{assign 'gpio_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{assign 'current_layer' @root.gpio_cxt.info.layer~}}
    {{assign 'current_resource' @root.gpio_cxt.settings.resources.instance.label~}}
    {{assign 'name' @root.gpio_cxt.name~}}
  {{/if}}
  {{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer (SW instance {{@root.name}}) */
/******************************************************************************/
    {{! ~}}
    {{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
    {{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval 0  GPIO group correctly initialized
  * @retval -1 Issue detected during GPIO group initialization
  */
    {{#if (eq @root.current_layer 'HAL')}}
system_status_t {{@root.fct_name}}_init(void);
    {{else}}
system_status_t {{@root.fct_name}}_init(void);
    {{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance.
  */
system_status_t {{@root.fct_name}}_deinit(void);

{{/each}}
{{> EXTI fct='exti_gpio_gethandle_proto' exti_list=@root.exti_object.list_exti}}
{{#each @root.irq_info_list}}
{{#if generate_handler}}
/******************************************************************************/
/* {{description}} */
/******************************************************************************/
void {{line}}_IRQHandler(void);
{{else}}
/******************************************************************************/
/* {{description}} is managed directly in user code. */
/******************************************************************************/
/* void {{line}}_IRQHandler(void); */
{{/if}}
{{/each}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{uppercase @root.file_name}}_H */
