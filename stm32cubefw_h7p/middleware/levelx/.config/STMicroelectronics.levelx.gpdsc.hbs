<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- ******************************************************************************
 * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
 * Description : Generator PDSC File generated by CodeGen
 ****************************************************************************** -->
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0"
  xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updated--}}
  <releases>
    <release version="0.0.1" date="2025-02-03">
      - First GPDSC LevelX Model Release
    </release>
  </releases>
  <conditions>
    {{~assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="Use NOR Flash Core, Use NAND Flash
    Core, USE W25N01GVXX POLLING, USE W25N01GVXX DMA NO OS, USE W25N01GVXX DMA OS, USE MX66UW1G45G POLLING")}}
    {{{@root.conditions}}}
    <condition id="Use NOR Flash Core">
      {{#if (@root.EnvVarAPI.getVariableValue 'NOR_Flash')}}
      <require Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core" />
      {{/if}}
    </condition>
    <condition id="Use NAND Flash Core">
      {{#if (@root.EnvVarAPI.getVariableValue 'NAND_Flash')}}
      <require Cclass="File System" Cgroup="LevelX" Csub="NAND Flash Core" />
      {{/if}}
    </condition>
    <condition id="USE W25N01GVXX POLLING">
      {{#if (@root.EnvVarAPI.getVariableValue 'w25n01gvxx_nand_polling')}}
      <require Cclass="File System" Cgroup="LevelX" Csub="NAND Flash Core" />
      <require Cclass="Board Part" Cgroup="Memory" Csub="W25N01GVXX Core" />
      <require Cclass="File System" Cgroup="LevelX" Csub="w25n01gvxx_nand_polling_itf" />
      {{/if}}
    </condition>
    <condition id="USE W25N01GVXX DMA NO OS">
      {{#if (@root.EnvVarAPI.getVariableValue 'w25n01gvxx_nand_dma_no_os')}}
      <require Cclass="File System" Cgroup="LevelX" Csub="NAND Flash Core" />
      <require Cclass="Board Part" Cgroup="Memory" Csub="W25N01GVXX Core" />
      <require Cclass="File System" Cgroup="LevelX" Csub="w25n01gvxx_nand_dma_no_os_itf" />
      {{/if}}
    </condition>
    <condition id="USE W25N01GVXX DMA OS">
      {{#if (@root.EnvVarAPI.getVariableValue 'w25n01gvxx_nand_dma_os')}}
      <require Cclass="File System" Cgroup="LevelX" Csub="NAND Flash Core" />
      <require Cclass="Board Part" Cgroup="Memory" Csub="W25N01GVXX Core" />
      <require Cclass="File System" Cgroup="LevelX" Csub="w25n01gvxx_nand_dma_os_itf" />
      {{/if}}
    </condition>
    <condition id="USE MX66UW1G45G POLLING">
      {{#if (@root.EnvVarAPI.getVariableValue 'mx66uw1g45g_nor_polling')}}
      <require Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core"/>
      <require Cclass="Board Part" Cgroup="Memory" Csub="MX66UW1G45G Core"/>
      <require Cclass="File System" Cgroup="LevelX" Csub="mx66uw1g45g_nor_polling_itf" />
      {{/if}}
    </condition>
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
    {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}}
      {{{condition}}}>
      <description>{{description}}</description>
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="LevelX"'))}}
      <Pre_Include_Global_h>
        #define LX_INCLUDE_USER_DEFINE_FILE
      </Pre_Include_Global_h>
      {{/if}}
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>