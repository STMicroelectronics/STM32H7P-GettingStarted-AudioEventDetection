  /* Set the number of additional Mandatory data Byte (MDB) sent to the controller after an acknowledge of the IBI */
  {{~assign 'nb_ibi_add_data' (concat 'LL_I3C_PAYLOAD_' ibi_config.ibi_payload)}}
