{{assign 'hal_handle_exist' 0~}}
{{assign 'exti_object' 'undefined'~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "HW")}}
    {{! ~}}
    {{assign 'current_layer' info.layer~}}
    {{assign 'configs' this~}}
  {{else}}
    {{! ~}}
    {{assign 'gpio_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{assign 'current_layer' @root.gpio_cxt.info.layer~}}
    {{assign 'configs' @root.gpio_cxt~}}
  {{/if}}
  {{! ~}}
  {{#with @root.configs}}
    {{#each pins}}
      {{~assign 'new_pin' (@root.pinoutAPI.getPinData _foreignKey)~}}
      {{#if basic.EnableEXTI}}
        {{! ~}}
        {{assign 'exti_object' (helper_gpio_retrieve_exti_object @root.current_layer this @root.new_pin @root.exti_object)~}}
        {{!log 'exti_object' @root.exti_object~}}
      {{/if}}
    {{/each}}
  {{/with}}
{{/each}}
{{#> EXTI fct='exti_gpio_variables' layer='HAL' exti_list=@root.exti_object.list_exti}}
{{/EXTI}}

{{helper_common_initialize_index~}}
{{assign 'nvic_context' 'undefined'~}}
{{assign 'nvic_generate_handler' true~}}
{{#each @root.instances}}
  {{#if (eq @root.strategy "HW")}}
    {{! ~}}
    {{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
    {{assign 'name' name~}}
    {{assign 'current_layer' info.layer~}}
  {{else}}
    {{! ~}}
    {{assign 'gpio_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{assign 'name' @root.gpio_cxt.name~}}
    {{assign 'current_layer' @root.gpio_cxt.info.layer~}}
    {{assign 'current_resource' @root.gpio_cxt.settings.resources.instance.label~}}
    {{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
  {{/if}}
  {{! ~}}
/******************************************************************************/
/* Exported functions for GPIO in {{@root.current_layer}} layer (SW instance {{@root.name}}) */
/******************************************************************************/
  {{! ~}}
  {{assign 'gpio_object' 'undefined'~}}
  {{#each pins}}
    {{! ~}}
    {{assign 'new_pin' (@root.pinoutAPI.getPinData _foreignKey)~}}
    {{!log "GPIO template - new pin:" @root.new_pin~}}
    {{assign 'gpio_object' (helper_gpio_get_gpioconfig_standalone_object label_name basic @root.new_pin @root.gpio_object)~}}
  {{/each}}
  {{!log "GPIO template - gpio_object:" (toJSON @root.gpio_object)~}}
  {{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
  {{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
  {{!
      Generation of initialization function used in HAL
  ~}}
  {{#if (eq @root.current_layer 'HAL')}}
system_status_t {{@root.fct_name}}_init(void)
{
      {{#if (length @root.gpio_object.list_port)}}
  hal_gpio_config_t  gpio_config;

      {{/if}}
      {{#each @root.gpio_object.list_port}}
        {{! ~}}
        {{assign 'gpio_port' (append 'GPIO' this)~}}
        {{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.gpio_port}}
      {{/each}}
      {{~assign 'found_exti' false~}}

      {{#each @root.gpio_object.list_config_pins}}

        {{#if aliases.master_label}}
  /* {{helper_gpio_add_pad_right (concat "P" port pin) 4}}  --------->  {{aliases.master_label}} */
        {{#each aliases.other_labels}}
  /* {{helper_gpio_add_pad_right (concat "P" ../port ../pin) 4}}  --------->  {{this}} */
        {{/each}}

        {{/if}}
        {{! if low_power is enabled, translated GPIO pin to LPGIO pin ex GPIOA pin 1 in low power configures LPGIO1 pin 0}}
        {{#if (eq mode 'EVENTOUT')}}
  /* Configure P{{port}}{{pin}} in alternate mode for EVENTOUT */
        {{/if}}
  gpio_config.mode            = HAL_GPIO_MODE_{{#if (eq mode 'EVENTOUT')}}ALTERNATE{{else}}{{mode}}{{/if}};
        {{#if speed}}
  gpio_config.speed           = HAL_GPIO_SPEED_FREQ_{{speed}};
        {{/if}}
        {{#if pull}}
  gpio_config.pull            = HAL_GPIO_PULL_{{pull}};
        {{/if}}
        {{#if output_type}}
  gpio_config.output_type     = HAL_GPIO_OUTPUT_{{output_type}};
        {{/if}}
        {{#if (eq mode 'EVENTOUT')}}
  gpio_config.alternate       = HAL_GPIO_AF_15;
        {{/if}}
        {{#if output_init_state}}
  gpio_config.init_state      = {{#if aliases.master_label}}{{aliases.master_label}}_INIT_STATE{{else}}HAL_GPIO_PIN_{{#if (eq output_init_state 'HIGH')}}SET{{else}}RESET{{/if}}{{/if}};

        {{/if}}
  if (HAL_GPIO_Init({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}HAL_GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}HAL_GPIO_PIN_{{pin}}{{/if}}, &gpio_config) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
        {{#if EnableEXTI}}

          {{#> EXTI fct='exti_gpio_init' layer=@root.current_layer needs=extiConfig.needs found_exti=@root.found_exti gpio_port=port gpio_pin=pin}}
          {{/EXTI}}
          {{! ~}}
          {{assign 'found_exti' true~}}
        {{/if}}
      {{/each}}

  return SYSTEM_OK;
}

system_status_t {{@root.fct_name}}_deinit(void)
{
      {{#each @root.gpio_object.list_config_pins}}
        {{#if EnableEXTI}}
{{> EXTI fct='exti_gpio_deinit' layer=@root.current_layer needs=extiConfig.needs gpio_port=port gpio_pin=pin}}
        {{/if}}
        {{#if aliases.master_label}}
  /* {{helper_gpio_add_pad_right (concat "P" port pin) 4}}  --------->  {{aliases.master_label}} */
        {{#each aliases.other_labels}}
  /* {{helper_gpio_add_pad_right (concat "P" ../port ../pin) 4}}  --------->  {{this}} */
        {{/each}}

        {{/if}}
  HAL_GPIO_DeInit({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}HAL_GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}HAL_GPIO_PIN_{{pin}}{{/if}});

      {{/each}}
  return SYSTEM_OK;
}

  {{else}}
      {{! ~}}
      {{assign 'nvic_generate_handler' false~}}
      {{!
          Generation of initialization function used in LL
      ~}}
system_status_t {{@root.fct_name}}_init(void)
{
  /* Enable peripherals and GPIO Clocks #################################*/
      {{! ~}}
      {{assign 'found_exti' false~}}
      {{assign 'first_gpio' true~}}
      {{assign 'gpios_clock' ''~}}
      {{#each @root.gpio_object.list_port}}
        {{#if (not @root.first_gpio)}}
          {{! ~}}
          {{assign 'gpios_clock' (append @root.gpios_clock ' | ')~}}
        {{/if}}
        {{! ~}}
        {{assign 'gpios_clock' (append @root.gpios_clock 'LL_AHB4_GRP1_PERIPH_GPIO')~}}
        {{assign 'gpios_clock' (append @root.gpios_clock this)~}}
        {{assign 'first_gpio' false~}}
      {{/each}}
  LL_AHB4_GRP1_EnableClock({{@root.gpios_clock}});

      {{! ~}}
      {{#each @root.gpio_object.list_config_pins}}{{! ~}}
        {{#if aliases.master_label}}
  /* {{helper_gpio_add_pad_right (concat "P" port pin) 4}}  --------->  {{aliases.master_label}} */
        {{#each aliases.other_labels}}
  /* {{helper_gpio_add_pad_right (concat "P" ../port ../pin) 4}}  --------->  {{this}} */
        {{/each}}

        {{/if}}
        {{! active_state is HW board dependent. Need a getter to retrieve the default to be applied}}
        {{#if output_init_state}}
  /* Initialize the output state */
  LL_GPIO_WriteOutputPin({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_INIT_STATE{{else}}LL_GPIO_PIN_{{#if (eq @root.output_init_state 'HIGH')}}SET{{else}}RESET{{/if}}{{/if}});

        {{/if}}
        {{#if speed}}
  /* Configure IO output speed (Low, Medium, High or Very-High) */
  LL_GPIO_SetPinSpeed({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_SPEED_FREQ_{{speed}});

        {{/if}}
        {{#if output_type}}
  /* Configure IO output type (Push-Pull or Open-Drain) */
  LL_GPIO_SetPinOutputType({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_OUTPUT_{{output_type}});

        {{/if}}
        {{#if pull}}
  /* Activate the Pull-up, Pull-down resistor, or No pull for the current IO */
  LL_GPIO_SetPinPull({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_PULL_{{pull}});

        {{/if}}
        {{#if (eq mode 'EVENTOUT')}}
  /* Configure Eventout in Alternate function mapped with the current IO */
  LL_GPIO_SetAFPin_8_15({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_AF_15);

        {{/if}}
  /* Configure IO direction mode (Input, Output, Alternate or Analog) */
  LL_GPIO_SetPinMode({{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PORT{{else}}GPIO{{port}}{{/if}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_MODE_{{#if (eq mode 'EVENTOUT')}}ALTERNATE{{else}}{{mode}}{{/if}});

        {{#if EnableEXTI}}
        {{#> EXTI fct='exti_gpio_init' layer=@root.current_layer needs=extiConfig.needs found_exti=@root.found_exti gpio_port=port gpio_pin=pin}}
        {{/EXTI}}
        {{~assign 'found_exti' true~}}

        {{/if}}
      {{/each}}
  return SYSTEM_OK;
}

system_status_t {{@root.fct_name}}_deinit(void)
{
    {{#each @root.gpio_object.list_config_pins}}
      {{#if EnableEXTI}}
        {{#> EXTI fct='exti_gpio_deinit' layer=@root.current_layer needs=extiConfig.needs gpio_port=port gpio_pin=pin}}
        {{/EXTI}}
      {{/if}}
      {{#if aliases.master_label}}
  /* {{helper_gpio_add_pad_right (concat "P" port pin) 4}}  --------->  {{aliases.master_label}} */
      {{#each aliases.other_labels}}
  /* {{helper_gpio_add_pad_right (concat "P" ../port ../pin) 4}}  --------->  {{this}} */
      {{/each}}

      {{/if}}
  /* Configure IO in Analog Mode */
  LL_GPIO_SetPinMode(GPIO{{port}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_MODE_ANALOG);

  /* Configure the default Alternate Function in current IO */
  LL_GPIO_SetAFPin_{{#if (lt pin 8)}}0_7{{else}}8_15{{/if}}(GPIO{{port}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_AF_0);

  /* Configure the default value for IO Speed */
  LL_GPIO_SetPinSpeed(GPIO{{port}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_SPEED_FREQ_LOW);

  /* Configure the default value IO Output Type */
  LL_GPIO_SetPinOutputType(GPIO{{port}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_OUTPUT_PUSHPULL);

  /* Deactivate the Pull-up and Pull-down resistor for the current IO */
  LL_GPIO_SetPinPull(GPIO{{port}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}}, LL_GPIO_PULL_NO);

  LL_GPIO_ResetOutputPin(GPIO{{port}}, {{#if aliases.master_label}}{{aliases.master_label}}_GPIO_PIN{{else}}LL_GPIO_PIN_{{pin}}{{/if}});

    {{/each}}
  return SYSTEM_OK;
}
  {{/if}}
{{/each}}

