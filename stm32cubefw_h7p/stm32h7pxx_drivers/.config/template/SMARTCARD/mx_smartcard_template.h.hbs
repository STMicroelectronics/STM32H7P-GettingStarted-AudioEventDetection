/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{resource}}_H
#define MX_{{resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
#include "stm32_hal.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */

{{assign 'current_index' 0~}}
{{#each instances}}
{{#if (eq @root.strategy "SW")}}
{{assign 'smartcard_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_function' @root.smartcard_cxt.info.function_type~}}
{{assign 'current_layer' @root.smartcard_cxt.info.layer~}}
{{else}}
{{assign 'current_function' info.function_type~}}
{{assign 'current_layer' info.layer~}}
{{/if}}
/******************************************************************************/
/* Exported functions for {{@root.current_function}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'from_where' 'smartcard_fct_exp_proto'}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index @root.current_function @root.from_where)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_smartcard_handle_t *{{@root.fct_name}}_init(void);
{{else}}
USART_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{@root.fct_name}} instance and return it.
  * @retval None
  */
void {{@root.fct_name}}_deinit(void);

{{#if (eq @root.current_layer 'HAL')}}
{{> SMARTCARD_HAL fct='exported_functions_gethandle_prototype'}}
{{/if}}

{{/each}}
{{#each @root.irq_info_list}}
{{#if generate_handler}}
/******************************************************************************/
/*                     {{description}}                    */
/******************************************************************************/
void {{line}}_IRQHandler(void);

{{else}}
/******************************************************************************/
/*    {{description}} is managed directly in user code.   */
/******************************************************************************/
/* void {{line}}_IRQHandler(void); */
{{/if}}
{{/each}}
#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{resource}}_H */
