{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CRS",
  "grammarVersion": "3.1",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "title": "Label",
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "default": ""
              }
            },
            "layer": {
              "title": "Software Layer",
              "type": "string",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "title": "resource initialization code generation",
              "type": "string",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "description": "generate or not the CRS init code, call it or not at boot",
              "$comment": "generate the init code of your CRS or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "default": "called"
            }
          }
        },
        "Main_configurations": {
          "type": "object",
          "description": "CRS Basic Structure definition.",
          "title": "Main peripheral configuration",
          "properties": {
            "Init": {
              "title": "Use default synchronizaton signal",
              "description": "Enable the CRS with the default source of synchronization ",
              "type": "boolean",
              "default": true
            },
            "CRS_auto_trimming": {
              "title": "Auto-trimming",
              "description": "Enable the automatic hardware adjustment of HSI48 oscillator trimming",
              "type": "boolean",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ],
              "default": false
            },
            "CRS_SYNC_divider": {
              "title": "Synchronization signal divider",
              "description": "Setting the division factor of the synchronization signal",
              "type": "integer",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ],
              "oneOf": [
                {
                  "title": "DIV1",
                  "const": 1
                },
                {
                  "title": "DIV2",
                  "const": 2
                },
                {
                  "title": "DIV4",
                  "const": 4
                },
                {
                  "title": "DIV8",
                  "const": 8
                },
                {
                  "title": "DIV16",
                  "const": 16
                },
                {
                  "title": "DIV32",
                  "const": 32
                },
                {
                  "title": "DIV64",
                  "const": 64
                },
                {
                  "title": "DIV128",
                  "const": 128
                }
              ],
              "default": 1
            },
            "CRS_SYNC_source": {
              "title": "Synchronization signal source",
              "description": "Setting the synchronization signal source",
              "type": "string",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                },
                {
                  "type": "warning",
                  "condition": "($Main_configurations.CRS_SYNC_source === 'LSE') && ($get('envVar.value', 'RCC_PROJECT_LSE') !== true)",
                  "message": "Make sure that LSE is enabled"
                },
                {
                  "type": "warning",
                  "condition": "($Main_configurations.CRS_SYNC_source === 'OTG_FS') || ($Main_configurations.CRS_SYNC_source === 'OTG_HS') || ($Main_configurations.CRS_SYNC_source === 'USB')",
                  "message": "Make sure that USB Clock is enabled"
                },
                {
                  "type": "warning",
                  "condition": "($Main_configurations.CRS_SYNC_source === 'HSE_1MHZ') && ($get('envVar.value', 'RCC_PROJECT_HSE') !== true)",
                  "message": "Make sure that HSE 1MHz clock is enabled"
                }
              ],
              "oneOf": [
                {
                  "title": "GPIO as synchronization source",
                  "description": "GPIO is selected as sync source",
                  "const": "GPIO"
                },
                {
                  "title": "LSE as synchronization source",
                  "description": "LSE is selected as sync source",
                  "const": "LSE"
                },
                {
                  "title": "USB SOF as synchronization source",
                  "description": "USB SOF is selected as sync source",
                  "const": "USB"
                }
              ],
              "default": "USB"
            },
            "CRS_SYNC_Polarity": {
              "title": "Synchronization signal Polarity",
              "description": "Setting the polarity of the synchronization signal",
              "type": "string",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ],
              "oneOf": [
                {
                  "title": "Synchronization active on rising edge",
                  "description": "Synchronization Active on rising edge",
                  "const": "RISING"
                },
                {
                  "title": "Synchronization active on falling edge",
                  "description": "Synchronization Active on falling edge",
                  "const": "FALLING"
                }
              ],
              "default": "RISING"
            },
            "CRS_counter_reload": {
              "title": "Counter reload",
              "description": "The value to be loaded in the frequency error counter with each synchronization event",
              "type": "integer",
              "default": 47999,
              "minimum": 0,
              "maximum": 65536,
              "display_format": [
                "dec",
                "hex"
              ],
              "actions": [
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ]
            },
            "CRS_frequency_error_limit": {
              "title": "Frequency error limit",
              "description": "The value to be used to evaluate the captured frequency error value",
              "type": "integer",
              "default": 34,
              "minimum": 0,
              "maximum": 255,
              "display_format": [
                "dec",
                "hex"
              ],
              "actions": [
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ]
            },
            "CRS_trimming_value": {
              "title": "Trimming value",
              "description": "Adjust the HSI48 oscillator trimming value. This value is relevant only when auto-trimming is disabled",
              "type": "integer",
              "default": 32,
              "minimum": 0,
              "maximum": 63,
              "display_format": [
                "dec",
                "hex"
              ],
              "actions": [
                {
                  "type": "enable",
                  "condition": "($Main_configurations.CRS_auto_trimming === false) && ($Main_configurations.Init === false)"
                }
              ]
            }
          }
        },
        "System_configuration": {
          "title": "System configuration",
          "type": "object",
          "description": "System configurations",
          "properties": {
            "GPIO": {
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "($Main_configurations.CRS_SYNC_source === 'GPIO') && ($Main_configurations.Init === false)"
                },
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ],
              "objectType": "need.pinout.signals",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "SYNC",
                  "constraints": {
                    "mode": {
                      "const": "ALTERNATE"
                    }
                  }
                }
              ]
            },
            "EnableInterruption": {
              "title": "Interruption",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ]
            },
            "irq_handler_generation": {
              "type": "boolean",
              "title": "IRQ Handler generation",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "($System_configuration.EnableInterruption) && ($info.layer === 'HAL')"
                },
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ]
            },
            "nvicConfig": {
              "title": "NVIC configurations",
              "type": "object",
              "objectType": "need.interrupt.lines",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*"
                }
              ],
              "actions": [
                {
                  "type": "include",
                  "condition": "($System_configuration.EnableInterruption) && ($Main_configurations.Init === false)"
                },
                {
                  "type": "enable",
                  "condition": "$Main_configurations.Init === false"
                }
              ]
            }
          }
        }
      }
    }
  }
}
