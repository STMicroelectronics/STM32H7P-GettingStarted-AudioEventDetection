{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32u5 hal Code Gen:SMARTCARD Init",
  "grammarVersion": "3.1",
  "type": "object",
  "properties": {

    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label",
              "$comment": "label associated to the instance of the peripheral, can be overridden at sample level. In this case it becomes read-only.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software Layer",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "title": "resource initialization code generation",
              "type": "string",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "description": "Generate or not the USART init code, call it or not at boot",
              "$comment": "Generate the init code of your USART or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "default": "SMARTCARD"
            }
          }
        },

              "main_peripheral_configuration": {
                "title": "Main peripheral configuration",
                "type": "object",
                "description": "SMARTCARD Global Configuration.",
                "properties": {
                  "baud_rate": {
                    "type": "integer",
                    "description": "Configures the SMARTCARD communication baud rate. The baud rate register is computed using the following formula: baud rate register = usart_ker_ckpres /BaudRate where usart_ker_ckpres is the USART input clock divided by a prescaler",
                    "minimum": 0,
                    "default": 10752
                  },
                  "stop_bit": {
                    "type": "string",
                    "description": "SMARTCARD Stop bits.",
                    "default": "0_5",
                    "oneOf": [
                      {
                        "title": "0.5 stop bit",
                        "const": "0_5"
                      },
                      {
                        "title": "1.5 stop bits",
                        "const": "1_5"
                      }
                    ]
                  },
                  "first_bit": {
                    "type": "string",
                    "description": "SMARTCARD Bit order.",
                    "default": "LSB_FIRST",
                    "oneOf": [
                      {
                        "title": "LSB First",
                        "const": "LSB_FIRST"
                      },
                      {
                        "title": "MSB First",
                        "const": "MSB_FIRST"
                      }
                    ]
                  },
                  "parity": {
                    "title": "Parity control",
                    "type": "string",
                    "description": "SMARTCARD Parity.",
                    "default": "ODD",
                    "oneOf": [
                      {
                        "title": "Even",
                        "const": "EVEN"
                      },
                      {
                        "title": "Odd",
                        "const": "ODD"
                      }
                    ]
                  },
                  "nack": {
                    "title": "NACK management",
                    "type": "string",
                    "description": "SMARTCARD NACK management.",
                    "default": "DISABLE",
                    "oneOf": [
                      {
                        "title": "NACK disabled",
                        "const": "DISABLE"
                      },
                      {
                        "title": "NACK enabled",
                        "const": "ENABLE"
                      }
                    ]
                  },
                  "clock_source_frequency": {
                    "type": "string",
                    "title": "Clock source frequency",
                    "description": "Input clock frequency can be modified in clock tree",
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "true"
                      },
                      {
                        "type": "set",
                        "condition": "($get('clock.frequency',$resource.id)) < 1000000",
                        "computed": {
                          "const": "$get('clock.frequency',$resource.id) / 1000 + ' kHz'"
                        }
                      },
                      {
                        "type": "set",
                        "condition": "($get('clock.frequency',$resource.id)) >= 1000000",
                        "computed": {
                          "const": "$get('clock.frequency',$resource.id) / 1000000 + ' MHz'"
                        }
                      }
                    ],
                    "default": ""
                  },
                  "clock_prescaler": {
                    "title": "Clock prescaler",
                    "type": "integer",
                    "description": "Specifies the prescaler value used to divide the SMARTCARD clock source.",
                    "default": 1,
                    "oneOf": [
                      {
                        "title": "USART input CLK DIV1",
                        "const": 1
                      },
                      {
                        "title": "USART input CLK DIV2",
                        "const": 2
                      },
                      {
                        "title": "USART input CLK DIV4",
                        "const": 4
                      },
                      {
                        "title": "USART input CLK DIV6",
                        "const": 6
                      },
                      {
                        "title": "USART input CLK DIV8",
                        "const": 8
                      },
                      {
                        "title": "USART input CLK DIV10",
                        "const": 10
                      },
                      {
                        "title": "USART input CLK DIV12",
                        "const": 12
                      },
                      {
                        "title": "USART input CLK DIV16",
                        "const": 16
                      },
                      {
                        "title": "USART input CLK DIV32",
                        "const": 32
                      },
                      {
                        "title": "USART input CLK DIV64",
                        "const": 64
                      },
                      {
                        "title": "USART input CLK DIV128",
                        "const": 128
                      },
                      {
                        "title": "USART input CLK DIV256",
                        "const": 256
                      }
                    ]
                  },
                  "sclk_prescaler": {
                    "title": "SMARTCARD clock prescaler",
                    "type": "integer",
                    "description": "Specifies the prescaler value used to divide the SMARTCARD output clock signal.",
                    "default": 2,
                    "oneOf": [
                      {
                        "title": "SMARTCARD Output CLK DIV2",
                        "const": 2
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV4",
                        "const": 4
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV6",
                        "const": 6
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV8",
                        "const": 8
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV10",
                        "const": 10
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV12",
                        "const": 12
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV14",
                        "const": 14
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV16",
                        "const": 16
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV18",
                        "const": 18
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV20",
                        "const": 20
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV22",
                        "const": 22
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV24",
                        "const": 24
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV26",
                        "const": 26
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV28",
                        "const": 28
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV30",
                        "const": 30
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV32",
                        "const": 32
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV34",
                        "const": 34
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV36",
                        "const": 36
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV38",
                        "const": 38
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV40",
                        "const": 40
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV42",
                        "const": 42
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV44",
                        "const": 44
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV46",
                        "const": 46
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV48",
                        "const": 48
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV50",
                        "const": 50
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV52",
                        "const": 52
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV54",
                        "const": 54
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV56",
                        "const": 56
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV58",
                        "const": 58
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV60",
                        "const": 60
                      },
                      {
                        "title": "SMARTCARD Output CLK DIV62",
                        "const": 62
                      }
                    ]
                  },
                  "clock_output": {
                    "title": "Clock signal output on CK pin",
                    "type": "boolean",
                    "description": "SMARTCARD Clock Output.",
                    "default": false
                  },
                  "clock_polarity": {
                    "type": "string",
                    "description": "SMARTCARD Clock polarity.",
                    "default": "LOW",
                    "oneOf": [
                      {
                        "title": "Low",
                        "const": "LOW"
                      },
                      {
                        "title": "High",
                        "const": "HIGH"
                      }
                    ]
                  },
                  "clock_phase": {
                    "type": "integer",
                    "description": "SMARTCARD Clock phase.",
                    "default": 1,
                    "oneOf": [
                      {
                        "title": "First edge",
                        "const": 1
                      },
                      {
                        "title": "Second edge",
                        "const": 2
                      }
                    ]
                  },
                  "guard_time_etu": {
                    "type": "integer",
                    "description": "Specifies the SMARTCARD Guard Time applied after stop bits.",
                    "minimum": 0,
                    "maximum": 255,
                    "default": 0
                  },
                  "auto_retry_count": {
                    "type": "integer",
                    "description": "Specifies the SMARTCARD auto-retry count (number of retries in receive and transmit mode). When set to 0, retransmission is disabled. Otherwise, its maximum value is 7 (before signalling an error)",
                    "minimum": 0,
                    "maximum": 7,
                    "default": 0
                  }
                }
              },
              "additional_features_configuration": {
                "title": "Additional features configuration",
                "type": "object",
                "properties": {
                  "EnableFifoMode": {
                    "type": "boolean",
                    "title": "FIFO Mode",
                    "default": false,
                    "variables": [
                      {
                        "on": "update-value",
                        "name": "USART_CORE_USE_HAL_SMARTCARD_FIFO",
                        "condition": "$value",
                        "value": true
                      }
                    ]
                  },
                  "SetTxFifoThreshold": {
                    "type": "string",
                    "title": "TX Fifo Threshold",
                    "oneOf": [
                      {
                        "title": "1/8 empty configuration",
                        "const": "1_8"
                      },
                      {
                        "title": "1/4 empty configuration",
                        "const": "1_4"
                      },
                      {
                        "title": "1/2 empty configuration",
                        "const": "1_2"
                      },
                      {
                        "title": "3/4 empty configuration",
                        "const": "3_4"
                      },
                      {
                        "title": "7/8 empty configuration",
                        "const": "7_8"
                      },
                      {
                        "title": "8/8 empty configuration (empty)",
                        "const": "8_8"
                      }
                    ],
                    "default": "1_8",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$additional_features_configuration.EnableFifoMode"
                      }
                    ]
                  },
                  "SetRxFifoThreshold": {
                    "type": "string",
                    "title": "RX Fifo Threshold",
                    "oneOf": [
                      {
                        "title": "1/8 full configuration",
                        "const": "1_8"
                      },
                      {
                        "title": "1/4 full configuration",
                        "const": "1_4"
                      },
                      {
                        "title": "1/2 full configuration",
                        "const": "1_2"
                      },
                      {
                        "title": "3/4 full configuration",
                        "const": "3_4"
                      },
                      {
                        "title": "7/8 full configuration",
                        "const": "7_8"
                      },
                      {
                        "title": "8/8 full configuration (full)",
                        "const": "8_8"
                      }
                    ],
                    "default": "1_8",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$additional_features_configuration.EnableFifoMode"
                      }
                    ]
                  },
                  "EnableIOInvert": {
                    "title": "IO inversion",
                    "type": "boolean",
                    "description": "Enable SMARTCARD pin active level logic inversion into the handler instance registers.",
                    "default": false
                  },
                  "EnableDataInvert": {
                    "title": "Data inversion",
                    "type": "boolean",
                    "description": "Enable the binary Data Inversion into the handler instance registers, (1=L, 0=H).",
                    "default": false
                  },
                  "EnableTxRxSwap": {
                    "title": "TX/RX Swap",
                    "type": "boolean",
                    "description": "Enable the Swap between TX and RX Pin into the handler instance registers.",
                    "default": false
                  },
                  "DisableRxOverRunDetection": {
                    "title": "RX overrun detection",
                    "type": "boolean",
                    "description": "Disable SMARTCARD RX overrun detection into the handler instance registers.",
                    "default": false
                  },
                  "EnableDMAStopOnRxError": {
                    "title": "DMA stop on RX error",
                    "type": "boolean",
                    "description": "Enable SMARTCARD DMA stop on RX error into the handler instance registers.",
                    "default": false
                  },
                  "EnableReceiverTimeout": {
                    "title": "Receiver timeout",
                    "type": "boolean",
                    "description": "Enable SMARTCARD Receiver Timeout feature into the handler instance registers.",
                    "default": false
                  },
                  "SetReceiverTimeout": {
                    "title": "Receiver timeout value",
                    "type": "integer",
                    "description": "Set the SMARTCARD receiver timeout value passed in parameters into the handler instance registers.",
                    "default": 0,
                    "actions": [
                      {
                        "type": "include",
                        "condition": "($additional_features_configuration.EnableReceiverTimeout)"
                      }
                    ],
                    "minimum": 0,
                    "maximum": 16777215
                  },
                  "SetTxCpltIndication": {
                    "title": "TX complete indication",
                    "type": "string",
                    "description": "SMARTCARD Pre guard time TX complete indication.",
                    "default": "AFTER",
                    "oneOf": [
                      {
                        "title": "SMARTCARD transmission complete (flag raised when guard time has elapsed)",
                        "const": "AFTER"
                      },
                      {
                        "title": "SMARTCARD transmission complete before guard time",
                        "const": "BEFORE"
                      }
                    ]
                  },
                  "SetBlockLength": {
                    "title": "Block length",
                    "type": "integer",
                    "description": "Set the SMARTCARD block length for T=1 smartcard protocol passed in parameters into the handler instance registers.",
                    "minimum": 0,
                    "default": 0
                  }
                }
              },
              "System": {
                "type": "object",
                "title": "System configuration",
                "properties": {
                  "GPIO_Settings": {
                    "type": "object",
                    "description": "GPIO settings",
                    "properties": {
                      "gpio_clk": {
                        "title": "GPIOs CLK configuration",
                        "type": "object",
                        "objectType": "need.pinout.signals",
                        "owner": "$resource.id",
                        "needs": [
                          {
                            "selector": "CK",
                            "constraints": {
                              "mode": {
                                "const": "ALTERNATE"
                              }
                            }
                          }
                        ]
                      },
                      "gpio_tx": {
                        "title": "GPIOs TX configuration",
                        "type": "object",
                        "objectType": "need.pinout.signals",
                        "owner": "$resource.id",
                        "needs": [
                          {
                            "selector": "TX",
                            "constraints": {
                              "mode": {
                                "const": "ALTERNATE"
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "EnableInterruption": {
                    "type": "boolean",
                    "title": "Global interrupt",
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "$System.EnableDMA_TX"
                      },
                      {
                        "type": "set",
                        "condition": "$System.EnableDMA_TX",
                        "attributes": {
                          "const": true
                        }
                      }
                    ],
                    "default": false
                  },
                  "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ Handler generation",
                  "default": true,
                  "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableInterruption && $info.layer === 'HAL'"
                      }
                    ]
                  },
                  "nvicConfig": {
                    "title": "NVIC SMARTCARD global configuration",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableInterruption"
                      }
                    ],
                    "type": "object",
                    "objectType": "need.interrupt.lines",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "*"
                      }
                    ]
                  },
                  "EnableDMA_TX": {
                    "title": "DMA TX",
                    "description": "Enable DMA TX mode for the peripheral.",
                    "type": "boolean",
                    "default": false
                  },
                  "dmaConfigTx": {
                    "title": "DMA TX configuration",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableDMA_TX"
                      }
                    ],
                    "type": "object",
                    "objectType": "need.dma.channels",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "TX",
                        "constraints": {
                          "direction": {
                            "const": "MEMORY_TO_PERIPH"
                          },
                          "dest_inc": {
                            "const": "FIXED"
                          },
                          "src_data_width": {
                            "forbid": [
                              "WORD"
                            ]
                          },
                          "dest_data_width": {
                            "forbid": [
                              "WORD"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "EnableDMA_RX": {
                    "title": "DMA RX",
                    "description": "Enable DMA RX mode for the peripheral.",
                    "type": "boolean",
                    "default": false
                  },
                  "dmaConfigRx": {
                    "title": "DMA RX configuration",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableDMA_RX"
                      }
                    ],
                    "type": "object",
                    "objectType": "need.dma.channels",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "RX",
                        "constraints": {
                          "direction": {
                            "const": "PERIPH_TO_MEMORY"
                          },
                          "src_inc": {
                            "const": "FIXED"
                          },
                          "src_data_width": {
                            "forbid": [
                              "WORD"
                            ]
                          },
                          "dest_data_width": {
                            "forbid": [
                              "WORD"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
}