/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef STM32_{{resource}}_H
#define STM32_{{resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each instances}}
{{#if (eq info.layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32u5xx_ll_gpio.h"
#include "stm32u5xx_ll_rcc.h"
#include "stm32u5xx_ll_bus.h"
{{! or include stm32_ll.h~}}
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
/* Exported macro ------------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{assign 'current_index' 0~}}
{{#each instances}}
{{assign 'current_layer' info.layer~}}
/******************************************************************************/
/* Exported functions for MMC in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index 'MMC')~}}
{{assign 'current_index' (add @root.current_index 1)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_mmc_handle_t *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{/each~}}{{~!configs~}}
{{#if (eq @root.current_layer 'HAL')~}}
{{~assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_mmc_handle_t *{{@root.fct_name}}_gethandle(void);
{{/if}}

{{assign 'nvic_context' (helper_cortex_nvic_get_irqline_info_list_legacy @root.NvicAPI @root.nvic_needs @root.current_resource 'MMC' @root.function)~}}
{{#each @root.nvic_context.list_irq}}
{{#if @root.nvic_generate_handler}}
/******************************************************************************/
/*                     {{description}}                    */
/******************************************************************************/
void {{line}}_IRQHandler(void);

{{else}}
/******************************************************************************/
/*    {{description}} is managed directly in user code.   */
/******************************************************************************/
/* void {{line}}_IRQHandler(void); */

{{/if}}
{{/each}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* STM32_{{resource}}_H */
{{/with~}}
{{/get_myctx~}}
