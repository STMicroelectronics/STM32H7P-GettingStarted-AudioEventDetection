  {{!       needs: only 1 need will be handled at one time (ex: [{ "id": "<uuid-#1>" }])~}}
  {{!       found_exti: boolean to generate only 1 time the hal_exti_config_t parameter~}}
  {{!~}}
  {{! ~}}
  {{assign 'gpio_configs' 'undefined'~}}
  {{assign 'layer' layer~}}
  {{log "EXTI_Partial (exti_gpio_init): needs" needs~}}
  {{#each needs~}}
    {{~assign 'get_exti_cfg_config_object' (@root.ExtiAPI.getNeedById id)~}}
  {{/each~}}
  {{log "EXTI_Partial: get_exti_cfg_config_object" (toJSON @root.get_exti_cfg_config_object)~}}
  {{#if (eq @root.layer 'HAL')}}
    {{#if (not found_exti)}}
  hal_exti_config_t exti_config;

    {{/if}}
    {{#with @root.get_exti_cfg_config_object.configuration.Basic}}
  /* Initialize the EXTI for line {{@root.gpio_pin}} */
  HAL_EXTI_Init(&hEXTI{{@root.gpio_pin}}, HAL_EXTI_LINE_{{@root.gpio_pin}});

  /* Set the trigger as {{trigger}} for the GPIO{{@root.gpio_port}} */
  exti_config.trigger   = HAL_EXTI_TRIGGER_{{trigger}};
  exti_config.gpio_port = HAL_EXTI_GPIO{{@root.gpio_port}};
  HAL_EXTI_SetConfig(&hEXTI{{@root.gpio_pin}}, &exti_config);

      {{#if Interruption}}
  /* Set line {{@root.gpio_pin}} Interrupt priority */
{{! The nvic_context must stay unchanged since it is used by another template~}}
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nvicConfig.needs 'EXTI' irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.layer needs=nvicConfig.needs}}

      {{/if}}
    {{/with}}
  {{else}}
    {{#with @root.get_exti_cfg_config_object.configuration.Basic}}
      {{#if (or (eq trigger 'RISING') (eq trigger 'RISING_FALLING'))}}
  LL_EXTI_EnableRisingTrig_0_31(LL_EXTI_LINE_{{@root.gpio_pin}});
      {{else}}
  LL_EXTI_DisableRisingTrig_0_31(LL_EXTI_LINE_{{@root.gpio_pin}});
      {{/if}}
      {{#if (or (eq trigger 'FALLING') (eq trigger 'RISING_FALLING'))}}
  LL_EXTI_EnableFallingTrig_0_31(LL_EXTI_LINE_{{@root.gpio_pin}});
      {{else}}
  LL_EXTI_DisableFallingTrig_0_31(LL_EXTI_LINE_{{@root.gpio_pin}});
      {{/if}}

      {{#if (lt @root.gpio_pin 16)}}
  /* Compute the EXTI source register and configure the corresponding GPIO port */
  LL_APB4_GRP1_EnableClock(LL_APB4_GRP1_PERIPH_SBS);
  LL_SBS_SetEXTISource(LL_SBS_EXTI_GPIO_PORT{{@root.gpio_port}}, LL_SBS_EXTI_GPIO_LINE{{@root.gpio_pin}});

      {{/if}}
      {{#if Interruption}}
  /* Set line {{@root.gpio_pin}} Interrupt priority */
{{! The nvic_context must stay unchanged since it is used by another template~}}
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context nvicConfig.needs 'EXTI' false)~}}
{{> CORTEX fct='init' layer=@root.layer needs=nvicConfig.needs}}

      {{/if}}
    {{/with}}
  {{/if}}
