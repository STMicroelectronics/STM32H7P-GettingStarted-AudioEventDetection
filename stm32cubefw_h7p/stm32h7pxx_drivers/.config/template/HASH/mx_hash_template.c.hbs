{{#if (eq @root.strategy "HW")}}
{{assign 'name' name~}}
{{assign 'current_layer' info.layer~}}
{{assign 'configs' this~}}
{{else}}
{{assign 'hash_cxt' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'name' @root.hash_cxt.name~}}
{{assign 'current_layer' @root.hash_cxt.settings.parameters.info.layer~}}
{{assign 'configs' @root.hash_cxt.settings.parameters~}}
{{/if}}
/******************************************************************************/
/* Exported functions for HASH in {{@root.current_layer}} layer (SW instance {{#if (eq name undefined)}}{{instanceIndex}}{{else}}{{name}}{{/if}}) */
/******************************************************************************/
{{#with @root.configs}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_hash_handle_t *{{@root.fct_name}}_init(void)
{
{{#if (not basic.use_hmac_feature)}}
  hal_hash_config_t config;
{{else}}
  hal_hash_hmac_config_t config;
{{/if}}{{~!use_hmac_feature}}
  if (HAL_HASH_Init(&h{{@root.current_resource}}, HAL_HASH) != HAL_OK)
  {
    return NULL;
  }
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource~}}
{{> SYSTEM component='hash' resource=@root.current_resource}}
{{#with basic}}
  config.data_swapping = {{#if (eq data_swapping 0)}}HAL_HASH_DATA_SWAP_NO{{else if (eq data_swapping 1)}}HAL_HASH_DATA_SWAP_HALFWORD{{else if (eq data_swapping 2)}}HAL_HASH_DATA_SWAP_BYTE{{else}}HAL_HASH_DATA_SWAP_BIT{{/if}};
  config.algorithm     = {{#if (eq algo 0)}}HAL_HASH_ALGO_SHA1{{else if (eq algo 1)}}HAL_HASH_ALGO_MD5{{else if (eq algo 2)}}HAL_HASH_ALGO_SHA224{{else if (eq algo 3)}}HAL_HASH_ALGO_SHA256{{else if (eq algo 4)}}HAL_HASH_ALGO_SHA3{{else if (eq algo 5)}}HAL_HASH_ALGO_SHA384{{else if (eq algo 6)}}HAL_HASH_ALGO_SHA512224{{else if (eq algo 7)}}HAL_HASH_ALGO_SHA512256{{else if (eq algo 8)}}HAL_HASH_ALGO_SHA512{{else if (eq algo 9)}}HAL_HASH_ALGO_SHA3224{{else if (eq algo 10)}}HAL_HASH_ALGO_SHA3256{{else if (eq algo 11)}}HAL_HASH_ALGO_SHA3384{{else if (eq algo 12)}}HAL_HASH_ALGO_SHA3512{{else if (eq algo 13)}}HAL_HASH_ALGO_SHAKE128{{else if (eq algo 14)}}HAL_HASH_ALGO_SHAKE256{{/if}};
{{#if use_hmac_feature}}
  config.p_key         = input_key;
  config.key_size_byte = {{key_settings.keySize}};
{{/if}}{{~!use_hmac_feature~}}
  {{assign 'found_SetConfig' true~}}
{{#if (not use_hmac_feature)}}
  if (HAL_HASH_SetConfig(&h{{@root.current_resource}}, &config) != HAL_OK)
  {
    return NULL;
  }
{{else}}
  if (HAL_HASH_HMAC_SetConfig(&h{{@root.current_resource}}, &config) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{~!use_hmac_feature}}
{{/with~}}{{~!basic~}}

{{#if system.dma_settings.enable_dma}}
  /* DMA Configuration ********************************************************/
{{> DMA_HAL fct='init' needs=system.dma_config.needs}}
  /* Link the DMA handle to the HASH handle */
  if (HAL_HASH_SetInDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{#if (and system.nvic_settings.enable_interruption (eq system.nvic_settings.enable_interruption true))}}
  /* Enable the interruption for HASH */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic_settings.irq_config.needs @root.current_resource system.nvic_settings.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic_settings.irq_config.needs}}
{{/if}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if system.enable_interruption}}
  /* Disable the Event interruption for HASH */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}

  (void)HAL_HASH_DeInit(&h{{@root.current_resource}});

  HAL_RCC_{{@root.current_resource}}_Reset();
  HAL_RCC_{{@root.current_resource}}_DisableClock();
}

{{/if~}}

{{#if (eq @root.current_layer 'HAL')~}}
{{#if (eq @root.hal_handle_exist 0)~}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_hash_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}

{{/with}}
{{/each}}
{{assign 'irq_info_list' (helper_cortex_nvic_get_irqline_info_list @root.NvicAPI @root.nvic_context 'HASH')~}}
