  {{! Generate the EXTI handle variable other than requested by GPIO~}}
  {{! > EXTI fct='exti_get_variables' layer=@root.layer needs=extiConfig.needs~}}
  {{! ~}}
  {{#if (eq layer 'HAL')}}
  {{#each needs}}
    {{~assign 'get_exti_cfg_config_object' (@root.ExtiAPI.getNeedById id)~}}
static hal_exti_handle_t h{{@root.get_exti_cfg_config_object.resourceId}};
  {{/each}}
  {{/if}}
{{else if (eq fct 'exti_gpio_init')}}
  {{! ~}}
  {{! Initialize EXTI in mx_gpio_template.c.hbs~}}
