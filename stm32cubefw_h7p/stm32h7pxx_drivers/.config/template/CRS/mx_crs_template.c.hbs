CRS_TypeDef *{{@root.fct_name}}_init(void)
{
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}

{{#with Main_configurations}}
  /* CRS divider : set the synchronization signal divider */
  LL_CRS_SetSyncDivider(CRS, {{CRS_SYNC_divider}});

  /* CRS source size: set the synchronization signal source */
  LL_CRS_SetSyncSignalSource(CRS, LL_CRS_SYNC_SOURCE_{{CRS_SYNC_source}});

  /* CRS polarity: Set the polarity of the synchronization signal */
  LL_CRS_SetSyncPolarity(CRS, LL_CRS_SYNC_POLARITY_{{CRS_SYNC_Polarity}});

  /* CRS reload value: Set counter reload value */
  LL_CRS_SetReloadCounter(CRS, {{CRS_counter_reload}});

  /* CRS frequency error limit: Set frequency error limit value */
  LL_CRS_SetFreqErrorLimit(CRS, {{CRS_frequency_error_limit}});

{{#if CRS_auto_trimming}}
  /* CRS auto trimming: Enable CRS hardware auto-trimming */
  LL_CRS_EnableAutoTrimming(CRS);

  /* CRS trimming: Set HSI48 trimming value */
  LL_CRS_ConfigTrimming(CRS, {{CRS_trimming_value}}, LL_CRS_AUTO_TRIMMING_ENABLE);
{{else}}
  /* CRS auto trimming: Disable CRS hardware auto-trimming */
  LL_CRS_DisableAutoTrimming(CRS);

  /* CRS trimming: Set HSI48 trimming value */
  LL_CRS_ConfigTrimming(CRS, {{CRS_trimming_value}}, LL_CRS_AUTO_TRIMMING_DISABLE);
{{/if}}
{{/with}}

{{#with System_configuration}}
{{#with GPIO}}
{{#> GPIO_LL fct='init' needs=needs}}
{{/GPIO_LL}}
{{/with}}
{{#if EnableInterruption}}
  /* Enable the interruption for {{@root.current_resource}} */
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvicConfig.needs}}
{{/CORTEX}}
{{/if}}
{{/with}}

  return CRS;
}

