#ifndef MX_LEVELX_INTERFACES_H
#define MX_LEVELX_INTERFACES_H

/* Includes ------------------------------------------------------------------*/
{{#each @root.levelx_cxt.interface_config}}
  {{#with logical_config}}
    {{#if (eq interface_type "W25N01GVXX_NAND_Flash_Interface")}}
#include "mx_w25n01gvxx.h"
      {{#if (eq transfer_mode "Polling")}}
#include "stm32_lx_w25n01gvxx_nand_flash_polling_driver.h"
      {{else if (eq transfer_mode "DMA_NO_OS")}}
#include "stm32_lx_w25n01gvxx_nand_flash_dma_no_os_driver.h"
      {{else if (eq transfer_mode "DMA_OS")}}
#include "stm32_lx_w25n01gvxx_nand_flash_dma_os_driver.h"
      {{/if}}
    {{/if}}
    {{#if (eq interface_type "MX66UW1G45G_NOR_Flash_Interface")}}
      {{#if (eq transfer_mode "Polling")}}
#include "mx_mx66uw1g45g.h"
#include "stm32_lx_mx66uw1g45g_nor_flash_polling_driver.h"
      {{/if}}
    {{/if}}
  {{/with}}
{{/each}}

/* define the list of the levelx generic functions to be called by the example */
{{#each @root.levelx_cxt.interface_config}}
  {{#with logical_config}}
    {{#if (eq interface_type "W25N01GVXX_NAND_Flash_Interface")}}
UINT mx_lx_nand_flash_driver_{{@index}}_initialize(LX_NAND_FLASH *nand_flash);
    {{/if}}
    {{#if (eq interface_type "MX66UW1G45G_NOR_Flash_Interface")}}
      {{#if (eq transfer_mode "Polling")}}
UINT mx_lx_nor_flash_driver_{{@index}}_initialize(LX_NOR_FLASH *nor_flash);
      {{/if}}
    {{/if}}
  {{/with}}
{{/each}}

#endif /* MX_LEVELX_INTERFACES_H */