/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macro -------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{!
    Generation of handle for each function defined in HAL layer
    - save a variable to indicate if handle has been already created (only 1 handle by function)
~}}
{{~#each instances~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'smartcard_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{log "SMARTCARD template smartcard_cxt:" (toJSON @root.smartcard_cxt)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.smartcard_cxt.info.layer~}}
{{log "SMARTCARD template current_resource:" @root.current_resource~}}
{{else}}
{{assign 'current_function' info.function_type~}}
{{assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{> SMARTCARD_HAL fct='exported_variables'}}
{{/if}}
{{/each}}
/* Exported function definition ----------------------------------------------*/
{{assign 'current_index' 0~}}
{{#each instances}}
{{assign 'nvic_needs' 'undefined'~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'smartcard_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{assign 'current_layer' @root.smartcard_cxt.info.layer~}}
{{assign 'current_function' @root.smartcard_cxt.info.function_type~}}
{{assign 'context' @root.smartcard_cxt~}}
{{else}}
{{assign 'context' this~}}
{{assign 'current_function' info.function_type~}}
{{assign 'current_layer' info.layer~}}
{{/if}}
{{assign 'lut_table'   (helper_smartcard_get_lut_table 'V3')~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
{{assign 'nvic_context' 'undefined'~}}
/******************************************************************************/
/* Exported functions for {{@root.current_function}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index @root.current_function @root.from_where)~}}
{{#with @root.context}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of initialization function used in HAL using SMARTCARD component
~}}
{{> SMARTCARD_HAL fct='exported_functions_init'}}

{{else}}
{{!
    Generation of initialization function used in LL
~}}
{{assign 'nvic_generate_handler' false~}}
{{> SMARTCARD_LL fct='exported_functions_init'}}
{{/if}}

{{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of getHandle functions used in HAL
    - should be generate only 1 time by function
}}
{{> SMARTCARD_HAL fct='exported_functions_gethandle'}}
{{/if}}
{{/with~}}
{{/each}}
{{assign 'irq_info_list' (helper_cortex_nvic_get_irqline_info_list @root.NvicAPI @root.nvic_context 'SMARTCARD')~}}
{{#each @root.irq_info_list}}
{{#if generate_handler}}
/******************************************************************************/
/*                     {{description}}                    */
/******************************************************************************/
void {{line}}_IRQHandler(void)
{
  HAL_{{component}}_IRQHandler(&h{{resource_hw}});
}

{{else}}
/******************************************************************************/
/*    {{description}} is managed directly in user code.   */
/******************************************************************************/
/*
void {{line}}_IRQHandler(void)
{
}
  */
{{/if}}
{{/each}}