{{/if}}{{!reset_pattern~}}
  {{~assign 'fifo_config' (concat 'LL_I3C_RXFIFO_THRESHOLD_' fifo_config.rx_fifo_threshold ' | LL_I3C_TXFIFO_THRESHOLD_' fifo_config.tx_fifo_threshold ' | LL_I3C_CTRL_FIFO_' fifo_config.ctrl_fifo)~}}
