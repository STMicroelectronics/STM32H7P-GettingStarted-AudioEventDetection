{{#if (eq fct 'exported_variables')}}
/* Handle for UART */
static hal_uart_handle_t h{{@root.current_resource}};

{{> GPIO_HAL fct='gpio_exti_variables' resource=@root.current_resource~}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{!
############################
##  exported_functions_init
############################
~}}
{{else if (eq fct 'exported_functions_init')}}
hal_uart_handle_t *{{@root.fct_name}}_init(void)
{
  hal_uart_config_t uart_config;

  /* Basic configuration */
  if (HAL_UART_Init(&h{{@root.current_resource}}, HAL_{{replace (uppercase @root.current_resource) "USART" "UART"}}) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='UART'}}

  uart_config.baud_rate = {{main_peripheral_configuration.baud_rate}};
  uart_config.clock_prescaler = HAL_UART_PRESCALER_DIV{{main_peripheral_configuration.clock_prescaler}};
  uart_config.word_length = HAL_UART_WORD_LENGTH_{{main_peripheral_configuration.word_length}}_BIT;
  uart_config.stop_bits = HAL_UART_STOP_BIT_{{main_peripheral_configuration.stop_bit}};
  uart_config.parity = HAL_UART_PARITY_{{main_peripheral_configuration.parity}};
  uart_config.direction = HAL_UART_DIRECTION_{{main_peripheral_configuration.direction}};
  uart_config.hw_flow_ctl = HAL_UART_HW_CONTROL_{{main_peripheral_configuration.hw_flow_ctl}};
  uart_config.oversampling = HAL_UART_OVERSAMPLING_{{main_peripheral_configuration.over_sampling}};
  uart_config.one_bit_sampling = HAL_UART_ONE_BIT_SAMPLE_{{main_peripheral_configuration.one_bit_sampling}};

  if (HAL_UART_SetConfig(&h{{@root.current_resource}}, &uart_config) != HAL_OK)
  {
    return NULL;
  }

{{#if (eq main_peripheral_configuration.mode "half_duplex_single_wire_mode")}}
  /* Half duplex configuration */
  if (HAL_UART_EnableHalfDuplexMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{else if (eq main_peripheral_configuration.mode "multiprocessor_communication")}}
  /* Multiprocessor configuration */
{{#if (eq additional_features_configuration.wakeup_method "ADDRESS_MARK")}}
  hal_uart_multi_processor_mode_wakeup_config_t uart_multi_processor_mode_wakeup_config;
  uart_multi_processor_mode_wakeup_config.wakeup_method = HAL_UART_WAKEUP_METHOD_{{additional_features_configuration.wakeup_method}};
  uart_multi_processor_mode_wakeup_config.address_length = HAL_UART_ADDRESS_DETECT_{{additional_features_configuration.address_length}}_BIT;
  uart_multi_processor_mode_wakeup_config.address = {{additional_features_configuration.address}};
  if (HAL_UART_SetConfigMultiProcessorMode(&h{{@root.current_resource}}, &uart_multi_processor_mode_wakeup_config) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
  if (HAL_UART_EnableMultiProcessorMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{else if (eq main_peripheral_configuration.mode "lin")}}
  /* LIN configuration */
  if (HAL_UART_SetLINModeBreakDetectLength(&h{{@root.current_resource}}, HAL_UART_LIN_BREAK_DETECT_{{additional_features_configuration.SetLINModeBreakDetectLength}}_BIT) != HAL_OK)
  {
    return NULL;
  }

  if (HAL_UART_EnableLINMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#with additional_features_configuration}}
{{#if EnableRS485Mode}}
  /* RS485 driver enable configuration */
  hal_uart_rs485_config_t uart_rs485_config;
  uart_rs485_config.assertion_time_samples = {{assertion_time_samples}};
  uart_rs485_config.deassertion_time_samples = {{deassertion_time_samples}};
  uart_rs485_config.polarity = HAL_UART_DE_POLARITY_{{polarity}};

  if (HAL_UART_SetConfigRS485Mode(&h{{@root.current_resource}}, &uart_rs485_config) != HAL_OK)
  {
    return NULL;
  }

  if (HAL_UART_EnableRS485Mode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableFifoMode}}
  /* Fifo configuration */
  if (HAL_UART_SetTxFifoThreshold(&h{{@root.current_resource}}, HAL_UART_FIFO_THRESHOLD_{{SetTxFifoThreshold}}) != HAL_OK)
  {
    return NULL;
  }
  if (HAL_UART_SetRxFifoThreshold(&h{{@root.current_resource}}, HAL_UART_FIFO_THRESHOLD_{{SetRxFifoThreshold}}) != HAL_OK)
  {
    return NULL;
  }
  if (HAL_UART_EnableFifoMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableReceiverTimeout}}
  if (HAL_UART_EnableReceiverTimeout(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{#if (not (eq SetReceiverTimeout 0))}}
  if (HAL_UART_SetConfigReceiverTimeout(&h{{@root.current_resource}}, {{SetReceiverTimeout}}) != HAL_OK)
  {
    return NULL;
  }
{{/if~}}{{! SetReceiverTimeout~}}
{{/if~}}{{! EnableReceiverTimeout~}}
{{#if AM_EnablePacketTrigger}}
{{#startsWith 'UART' @root.current_resource}}
{{assign 'trig_prefix' 'UART'~}}
{{/startsWith}}
{{#startsWith 'USART' @root.current_resource}}
{{assign 'trig_prefix' 'UART'~}}
{{/startsWith}}
{{#startsWith 'LPUART' @root.current_resource}}
{{assign 'trig_prefix' 'LPUART'~}}
{{/startsWith}}
  /* Autonomous mode configuration */
  hal_uart_am_trig_config_t uart_am_trig_config;

  uart_am_trig_config.source = HAL_{{@root.trig_prefix}}_AM_TRIG_{{source.source}};
  uart_am_trig_config.trigger_polarity = HAL_UART_AM_TRIG_{{trigger_polarity}};
  uart_am_trig_config.packet_size_byte = {{packet_size_byte}};

  if (HAL_UART_AM_SetConfigPacketTrigger(&h{{@root.current_resource}}, &uart_am_trig_config) != HAL_OK)
  {
    return NULL;
  }
{{#if AM_EnableIdle}}
  if (HAL_UART_AM_EnableIdle(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
  if (HAL_UART_AM_EnablePacketTrigger(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if SetConfigAutoBaudRate}}
{{#if (not (eq SetConfigAutoBaudRate "DISABLE"))}}
  /* Auto baud rate mode configuration */
  if (HAL_UART_SetConfigAutoBaudRateMode(&h{{@root.current_resource}}, HAL_UART_AUTO_BAUD_DET_ON_{{SetConfigAutoBaudRate}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{/if~}}
{{#if EnableTxPinLevelInvert}}
  /* Tx pin level inversion configuration */
  if (HAL_UART_EnableTxPinLevelInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableRxPinLevelInvert}}
  /* Rx pin level inversion configuration */
  if (HAL_UART_EnableRxPinLevelInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableDataInvert}}
  /* Data inversion configuration */
  if (HAL_UART_EnableDataInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableTxRxSwap}}
  /* Tx and Rx pins swapping configuration */
  if (HAL_UART_EnableTxRxSwap(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if DisableRxOverRunDetection}}
  /* Overrun configuration */
  if (HAL_UART_DisableRxOverRunDetection(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableDMAStopOnRxError}}
  /* DMA stop on Rx error configuration */
  if (HAL_UART_EnableDMAStopOnRxError(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableMSBFirst}}
  /* MSB first configuration */
  if (HAL_UART_EnableMSBFirst(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableStopMode}}
  /* Wake up from low power mode configuration */
  if (HAL_UART_EnableStopMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{/with}}
{{#with System}}
{{#with GPIO_Settings}}
{{assign 'gpio_needs' 'undefined'}}
  /* GPIO */
{{#if gpio_tx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_tx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_cts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_cts.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rts.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_de.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_de.needs @root.gpio_needs)~}}
{{/if~}}
{{#> GPIO_HAL fct='init' needs=@root.gpio_needs resource=@root.current_resource~}}
{{/GPIO_HAL}}
{{/with}}{{! GPIO_Settings ~}}
{{#if EnableInterruption}}
  /* Enable interrupt */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvicConfig.needs @root.current_resource irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvicConfig.needs}}
{{/if~}}
{{#if EnableDMA_TX}}
  /* Configure the DMA TX */
{{> DMA_HAL fct='init' layer=@root.current_layer needs=dmaConfigTx.needs arg3=@root.system_cxt.Clock_activation.dma_clk_enable_model}}
  /* Link the Transmit DMA handle to the UART handle */
  if (HAL_UART_SetTxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{#if EnableDMA_RX}}
  /* Configure the DMA RX */
{{> DMA_HAL fct='init' layer=@root.current_layer needs=dmaConfigRx.needs arg3=@root.system_cxt.Clock_activation.dma_clk_enable_model}}
  /* Link the Transmit DMA handle to the PPP handle */
  if (HAL_UART_SetRxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}
{{/with}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if System.EnableInterruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if~}}
  (void)HAL_UART_DeInit(&h{{@root.current_resource}});

  HAL_RCC_{{@root.current_resource}}_Reset();

  HAL_RCC_{{@root.current_resource}}_DisableClock();
{{#with System}}
{{#if GPIO_Settings.gpio_tx}}

{{> GPIO_HAL fct='deinit' needs=GPIO_Settings.gpio_tx.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_rx}}

{{> GPIO_HAL fct='deinit' needs=GPIO_Settings.gpio_rx.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_rts}}

{{> GPIO_HAL fct='deinit' needs=GPIO_Settings.gpio_rts.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_cts}}

{{> GPIO_HAL fct='deinit' needs=GPIO_Settings.gpio_cts.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_de}}

{{> GPIO_HAL fct='deinit' needs=GPIO_Settings.gpio_de.needs resource=@root.current_resource}}
{{/if~}}

{{#if EnableDMA_TX}}
{{> DMA_HAL fct='deinit' needs=dmaConfigTx.needs~}}
{{/if~}}
{{#if EnableDMA_RX}}
{{> DMA_HAL fct='deinit' needs=dmaConfigRx.needs~}}
{{/if~}}
{{/with}}{{! System~}}
}
