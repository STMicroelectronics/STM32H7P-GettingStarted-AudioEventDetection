{{else if (eq fct 'configure_compensation_cells')}}
  {{! ~}}
  {{! Generate the configuration of compensation cells functions ~}}
  {{! > SBS fct='configure_compensation_cells'~}}
  {{! ~}}
  {{assign 'layer' info.layer~}}
  {{#if (helper_sbs_any_true Additional.Compensation_cell_config)}}
    {{#with Additional.Compensation_cell_config}}
      {{assign 'ccell' ''~}}
      {{assign 'act' false~}}
      {{#if VDDIO_compensation_cell~}}
      {{assign 'ccell' (helper_sbs_concatenate_selections @root.ccell @root.layer '_SBS_CCELL_VDDIO' )~}}
      {{assign 'act' true~}}
      {{/if}}
      {{#if XSPI1_compensation_cell~}}
      {{assign 'ccell' (helper_sbs_concatenate_selections @root.ccell @root.layer '_SBS_CCELL_VDDXSPI1IO' )~}}
      {{assign 'act' true~}}
      {{/if~}}
      {{#if XSPI2_compensation_cell~}}
      {{assign 'ccell' (helper_sbs_concatenate_selections @root.ccell @root.layer '_SBS_CCELL_VDDXSPI2IO' )~}}
      {{assign 'act' true~}}
      {{/if}}

  /* Enable the I/O compensation cell */
      {{#if (eq @root.layer 'HAL')}}
  if (HAL_SBS_EnableCompensationCell({{@root.ccell}}) != HAL_OK)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
      {{else}}
  uint32_t timeout = (50U * (SystemCoreClock / 1000U)) + 1U;
  uint32_t comp_cell = {{@root.ccell}};
  uint32_t comp_rdy;

  LL_SBS_EnableCompensationCell({{@root.ccell}});

  do
  {
{{! ~}}
{{assign 'comp_rdy' ''~}}
{{assign 'act' false~}}
{{#if VDDIO_compensation_cell}}
{{assign 'comp_rdy' (helper_sbs_concatenate_selections @root.comp_rdy @root.layer '_SBS_IsActiveFlag_RDY1() << SBS_CCCSR_COMP_EN_Pos' )~}}
{{assign 'act' true~}}
{{/if}}
{{#if XSPI1_compensation_cell}}
{{assign 'comp_rdy' (helper_sbs_concatenate_selections @root.comp_rdy @root.layer '_SBS_IsActiveFlag_VDDXSPI1RDY() << SBS_CCCSR_VDDXSPI1EN_Pos' )~}}
{{assign 'act' true~}}
{{/if}}
{{#if XSPI2_compensation_cell}}
{{assign 'comp_rdy' (helper_sbs_concatenate_selections @root.comp_rdy @root.layer '_SBS_IsActiveFlag_VDDXSPI2RDY() << SBS_CCCSR_VDDXSPI2EN_Pos' )~}}
{{assign 'act' true~}}
{{/if}}
    comp_rdy = {{{@root.comp_rdy}}};

    timeout--;

  } while (((comp_rdy & comp_cell) != comp_cell) && (timeout != 0U));

  if (timeout == 0U)
  {
    return SYSTEM_PERIPHERAL_ERROR;
  }
      {{/if}}
      {{#if VDDIO_compensation_cell}}

  /* Set the compensation cell code source */
  {{@root.layer}}_SBS_SetCompensationCellCodeSrc({{@root.layer}}_SBS_CCELL_VDDIO, {{@root.layer}}_SBS_CCELL_CODE_{{VDDIO_compensation_cell_code_source}});
        {{#if (eq VDDIO_compensation_cell_code_source 'CUSTOM')}}
  
  /* Set the compensation cell code */
          {{#if (eq @root.layer 'HAL')}}
  HAL_SBS_SetConfigxMOSCompensationCellCode(HAL_SBS_CCELL_VDDIO, {{VDDIO_PMOS_Compensation_value}}, {{VDDIO_NMOS_Compensation_value}});
          {{else}}
  LL_SBS_SetxMOSVddIOCompensationCellCode({{VDDIO_PMOS_Compensation_value}}, {{VDDIO_NMOS_Compensation_value}});
          {{/if}}
        {{/if}}
      {{/if}}
      {{#if XSPI1_compensation_cell}}

  /* Set the compensation cell code source */
  {{@root.layer}}_SBS_SetCompensationCellCodeSrc({{@root.layer}}_SBS_CCELL_VDDXSPI1IO, {{@root.layer}}_SBS_CCELL_CODE_{{XSPI1_compensation_cell_code_source}});
        {{#if (eq XSPI1_compensation_cell_code_source 'CUSTOM')}}

  /* Set the compensation cell code */
          {{#if (eq @root.layer 'HAL')}}
  HAL_SBS_SetConfigxMOSCompensationCellCode(HAL_SBS_CCELL_VDDXSPI1IO, {{XSPI1_PMOS_Compensation_value}}, {{XSPI1_NMOS_Compensation_value}});
          {{else}}
  LL_SBS_SetxMOSVddXSPI1IOCompensationCellCode({{VDDIO_PMOS_Compensation_value}}, {{VDDIO_NMOS_Compensation_value}});
          {{/if}}
        {{/if}}
      {{/if}}
      {{#if XSPI2_compensation_cell}}

  /* Set the compensation cell code source */
  {{@root.layer}}_SBS_SetCompensationCellCodeSrc({{@root.layer}}_SBS_CCELL_VDDXSPI2IO, {{@root.layer}}_SBS_CCELL_CODE_{{XSPI2_compensation_cell_code_source}});
        {{#if (eq XSPI2_compensation_cell_code_source 'CUSTOM')}}

  /* Set the compensation cell code */
          {{#if (eq @root.layer 'HAL')}}
  HAL_SBS_SetConfigxMOSCompensationCellCode(HAL_SBS_CCELL_VDDXSPI2IO, {{XSPI2_PMOS_Compensation_value}}, {{XSPI2_NMOS_Compensation_value}});
          {{else}}
  LL_SBS_SetxMOSVddXSPI2IOCompensationCellCode({{VDDIO_PMOS_Compensation_value}}, {{VDDIO_NMOS_Compensation_value}});
          {{/if}}
        {{/if}}
      {{/if}}
    {{/with}}
  {{/if}}
{{else if (eq fct 'flash_eccnmi')}}
  {{! ~}}
  {{! Generate the disable of the NMI in case of double ECC error in FLASH Interface function ~}}
  {{! > SBS fct='flash_eccnmi'~}}
  {{! ~}}
  {{assign 'layer' info.layer~}}
  {{#if Additional.Disable_FLASH_ECCNMI}}

  /* Disable the NMI in case of double ECC error in FLASH Interface */
    {{#if (eq @root.layer 'HAL')}}
  HAL_SBS_FLASH_DisableECCNMI();
    {{else}}
  LL_SBS_FLASH_DisableECCNMI();
    {{/if}}
  {{/if}}
{{else if (eq fct 'set_epoch_value')}}
