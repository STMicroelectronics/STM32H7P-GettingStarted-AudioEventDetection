          {{else}}
  LL_EXTI_EnableFallingTrig_64_95(LL_EXTI_LINE_{{@root.exti_line}});
          {{/if}}
        {{else}}
          {{#if (lt @root.exti_line 32)}}
  LL_EXTI_DisableFallingTrig_0_31(LL_EXTI_LINE_{{@root.exti_line}});
          {{else if (lt @root.exti_line 64)}}
  LL_EXTI_DisableFallingTrig_32_63(LL_EXTI_LINE_{{@root.exti_line}});
          {{else}}
  LL_EXTI_DisableFallingTrig_64_95(LL_EXTI_LINE_{{@root.exti_line}});
          {{/if}}
        {{/if}}
      {{else}}
