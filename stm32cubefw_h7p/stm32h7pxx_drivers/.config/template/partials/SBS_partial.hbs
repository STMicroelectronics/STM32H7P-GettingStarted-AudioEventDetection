  {{! Generate the set analog io switch supply function ~}}
  {{! > SBS fct='set_analog_io_switch_supply'~}}
  {{! ~}}
  {{assign 'layer' info.layer~}}
  {{#if Additional.Analog_IO_Switch_Supply_Config.Analog_IO_Switch_Supply}}
    {{#unless (eq Additional.Analog_IO_Switch_Supply_Config.Analog_IO_Switch_Supply 'NONE')}}

  /* Set the I/O analog switch supply */
      {{#if (eq @root.layer 'HAL')}}
  HAL_SBS_SetAnalogIOSwitchSupply(HAL_SBS_{{Additional.Analog_IO_Switch_Supply_Config.Analog_IO_Switch_Supply}});
      {{else}}
  LL_SBS_SetAnalogIOSwitchSupply(LL_SBS_{{Additional.Analog_IO_Switch_Supply_Config.Analog_IO_Switch_Supply}});
      {{/if}}
    {{/unless}}
  {{/if}}
