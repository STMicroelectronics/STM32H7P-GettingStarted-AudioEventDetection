{{!
  Partial used for LL USART:
  how to use
  > USART_LL fct='xxxx' with xxxx:
    * exported_functions_init
~}}
{{#if (eq fct 'exported_functions_init')}}
USART_TypeDef *{{@root.fct_name}}_init(void)
{

  /* Basic configuration */
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='UART'}}

{{#if (eq main_peripheral_configuration.mode "SLAVE")}}
  LL_USART_ConfigSyncSlaveMode({{@root.current_resource}});
{{else}}
  LL_USART_ConfigSyncMasterMode({{@root.current_resource}});
{{/if}}
{{#if main_peripheral_configuration.clock_last_bit}}
{{assign 'clock_last_bit' 'ENABLED'}}
{{else}}
{{assign 'clock_last_bit' 'DISABLED'}}
{{/if}}

  LL_USART_ConfigXfer({{@root.current_resource}}, LL_USART_DATAWIDTH_{{main_peripheral_configuration.word_length}}_BIT | LL_USART_PARITY_{{main_peripheral_configuration.parity}}
                              | LL_USART_DIRECTION_{{main_peripheral_configuration.direction}} | LL_USART_OVERSAMPLING_8,
                              LL_USART_STOP_BIT_{{main_peripheral_configuration.stop_bit}} | LL_USART_CLOCK_POLARITY_{{main_peripheral_configuration.clock_polarity}}
                              | LL_USART_CLOCK_PHASE_{{main_peripheral_configuration.clock_phase}}_EDGE | LL_USART_LASTCLKPULSE_{{@root.clock_last_bit}});

  {{helper_common_gen_ll_code 'LL_USART_SetPrescaler'(concat 'LL_USART_PRESCALER_DIV' main_peripheral_configuration.clock_prescaler)}}

  {{assign 'clock_config_object' (helper_rcc_get_clock_source_object @root.current_resource)}}
  LL_USART_SetBaudRate({{@root.current_resource}}, {{@root.clock_config_object.frequency}}, LL_USART_PRESCALER_DIV{{main_peripheral_configuration.clock_prescaler}}, LL_USART_OVERSAMPLING_8,
                       {{main_peripheral_configuration.baud_rate}});
{{#with additional_features_configuration}}
{{#if EnableFifoMode}}
  /* Fifo configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetTXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' SetTxFifoThreshold)}}
  {{helper_common_gen_ll_code 'LL_USART_SetRXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' SetRxFifoThreshold)}}
  LL_USART_EnableFIFO({{@root.current_resource}});
{{/if~}}
{{#if AM_EnablePacketTrigger}}
  LL_USART_AM_ConfigPacketTrigger({{@root.current_resource}}, LL_USART_AM_TRIG_{{trigger_polarity}}, LL_USART_AM_TRIG_{{source.source}},
                                  {{packet_size_byte}});
  LL_USART_Enable_SelectedTrigger({{@root.current_resource}});
{{/if~}}
{{/with}}
  LL_USART_Enable({{@root.current_resource}});
{{#with System}}
{{#with GPIO_Settings}}
{{assign 'gpio_needs' 'undefined'}}
{{#if gpio_clk.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_clk.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_tx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_tx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_cts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_cts.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rts.needs @root.gpio_needs)~}}
{{/if~}}
{{> GPIO_LL fct='init' needs=@root.gpio_needs resource=@root.current_resource}}
{{/with}}{{! GPIO_Settings ~}}
{{#if EnableInterruption}}
  /* Enable interrupt */
{{assign 'nvic_needs' (helper_common_concatenate_needs nvicConfig.needs @root.nvic_needs)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvicConfig.needs}}
{{/if~}}
{{#if EnableDMA_TX}}
{{> DMA_LL fct='init' needs=dmaConfigTx.needs~}}
{{/if~}}
{{#if EnableDMA_RX}}
{{> DMA_LL fct='init' needs=dmaConfigRx.needs~}}
{{/if}}
{{/with}}{{! System~}}
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if System.EnableInterruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if}}
  LL_USART_Disable({{@root.current_resource}});

  HAL_RCC_{{@root.current_resource}}_Reset();

  HAL_RCC_{{@root.current_resource}}_DisableClock();
{{#with System}}
{{#with GPIO_Settings}}
{{assign 'gpio_needs' 'undefined'}}
{{#if gpio_clk.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_clk.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_tx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_tx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_cts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_cts.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rts.needs @root.gpio_needs)~}}
{{/if~}}
{{> GPIO_LL fct='deinit' needs=@root.gpio_needs resource=@root.current_resource}}
{{/with}}{{! GPIO_Settings ~}}

{{#if EnableDMA_TX}}
{{> DMA_LL fct='deinit' needs=dmaConfigTx.needs~}}
{{/if~}}
{{#if EnableDMA_RX}}
{{> DMA_LL fct='deinit' needs=dmaConfigRx.needs~}}
{{/if~}}
{{/with}}{{! System~}}
}

{{else}}
#warning "step {{step}} in partial USART_LL not managed"
{{/if}}
