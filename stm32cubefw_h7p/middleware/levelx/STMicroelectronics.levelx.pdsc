    <!-- START: STMicroelectronics MW LevelX CODE GEN -->
    <component generator="levelx_mx2codegen" Cclass="File System" Cgroup="STM32CubeMX2 Config" Csub="LevelX" Cversion="0.1.0" condition="LX Core condition">
      <description>STMicroelectronics: STM32 Cube Configuration Code Geneneration for LevelX</description>
      <environments>
