{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:DTS",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/dts_helpers.js",
      "accessor": "common"
    },
    {
      "path": ".config/template/helpers/rcc_helpers.js",
      "accessor": "rcc_common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "Software information",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "const": "HAL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_DTS_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "resource initialization code generation",
              "description": "generate or not the DTS init code, call it or not at boot",
              "$comment": "generate the init code of your DTS or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },
        "Main": {
          "type": "object",
          "title": "Main peripheral configuration",
          "properties": {
            "reference_clock": {
              "type": "string",
              "oneOf": [
                {
                  "title": "High speed reference clock (PCLK)",
                  "const": "PCLK"
                },
                {
                  "title": "Low speed reference clock (LSE)",
                  "const": "LSE"
                }
              ],
              "actions": [
                {
                  "type": "warning",
                  "condition": "($value === 'LSE') && ($get('envVar.value', 'RCC_PROJECT_LSE') !== true)",
                  "message": "Make sure that LSE is enabled into RCC panel"
                }
              ],
              "default": "PCLK"
            },
            "reference_clock_frequency": {
              "title": "Reference clock frequency",
              "description": "DTS kernel clock frequency",
              "type": "string",
              "default": "",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "set",
                  "condition": "($Main.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) < 1000000)",
                  "computed": {
                    "const": "($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / 1000).toFixed(3) + ' KHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($Main.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) >= 1000000)",
                  "computed": {
                    "const": "($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / 1000000).toFixed(3) + ' MHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "$Main.reference_clock== 'LSE'",
                  "computed": {
                    "const": "($get('clock.frequency', 'LSE') / 1000).toFixed(3) + ' KHz'"
                  }
                }
              ]
            },
            "quick_measurement": {
              "type": "boolean",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$Main.reference_clock== 'PCLK'"
                },
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum == 2.0"
                }
              ],
              "default": false
            },
            "high_speed_clock_division": {
              "type": "integer",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$Main.reference_clock== 'LSE'"
                },
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum == 2.0"
                }
              ],
              "default": 1,
              "minimum": 1,
              "maximum": 127,
              "display_format": ["dec"]
            },
            "high_speed_clock_frequency": {
              "title": "High speed clock frequency",
              "type": "string",
              "description": "High speed clock frequency after the division",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum == 2.0"
                },
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "set",
                  "condition": "($Main.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) < 1000000)",
                  "computed": {
                    "const": "(($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / ($Main.high_speed_clock_division * 1000)).toFixed(3)) + ' KHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($Main.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) >= 1000000)",
                  "computed": {
                    "const": "(($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / ($Main.high_speed_clock_division * 1000000)).toFixed(3)) + ' MHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "$Main.reference_clock== 'LSE'",
                  "attributes": {
                    "const": "Not available"
                  }
                }
              ],
              "default": "Not available"
            }
          }
        },
        "Sensors": {
          "title": "Sensors configuration",
          "rendering": "sensors-tabs",
          "type": "array",
          "source": "Array.from({ length : ($resource.features.TEMP_CFG + 1)}, (_, i) => ({ id: i, name: `Sensor ${i+1}` }))",
          "itemTitle": "name",
          "itemId": "id",
          "itemVar": "sensor",
          "items": {
            "type": "object",
            "properties": {
              "configure": {
                "type": "boolean",
                "default": true
              },
              "trigger_source": {
                "description": "DTS sensor trigger.",
                "type": "object",
                "objectType": "query",
                "query": {
                  "entity": "peripheral.interconnect.input trigger",
                  "parent": "$resource.id",
                  "title": "{{source.replace('Sw trigger', 'SOFTWARE').replace('EXT', 'EXTI').replace('_trgo_cktim', '_TRGO').replace('[', '').replace(']', '').replace('_IT', '').replace('tim', 'TIM')}}",
                  "where": "($entity.source != '\"000000000000\"') && ($entity.source != '\"0000000000000000\"')"
                },
                "select": "first",
                "actions": [
                  {
                    "type": "enable",
                    "condition": "$item.configure"
                  },
                  {
                    "type": "info",
                    "condition": "$entity.source !== 'SOFTWARE'",
                    "message": "The selected interconnect must be configured manually"
                  }
                ]
              },
              "sampling_time": {
                "description": "Sampling time for one measurement",
                "type": "integer",
                "oneOf": [
                  {
                    "title": "1 clock cycle",
                    "const": 1
                  },
                  {
                    "title": "2 clock cycles",
                    "const": 2
                  },
                  {
                    "title": "3 clock cycles",
                    "const": 3
                  },
                  {
                    "title": "4 clock cycles",
                    "const": 4
                  },
                  {
                    "title": "5 clock cycles",
                    "const": 5
                  },
                  {
                    "title": "6 clock cycles",
                    "const": 6
                  },
                  {
                    "title": "7 clock cycles",
                    "const": 7
                  },
                  {
                    "title": "8 clock cycles",
                    "const": 8
                  },
                  {
                    "title": "9 clock cycles",
                    "const": 9
                  },
                  {
                    "title": "10 clock cycles",
                    "const": 10
                  },
                  {
                    "title": "11 clock cycles",
                    "const": 11
                  },
                  {
                    "title": "12 clock cycles",
                    "const": 12
                  },
                  {
                    "title": "13 clock cycles",
                    "const": 13
                  },
                  {
                    "title": "14 clock cycles",
                    "const": 14
                  },
                  {
                    "title": "15 clock cycles",
                    "const": 15
                  }
                ],
                "actions": [
                  {
                    "type": "enable",
                    "condition": "$item.configure"
                  }
                ],
                "default": 1
              },
              "sampling_time_value": {
                "description": "Sampling time for one measurement (in ns)",
                "type": "string",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true"
                  },
                  {
                    "type": "set",
                    "condition": "$Main.reference_clock== 'LSE'",
                    "computed": {
                      "const": "($item.sampling_time * (1000000 / $get('clock.frequency', 'LSE'))).toFixed(3) + ' ns'"
                    }
                  },
                  {
                    "type": "info",
                    "message": "The value of the sampling time in ns is calculated as follows:\n sampling_time * (10000 / (Factory value of the frequency measured at T0 for temperature sensor))",
                    "condition": "$Main.reference_clock== 'PCLK'"
                  },
                  {
                    "type": "enable",
                    "condition": "$item.configure"
                  }
                ],
                "default": "Not available"
              },
              "configure_sensor_thresholds": {
                "type": "boolean",
                "default": false,
                "actions": [
                  {
                    "type": "info",
                    "message": "Interrupt line must be enabled in order to benefit from this feature",
                    "condition": "$item.configure_sensor_thresholds && !$System.NVIC_Settings.EnableInterruption"
                  },
                  {
                    "type": "enable",
                    "condition": "$item.configure"
                  }
                ]
              },
              "sensor_high_threshold": {
                "type": "integer",
                "description": "Sensor high threshold in Celsius degree",
                "default": 0,
                "minimum": -40,
                "maximum": 140,
                "display_format": ["dec"],
                "unit": "celsius degree",
                "actions": [
                  {
                    "type": "enable",
                    "condition": "$item.configure && $item.configure_sensor_thresholds"
                  }
                ]
              },
              "sensor_low_threshold": {
                "type": "integer",
                "description": "Sensor low threshold in Celsius degree",
                "default": 0,
                "minimum": -40,
                "maximum": 140,
                "display_format": ["dec"],
                "unit": "celsius degree",
                "actions": [
                  {
                    "type": "enable",
                    "condition": "$item.configure && $item.configure_sensor_thresholds"
                  }
                ]
              }
            }
          }
        },
        "System": {
          "type": "object",
          "description": "DTS Global Configuration Structure definition.",
          "properties": {
            "NVIC_Settings": {
              "type": "object",
              "title": "NVIC settings",
              "properties": {
                "EnableInterruption": {
                  "title": "Interruption",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$Sensor.sensor_thresholds_enable",
                      "attributes": {
                        "default": true
                      }
                    }
                  ]
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ Handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($System.NVIC_Settings.EnableInterruption) && ($info.layer === 'HAL')"
                    }
                  ]
                },
                "nvicConfig": {
                  "title": "NVIC DTS configuration",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$System.NVIC_Settings.EnableInterruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}