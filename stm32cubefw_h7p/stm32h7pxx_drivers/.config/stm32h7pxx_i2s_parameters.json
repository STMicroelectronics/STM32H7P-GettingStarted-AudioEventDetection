{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:I2S",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/i2s_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label",
              "$comment": "label associated to the instance of the peripheral, can be overridden at sample level. In this case it becomes read-only.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 3,
                "maxLength": 32,
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software Layer",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "resource initialization code generation",
              "description": "generate or not the I2S init code, call it or not at boot",
              "$comment": "generate the init code of your I2S or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },

              "Basic": {
                "type": "object",
                "description": "I2S Global Configuration Structure definition.",
                "title": "Main peripheral configuration",
                "properties": {
                  "mode": {
                    "title": "Mode",
                    "type": "string",
                    "default": "SLAVE_TX",
                    "oneOf": [
                      {
                        "title": "Slave transmit",
                        "const": "SLAVE_TX"
                      },
                      {
                        "title": "Slave receive",
                        "const": "SLAVE_RX"
                      },
                      {
                        "title": "Master transmit",
                        "const": "MASTER_TX"
                      },
                      {
                        "title": "Master receive",
                        "const": "MASTER_RX"
                      },
                      {
                        "title": "Slave full-duplex",
                        "const": "SLAVE_FULL_DUPLEX"
                      },
                      {
                        "title": "Master full-duplex",
                        "const": "MASTER_FULL_DUPLEX"
                      }
                    ]
                  },
                  "standard": {
                    "title": "Standard",
                    "type": "string",
                    "default": "PHILIPS",
                    "oneOf": [
                      {
                        "title": "PHILIPS",
                        "const": "PHILIPS"
                      },
                      {
                        "title": "MSB-justified",
                        "const": "MSB"
                      },
                      {
                        "title": "LSB-justified",
                        "const": "LSB"
                      },
                      {
                        "title": "PCM with short frame synchronization",
                        "const": "PCM_SHORT"
                      },
                      {
                        "title": "PCM with long frame synchronization",
                        "const": "PCM_LONG"
                      }
                    ]
                  },
                  "data_format": {
                    "title": "Data format",
                    "type": "string",
                    "default": "16_BIT",
                    "oneOf": [
                      {
                        "title": "16-bit on 16-bit channel",
                        "const": "16_BIT"
                      },
                      {
                        "title": "16-bit on 32-bit channel",
                        "const": "16_BIT_EXTENDED"
                      },
                      {
                        "title": "24-bit on 32-bit channel",
                        "const": "24_BIT"
                      },
                      {
                        "title": "32-bit on 32-bit channel",
                        "const": "32_BIT"
                      }
                    ]
                  },
                  "data_alignment": {
                    "description": "Data alignment for data format 24-bit",
                    "type": "string",
                    "default": "Right",
                    "oneOf": [
                      {
                        "title": "Right alignment",
                        "const": "Right"
                      },
                      {
                        "title": "Left alignment",
                        "const": "Left"
                      }
                    ],
                    "actions" : [
                      {
                        "type": "include",
                        "condition": "$Basic.data_format === '24_BIT'"
                      }
                    ]
                  },
                  "audio_frequency": {
                    "title": "Audio frequency",
                    "type": "integer",
                    "default": 8000,
                    "oneOf": [
                      {
                        "title": "192kHz",
                        "const": 192000
                      },
                      {
                        "title": "96kHz",
                        "const": 96000
                      },
                      {
                        "title": "48kHz",
                        "const": 48000
                      },
                      {
                        "title": "44kHz",
                        "const": 44100
                      },
                      {
                        "title": "32kHz",
                        "const": 32000
                      },
                      {
                        "title": "22kHz",
                        "const": 22050
                      },
                      {
                        "title": "16kHz",
                        "const": 16000
                      },
                      {
                        "title": "11kHz",
                        "const": 11025
                      },
                      {
                        "title": "8kHz",
                        "const": 8000
                      },
                      {
                        "title": "Default frequency",
                        "const": 0
                      }
                    ],
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "$Basic.mode === 'SLAVE_FULL_DUPLEX' || $Basic.mode === 'SLAVE_TX' || $Basic.mode === 'SLAVE_RX'"
                      }
                    ]
                  },
                  "real_audio_frequency": {
                    "description": "Real audio frequency in kHz",
                    "type": "integer",
                    "default": 0,
                    "actions": [
                      {
                        "type": "set",
                        "condition": "true",
                        "computed": {
                          "const": "($common.helper_i2s_getrealfrequency($get('clock.frequency',$resource.id), $Basic.standard, $Basic.data_format, $Additional.EnableMclkOutput, $Basic.audio_frequency))"
                        }
                      },
                      {
                        "type": "disable",
                        "condition": "true"
                      },
                      {
                        "type": "include",
                        "condition": "$Basic.mode === 'MASTER_FULL_DUPLEX' || $Basic.mode === 'MASTER_TX' || $Basic.mode === 'MASTER_RX'"
                      }
                    ]
                  },
                  "error_frequency": {
                    "description": "Relative error between Audio frequency and Real audio frequency, in %",
                    "type": "integer",
                    "default": 0,
                    "actions": [
                      {
                        "type": "set",
                        "condition": "true",
                        "computed": {
                          "const": "($common.helper_i2s_error_frequency($Basic.audio_frequency, $Basic.real_audio_frequency))"
                        }
                      },
                      {
                        "type": "error",
                        "condition": "$value >= 5",
                        "message": "The input clock frequency must be increased to deliver this frequency."
                      },
                      {
                        "type": "error",
                        "condition": "$value <= -5",
                        "message": "The input clock frequency must be increased to deliver this frequency."
                      },
                      {
                        "type": "warning",
                        "condition": "($value > 2) && ($value < 5) ",
                        "message": "Increasing the input clock frequency could allow for more precise delivery of this frequency."
                      },
                      {
                        "type": "disable",
                        "condition": "true"
                      },
                      {
                        "type": "include",
                        "condition": "$Basic.mode === 'MASTER_FULL_DUPLEX' || $Basic.mode === 'MASTER_TX' || $Basic.mode === 'MASTER_RX'"
                      }
                    ]
                  },
                  "clock_polarity": {
                    "title": "Clock polarity",
                    "type": "string",
                    "description": "Choose level of clock signal when clock is in IDLE state",
                    "default": "LOW",
                    "oneOf": [
                      {
                        "title": "Low",
                        "const": "LOW"
                      },
                      {
                        "title": "High",
                        "const": "HIGH"
                      }
                    ]
                  },
                  "bit_order": {
                    "title": "Transfer bits order",
                    "type": "string",
                    "default": "MSB_FIRST",
                    "oneOf": [
                      {
                        "title": "MSB",
                        "const": "MSB_FIRST"
                      },
                      {
                        "title": "LSB",
                        "const": "LSB_FIRST"
                      }
                    ]
                  }
                }
              },
              "Additional": {
                "type": "object",
                "title": "Additional features configuration",
                "description": "Additional features I2S",
                "properties": {
                  "EnableMclkOutput": {
                    "title": "MCLK output",
                    "type": "boolean",
                    "description": "I2S Master Clock Output.",
                    "default": false,
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "$Basic.mode === 'SLAVE_FULL_DUPLEX' || $Basic.mode === 'SLAVE_TX' || $Basic.mode === 'SLAVE_RX'"
                      }
                    ]
                  },
                  "EnableWSInversion": {
                    "title": "WS inversion",
                    "type": "boolean",
                    "description": "I2S Word Select Inversion.",
                    "default": false
                  },
                  "EnableChannelDetectionErr": {
                    "title": "Channel length error detection",
                    "type": "boolean",
                    "description": "Channel Length detection error.",
                    "default": false
                  },
                  "SetFifoThreshold": {
                    "title": "FIFO threshold",
                    "type": "integer",
                    "description": "HAL I2S FIFO threshold level enumeration definition.",
                    "default": 1,
                    "oneOf": [
                      {
                        "title": "1-data",
                        "const": 1
                      },
                      {
                        "title": "2-data",
                        "const": 2
                      },
                      {
                        "title": "3-data",
                        "const": 3
                      },
                      {
                        "title": "4-data",
                        "const": 4
                      },
                      {
                        "title": "5-data",
                        "const": 5
                      },
                      {
                        "title": "6-data",
                        "const": 6
                      },
                      {
                        "title": "7-data",
                        "const": 7
                      },
                      {
                        "title": "8-data",
                        "const": 8
                      }
                    ]
                  },
                  "I2S_IO_configuration": {
                    "title": "I2S IO configuration",
                    "type": "object",
                    "description": "I2S IO configuration",
                    "properties": {
                      "EnableMasterKeepIOState": {
                        "type": "boolean",
                        "title": "Master keep IO state",
                        "default": false,
                        "description": "Enable Master keep IO state"
                      },
                      "EnableIOSwap": {
                        "type": "boolean",
                        "title": "IO Swap",
                        "description": "Invert MOSI and MISO alternate functions",
                        "default": false
                      },
                      "LockIOConfig": {
                        "title": "Lock IO Config",
                        "type": "boolean",
                        "description": "Lock the alternate function configuration of associated I/Os",
                        "default": false
                      }
                    }
                  }
                }
              },
              "System": {
                "type": "object",
                "title": "System view",
                "properties": {
                  "gpio_ck": {
                    "type": "object",
                    "title": "GPIOs CK configuration",
                    "objectType": "need.pinout.signals",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "CK",
                        "constraints": {
                          "mode": {
                            "const": "ALTERNATE"
                          }
                        }
                      }
                    ]
                  },
                  "gpio_ws": {
                    "title": "GPIOs WS configuration",
                    "type": "object",
                    "objectType": "need.pinout.signals",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "WS",
                        "constraints": {
                          "mode": {
                            "const": "ALTERNATE"
                          }
                        }
                      }
                    ]
                  },
                  "gpio_sdi": {
                    "title": "GPIOs SDI configuration",
                    "type": "object",
                    "objectType": "need.pinout.signals",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "SDI",
                        "constraints": {
                          "mode": {
                            "const": "ALTERNATE"
                          }
                        }
                      }
                    ]
                  },
                  "gpio_sdo": {
                    "title": "GPIOs SDO configuration",
                    "type": "object",
                    "objectType": "need.pinout.signals",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "SDO",
                        "constraints": {
                          "mode": {
                            "const": "ALTERNATE"
                          }
                        }
                      }
                    ]
                  },
                  "EnableDMA_TX": {
                    "title": "DMA TX",
                    "description": "Enable DMA TX mode for the peripheral.",
                    "type": "boolean",
                    "default": false
                  },
                  "dmaConfigTX": {
                    "title": "DMA TX configuration",
                    "type": "object",
                    "objectType": "need.dma.channels",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "TX",
                        "constraints": {
                          "direction": {
                            "const": "MEMORY_TO_PERIPH"
                          },
                          "src_inc": {
                            "const": "INCREMENTED"
                          },
                          "dest_inc": {
                            "const": "FIXED"
                          },
                          "dest_data_width": {
                            "const": "BYTE"
                          }
                        }
                      }
                    ],
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableDMA_TX"
                      }
                    ]
                  },
                  "EnableDMA_RX": {
                    "title": "DMA RX",
                    "type": "boolean",
                    "default": false,
                    "description": "Enable DMA RX mode for the peripheral."
                  },
                  "dmaConfigRX": {
                    "type": "object",
                    "title": "DMA RX configuration",
                    "objectType": "need.dma.channels",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "RX",
                        "constraints": {
                          "direction": {
                            "const": "PERIPH_TO_MEMORY"
                          },
                          "src_inc": {
                            "const": "FIXED"
                          },
                          "dest_inc": {
                            "const": "INCREMENTED"
                          },
                          "dest_data_width": {
                            "const": "BYTE"
                          }
                        }
                      }
                    ],
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableDMA_RX"
                      }
                    ]
                  },
                  "EnableInterruption": {
                    "title": "Interruption",
                    "type": "boolean",
                    "description": "Enable interruption mode for the peripheral.",
                    "default": false,
                    "actions": [
                      {
                        "type": "set",
                        "condition": "($System.EnableDMA_RX) || ($System.EnableDMA_TX)",
                        "computed": {
                          "const": true
                        }
                      },
                      {
                        "type": "disable",
                        "condition": "($System.EnableDMA_RX) || ($System.EnableDMA_TX)"
                      }
                    ]
                  },
                  "irq_handler_generation": {
                    "type": "boolean",
                    "title": "IRQ Handler generation",
                    "default": true,
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableInterruption && $info.layer === 'HAL'"
                      }
                    ]
                  },
                  "nvicConfig": {
                    "title": "NVIC configuration",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.EnableInterruption"
                      }
                    ],
                    "type": "object",
                    "objectType": "need.interrupt.lines",
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "*"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
}