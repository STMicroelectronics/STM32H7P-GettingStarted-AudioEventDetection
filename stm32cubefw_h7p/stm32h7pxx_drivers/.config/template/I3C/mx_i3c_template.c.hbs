  {{helper_common_gen_ll_code 'LL_I3C_SetMIPIInstanceID' @root.mipi_instance_id}}

{{#if (or ctrl_role ibi max_config.speed_limit)}}
  /* Set the control capability, IBI payload support and max speed limitation in BCR register */
  {{~#if ctrl_role}}{{assign 'ctrl_role_int' '1'}}{{else}}{{assign 'ctrl_role_int' '0'}}{{/if~}}
  {{~#if ibi}} {{assign 'ibi_int' '1'}}{{else}}{{assign 'ibi_int' '0'}}{{/if~}}
  {{~#if max_config.speed_limit}}{{assign 'speed_limit_int' '1'}}{{else}}{{assign 'speed_limit_int' '0'}}{{/if~}}
  {{~assign 'payload' (concat '(uint32_t)((' @root.ctrl_role_int 'U << I3C_BCR_BCR0_Pos) | (' @root.ibi_int 'U << I3C_BCR_BCR2_Pos) | (' @root.speed_limit_int 'U << I3C_BCR_BCR6_Pos))')}}
  {{{helper_common_gen_ll_code 'LL_I3C_ConfigPayloadEntDAA' @root.payload}}}

{{/if}}{{!ctrl_role ibi max_config.speed_limit~}}
{{#if ibi}}
  /* Enable the IBI request */
