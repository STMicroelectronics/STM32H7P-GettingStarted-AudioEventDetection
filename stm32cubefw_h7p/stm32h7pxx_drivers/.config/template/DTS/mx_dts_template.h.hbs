/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef STM32_{{@root.file_name}}_H
#define STM32_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each @root.instances~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'dts_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
