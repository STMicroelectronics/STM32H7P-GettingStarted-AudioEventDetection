{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CORTEX NVIC",
  "grammarVersion": "3.5",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Layer",
              "type": "string",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "title": "ARM CMSIS",
                  "const": "LL"
                }
              ],
              "default": "HAL"
            },
            "note": {
              "type": "string",
              "title": "SW Component not implemented",
              "actions": [
                {
                  "type": "disabled",
                  "condition": "true"
                }
              ],
              "default": "This driver configuration is not implemented yet."
            }
          }
        }
      }
    }
  }
}