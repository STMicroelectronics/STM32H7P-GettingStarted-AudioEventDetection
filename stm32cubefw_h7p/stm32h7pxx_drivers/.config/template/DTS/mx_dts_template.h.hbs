{{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
{{#if (eq @root.strategy "SW")}}
{{assign 'dts_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'current_resource' @root.dts_cxt.settings.resources.DTS_Instance.name~}}
{{assign 'current_layer' @root.dts_cxt.info.layer~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{else}}
{{assign 'current_layer' info.layer~}}
{{/if}}
/******************************************************************************/
/* Exported functions for DTS in {{@root.current_layer}} layer */
