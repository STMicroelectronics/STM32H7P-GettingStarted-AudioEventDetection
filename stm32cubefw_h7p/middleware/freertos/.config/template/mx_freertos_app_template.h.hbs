/* Suppress Ticks And Sleep function -----------------------*/
void vPortSuppressTicksAndSleep (TickType_t xExpectedIdleTime);
{{/if~}}
{{/with}}
{{#with Memory_Management~}}
{{#with more~}}
{{#if Enable_heap_protector}}
/* Heap Canary Random Value Function ------------------------*/
void vApplicationGetRandomHeapCanary( portPOINTER_SIZE_TYPE * pxHeapCanary);
{{/if~}}
{{~/with~}}
{{~/with~}}
{{#with Advanced_Configuration_parameters_selector~}}
{{#with Hook_Selector~}}
{{#if (or USE_IDLE_HOOK USE_TICK_HOOK USE_MALLOC_FAILED_HOOK USE_DAEMON_TASK_STARTUP_HOOK (eq CHEK_FOR_STACK_OVERFLOW '1') (eq CHEK_FOR_STACK_OVERFLOW '2'))}}
/* Hook Function --------------------------------------------*/
{{#if USE_IDLE_HOOK}}
void vApplicationIdleHook (void);
{{/if}}
{{#if USE_TICK_HOOK}}
void vApplicationTickHook (void);
{{/if}}
{{#if USE_MALLOC_FAILED_HOOK}}
void vApplicationMallocFailedHook (void);
{{/if}}
{{#if USE_DAEMON_TASK_STARTUP_HOOK}}
void vApplicationDaemonTaskStartupHook (void);
{{/if}}
{{#if (eq CHEK_FOR_STACK_OVERFLOW '1')}}
void vApplicationStackOverflowHook (TaskHandle_t xTask, char * pcTaskName);
{{/if}}
{{#if (eq CHEK_FOR_STACK_OVERFLOW '2')}}
void vApplicationStackOverflowHook (TaskHandle_t xTask, char * pcTaskName);
{{/if}}
{{/if}}
