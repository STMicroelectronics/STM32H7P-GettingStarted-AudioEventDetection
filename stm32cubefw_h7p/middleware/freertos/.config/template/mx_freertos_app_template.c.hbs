/**************************RTOS APIs*******************************************/
int32_t app_synctasks_init (void)
{
{{#each Tasks}}
{{~#if (eq Memory_allocation 'Dynamic')}}
{{~#if (not @root.dynamic_memory_allocation)}}
  BaseType_t ret;
{{assign 'dynamic_memory_allocation' true}}
{{/if}}
{{/if}}
{{/each}}
{{#each Tasks}}
  /* {{Task_name}} creation-------------------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  ret = xTaskCreate({{Entry_function}}, "{{Task_name}}", {{Task_name}}_STACK_SIZE,
                    (void*) {{#if (eq Parameter 0)}}NULL{{else}}{{Parameter}}{{/if}}, {{Task_priority}}, &{{Task_name}}_Handle);

  if (ret != pdPASS)
  {
      return -1;
  }
{{else}}
  {{Task_name}}_Handle = xTaskCreateStatic({{Entry_function}}, "{{Task_name}}", {{Task_name}}_STACK_SIZE,
                                          (void*) {{#if (eq Parameter 0)}}NULL{{else}}{{Parameter}}{{/if}}, {{Task_priority}}, {{ControlBlockName}}, &{{BufferName}});

  if ({{Task_name}}_Handle == NULL)
  {
      return -1;
  }
{{/if}}

{{/each}}
{{#each Queues}}
  /* {{Queue_name}} creation-------------------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Queue_name}}_Handle = xQueueCreate({{Queue_name}}_BUFFER_SIZE, sizeof({{Queue_item_size}}));
{{else}}
  {{Queue_name}}_Handle = xQueueCreateStatic({{Queue_name}}_BUFFER_SIZE, sizeof({{Queue_item_size}}), {{ControlBlockName}}, &{{BufferName}});
{{/if}}

  if ({{Queue_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Counting_Semaphores}}
  /* {{Semaphore_name}} creation---------------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Semaphore_name}}_Handle = xSemaphoreCreateCounting({{Max_count}}, {{Initial_count}});
{{else}}
  {{Semaphore_name}}_Handle = xSemaphoreCreateCountingStatic({{Max_count}}, {{Initial_count}}, &{{BufferName}});
{{/if}}

  if ({{Semaphore_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Binary_Semaphores}}
  /* {{Semaphore_name}} creation--------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Semaphore_name}}_Handle = xSemaphoreCreateBinary();
{{else}}
  {{Semaphore_name}}_Handle = xSemaphoreCreateBinaryStatic(&{{BufferName}});
{{/if}}

  if ({{Semaphore_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Timers}}
  /* {{Timer_name}} creation------------------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Timer_name}}_Handle = xTimerCreate("{{Timer_name}}", {{Timer_name}}_Period, {{#if (eq Reload_mode 'Periodic')}}pdTRUE{{else}}pdFALSE{{/if}}, (void *) {{#if (eq TimerID 0)}}NULL{{else}}{{TimerID}}{{/if}}, {{Callback_function}});
{{else}}
  {{Timer_name}}_Handle = xTimerCreateStatic("{{Timer_name}}", {{Timer_name}}_Period, {{#if (eq Reload_mode 'Periodic')}}pdTRUE{{else}}pdFALSE{{/if}}, (void *) {{#if (eq TimerID 0)}}NULL{{else}}{{TimerID}}{{/if}}, {{Callback_function}}, &{{BufferName}});
{{/if}}

  if ({{Timer_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Events}}
  /* {{Event_name}} creation-------------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Event_name}}_Handle = xEventGroupCreate();
{{else}}
  {{Event_name}}_Handle = xEventGroupCreateStatic(&{{BufferName}});
{{/if}}

  if ({{Event_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Mutexes}}
  /* {{Mutexe_name}} creation-----------------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Mutexe_name}}_Handle = xSemaphoreCreateMutex();
{{else}}
  {{Mutexe_name}}_Handle = xSemaphoreCreateMutexStatic(&{{BufferName}});
{{/if}}

  if ({{Mutexe_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Recursive_Mutexes}}
  /* {{Recursive_Mutexe_name}} creation-------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Recursive_Mutexe_name}}_Handle = xSemaphoreCreateRecursiveMutex();
{{else}}
  {{Recursive_Mutexe_name}}_Handle = xSemaphoreCreateRecursiveMutexStatic(&{{BufferName}});
{{/if}}

  if ({{Recursive_Mutexe_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Queue_sets}}
  /* {{Queue_sets}} creation-------------------------*/
  {{Queue_Set_name}}_Handle = xQueueCreateSet({{Queue_Set_name}}_LENGTH);

  if ({{Queue_Set_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
{{#each Stream_Buffers}}
  /* {{Stream_Buffer_name}} creation-------------------------*/
{{#if (eq Memory_allocation 'Dynamic')}}
  {{Stream_Buffer_name}}_Handle = xStreamBufferCreate({{Stream_Buffer_name}}_size, {{Stream_Buffer_name}}_Trigger_Level);
{{else}}
  {{Stream_Buffer_name}}_Handle = xStreamBufferCreateStatic({{Stream_Buffer_name}}_size, {{Stream_Buffer_name}}_Trigger_Level, {{bufferStorage}}, &{{streamBufferControl}});
{{/if}}

  if ({{Stream_Buffer_name}}_Handle == NULL)
  {
      return -1;
  }

{{/each}}
  return 0;
}

