{{!--
  Partial used for LL FMAC:
  how to use
  > FMAC_LL fct='xxxx' with xxxx:
    * init
    * deinit
--}}
{{!==================== partial function: init ====================~}}
{{#if (eq fct 'init')}}
FMAC_TypeDef *{{@root.fct_name}}_init(void)
{
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource ~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='FMAC'~}}
{{#with Basic}}
  {{helper_common_gen_ll_code "LL_FMAC_SetX1BaseAndSize" buff_x1.base_half_word buff_x1.size_half_word}}
  {{helper_common_gen_ll_code "LL_FMAC_SetX2BaseAndSize" buff_x2.base_half_word buff_x2.size_half_word}}
  {{helper_common_gen_ll_code "LL_FMAC_SetYBaseAndSize" buff_y.base_half_word buff_y.size_half_word}}
{{/with}}
{{#with System}}
{{#if dma.EnableDMA_Write}}

  /* Configure the DMA Write */
{{#> DMA_LL fct='init' needs=dma.dmaConfigWrite.needs}}
{{/DMA_LL}}
{{/if}}
{{#if dma.EnableDMA_Read}}

  /* Configure the DMA Read */
{{#> DMA_LL fct='init' needs=dma.dmaConfigRead.needs}}
{{/DMA_LL}}
{{/if}}
{{#if nvic.EnableInterruption}}

  /* Enable the Event interruption for FMAC */
{{assign 'nvic_needs' (helper_common_concatenate_needs nvic.nvic_config.needs @root.nvic_needs)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic.nvic_config.needs}}
{{/CORTEX}}
{{/if}}
{{/with}}

  return {{@root.current_resource}};
}
{{!==================== partial function: deinit ====================~}}
{{else if (eq fct 'deinit')}}
void {{@root.fct_name}}_deinit(void)
{
{{#with System}}
{{#if nvic.EnableInterruption}}
  /* Disable the Event interruption for {{@root.current_resource}} */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}
  LL_FMAC_EnableReset({{@root.current_resource}});
{{#if dma.EnableDMA_Write}}

  /* Disable the DMA Write */
{{#> DMA_LL fct='deinit' needs=dma.dmaConfigWrite.needs}}
{{/DMA_LL}}
{{/if}}
{{#if dma.EnableDMA_Read}}

  /* Disable the DMA Read */
{{#> DMA_LL fct='deinit' needs=dma.dmaConfigRead.needs}}
{{/DMA_LL}}
{{/if}}
{{/with}}
}
{{else}}
#warning "step {{fct}} in partial FMAC_LL not managed"
{{/if}}