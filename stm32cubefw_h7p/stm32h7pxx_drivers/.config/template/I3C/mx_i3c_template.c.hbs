    * - SDA rise time = {{ctrl_adv_timing_config.sda_rise_time}} ns
{{else}}
    * - SDA rise time = 350 ns
{{/if}}{{!ctrl_adv_timing_config}}
{{~!}}
    * - Input frequency = {{divide @root.input_frequency 1000000}} MHz
    * - Bus usage = {{bus_usage}}
    * - I3C bus frequency = {{divide freq_i3c 1000}} MHz
{{#if (eq bus_usage 'UTILS_I3C_I2C_MIXED_BUS')}}{{!bus_usage~}}
{{~!}}
    * - I2C bus frequency = {{freq_i2c}} KHz
    * - I2C and I3C duty cycle = {{duty_cycle_i2c}} %
{{else}}
    * - I3C duty cycle = {{duty_cycle_i3c}} %
{{/if}}{{!bus_usage~}}
{{~!}}
    * {{@root.current_resource}} timing_reg1 calculated by cubemx with:
{{#if ctrl_adv_timing_config}}
    * - Wait time = {{ctrl_adv_timing_config.wait_time}}
    * - SDA hold time = {{ctrl_adv_timing_config.sda_hold_time}}
    * - Bus free duration = {{ctrl_adv_timing_config.bus_free_duration}} ns
    * - Bus idle duration = {{ctrl_adv_timing_config.bus_idle_duration}} ns
{{else}}
    * - Wait time = LL_I3C_OWN_ACTIVITY_STATE_0
{{/if}}{{!ctrl_adv_timing_config~}}
{{~!}}
  */
  {{~#if (eq ctrl_timing_reg0 0)~}}
    {{~assign 'clock_wave_form' '0x00000000U'~}}
  {{~else~}}
    {{~assign 'clock_wave_form' (concat '0x' (uppercase (dec2hex ctrl_timing_reg0)) 'U')~}}
  {{~/if}}

  {{helper_common_gen_ll_code 'LL_I3C_ConfigClockWaveForm' @root.peripheral_mode}}
{{#if ctrl_adv_timing_config}}
  {{~#if (eq ctrl_adv_timing_reg1 0)~}}
    {{~assign 'ctrl_bus_characteristic' '0x00000000U'~}}
  {{~else~}}
    {{~assign 'ctrl_bus_characteristic' (concat '0x' (uppercase (dec2hex ctrl_adv_timing_reg1)) 'U')~}}
  {{~/if}}
  {{helper_common_gen_ll_code 'LL_I3C_SetBusCharacteristic' @root.ctrl_bus_characteristic}}
{{else}}
  {{~#if (eq ctrl_timing_reg1 0)~}}
    {{~assign 'ctrl_bus_characteristic' '0x00000000U'~}}
  {{~else~}}
    {{~assign 'ctrl_bus_characteristic' (concat '0x' (uppercase (dec2hex ctrl_timing_reg1)) 'U')~}}
  {{~/if}}
  {{helper_common_gen_ll_code 'LL_I3C_SetBusCharacteristic' @root.ctrl_bus_characteristic}}
{{/if}}{{!ctrl_adv_timing_config~}}
{{~!}}
{{else}}{{!mode~}}
{{~!}}
  /* Set the target mode */
  {{~assign 'peripheral_mode' 'LL_I3C_MODE_TARGET'}}
  {{helper_common_gen_ll_code 'LL_I3C_SetMode' @root.peripheral_mode}}

  /**
    * {{@root.current_resource}} timing_reg1 calculated by cubemx with:
{{#if tgt_adv_timing_config}}
    * Bus available duration = {{tgt_adv_timing_config.bus_available_duration}} ns
{{else}}
    * Bus available duration = 1000 ns
{{/if}}{{!tgt_adv_timing_config~}}
{{~!}}
    */
{{#if tgt_adv_timing_config}}
  {{~#if (eq tgt_adv_timing_reg1 0)~}}
    {{~assign 'ctrl_bus_characteristic' '0x00000000U'~}}
  {{~else~}}
    {{~assign 'ctrl_bus_characteristic' (concat '0x' (uppercase (dec2hex tgt_adv_timing_reg1)) 'U')~}}
  {{~/if}}
  {{helper_common_gen_ll_code 'LL_I3C_SetBusCharacteristic' @root.ctrl_bus_characteristic}}
{{else}}
  {{~#if (eq tgt_timing_reg1 0)~}}
    {{~assign 'ctrl_bus_characteristic' '0x00000000U'~}}
  {{~else~}}
    {{~assign 'ctrl_bus_characteristic' (concat '0x' (uppercase (dec2hex tgt_timing_reg1)) 'U')~}}
  {{~/if}}
  {{helper_common_gen_ll_code 'LL_I3C_SetBusCharacteristic' @root.ctrl_bus_characteristic}}
{{/if}}{{!tgt_adv_timing_config~}}
{{~!}}
{{/if}}{{!mode~}}
{{~assign 'found_SetConfig' true~}}
{{~!}}

{{/with}}{{!basic~}}
{{#with ctrl_advanced}}
{{#if enable_own_dyn_addr}}
{{#with own_dyn_addr_config}}
  /* Set the own dynamic address value */
  LL_I3C_SetOwnDynamicAddress({{@root.current_resource}}, {{own_dyn_addr}}U);
  LL_I3C_EnableOwnDynAddress({{@root.current_resource}});

{{/with}}{{!own_dyn_addr_config~}}
