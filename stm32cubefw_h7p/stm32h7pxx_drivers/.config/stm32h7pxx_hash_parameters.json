{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:HASH",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/hash_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label",
              "$comment": "label associated to the instance of the peripheral, can be overridden at sample level. In this case it becomes read-only.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_HASH_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "type": "string",
              "title": "resource initialization code generation",
              "description": "generate or not the PPP init code, call it or not at boot",
              "$comment": "generate the init code of your PPP or not (Enabled/Disabled), call it automatically at startup or not (Called/Enabled)",
              "oneOf": [
                {
                  "const": "Called"
                },
                {
                  "const": "Enabled"
                },
                {
                  "const": "Disabled"
                }
              ],
              "default": "Called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "data_swapping": {
              "type": "integer",
              "title": "Data swapping",
              "description": "",
              "default": 0,
              "oneOf": [
                {
                  "title": "Swap no",
                  "const": 0
                },
                {
                  "title": "SWAP half word",
                  "const": 1
                },
                {
                  "title": "Swap byte",
                  "const": 2
                },
                {
                  "title": "Swap bit",
                  "const": 3
                }
              ]
            },
            "algo": {
              "title": "Algorithm",
              "type": "integer",
              "description": "",
              "default": 0,
              "oneOf": [
                {
                  "title": "SHA1",
                  "const": 0
                },
                {
                  "title": "MD5",
                  "const": 1,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_md5 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA224",
                  "const": 2
                },
                {
                  "title": "SHA256",
                  "const": 3
                },
                {
                  "title": "SHA3",
                  "const": 4,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha3 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA384",
                  "const": 5,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha512 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA512224",
                  "const": 6,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha512 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA512256",
                  "const": 7,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha512 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA512",
                  "const": 8,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha512 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA3224",
                  "const": 9,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha3 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA3256",
                  "const": 10,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha3 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA3384",
                  "const": 11,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha3 > 0"
                    }
                  ]
                },
                {
                  "title": "SHA3512",
                  "const": 12,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha3 > 0"
                    }
                  ]
                },
                {
                  "title": "SHAKE128",
                  "const": 13,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha3 > 0"
                    }
                  ]
                },
                {
                  "title": "SHAKE256",
                  "const": 14,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$resource.features.g_sha3 > 0"
                    }
                  ]
                }
              ]
            },
            "use_hmac_feature": {
              "type": "boolean",
              "title": "Enable HMAC feature",
              "description": "Activate the HMAC feature.",
              "default": false
            },
            "key_settings": {
              "type": "object",
              "title": "HMAC key settings",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$basic.use_hmac_feature"
                },
                {
                  "type": "exclude",
                  "condition": "$basic.use_hmac_feature == false"
                }
              ],
              "properties": {
                "hmac_key": {
                  "type": "string",
                  "title": "Input key",
                  "default": "",
                  "description": "The HMAC key can be provided as a hex string or a regular string.",
                  "pattern": "^(?:[0-9a-fA-F]{2})*$|^.*$"
                },
                "keySize": {
                  "type": "integer",
                  "title": "Input key size (byte)",
                  "default": 0,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "true"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_hash_calculatekeySize($basic.key_settings.hmac_key)"
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "system": {
          "type": "object",
          "description": "HASH Global Configuration Structure definition.",
          "properties": {
            "dma_settings": {
              "title": "DMA",
              "type": "object",
              "properties": {
                "enable_dma": {
                  "type": "boolean",
                  "title": "Enable DMA Configuration",
                  "default": false
                },
                "dma_config": {
                  "title": "DMA configuration",
                  "type": "object",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma_settings.enable_dma"
                    }
                  ],
                  "objectType": "need.dma.channels",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_DMA_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "IN",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_inc": {
                          "const": "FIXED"
                        },
                        "src_data_width": {
                          "const": "WORD"
                        },
                        "dest_data_width": {
                          "const": "WORD"
                        },
                        "priority": {
                          "const": "LOW_WEIGHT_LOW"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic_settings": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "enable_interruption": {
                  "description": "Enable interruption mode for the peripheral.",
                  "type": "boolean",
                  "default": false,
                  "title": "Interruption"
                },
                "irq_handler_generation": {
                  "title": "IRQ handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic_settings.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "irq_config": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic_settings.enable_interruption"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}