hal_i2s_handle_t *{{@root.fct_name}}_init(void)
{
  hal_i2s_config_t i2s_config;

  if (HAL_I2S_Init(&h{{@root.current_resource}}, HAL_I2S{{removeFirst @root.current_resource 'SPI'}}) != HAL_OK)
  {
    return NULL;
  }

{{> SYSTEM component='i2s' resource=@root.current_resource~}}

{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource return_value='NULL'}}
{{assign 'found_i2s_rcc_kernel' true~}}

{{#with Basic}}
  i2s_config.mode = HAL_I2S_MODE_{{mode}};
  i2s_config.standard = HAL_I2S_STANDARD_{{standard}};
  i2s_config.data_format = HAL_I2S_DATA_FORMAT_{{data_format}};
{{#if (eq audio_frequency 0)}}
  i2s_config.audio_frequency = HAL_I2S_AUDIO_FREQ_DEFAULT;
{{else}}
  i2s_config.audio_frequency = HAL_I2S_AUDIO_FREQ_{{helper_format_frequency audio_frequency}}_KHZ;
{{/if}}
  i2s_config.clock_polarity = HAL_I2S_CLOCK_POLARITY_{{clock_polarity}};
  i2s_config.bit_order = HAL_I2S_{{bit_order}};

  if (HAL_I2S_SetConfig(&h{{@root.current_resource}}, &i2s_config) != HAL_OK)
  {
    return NULL;
  }
{{#if (eq data_format "24_BIT")}}

  if (HAL_I2S_SetData24BitsAligned{{data_alignment}}(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{/with}}

{{#with Additional}}
{{#if EnableMclkOutput}}
  {{assign 'found_i2s_mclk_output_enable' true~}}
  HAL_I2S_EnableMclkOutput(&h{{@root.current_resource}});

{{/if}}
{{#if EnableWSInversion}}
  {{assign 'found_i2s_ws_inversation_enable' true~}}
  HAL_I2S_EnableWSInversion(&h{{@root.current_resource}});

{{/if}}
{{#if EnableChannelDetectionErr}}
  {{assign 'found_i2s_channel_detection_err_enable' true~}}
