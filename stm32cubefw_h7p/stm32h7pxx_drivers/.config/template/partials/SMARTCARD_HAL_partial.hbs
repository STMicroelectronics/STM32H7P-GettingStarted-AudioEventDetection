{{!
  Partial used for HAL SMARTCARD:
  how to use
  > SMARTCARD_HAL fct='xxxx' with xxxx:
    * exported_variables
    * exported_functions_init
    * exported_functions_gethandle
~}}
{{#if (eq fct 'exported_variables')}}
/* Handle for {{@root.current_function}} */
static hal_smartcard_handle_t h{{@root.current_resource}};
{{> GPIO_HAL fct='gpio_exti_variables' resource=@root.current_resource~}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}
{{else if (eq fct 'exported_functions_init')}}
hal_smartcard_handle_t *{{@root.fct_name}}_init(void)
{
  hal_smartcard_config_t smartcard_config;

  if (HAL_SMARTCARD_Init(&h{{@root.current_resource}}, HAL_{{replace (uppercase @root.current_resource) "USART" "SMARTCARD"}}) != HAL_OK)
  {
    return NULL;
  }
{{> SYSTEM component='smartcard' resource=@root.current_resource}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource}}
{{#with main_peripheral_configuration}}
  smartcard_config.baud_rate = {{baud_rate}}U;
  smartcard_config.stop_bits = HAL_SMARTCARD_STOP_BIT_{{stop_bit}};
  smartcard_config.first_bit = HAL_SMARTCARD_BIT_ORDER_{{first_bit}};
  smartcard_config.parity = HAL_SMARTCARD_PARITY_{{parity}};
{{#if nack}}
  smartcard_config.nack = HAL_SMARTCARD_NACK_ENABLE;
{{else}}
  smartcard_config.nack = HAL_SMARTCARD_NACK_DISABLE;
{{/if}}
  smartcard_config.clock_prescaler = HAL_SMARTCARD_CLOCK_PRESC_DIV{{clock_prescaler}};
  smartcard_config.sclk_prescaler = HAL_SMARTCARD_SCLK_PRESC_DIV{{sclk_prescaler}};
{{#if clock_output}}
  smartcard_config.clock_output = HAL_SMARTCARD_CLOCK_OUTPUT_ENABLE;
{{else}}
  smartcard_config.clock_output = HAL_SMARTCARD_CLOCK_OUTPUT_DISABLE;
{{/if}}
  smartcard_config.clock_polarity = HAL_SMARTCARD_CLOCK_POLARITY_{{clock_polarity}};
  smartcard_config.clock_phase = HAL_SMARTCARD_CLOCK_PHASE_{{clock_phase}}_EDGE;
  smartcard_config.guard_time_etu = {{guard_time_etu}}U;
  smartcard_config.auto_retry_count = {{auto_retry_count}}U;
{{/with~}}{{!main_peripheral_configuration}}

  if (HAL_SMARTCARD_SetConfig(&h{{@root.current_resource}}, &smartcard_config) != HAL_OK)
  {
    return NULL;
  }

{{#with additional_features_configuration}}
{{#if EnableFifoMode}}
  if (HAL_SMARTCARD_SetTxFifoThreshold(&h{{@root.current_resource}}, HAL_SMARTCARD_FIFO_THRESHOLD_{{SetTxFifoThreshold}}) != HAL_OK)
  {
    return NULL;
  }
  if (HAL_SMARTCARD_SetRxFifoThreshold(&h{{@root.current_resource}}, HAL_SMARTCARD_FIFO_THRESHOLD_{{SetRxFifoThreshold}}) != HAL_OK)
  {
    return NULL;
  }
  if (HAL_SMARTCARD_EnableFifoMode(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}

{{#if EnableIOInvert}}
  if (HAL_SMARTCARD_EnableIOInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}{{! EnableIOInvert~}}

{{#if EnableDataInvert}}
  if (HAL_SMARTCARD_EnableDataInvert(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}{{! EnableDataInvert~}}

{{#if EnableTxRxSwap}}
  if (HAL_SMARTCARD_EnableTxRxSwap(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}{{! EnableTxRxSwap~}}

{{#if DisableRxOverRunDetection}}
  if (HAL_SMARTCARD_DisableRxOverRunDetection(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}{{! EnableRxOverRunDetection~}}

{{#if EnableDMAStopOnRxError}}
  if (HAL_SMARTCARD_EnableDMAStopOnRxError(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}{{! EnableDMAStopOnRxError~}}

{{#if EnableReceiverTimeout}}
  if (HAL_SMARTCARD_EnableReceiverTimeout(&h{{@root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{#if (not (eq SetReceiverTimeout 0))}}
  if (HAL_SMARTCARD_SetReceiverTimeout(&h{{@root.current_resource}}, {{SetReceiverTimeout}}) != HAL_OK)
  {
    return NULL;
  }
{{/if~}}{{! SetReceiverTimeout~}}
{{/if~}}{{! EnableReceiverTimeout~}}

{{#if (not (eq SetTxCpltIndication "DISABLE"))}}
  if (HAL_SMARTCARD_SetTxCpltIndication(&h{{@root.current_resource}}, HAL_SMARTCARD_TX_CPLT_{{SetTxCpltIndication}}_GUARD_TIME) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}{{! SetTxCpltIndication~}}

{{#if (not (eq SetBlockLength 0))}}
  if (HAL_SMARTCARD_SetBlockLength(&h{{@root.current_resource}}, {{SetBlockLength}}) != HAL_OK)
  {
    return NULL;
  }

{{/if~}}{{! SetBlockLength~}}
{{/with~}}{{!additional_features_configuration}}


{{#with System.GPIO_Settings}}
{{assign 'gpio_needs' 'undefined'~}}
{{#if gpio_clk.needs}}
{{assign 'found_smartcard_gpio_clk' true~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_clk.needs @root.gpio_needs)~}}
{{/if~}}{{!gpio_clk.needs}}
{{#if gpio_tx.needs}}
{{assign 'found_smartcard_gpio_tx' true~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_tx.needs @root.gpio_needs)~}}
{{/if~}}{{!gpio_tx.needs}}
{{#if gpio_rx.needs}}
{{assign 'found_smartcard_gpio_rx' true~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rx.needs @root.gpio_needs)~}}
{{/if~}}{{!gpio_rx.needs}}
{{#> GPIO_HAL fct='init' needs=@root.gpio_needs resource=@root.current_resource}}
{{/GPIO_HAL~}}
{{/with~}}{{!System.GPIO_Settings}}

{{#with System}}
{{#if EnableInterruption}}
  /* Enable interrupt */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvicConfig.needs @root.current_resource irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvicConfig.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}

{{#if EnableDMA_TX}}
{{assign 'found_smartcard_dma_tx' true~}}
  /* Configure the DMA TX */
{{#> DMA_HAL fct='init' needs=dmaConfigTx.needs}}
{{/DMA_HAL}}

  /* Link the Transmit DMA handle to the SMARTCARD handle */
  if (HAL_SMARTCARD_SetTxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{! EnableDMA_TX~}}

{{#if EnableDMA_RX}}
{{assign 'found_smartcard_dma_rx' true~}}
  /* Configure the DMA RX */
{{#> DMA_HAL fct='init' needs=dmaConfigRx.needs}}
{{/DMA_HAL}}

  /* Link the Receive DMA handle to the SMARTCARD handle */
  if (HAL_SMARTCARD_SetRxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{! EnableDMA_RX~}}
{{/with}}{{!System}}

  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if System.EnableInterruption}}
  /* Disable interrupt */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}

  (void)HAL_SMARTCARD_DeInit(&h{{@root.current_resource}});

  HAL_RCC_{{@root.current_resource}}_Reset();

  HAL_RCC_{{@root.current_resource}}_DisableClock();

{{#with System}}
{{#> GPIO_HAL fct='deinit' needs=@root.gpio_needs resource=@root.current_resource}}
{{/GPIO_HAL}}

{{#if EnableDMA_TX}}
{{#> DMA_HAL fct='deinit' needs=dmaConfigTx.needs}}
{{/DMA_HAL~}}
{{/if}}

{{#if EnableDMA_RX}}
{{#> DMA_HAL fct='deinit' needs=dmaConfigRx.needs}}
{{/DMA_HAL~}}
{{/if}}
{{/with}}
}

{{else if (eq fct 'exported_functions_gethandle')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined undefined)~}}
hal_smartcard_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{else if (eq fct 'exported_functions_gethandle_prototype')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined undefined)~}}
/**
  * @brief  Get the {{@root.current_resource}}{{addConfigLC @root.current_function}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_smartcard_handle_t *{{@root.fct_name}}_gethandle(void);

{{else}}
#warning "step {{fct}} in partial SMARTCARD_HAL not managed"
{{/if}}
