#include "mx_levelx_interfaces.h"

{{#each @root.levelx_cxt.interface_config}}
  {{#with logical_config}}
    {{#if (eq interface_type "W25N01GVXX_NAND_Flash_Interface")}}
static STM32_LX_NAND_FLASH_DRIVER_CONTEXT nand_flash_driver_{{@index}}_ctx;

/**
  * mx_lx_nand_flash_driver_{{@index}}_initialize() levelx stub interface
  */
UINT mx_lx_nand_flash_driver_{{@index}}_initialize(LX_NAND_FLASH *nand_flash)
{
  UINT nand_flash_status = LX_ERROR;
  w25n01gvxx_obj_t *pFlashObj;

  /* Retrieve the NAND flash object pointer */
  pFlashObj = mx_w25n01gvxx_{{@index}}_getobject();

  /* Initialize the memory part */
  if (w25n01gvxx_init(pFlashObj, W25N01GVXX_{{@index}}) != W25N01GVXX_OK)
  {
    return LX_ERROR;
  }

  /* Setup the levelx nand flash context */
  {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_ALL}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags = STM32_LX_NAND_FLAG_ALL;
  {{else}}
    {{!-- Assign the first selected flag with = --}}
    {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_NONE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags = STM32_LX_NAND_FLAG_NONE;
      {{!-- OR the rest except NONE --}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_START_BLOCK}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_START_BLOCK;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_TOTAL_BLOCKS}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_TOTAL_BLOCKS;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_CACHE_MAINTENANCE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_CACHE_MAINTENANCE;
      {{/if}}
    {{else if NAND_Flash_Flags.STM32_LX_NAND_FLAG_START_BLOCK}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags = STM32_LX_NAND_FLAG_START_BLOCK;
      {{!-- OR the rest except START_BLOCK --}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_NONE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_NONE;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_TOTAL_BLOCKS}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_TOTAL_BLOCKS;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_CACHE_MAINTENANCE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_CACHE_MAINTENANCE;
      {{/if}}
    {{else if NAND_Flash_Flags.STM32_LX_NAND_FLAG_TOTAL_BLOCKS}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags = STM32_LX_NAND_FLAG_TOTAL_BLOCKS;
      {{!-- OR the rest except TOTAL_BLOCKS --}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_NONE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_NONE;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_START_BLOCK}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_START_BLOCK;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_CACHE_MAINTENANCE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_CACHE_MAINTENANCE;
      {{/if}}
    {{else if NAND_Flash_Flags.STM32_LX_NAND_FLAG_CACHE_MAINTENANCE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags = STM32_LX_NAND_FLAG_CACHE_MAINTENANCE;
      {{!-- OR the rest except CACHE_MAINTENANCE --}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_NONE}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_NONE;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_START_BLOCK}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_START_BLOCK;
      {{/if}}
      {{#if NAND_Flash_Flags.STM32_LX_NAND_FLAG_TOTAL_BLOCKS}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags |= STM32_LX_NAND_FLAG_TOTAL_BLOCKS;
      {{/if}}
    {{else}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_flags = STM32_LX_NAND_FLAG_NONE;
    {{/if}}
  {{/if}}
  nand_flash_driver_{{@index}}_ctx.nand_flash_start_block = {{Start_block}};
  nand_flash_driver_{{@index}}_ctx.nand_flash_total_blocks = {{Total_blocks}};
  nand_flash_driver_{{@index}}_ctx.nand_flash_get_driver_object = (nand_flash_get_object *)mx_w25n01gvxx_{{@index}}_getobject;
  nand_flash_driver_{{@index}}_ctx.nand_flash_op_timeout = {{NAND_Op_Timeout}};

  nand_flash->lx_nand_flash_info_ptr = (void *)&nand_flash_driver_{{@index}}_ctx;

  /* call the actual levelx interface initialize function */
  {{#if (eq transfer_mode "Polling")}}
  nand_flash_status = stm32_lx_w25n01gvxx_nand_flash_polling_driver_initialize(nand_flash);
  {{else if (eq transfer_mode "DMA_NO_OS")}}
  nand_flash_status = stm32_lx_w25n01gvxx_nand_flash_dma_no_os_driver_initialize(nand_flash);
  {{else if (eq transfer_mode "DMA_OS")}}
  nand_flash_status = stm32_lx_w25n01gvxx_nand_flash_dma_os_driver_initialize(nand_flash);
  {{/if}}

  return nand_flash_status;
}
    {{/if}}
  {{/with}}
{{/each}}
