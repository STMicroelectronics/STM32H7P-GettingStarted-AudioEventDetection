{{assign 'dma_usage' fct~}}
{{#if (eq fct 'init')}}
  {{! }}
  {{! Generate the DMA code inside the PPPi init function}}
  {{! > DMA_HAL fct='init' needs=dmaConfigTX.needs}}
  {{! }}
  {{log "DMA_HAL fct='init': DMA Channel instance:" needs~}}
  {{#each needs}}
  {{assign 'dma_config' (@root.DmaAPI.getNeedById id)~}}
  {{!log "DMA_HAL fct='init' dma_config:" @root.dma_config~}}
  {{/each}}
  {{assign 'dma_channel_instance' @root.dma_config.resourceId~}}
  {{assign 'dma_config' @root.dma_config.configuration~}}
  {{#if (eq @root.xfer_exist undefined)}}
    {{assign 'xfer_exist' 1~}}
  {{/if}}

{{else if (eq fct 'init_dma')}}

  {{! }}
  {{! Generate the DMA code inside the DMAi_CHy init function}}
  {{! > DMA_HAL fct='init_dma' arg1=@root.current_resource arg2=@root.current_config}}
  {{! }}
  {{~assign 'dma_channel_instance' arg1~}}
  {{~assign 'dma_config' arg2~}}
  {{else if (eq fct 'get_dma_handles')}}
    {{! > DMA_HAL fct='get_dma_handles' resource='I2C1' strategy='HW'}}
    {{!       strategy can be HW or SW depending of project options }}
    {{!                if SW resource is equle to 'STM32 HAL Code Gen:I2C Init'}}
    {{! }}
    {{~log "DMA_HAL fct='get_dma_handles' resource:" resource " strategy:" strategy~}}
    {{~assign 'a_dma_instances' 'undefined'~}}
    {{#if (or (eq strategy undefined) (eq strategy 'HW'))}}
      {{~assign 'getAllocatedResourceNeeds' (@root.DmaAPI.getAllocatedResourceNeedsByHwInstance resource)~}}
      {{~log 'DMA_HAL (get_dma_handles): getAllocatedResourceNeeds (by HW)=' (toJSON @root.getAllocatedResourceNeeds)~}}
    {{else}}
      {{~assign 'getAllocatedResourceNeeds' (@root.DmaAPI.getAllocatedResourceNeedsByComponent resource)~}}
      {{~log 'DMA_HAL (get_dma_handles): getAllocatedResourceNeeds (by SW)=' (toJSON @root.getAllocatedResourceNeeds)~}}
    {{/if}}
    {{~assign 'dma_node_exist' true~}}
    {{#each @root.getAllocatedResourceNeeds}}
    {{~assign 'sw_instance_config' (@root.SWConfigurationAPI.getSwInstanceConfiguration swInstanceId)~}}
    {{!log "test_dma_partial sw_instance_config:" (toJSON @root.sw_instance_config)~}}
    {{#if (eq @root.sw_instance_config.info.layer 'HAL')}}
      {{~assign 'dma_config' (@root.DmaAPI.getNeedById needId)~}}
      {{~assign 'a_dma_instances' (helper_dma_get_dma_handle @root.dma_config @root.a_dma_instances)~}}
      {{#with @root.dma_config}}
{{#with configuration.Main_configuration}}
{{#if (eq DMA_Mode 2)}}
{{#with Basic_xfer}}
{{assign 'DMA_Node' (helper_dma_get_node request.id )~}}
{{/with~}}
static hal_dma_node_t {{@root.DMA_Node~}};
{{~assign 'dma_node_exist' false}}
{{/if~}}
{{/with~}}
      {{/with~}}
      {{!log "test_dma_partial dma_config:" (toJSON @root.dma_config)~}}
    {{/if}}
    {{/each}}
    {{~log "DMA_HAL fct='get_dma_handles' a_dma_instances:" @root.a_dma_instances~}}
{{#if (not (eq @root.a_dma_instances 'undefined'))}}
{{#each @root.a_dma_instances}}
static hal_dma_handle_t h{{this}};
{{/each}}
{{/if}}
{{! }}
{{! Generate the DMA code inside the PPPi init function}}
{{! > DMA_HAL fct='deinit' needs=dmaConfigTX.needs}}
{{! }}
{{else if (eq fct 'deinit')}}
{{#each needs}}
{{assign 'dma_config' (@root.DmaAPI.getNeedById id)~}}
{{!log "DMA_HAL fct='init' dma_config:" @root.dma_config~}}
{{/each}}
  /* De-initialize the DMA channel */
  {{assign 'dma_channel_instance' @root.dma_config.resourceId~}}
  HAL_DMA_DeInit(&h{{@root.dma_channel_instance}});

{{#each @root.dma_config}}
{{#if System_configuration.nvicConfig}}
  /* Disable the interruption for DMA */
{{assign 'nvic_needs' (helper_common_concatenate_needs System_configuration.nvicConfig.needs @root.nvic_needs)~}}
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context System_configuration.nvicConfig.needs @root.dma_channel_instance System_configuration.irq_handler_generation_dma)~}}
{{#> CORTEX fct='deinit' layer=@root.current_layer needs=System_configuration.nvicConfig.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}
{{/each}}

{{else}}
#warning "{{fct}} not present in partial DMA_HAL_partial.hbs"
{{/if}}
{{#if (or (eq fct 'init') (eq fct 'init_dma'))}}
{{assign 'dma_parent' (helper_dma_get_parent @root.dma_channel_instance)~}}
{{> SYSTEM component='dma' resource=@root.dma_parent}}
  if (HAL_DMA_Init(&h{{@root.dma_channel_instance}}, HAL_{{uppercase @root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{#with @root.dma_config}}
{{! DMA channel direct mode basic xfer : }}
{{#with Main_configuration}}
{{#if (eq @root.dma_usage 'init')}}
{{assign 'xfer_cfg' (concat 'xfer_cfg' @root.xfer_exist)~}}
{{else}}
{{assign 'xfer_cfg' 'xfer_cfg'}}
{{#if (eq DMA_Mode 0)}}
  hal_dma_direct_xfer_config_t {{@root.xfer_cfg}};
{{/if}}
{{/if}}

{{assign 'dma_transfer_mode' (helper_dma_transfer_mode DMA_Mode)~}}
{{#with Basic_xfer}}
{{#if (eq @root.dma_usage 'init')}}
{{assign 'DMA_Node' (helper_dma_get_node request.id )~}}
  {{#if request}}
    {{assign 'xfer_cfg' (append 'xfer_cfg_' request.id)}}
  hal_dma_direct_xfer_config_t {{@root.xfer_cfg}};
  {{assign 'req' (helper_dma_get_request @root.dma_channel_instance @root.current_layer request.id)~}}
  {{@root.xfer_cfg}}.request         = {{@root.req}};
  {{else}}
  hal_dma_direct_xfer_config_t {{@root.xfer_cfg}};
  {{@root.xfer_cfg}}.request         = HAL_DMA_REQUEST_SW;
 {{/if}}
{{else}}
  {{@root.xfer_cfg}}.request         = HAL_DMA_REQUEST_SW;
{{/if}}
  {{@root.xfer_cfg}}.direction       = HAL_DMA_DIRECTION_{{direction}};
  {{@root.xfer_cfg}}.src_inc         = HAL_DMA_SRC_ADDR_{{src_inc}};
  {{@root.xfer_cfg}}.dest_inc        = HAL_DMA_DEST_ADDR_{{dest_inc}};
  {{@root.xfer_cfg}}.src_data_width  = HAL_DMA_SRC_DATA_WIDTH_{{src_data_width}};
  {{@root.xfer_cfg}}.dest_data_width = HAL_DMA_DEST_DATA_WIDTH_{{dest_data_width}};
  {{@root.xfer_cfg}}.priority        = HAL_DMA_PRIORITY_{{priority}};
{{/with}}

{{#if (eq @root.dma_usage 'init_dma')}}
{{#if (eq DMA_Mode 0)}}
  if (HAL_DMA_SetConfigDirectXfer(&h{{@root.dma_channel_instance}}, &{{@root.xfer_cfg}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{else}}
{{#if (eq DMA_Mode 2)}}
  if (HAL_DMA_SetConfigPeriphLinkedListCircularXfer(&h{{@root.dma_channel_instance}}, &{{@root.DMA_Node}}, &{{@root.xfer_cfg}}) != HAL_OK)
  {
    return NULL;
  }

{{#if (or (eq Basic_xfer.fetch_port_circular_mode 0) (eq Basic_xfer.fetch_port_circular_mode 1))}}
  if (HAL_DMA_SetLinkedListXferFetchNodePort(&h{{@root.dma_channel_instance}}, HAL_DMA_PORT{{Basic_xfer.fetch_port_circular_mode}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}

{{else}}
  if (HAL_DMA_SetConfigPeriphDirectXfer(&h{{@root.dma_channel_instance}}, &{{@root.xfer_cfg}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{/if}}
{{#if (eq @root.dma_usage 'init')}}
  {{assign 'xfer_exist' (add @root.xfer_exist 1)~}}
{{/if}}
{{/with}}
{{! DMA channel linked list mode xfer : }}
{{#with Main_configuration.Linked_list_xfer}}
/* Set DMA channel linked list xfer configuration */
  hal_dma_linkedlist_xfer_config_t linkedlist_xfer_cfg;

  linkedlist_xfer_cfg.priority        = HAL_DMA_PRIORITY_{{priority}};
{{#if (or (eq fetch_port 0) (eq fetch_port 1))}}
  linkedlist_xfer_cfg.fetch_port      = HAL_DMA_PORT{{fetch_port}};
{{/if}}
  linkedlist_xfer_cfg.xfer_event_mode = HAL_DMA_LINKEDLIST_XFER_EVENT_Q;
  if (HAL_DMA_SetConfigLinkedListXfer(&h{{@root.dma_channel_instance}}, &linkedlist_xfer_cfg) != HAL_OK)
  {
    return NULL;
  }

{{/with}}
{{! DMA channel access port xfer : }}
{{#with Additional_configuration.Access_ports_xfer}}
{{#if configuration}}
  /* Set DMA channel access ports xfer configuration */
  {

{{#if (eq @root.dma_transfer_mode 0)}}
    if (HAL_DMA_SetConfigDirectXferPort(&h{{@root.dma_channel_instance}}, HAL_DMA_PORT{{DMA_channel_source_port}}, HAL_DMA_PORT{{DMA_channel_destination_port}}) != HAL_OK)
{{else}}
    if (HAL_DMA_FillNodePort( &{{@root.DMA_Node}}, HAL_DMA_PORT{{DMA_channel_source_port}}, HAL_DMA_PORT{{DMA_channel_destination_port}}) != HAL_OK)
{{/if}}
    {
      return NULL;
    }
  }

{{/if}}
{{/with}}
{{! DMA channel burst xfer : }}
{{#with Additional_configuration.Burst_xfer}}
{{#if configuration}}
  /* Set DMA channel burst xfer configuration */
  {
{{#if (eq @root.dma_transfer_mode 0)}}
    if (HAL_DMA_SetConfigDirectXferBurst(&h{{@root.dma_channel_instance}}, {{DMA_channel_source_burst}}, {{DMA_channel_destination_burst}}) != HAL_OK)
{{else}}
    if (HAL_DMA_FillNodeBurst(&{{@root.DMA_Node}}, {{DMA_channel_source_burst}}, {{DMA_channel_destination_burst}}) != HAL_OK)
{{/if}}
    {
      return NULL;
    }
  }

{{/if}}
{{/with}}
{{! DMA channel trigger xfer : }}
{{#with Additional_configuration.Trigger_xfer}}
{{#if configuration}}
  {{assign 'trig' (helper_dma_get_trigger @root.dma_channel_instance @root.current_layer DMA_channel_trigger_source.id)~}}
  {{assign 'dma_default_trigger' 0~}}
  /* Set DMA channel trigger xfer configuration */
  {
    hal_dma_trigger_config_t trigger_cfg;

  {{#if (eq @root.trig undefined)}}
    trigger_cfg.source    = {{@root.dma_default_trigger}};
  {{else}}
    trigger_cfg.source    = {{@root.trig}};
  {{/if}}
    trigger_cfg.polarity  = HAL_DMA_TRIGGER_POLARITY_{{DMA_channel_trigger_polarity}};
    trigger_cfg.mode      = HAL_DMA_TRIGGER_{{DMA_channel_trigger_mode}};
{{#if (eq @root.dma_transfer_mode 0)}}
    if (HAL_DMA_SetConfigDirectXferTrigger(&h{{@root.dma_channel_instance}}, &trigger_cfg) != HAL_OK)
{{else}}
    if (HAL_DMA_FillNodeTrigger( &{{@root.DMA_Node}}, &trigger_cfg) != HAL_OK)
{{/if}}
    {
      return NULL;
    }
  }

{{/if}}
{{/with}}
{{! DMA channel data handling xfer : }}
{{#with Additional_configuration.Data_handling_xfer}}
{{#if configuration}}
  /* Set DMA channel data handling xfer configuration */
  {
    hal_dma_data_handling_config_t data_handling_cfg;

{{#if src_byte_exchange}}
    data_handling_cfg.src_byte_exchange      = HAL_DMA_SRC_BYTE_{{src_byte_exchange}};
{{/if}}
{{#if dest_byte_exchange}}
    data_handling_cfg.dest_byte_exchange     = HAL_DMA_DEST_BYTE_{{dest_byte_exchange}};
{{/if}}
{{#if dest_halfword_exchange}}
    data_handling_cfg.dest_halfword_exchange = HAL_DMA_DEST_HALFWORD_{{dest_halfword_exchange}};
{{/if}}
{{#if dest_word_exchange}}
    data_handling_cfg.dest_word_exchange     = HAL_DMA_DEST_WORD_{{dest_word_exchange}};
{{/if}}
{{#if trunc_padd}}
    data_handling_cfg.trunc_padd             = HAL_DMA_DEST_DATA_TRUNC_{{trunc_padd}};
{{/if}}
{{#if pack}}
    data_handling_cfg.pack                   = HAL_DMA_DEST_DATA_{{pack}};
{{/if}}
{{#if (eq @root.dma_transfer_mode 0)}}
    if (HAL_DMA_SetConfigDirectXferDataHandling(&h{{@root.dma_channel_instance}}, &data_handling_cfg) != HAL_OK)
{{else}}
    if (HAL_DMA_FillNodeDataHandling(&{{@root.DMA_Node}}, &data_handling_cfg) != HAL_OK)
{{/if}}
    {
      return NULL;
    }
  }

{{/if}}
{{/with}}
{{! DMA channel repeated block xfer : }}
{{#with Additional_configuration.Repeated_block_xfer}}
{{#if configuration}}
  /* Set DMA channel repeated block xfer configuration */
  {
    hal_dma_repeat_block_config_t repeat_block_cfg;

    repeat_block_cfg.block_count            = {{block_count}};
    repeat_block_cfg.burst_src_offset_byte  = {{burst_src_offset_byte}};
    repeat_block_cfg.burst_dest_offset_byte = {{burst_dest_offset_byte}};
    repeat_block_cfg.block_src_offset_byte  = {{block_src_offset_byte}};
    repeat_block_cfg.block_dest_offset_byte = {{block_dest_offset_byte}};
    repeat_block_cfg.burst_src_inc          = HAL_DMA_BURST_SRC_ADDR_{{burst_src_inc}};
    repeat_block_cfg.burst_dest_inc         = HAL_DMA_BURST_DEST_ADDR_{{burst_dest_inc}};
    repeat_block_cfg.block_src_inc          = HAL_DMA_BLOCK_SRC_ADDR_{{block_src_inc}};
    repeat_block_cfg.block_dest_inc         = HAL_DMA_BLOCK_DEST_ADDR_{{block_dest_inc}};
    repeat_block_cfg.xfer_event_mode        = HAL_DMA_DIRECT_XFER_EVENT_{{event_mode}};
{{#if (eq @root.dma_transfer_mode 0)}}
    if (HAL_DMA_SetConfigDirectXferRepeatBlock(&h{{@root.dma_channel_instance}}, &repeat_block_cfg) != HAL_OK)
{{else}}
    if (HAL_DMA_FillNodeRepeatBlock(&{{@root.DMA_Node}}, &repeat_block_cfg) != HAL_OK)
{{/if}}
    {
      return NULL;
    }
  }

{{/if}}
{{/with}}

{{#if (eq @root.dma_transfer_mode 2)}}
{{assign 'node_counter' (add @root.node_counter 1)~}}
{{/if}}

{{! DMA channel NVIC configuration : }}
{{#if System_configuration.nvicConfig}}
  /* Enable the interruption for {{@root.dma_channel_instance}} */
{{assign 'nvic_needs' (helper_common_concatenate_needs System_configuration.nvicConfig.needs @root.nvic_needs)~}}
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context System_configuration.nvicConfig.needs @root.dma_channel_instance System_configuration.irq_handler_generation_dma)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=System_configuration.nvicConfig.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}

{{/with}}
{{/if}}