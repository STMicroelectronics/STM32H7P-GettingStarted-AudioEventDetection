                  "title": "Fast",
                  "const": "fast"
                },
                {
                  "title": "Small",
                  "const": "small"
                }
              ],
              "title": "AES configuration (implementation)",
              "default": "fast",
              "actions": [
                {
                  "type": "set",
                  "condition": "$STCryptoLib_Profile == 'small_and_low'",
                  "computed": {
                    "const": "small"
                  }
                },
                {
                  "type": "set",
                  "condition": "$STCryptoLib_Profile == 'fast_and_high'",
                  "computed": {
                    "const": "fast"
                  }
                },
                {
                  "type": "disable",
                  "condition": "$STCryptoLib_Profile != 'custom'"
                }
              ]
            },
            "gcm_config": {
