  * @brief  Get the {{@root.fct_name}} object.
  * @retval Pointer on the {{@root.fct_name}}Handle
  */
hal_uart_handle_t *{{@root.fct_name}}_gethandle(void);
{{assign 'hal_handle_uart_exist' 1~}}

