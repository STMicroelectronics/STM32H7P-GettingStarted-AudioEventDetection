/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{#each @root.instances~}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'RTC_cxt' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.RTC_cxt.settings.parameters.info.layer~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
  {{#if (eq @root.current_layer 'HAL')}}
    {{~assign 'only_ll' false~}}
  {{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}
#include "mx_def.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
/* Exported macros -----------------------------------------------------------*/
{{#each @root.instances~}}
  {{#with system}}
    {{#with gpioSettings}}
      {{~assign 'rtc_gpio_needs' 'undefined'~}}
      {{#if rtcOut2.needs}}
        {{~assign 'rtc_gpio_needs' (helper_common_concatenate_needs rtcOut2.needs @root.rtc_gpio_needs)~}}
      {{/if}}
      {{#if rtcRefIn.needs}}
        {{~assign 'rtc_gpio_needs' (helper_common_concatenate_needs rtcRefIn.needs @root.rtc_gpio_needs)~}}
      {{/if}}
    {{/with}}
  {{/with}}
  {{#if (eq @root.current_layer 'HAL')}}
    {{#> GPIO_HAL fct='generate_labels' needs=@root.rtc_gpio_needs}}
    {{/GPIO_HAL~}}
  {{else}}
    {{#> GPIO_LL fct='generate_labels' needs=@root.rtc_gpio_needs}}
    {{/GPIO_LL~}}
  {{/if}}
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'RTC_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.RTC_cxt.info.layer~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
/******************************************************************************/
/* Exported functions for RTC in {{@root.current_layer}} layer */
/******************************************************************************/
  {{~assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  */
  {{#if (eq @root.current_layer 'HAL')}}
system_status_t {{@root.fct_name}}_init(void);
  {{else}}
system_status_t {{@root.fct_name}}_init(void);
  {{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

  {{#if (eq @root.current_layer 'HAL')}}
    {{~assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined 'RTC')~}}
  {{/if}}
{{/each}}
{{assign 'irq_info_list' (helper_cortex_nvic_get_irqline_info_list @root.NvicAPI @root.nvic_context 'RTC')~}}
{{#each @root.irq_info_list}}
  {{#if generate_handler}}
/******************************************************************************/
/*                     {{description}}                    */
/******************************************************************************/
void {{line}}_IRQHandler(void);

  {{else}}
/******************************************************************************/
/*    {{description}} is managed directly in user code.   */
/******************************************************************************/
/* void {{line}}_IRQHandler(void); */

  {{/if}}
{{/each}}
#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.file_name}}_H */
