{{!--
  Partial used for HAL FMAC:
  how to use
  > FMAC_HAL fct='xxxx' with xxxx:
    * init
    * deinit
--}}
{{!==================== partial function: init ====================~}}
{{#if (eq fct 'init')}}
hal_fmac_handle_t *{{@root.fct_name}}_init(void)
{
  hal_fmac_config_t fmac_config;

  if (HAL_FMAC_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{> SYSTEM component='fmac' resource=@root.current_resource}}
{{#with Basic}}
  fmac_config.x1_buf.base_half_word = {{buff_x1.base_half_word}};
  fmac_config.x1_buf.size_half_word = {{buff_x1.size_half_word}};
  fmac_config.x2_buf.base_half_word = {{buff_x2.base_half_word}};
  fmac_config.x2_buf.size_half_word = {{buff_x2.size_half_word}};
  fmac_config.y_buf.base_half_word = {{buff_y.base_half_word}};
  fmac_config.y_buf.size_half_word = {{buff_y.size_half_word}};

  {{assign 'found_FMAC_SetConfig' true~}}
  HAL_FMAC_SetConfig(&h{{@root.current_resource}}, &fmac_config);
{{/with}}{{!Basic~}}
{{#with System}}
{{#if dma.EnableDMA_Write}}

  /* Configure the DMA Write */
{{#> DMA_HAL fct='init' needs=dma.dmaConfigWrite.needs}}
{{/DMA_HAL}}
  /* Link the Write X1 DMA handle to the {{@root.current_resource}} handle */
  if (HAL_FMAC_SetWriteX1DMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{! EnableDMA_Write~}}
{{#if dma.EnableDMA_Read}}

  /* Configure the DMA Read */
{{#> DMA_HAL fct='init' needs=dma.dmaConfigRead.needs}}
{{/DMA_HAL}}
  /* Link the Read Y DMA handle to the {{@root.current_resource}} handle */
  if (HAL_FMAC_SetReadYDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{! EnableDMA_Read~}}
{{#if nvic.EnableInterruption}}

  /* Enable the interruption for {{@root.current_resource}} */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context System.nvicConfig.needs @root.current_resource System.irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=nvic.nvic_config.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}
{{/with}}

  return &h{{@root.current_resource}};
}
{{!==================== partial function: deinit ====================~}}
{{else if (eq fct 'deinit')}}
void {{@root.fct_name}}_deinit(void)
{
{{#with System}}
{{#if nvic.EnableInterruption}}

  /* Disable the interruption for FMAC */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}
{{/with}}
  (void)HAL_FMAC_DeInit(&h{{@root.current_resource}});

  HAL_RCC_{{@root.current_resource}}_Reset();
  HAL_RCC_{{@root.current_resource}}_DisableClock();
{{#with System}}
{{#if dma.EnableDMA_Write}}

{{> DMA_HAL fct='deinit' needs=dma.dmaConfigWrite.needs}}
{{/if}}
{{#if dma.EnableDMA_Read}}

{{> DMA_HAL fct='deinit' needs=dma.dmaConfigRead.needs}}
{{/if}}
{{/with}}
}
{{else}}
#warning "step {{fct}} in partial FMAC_HAL not managed"
{{/if}}