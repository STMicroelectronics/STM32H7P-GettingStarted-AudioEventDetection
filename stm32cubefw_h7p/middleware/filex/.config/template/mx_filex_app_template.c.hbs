  * @param  None
  * @retval UINT: FX_SUCCESS on success, error code otherwise
  */
UINT app_filex_init(VOID)
{
  UINT ret = FX_SUCCESS;
{{#if (helper_if_component_os_is_enabled @root.used_components_freertos 'Core')}}
{{#with @root.filex_cxt~}}
{{#with core_config~}}
{{#with Applicative~}}
{{#if FILEX_GENERATE_INIT_CODE}}
  /* Create the {{FILEX_APP_TASK_NAME}} */
  ret = xTaskCreate({{FILEX_APP_TASK_ENTRY}}, "{{FILEX_APP_TASK_NAME}}", {{FILEX_APPLICATION_TASK_STACK_SIZE}}, (VOID *) NULL,
                    {{FILEX_APPLICATION_TASK_PRIORITY}}, &main_task);
  if (ret != pdPASS)
  {
    return FX_PTR_ERROR;
  }
{{/if}}
{{/with}}
{{/with}}
{{/with}}
{{/if}}

  /* Initializes FileX.*/
  fx_system_initialize();

  return ret;
}

