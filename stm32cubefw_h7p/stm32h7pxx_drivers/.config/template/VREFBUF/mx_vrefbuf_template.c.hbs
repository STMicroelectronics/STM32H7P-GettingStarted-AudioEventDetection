{{assign "strategy" (@root.EnvVarAPI.getVariableValue 'SYSTEM_PROJECT_CODEGEN_STRATEGY')~}}
{{log "strategy" @root.strategy~}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'current_resource' 'VREFBUF'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:VREFBUF')~}}
{{else}}
  {{~assign "strategy" 'HW'~}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~log "VREFBUF template _myctx:" this~}}
      {{~assign 'current_resource' resource~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
  {{/get_myctx~}}
{{/if}}
{{log "VREFBUF template current_resource:" @root.current_resource~}}
{{log "VREFBUF template instances:" (toJSON @root.instances)~}}
{{> SYSTEM fct='system_check_ll_optim'}}
