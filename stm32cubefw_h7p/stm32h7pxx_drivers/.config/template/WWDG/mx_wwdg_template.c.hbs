hal_wwdg_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_WWDG_Init(&h{{@root.current_resource}},HAL_{{@root.current_resource}}{{@root.current_index}}) != HAL_OK)
  {
    return NULL;
  }
{{#if System.nvicSettings.EnableInterruption}}
  /* Enable the interruption for WWDG */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context System.nvicSettings.nvicConfig.needs @root.current_resource System.nvicSettings.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=System.nvicSettings.nvicConfig.needs}}
{{/if}}
  return &h{{@root.current_resource}};
}
{{#if RunTime.Start}}
hal_status_t {{@root.fct_name}}_start(void)
{
{{#if System.NVIC_Settings.EnableInterruption }}
  return HAL_WWDG_Start(&h{{@root.current_resource}}, {{Applicative.MinTime.InputMinTime}}UL, {{Applicative.MaxTime.InputMaxTime}}UL, 1UL);
{{else}}
  return HAL_WWDG_Start(&h{{@root.current_resource}}, {{Applicative.MinTime.InputMinTime}}UL, {{Applicative.MaxTime.InputMaxTime}}UL, 0UL);
{{/if}}
}
