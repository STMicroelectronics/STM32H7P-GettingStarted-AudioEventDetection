{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:System",
  "grammarVersion": "3.1",
  "license": "LICENSE.md",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/common_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "warning": {
          "title": "Warning",
          "type": "string",
          "default": "NVIC component must be configured",
          "actions": [
            {
              "type": "exclude",
              "condition": "$get('peripheral.isBound', 'NVIC')"
            },
            {
              "type": "disable",
              "condition": "!$get('peripheral.isBound', 'NVIC')"
            },
            {
              "type": "info",
              "condition": "!$get('peripheral.isBound', 'NVIC')",
              "message": "NVIC component must be configured"
            }
          ]
        },
        "GeneratedFunctionCalls": {
          "type": "array",
          "rendering": "horizontal-list",
          "source": "$common.helper_common_get_generated_function_calls($get('sw-config.instances',$modelId))",
          "itemId": "name",
          "itemVar": "functions_calls",
          "itemTitle": "_rank",
          "allowRanking": true,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "default": "",
                "title": "Function name",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true"
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.name"
                    }
                  }
                ]
              },
              "peripheral": {
                "type": "string",
                "default": "",
                "title": "Peripheral Instance",
                "actions": [
                  {
                    "type": "disable",
                    "condition": "true"
                  },
                  {
                    "type": "set",
                    "condition": "true",
                    "computed": {
                      "const": "$functions_calls.sw_instance"
                    }
                  }
                ]
              },
              "generated": {
                "type": "boolean",
                "default": true
              },
              "callable": {
                "type": "boolean",
                "default": true,
                "actions": [
                  {
                    "type": "enable",
                    "condition": "$item.generated"
                  }
                ]
              }
            }
          }
        },
        "code_generation": {
          "type": "object",
          "title": "Code Generation model",
          "properties": {
            "isr_handler": {
              "type": "boolean",
              "default": false,
              "title": "Single file for ISR",
              "description": "All IRQ handlers are generated inside mx_cortex_nvic.c/h"
            },
            "optim_enable": {
              "type": "boolean",
              "default": false,
              "title": "LL code optimization",
              "description": "This feature allows to optimize the LL generated code linked to the HW reset values of each peripheral"
            },
            "strategy": {
              "type": "string",
              "oneOf": [
                {
                  "description": "Generated files are inside a mx_ppp.c/h (not functional yet)",
                  "const": "SW",
                  "title": "By SW instance",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "true"
                    }
                  ]
                },
                {
                  "const": "HW",
                  "title": "By HW instance",
                  "description": "Generated files are inside a mx_pppi.c/h"
                }
              ],
              "title": "Code generation strategy",
              "description": "Code generation is based on SW instance or HW instance",
              "variables": [
                {
                  "on": "update-value",
                  "name": "SYSTEM_PROJECT_CODEGEN_STRATEGY",
                  "computed_value": "$value"
                }
              ],
              "default": "HW"
            }
          }
        },
        "debug": {
          "type": "object",
          "title": "Debug",
          "properties": {
            "assert_dbg_param": {
              "type": "boolean",
              "title": "Assert checks on function parameters",
              "description": "Enable check param for HAL and LL (USE_ASSERT_DBG_PARAM define in pre-compilation)",
              "default": false,
              "synchronize": true,
              "synchronizeOn": {
                "path": "assert_dbg_param",
                "component": "HAL-CORE"
              }
            },
            "assert_dbg_param_function": {
              "type": "boolean",
              "title": "Use default assert parameters function",
              "description": "Generate in mx_system.c the definition of 'assert_dbg_param_failed' function. Otherwise, function must be defined in the application.",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$debug.assert_dbg_param"
                }
              ]
            },
            "assert_dbg_state": {
              "type": "boolean",
              "title": "Assert checks on module state",
              "description": "Enable check state for HAL (USE_ASSERT_DBG_STATE define in pre-compilation)",
              "default": false,
              "synchronize": true,
              "synchronizeOn": {
                "path": "assert_dbg_state",
                "component": "HAL-CORE"
              }
            },
            "assert_dbg_state_function": {
              "type": "boolean",
              "title": "Use default assert state function",
              "description": "Generate in mx_system.c the definition of 'assert_dbg_state_failed' function. Otherwise, function must be defined in the application.",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$debug.assert_dbg_state"
                }
              ]
            }
          }
        }
      }
    }
  }
}
