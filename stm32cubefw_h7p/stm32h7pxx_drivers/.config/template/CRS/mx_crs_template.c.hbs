  crs_config.trimming               = 0x{{#if CRS_trimming_value }}{{uppercase (dec2hex CRS_trimming_value)}}{{else}}0{{/if}};

  HAL_CRS_SetConfig(&h{{uppercase @root.current_resource}}, &crs_config);
