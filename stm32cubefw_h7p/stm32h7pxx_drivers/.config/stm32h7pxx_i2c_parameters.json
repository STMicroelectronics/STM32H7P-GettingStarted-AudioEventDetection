{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:I2C",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/i2c_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "Software information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_I2C_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "resource initialization code generation",
              "description": "generate or not the I2C init code, call it or not at boot",
              "$comment": "generate the init code of your I2C or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },
        "Basic": {
          "type": "object",
          "title": "Main peripheral configuration",
          "properties": {
            "AdvancedTimingConfiguration": {
              "type": "boolean",
              "title": "Advanced configuration for the timing calculation",
              "default": false
            },
            "Speed_Frequency_Hz": {
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$Basic.AdvancedTimingConfiguration"
                }
              ],
              "type": "integer",
              "description": "I2C Speed Frequency (KHz)",
              "oneOf": [
                {
                  "title": "Standard Mode - 100 KHz",
                  "const": 100000
                },
                {
                  "title": "Fast Mode - 400 KHz",
                  "const": 400000
                },
                {
                  "title": "Fast Mode Plus - 1 MHz",
                  "const": 1000000
                }
              ],
              "default": 100000
            },
            "timing": {
              "type": "integer",
              "description": "This timing is directly calculated by CubeMX2",
              "display_format": ["hex"],
              "maximum": 4043309055,
              "default": 0,
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$Basic.AdvancedTimingConfiguration"
                },
                {
                  "type": "disable",
                  "condition": "\"true\""
                },
                {
                  "type": "set",
                  "computed": {
                    "const": "$common.helper_compute_timing_basic($get('clock.frequency',$resource.id), $Basic.Speed_Frequency_Hz).timing_reg"
                  }
                }
              ]
            },
            "ClockTimingConfiguration": {
              "type": "object",
              "title": "Clock Timing Configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$Basic.AdvancedTimingConfiguration"
                }
              ],
              "properties": {
                "Speed_Frequency_Custom": {
                  "type": "integer",
                  "description": "I2C Speed Frequency (Hz)",
                  "minimum": 1,
                  "maximum": 1000000,
                  "default": 100000,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$Basic.AdvancedTimingConfiguration"
                    }
                  ]
                },
                "rise_time": {
                  "type": "integer",
                  "description": "Rise Time (ns)",
                  "maximum": 1000,
                  "default": 0,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$Basic.AdvancedTimingConfiguration"
                    },
                    {
                      "type": "set",
                      "condition": "$Basic.ClockTimingConfiguration.Speed_Frequency_Custom <= 100000",
                      "attributes": {
                        "maximum": 1000
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$Basic.ClockTimingConfiguration.Speed_Frequency_Custom > 100000 && $Basic.ClockTimingConfiguration.Speed_Frequency_Custom <= 400000",
                      "attributes": {
                        "maximum": 300
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$Basic.ClockTimingConfiguration.Speed_Frequency_Custom> 400000",
                      "attributes": {
                        "maximum": 120
                      }
                    }
                  ]
                },
                "fall_time": {
                  "type": "integer",
                  "description": "Fall Time (ns)",
                  "maximum": 300,
                  "default": 0,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$Basic.AdvancedTimingConfiguration"
                    },
                    {
                      "type": "set",
                      "condition": "$Basic.ClockTimingConfiguration.Speed_Frequency_Custom <= 400000",
                      "attributes": {
                        "maximum": 300
                      }
                    },
                    {
                      "type": "set",
                      "condition": "$Basic.ClockTimingConfiguration.Speed_Frequency_Custom > 400000",
                      "attributes": {
                        "maximum": 120
                      }
                    }
                  ]
                },
                "EnableAnalogFilter": {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$Basic.AdvancedTimingConfiguration"
                    }
                  ],
                  "type": "boolean",
                  "title": "Analog noise filter",
                  "default": true
                },
                "DigitalNoiseFilter": {
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$Basic.AdvancedTimingConfiguration"
                    }
                  ],
                  "type": "integer",
                  "title": "Coefficient of digital noise filter ",
                  "description": "Value is between 0x00 and 0x0F",
                  "minimum": 0,
                  "maximum": 15,
                  "default": 0
                },
                "timing": {
                  "type": "integer",
                  "description": "This timing is directly calculated by CubeMX2",
                  "display_format": ["hex"],
                  "maximum": 4043309055,
                  "default": 0,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$Basic.AdvancedTimingConfiguration"
                    },
                    {
                      "type": "disable",
                      "condition": "\"true\""
                    },
                    {
                      "type": "set",
                      "computed": {
                        "const": "$common.helper_compute_timing_advanced($get('clock.frequency',$resource.id), $Basic.ClockTimingConfiguration.Speed_Frequency_Custom, $Basic.ClockTimingConfiguration.rise_time, $Basic.ClockTimingConfiguration.fall_time, $Basic.ClockTimingConfiguration.DigitalNoiseFilter, $Basic.ClockTimingConfiguration.EnableAnalogFilter).timing_reg"
                      }
                    }
                  ]
                }
              }
            },
            "addressing_mode": {
              "type": "integer",
              "description": "7-bit or 10-bit addressing mode",
              "oneOf": [
                {
                  "title": "7-bit addressing mode",
                  "const": 7
                },
                {
                  "title": "10-bit addressing mode",
                  "const": 10,
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$Advanced.EnableOwnAddress2"
                    }
                  ]
                }
              ],
              "default": 7
            },
            "own_address1": {
              "type": "integer",
              "title": "Own Primary Address",
              "description": "First device own 7-bit address",
              "minimum": 0,
              "maximum": 1023,
              "display_format": ["hex", "dec"],
              "actions": [
                {
                  "type": "set",
                  "condition": "$Basic.addressing_mode==7",
                  "attributes": {
                    "maximum": 127
                  }
                },
                {
                  "type": "set",
                  "condition": "$Basic.addressing_mode==10",
                  "attributes": {
                    "description": "First device own 10-bit address."
                  }
                }
              ],
              "default": 0
            }
          }
        },
        "Advanced": {
          "type": "object",
          "title": "Additional features configuration",
          "properties": {
            "EnableAutonomousMode": {
              "type": "boolean",
              "title": "Autonomous mode",
              "default": false,
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.features.auton > 0"
                }
              ]
            },
            "AutonomousConfiguration": {
              "type": "object",
              "title": "Advanced configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$Advanced.EnableAutonomousMode"
                }
              ],
              "properties": {
                "source": {
                  "type": "object",
                  "description": "Autonomous Mode Trigger Selection",
                  "objectType": "query",
                  "query": {
                    "entity": "peripheral.interconnect.input trigger",
                    "parent": "$resource.id",
                    "title": "{{source}}"
                  }
                },
                "polarity": {
                  "type": "string",
                  "description": "Autonomous Mode Trigger Polarity",
                  "oneOf": [
                    {
                      "title": "RISING",
                      "const": "RISING"
                    },
                    {
                      "title": "FALLING",
                      "const": "FALLING"
                    }
                  ],
                  "default": "RISING"
                }
              }
            },
            "EnableFastModePlus": {
              "type": "boolean",
              "title": "Enable IO 20 mA Fast mode plus",
              "default": false
            },
            "ClockStretching": {
              "type": "boolean",
              "title": "Slave Clock Stretching",
              "default": true
            },
            "EnableWakeUp": {
              "type": "boolean",
              "title": "Slave Wakeup from Stop mode",
              "default": false
            },
            "EnableAckGeneralCall": {
              "type": "boolean",
              "title": "Slave Acknowledge General Call",
              "default": false
            },
            "EnableOwnAddress2": {
              "type": "boolean",
              "title": "Slave Secondary Address",
              "default": false
            },
            "OwnAddress2Configuration": {
              "type": "object",
              "title": "Slave Secondary Address Configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$Advanced.EnableOwnAddress2"
                }
              ],
              "properties": {
                "own_address2": {
                  "type": "integer",
                  "title": "Own Secondary Address",
                  "description": "7-Bit Secondary Address",
                  "display_format": ["hex", "dec"],
                  "minimum": 0,
                  "maximum": 127,
                  "default": 0
                },
                "MaskAddress2": {
                  "type": "string",
                  "title": "Slave Secondary Address Mask",
                  "description": "Secondary Address Acknowledgement Mask",
                  "oneOf": [
                    {
                      "title": "No mask",
                      "const": "NOMASK"
                    },
                    {
                      "title": "Mask 01",
                      "const": "MASK01"
                    },
                    {
                      "title": "Mask 02",
                      "const": "MASK02"
                    },
                    {
                      "title": "Mask 03",
                      "const": "MASK03"
                    },
                    {
                      "title": "Mask 04",
                      "const": "MASK04"
                    },
                    {
                      "title": "Mask 05",
                      "const": "MASK05"
                    },
                    {
                      "title": "Mask 06",
                      "const": "MASK06"
                    },
                    {
                      "title": "Mask 07",
                      "const": "MASK07"
                    }
                  ],
                  "default": "NOMASK"
                }
              }
            }
          }
        },
        "System": {
          "type": "object",
          "description": "I2C Global Configuration Structure definition.",
          "properties": {
            "gpio": {
              "type": "object",
              "objectType": "need.pinout.signals",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "SCL",
                  "constraints": {
                    "pull": {
                      "allow": ["UP", "NO"]
                    },
                    "mode": {
                      "const": "ALTERNATE"
                    },
                    "output_type": {
                      "const": "OPENDRAIN"
                    }
                  }
                },
                {
                  "selector": "SDA",
                  "constraints": {
                    "pull": {
                      "allow": ["UP", "NO"]
                    },
                    "mode": {
                      "const": "ALTERNATE"
                    },
                    "output_type": {
                      "const": "OPENDRAIN"
                    }
                  }
                }
              ]
            },
            "EnableEventInterruption": {
              "type": "boolean",
              "description": "Enable interruption mode for the peripheral.",
              "default": false
            },
            "event_irq_handler_generation": {
              "type": "boolean",
              "title": "IRQ Handler generation",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableEventInterruption && $info.layer === 'HAL'"
                }
              ]
            },
            "nvicConfigEvent": {
              "title": "NVIC Event configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableEventInterruption"
                }
              ],
              "type": "object",
              "objectType": "need.interrupt.lines",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "EV"
                }
              ]
            },
            "EnableErrorInterruption": {
              "type": "boolean",
              "description": "Enable interruption mode for the peripheral.",
              "default": false
            },
            "error_irq_handler_generation": {
              "type": "boolean",
              "title": "IRQ Handler generation",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableErrorInterruption && $info.layer === 'HAL'"
                }
              ]
            },
            "nvicConfigError": {
              "title": "NVIC Error configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableErrorInterruption"
                }
              ],
              "type": "object",
              "objectType": "need.interrupt.lines",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "ERR"
                }
              ]
            },
            "EnableDMA_TX": {
              "type": "boolean",
              "description": "Enable DMA TX mode for the peripheral.",
              "default": false
            },
            "dmaConfigTX": {
              "title": "DMA TX configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableDMA_TX"
                }
              ],
              "type": "object",
              "objectType": "need.dma.channels",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "TX",
                  "constraints": {
                    "direction": {
                      "const": "MEMORY_TO_PERIPH"
                    },
                    "dest_inc": {
                      "const": "FIXED"
                    },
                    "dest_data_width": {
                      "const": "BYTE"
                    }
                  }
                }
              ]
            },
            "EnableDMA_RX": {
              "type": "boolean",
              "description": "Enable DMA RX mode for the peripheral.",
              "default": false
            },
            "dmaConfigRX": {
              "title": "DMA RX configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableDMA_RX"
                }
              ],
              "type": "object",
              "objectType": "need.dma.channels",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "RX",
                  "constraints": {
                    "direction": {
                      "const": "PERIPH_TO_MEMORY"
                    },
                    "src_inc": {
                      "const": "FIXED"
                    },
                    "src_data_width": {
                      "const": "BYTE"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
