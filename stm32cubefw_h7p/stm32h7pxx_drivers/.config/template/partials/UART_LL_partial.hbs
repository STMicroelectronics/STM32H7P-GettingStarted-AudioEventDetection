{{!
  Partial used for LL UART:
  how to use
  > UART_LL fct='xxxx' with xxxx:
    * exported_variables
    * exported_functions_init
    * exported_functions_gethandle
    * exported_functions_gethandle_prototype
~}}

{{!
############################
##  exported_variables
############################
~}}
{{#if (eq fct 'exported_variables')}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{!
############################
##  exported_functions_init
############################
~}}
{{else if (eq fct 'exported_functions_init')}}
{{#startsWith 'UART' @root.current_resource}}
{{assign 'prefix' 'USART'~}}
{{assign 'instance_type' 'UART'~}}
{{/startsWith}}
{{#startsWith 'USART' @root.current_resource}}
{{assign 'prefix' 'USART'~}}
{{assign 'instance_type' 'UART'~}}
{{/startsWith}}
{{#startsWith 'LPUART' @root.current_resource}}
{{assign 'prefix' 'LPUART'~}}
{{assign 'instance_type' 'LPUART'~}}
{{/startsWith}}
USART_TypeDef *{{@root.fct_name}}_init(void)
{
  uint32_t reg_temp;

  /* Basic configuration */
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='UART'}}
  LL_USART_ConfigAsyncMode({{@root.current_resource}});

  reg_temp = (LL_USART_DATAWIDTH_{{main_peripheral_configuration.word_length}}_BIT | LL_USART_PARITY_{{main_peripheral_configuration.parity}}
              | LL_USART_DIRECTION_{{main_peripheral_configuration.direction}} | LL_USART_OVERSAMPLING_{{main_peripheral_configuration.over_sampling}});
  LL_{{@root.prefix}}_ConfigXfer({{@root.current_resource}}, reg_temp, LL_USART_STOP_BIT_{{main_peripheral_configuration.stop_bit}});

  {{helper_common_gen_ll_code 'LL_USART_SetHWFlowCtrl'(concat 'LL_USART_HWCONTROL_' main_peripheral_configuration.hw_flow_ctl)}}

  {{helper_common_gen_ll_code 'LL_USART_SetPrescaler'(concat 'LL_USART_PRESCALER_DIV' main_peripheral_configuration.clock_prescaler)}}

{{#if (eq main_peripheral_configuration.one_bit_sampling "ENABLE")}}
  LL_USART_EnableOneBitSample({{@root.current_resource}});

{{/if}}
{{assign 'clock_config_object' (helper_rcc_get_clock_source_object @root.current_resource)}}
{{#if (eq @root.prefix USART)}}
  LL_USART_SetBaudRate({{@root.current_resource}}, {{@root.clock_config_object.frequency}}, LL_USART_PRESCALER_DIV{{main_peripheral_configuration.clock_prescaler}}, LL_USART_OVERSAMPLING_{{main_peripheral_configuration.over_sampling}},
                       {{main_peripheral_configuration.baud_rate}});
{{else}}
  LL_LPUART_SetBaudRate({{@root.current_resource}}, {{@root.clock_config_object.frequency}}, LL_USART_PRESCALER_DIV{{main_peripheral_configuration.clock_prescaler}}, {{main_peripheral_configuration.baud_rate}});
{{/if}}
{{#if (eq main_peripheral_configuration.mode "half_duplex_single_wire_mode")}}
  /* Half duplex configuration */
  LL_USART_ConfigHalfDuplexMode({{@root.current_resource}});

{{else if (eq main_peripheral_configuration.mode "multiprocessor_communication")}}
  /* Multiprocessor configuration */
{{#if (eq additional_features_configuration.wakeup_method "ADDRESS_MARK")}}
  {{helper_common_gen_ll_code 'LL_USART_SetWakeUpMethod'(concat 'LL_USART_WAKEUP_METHOD_' additional_features_configuration.wakeup_method)}}
  LL_USART_ConfigNodeAddress({{@root.current_resource}}, LL_USART_ADDRESS_DETECT_{{additional_features_configuration.address_length}}_BIT, {{additional_features_configuration.address}});

{{/if~}}
  LL_USART_ConfigMultiProcessMode({{@root.current_resource}});

  LL_USART_EnableMuteMode({{@root.current_resource}});

{{else if (eq main_peripheral_configuration.mode "lin")}}
  /* LIN configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetLINBrkDetectionLen'(concat 'LL_USART_LIN_BREAK_DETECT_' additional_features_configuration.SetLINModeBreakDetectLength '_BIT')}}

  LL_USART_ConfigLINMode({{@root.current_resource}});

{{/if~}}
{{#with additional_features_configuration}}
{{#if EnableRS485Mode}}
  {{helper_common_gen_ll_code 'LL_USART_SetDESignalPolarity'(concat 'LL_USART_DE_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_USART_ConfigDETime'(concat assertion_time_samples 'U') (concat deassertion_time_samples 'U')}}
  LL_USART_EnableDEMode({{@root.current_resource}});

{{/if~}}
{{#if EnableFifoMode}}
  /* Fifo configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetTXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' SetTxFifoThreshold)}}
  {{helper_common_gen_ll_code 'LL_USART_SetRXFIFOThreshold'(concat 'LL_USART_FIFO_THRESHOLD_' SetRxFifoThreshold)}}

  LL_USART_EnableFIFO({{@root.current_resource}});

{{/if~}}
{{#if EnableReceiverTimeout}}
  {{helper_common_gen_ll_code 'LL_USART_SetRxTimeout'(concat SetReceiverTimeout 'U')}}
  LL_USART_EnableRxTimeout({{@root.current_resource}});

{{/if~}}{{! EnableReceiverTimeout~}}

{{#if AM_EnablePacketTrigger}}
  LL_USART_AM_ConfigPacketTrigger({{@root.current_resource}}, LL_USART_AM_TRIG_{{trigger_polarity}}, LL_{{@root.prefix}}_AM_TRIG_{{source.source}},
                                  {{packet_size_byte}});
{{#if AM_EnableIdle}}
  LL_USART_Enable_AutonomousSendIdleFrame({{@root.current_resource}});

{{/if}}
  LL_USART_DisableDirectionTx({{@root.current_resource}});

  LL_USART_Enable_SelectedTrigger({{@root.current_resource}});

{{/if~}}
{{#if SetConfigAutoBaudRate}}
{{#if (not (eq SetConfigAutoBaudRate "DISABLE"))}}
  /* Auto baud rate mode configuration */
  {{helper_common_gen_ll_code 'LL_USART_SetAutoBaudRateMode'(concat 'LL_USART_AUTO_BAUD_DETECT_ON_' SetConfigAutoBaudRate)}}
  LL_USART_EnableAutoBaudRate({{@root.current_resource}});
{{/if~}}
{{/if~}}
{{#if EnableTxPinLevelInvert}}
  /* Tx pin level inversion configuration */
  LL_USART_SetTXPinLevel({{@root.current_resource}}, LL_USART_TXPIN_LEVEL_INVERTED);

{{/if~}}
{{#if EnableRxPinLevelInvert}}
  /* Rx pin level inversion configuration */
  LL_USART_SetRXPinLevel({{@root.current_resource}}, LL_USART_TXPIN_LEVEL_INVERTED);

{{/if~}}
{{#if EnableDataInvert}}
  /* Data inversion configuration */
  LL_USART_SetBinaryDataLogic({{@root.current_resource}}, LL_USART_BINARY_LOGIC_NEGATIVE);

{{/if~}}
{{#if EnableTxRxSwap}}
  /* Tx and Rx pins swapping configuration */
  LL_USART_SetTXRXSwap({{@root.current_resource}}, LL_USART_TXRX_SWAPPED);

{{/if~}}
{{#if DisableRxOverRunDetection}}
  /* Overrun configuration */
  LL_USART_DisableOverrunDetect({{@root.current_resource}});

{{/if~}}
{{#if EnableDMAStopOnRxError}}
  /* DMA stop on Rx error configuration */
  LL_USART_EnableDMADeactOnRxErr({{@root.current_resource}});

{{/if~}}
{{#if EnableMSBFirst}}
  /* MSB first configuration */
  LL_USART_SetTransferBitOrder({{@root.current_resource}}, LL_USART_BITORDER_MSB_FIRST);

{{/if~}}
{{#if EnableStopMode}}
  /* Wake up from low power mode configuration */
  LL_USART_EnableInStopMode({{@root.current_resource}});
{{/if~}}
{{/with}}
{{#with System}}
{{#with GPIO_Settings}}
{{assign 'gpio_needs' 'undefined'}}
  /* GPIO */
{{#if gpio_tx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_tx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rx.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rx.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_cts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_cts.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_rts.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_rts.needs @root.gpio_needs)~}}
{{/if~}}
{{#if gpio_de.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_de.needs @root.gpio_needs)~}}
{{/if~}}
{{#> GPIO_LL fct='init' needs=@root.gpio_needs resource=@root.current_resource~}}
{{/GPIO_LL}}
{{/with}}{{! GPIO_Settings ~}}
{{#if EnableInterruption}}
  /* Enable interrupt */
{{assign 'nvic_needs' (helper_common_concatenate_needs nvicConfig.needs @root.nvic_needs)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvicConfig.needs}}
{{/if~}}
{{#if EnableDMA_TX}}
{{> DMA_LL fct='init' needs=dmaConfigTx.needs~}}
{{/if~}}
{{#if EnableDMA_RX}}
{{> DMA_LL fct='init' needs=dmaConfigRx.needs~}}
{{/if~}}
{{/with}}

  LL_USART_Enable({{@root.current_resource}});
  return {{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if System.EnableInterruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if}}
  LL_USART_Disable({{@root.current_resource}});

  HAL_RCC_{{@root.current_resource}}_Reset();

  HAL_RCC_{{@root.current_resource}}_DisableClock();
{{#with System}}
{{#if GPIO_Settings.gpio_tx}}

{{> GPIO_LL fct='deinit' needs=GPIO_Settings.gpio_tx.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_rx}}

{{> GPIO_LL fct='deinit' needs=GPIO_Settings.gpio_rx.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_rts}}

{{> GPIO_LL fct='deinit' needs=GPIO_Settings.gpio_rts.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_cts}}

{{> GPIO_LL fct='deinit' needs=GPIO_Settings.gpio_cts.needs resource=@root.current_resource}}
{{/if~}}
{{#if GPIO_Settings.gpio_de}}

{{> GPIO_LL fct='deinit' needs=GPIO_Settings.gpio_de.needs resource=@root.current_resource}}
{{/if~}}

{{#if EnableDMA_TX}}
{{> DMA_LL fct='deinit' needs=dmaConfigTx.needs~}}
{{/if~}}
{{#if EnableDMA_RX}}
{{> DMA_LL fct='deinit' needs=dmaConfigRx.needs~}}
{{/if~}}
{{/with}}{{! System~}}
}
