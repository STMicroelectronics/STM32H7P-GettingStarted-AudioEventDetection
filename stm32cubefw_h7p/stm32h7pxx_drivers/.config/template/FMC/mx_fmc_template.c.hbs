static hal_sram_handle_t hSRAM{{chip_select}};

hal_sram_handle_t *mx_fmc_bank1_sub{{chip_select}}_hal_sram_init(void)
{
  hal_sram_config_t sram_config;

  if (HAL_SRAM_Init(&hSRAM{{chip_select}}, HAL_SRAM{{chip_select}}) != HAL_OK)
  {
    return NULL;
  }

  sram_config.memory_type              = HAL_SRAM_MEMORY_TYPE_SRAM;
  sram_config.write_fifo               = HAL_SRAM_WRITE_FIFO_{{#if static_config.write_fifo}}ENABLE{{else}}DISABLE{{/if}};
  sram_config.wait_signal_polarity     = HAL_SRAM_WAIT_SIGNAL_POLARITY_{{static_config.wait_signal_polarity}};

  if (HAL_SRAM_SetConfig(&hSRAM{{chip_select}}, &sram_config) != HAL_OK)
  {
    return NULL;
  }

