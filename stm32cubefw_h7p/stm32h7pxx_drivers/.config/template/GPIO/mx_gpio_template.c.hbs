{{assign "strategy" (@root.EnvVarAPI.getVariableValue 'SYSTEM_PROJECT_CODEGEN_STRATEGY')~}}
{{log "strategy" @root.strategy~}}
{{#if (eq @root.strategy "SW")}}
  {{! ~}}
  {{assign 'current_resource' 'GPIO'~}}
  {{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:GPIO')~}}
{{else}}
  {{! ~}}
  {{assign "strategy" "HW"~}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{!log "GPIO template _myctx:" this~}}
      {{assign 'current_resource' resource~}}
      {{assign 'name_file' resource~}}
      {{assign 'instances' instances~}}
    {{/with~}}
  {{/get_myctx~}}
{{/if}}
{{log "GPIO template current_resource:" @root.current_resource~}}
{{log "GPIO template instances:" (toJSON @root.instances)~}}
