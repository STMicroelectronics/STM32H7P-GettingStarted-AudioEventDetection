  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
    {{~assign 'save_files' (arrayify  '')~}}
   {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="RCC"'))}}
        {{#if (or (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_HSE') (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_LSE') (@root.EnvVarAPI.getVariableValue 'RCC_PROJECT_AUDIO_CLOCK'))}}
        <Pre_Include_Global_h>
          #define USE_EXTERNAL_ENV
        </Pre_Include_Global_h>
        {{/if}}
      {{/if}}
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="CORE"'))}}
        {{#if (or (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_PARAM') (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_STATE'))}}
        <Pre_Include_Global_h>
          {{#if (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_PARAM')}}
          #define USE_ASSERT_DBG_PARAM
          {{/if}}
          {{#if (@root.EnvVarAPI.getVariableValue 'CORE_PROJECT_USE_ASSERT_DBG_STATE')}}
          #define USE_ASSERT_DBG_STATE
          {{/if}}
        </Pre_Include_Global_h>
        {{/if}}
      {{/if}}
      <files>
        {{#each files_array}}
        {{#unless (inArray gen_file @root.save_files)}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{~assign 'save_files' (helper_common_concatenate_elt_in_array gen_file @root.save_files)}}
        {{/unless}}
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
