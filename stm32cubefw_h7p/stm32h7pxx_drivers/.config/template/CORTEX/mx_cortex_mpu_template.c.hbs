system_status_t {{@root.fct_name}}_init(void)
{
  /* Disables the MPU */
  ARM_MPU_Disable();
      {{~#with Basic}}
        {{~#if MPUEnabled}}
          {{~assign 'found_region' false}}
          {{~#each Regions}}
            {{~#if use_region}}
              {{~#unless @root.found_region}}
                {{~assign 'found_region' true}}

  /*
     Initializes and configures the MPU Region
  */
              {{~/unless}}
              {{~assign 'disable_subregion' (helper_cortex_mpu_get_disable_subregion Subregions 'LL')}}


  ARM_MPU_SetRegionEx({{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}}, 0x{{#if (eq BaseAddress 0)}}00000000{{else}}{{uppercase (dec2hex BaseAddress)}}{{/if}},
                      ({{helper_cortex_mpu_get_arm_cmsis_value Size}} << MPU_RASR_SIZE_Pos)
                      | ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_' (concat Attributes.MemoryType (concat '_MEM_' (concat Attributes.Shareability (concat Attributes.WritePolicy Attributes.AllocationPolicy)))))}} &  (MPU_RASR_TEX_Msk | MPU_RASR_B_Msk | MPU_RASR_S_Msk | MPU_RASR_C_Msk))
                      | ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_REGION_' AccessPermission)}} << MPU_RASR_AP_Pos)
                      | ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_EXECUTION_ATTR_' InstructionAccess)}} << MPU_RASR_XN_Pos)
                      | (0x{{#if (eq BaseAddress 0)}}00{{else}}{{uppercase (dec2hex @root.disable_subregion)}}{{/if}} << MPU_RASR_SRD_Pos));


  STM32_WRITE_REG(MPU->RNR, {{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}});
  STM32_SET_BIT(MPU->RASR, MPU_RASR_ENABLE_Msk);
            {{~/if}}
          {{~/each}}


  /* Enables the MPU */
  ARM_MPU_Enable({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_HARDFAULT_NMI_' DuringHardfault)}} | {{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_ACCESS_FAULT_' DefaultMapEnabled)}});
        {{~/if}}
      {{~/with}}


  return SYSTEM_OK;
}

