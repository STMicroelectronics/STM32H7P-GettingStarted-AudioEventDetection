  * in the root directory of this software component.
  * If no LICENSE file comes with this software, it is provided AS-IS.
  *
~}}
{{#if (eq fct 'target_gethandle')}}
  {{! }}
  {{! Generate the GPIO getobject function section in mx_hal_def_template.h.hbs}}
  {{! > GPIO_HAL fct='target_gethandle'}}
  {{! }}
/* *********************************************************** */
/*        GPIO: aliases for get EXTI object functions */
/* *********************************************************** */
{{!}}
  {{~assign 'gpio_contexts' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:GPIO')~}}
  {{#each @root.gpio_contexts}}
    {{~assign 'gpio_context' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~log "GPIO_HAL_Partial (target_gethandle): gpio_context=" (toJSON @root.gpio_context)~}}
    {{#with @root.gpio_context}}
      {{~assign 'current_layer' info.layer}}
      {{#if (eq @root.current_layer 'HAL')}}
          {{#each pins}}
            {{~assign 'gpio_pin_user_labels' (JSONparse '[]')~}}
            {{~assign 'gpio_pin_labels' (JSONparse '[]')~}}
            {{~assign 'pin' (@root.pinoutAPI.getPinData _foreignKey)~}}
            {{#if basic.EnableEXTI}}
              {{~!}}{{!log "GPIO_HAL_Partial (target_gethandle): pin=" (toJSON @root.pin)~}}
              {{#if (and @root.pin.labels (gt (length @root.pin.labels) 0))}}
                {{~assign 'gpio_pin_user_labels' @root.pin.labels~}}
              {{/if}}
              {{#if (and label_name (gt (length label_name) 0))}}
                {{~assign 'gpio_pin_labels' label_name~}}
              {{/if}}
              {{~assign 'found_label' false~}}

/**
  * @brief  Get the EXTI handle for EXTI{{@root.pin.index}} used for {{@root.pin.name}}
  *         Name of the User label:
              {{#each @root.gpio_pin_user_labels}}
  *                   {{lowercase this}} (user label)
              {{/each}}
              {{#each @root.gpio_pin_labels}}
  *                   {{this}} (SW label)
              {{/each}}
  * @retval hal_exti_handle_t Pointer on the handle on the EXTI instance
  */
{{assign 'define' '#define'~}}
              {{#each @root.gpio_pin_user_labels}}
                {{#if (not @root.found_label)}}
                  {{~assign 'found_label' true~}}
                  {{~assign 'master' (lowercase this)~}}
{{@root.define}} {{@root.master}}_exti_gethandle   mx_gpio_exti{{@root.pin.index}}_gethandle
                {{else}}
{{@root.define}} {{lowercase this}}_exti_gethandle   {{@root.master}}_exti_gethandle
                {{/if}}{{!not @root.found_label~}}
              {{/each}}{{!@root.gpio_pin_user_labels~}}
              {{#each @root.gpio_pin_labels}}
                {{#if (not @root.found_label)}}
                  {{~assign 'found_label' true~}}
                  {{~assign 'master' (lowercase this)~}}
{{@root.define}} {{@root.master}}_exti_gethandle   mx_gpio_exti{{@root.pin.index}}_gethandle
                {{else}}
{{@root.define}} {{lowercase this}}_exti_gethandle   {{@root.master}}_exti_gethandle
{{!}}
                {{~/if}}{{!not @root.found_label~}}
              {{/each}}{{!@root.gpio_pin_labels~}}
            {{/if}}{{!basic.EnableEXTI~}}
          {{/each}}{{!pins~}}
      {{/if}}{{!eq @root.current_layer 'HAL'~}}
    {{/with}}{{!@root.gpio_context.settings.blocks}}
  {{/each}}{{!@root.gpio_contexts~}}
{{else if (eq fct 'init')}}
  {{! ~}}
  {{! Generate the GPIO init code in pppi_init function~}}
  {{! > GPIO_HAL fct='init' needs=this.needs resource='USART1'~}}
  {{! ~}}
  {{log "GPIO_HAL_partial: needs:" needs~}}
  {{! temporary helper in waiting for this one provided by tool~}}
  {{~assign 'gpio_configs' 'undefined'~}}
  {{~assign 'resource' resource~}}
  {{#each needs}}
    {{~assign 'getNeedById' (@root.pinoutAPI.getNeedById id)~}}
    {{!log "GPIO_HAL_Partial (init): getNeedById:" (toJSON @root.getNeedById)~}}
    {{~assign 'gpio_configs' (helper_gpio_get_gpioconfig_object @root.getNeedById @root.gpio_configs)~}}
  {{/each}}
  {{!log "GPIO_HAL_partial(init) gpio_configs:" @root.gpio_configs~}}
  {{assign 'found_signal' true~}}
  {{#each @root.gpio_configs.list_port}}
    {{~assign 'gpio_port' (append 'GPIO' this)~}}
    {{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.gpio_port}}
  {{/each}}

  {{~assign 'found_exti' false}}
  {{#each @root.gpio_configs.list_config_pins}}
    {{#if @root.found_signal}}
  hal_gpio_config_t  gpio_config;
      {{~assign 'found_signal' false}}
    {{/if}}

  /**
    {{@root.resource}} GPIO Configuration

    {{#if (and (gt (length pin) 0) (gt (length signalName) 0) (gt (length label_name) 0))}}
      {{~assign 'sw_labels_found' false~}}
      {{#each pin}}
        {{#if (and (not @root.sw_labels_found) (gt (length (lookup ../label_name @index)) 0))}}
          {{~assign 'sw_labels_found' true~}}
        {{/if}}
      {{/each}}
      {{#if @root.sw_labels_found}}
    [GPIO Pin] ------> [Signal Name] ------> [SW label(s)]
      {{else}}
    [GPIO Pin] ------> [Signal Name]
      {{/if}}

      {{#each pin}}
        {{#if (gt (length (lookup ../label_name @index)) 0)}}
       {{helper_gpio_add_pad_right (concat "P" ../port this) 4}}    ------>   {{lookup ../signalName @index}}   ------>  {{#each (lookup ../label_name @index)}}{{uppercase this}}{{#unless @last}}, {{/unless}}{{/each}}
        {{else}}
       {{helper_gpio_add_pad_right (concat "P" ../port this) 4}}    ------>   {{lookup ../signalName @index}}
        {{/if}}
      {{/each}}
    {{/if}}
    **/
  gpio_config.mode        = {{#if mode}}HAL_GPIO_MODE_{{mode}}{{else}}HAL_GPIO_MODE_ALTERNATE{{/if}};
    {{#if output_type}}
  gpio_config.output_type = HAL_GPIO_OUTPUT_{{output_type}};
    {{/if}}
    {{#if pull}}
  gpio_config.pull        = HAL_GPIO_PULL_{{pull}};
    {{/if}}
    {{#if speed}}
  gpio_config.speed       = HAL_GPIO_SPEED_FREQ_{{speed}};
    {{/if}}
    {{#unless (eq af undefined)}}
  gpio_config.alternate   = HAL_GPIO_AF_{{af}};
    {{/unless}}
    {{~assign 'gpio_pins' ''~}}
    {{~assign 'not_first_pin' false~}}
    {{#each pin}}
      {{#if @root.not_first_pin}}
        {{~assign 'gpio_pins' (append @root.gpio_pins ' | ')~}}
      {{/if}}
      {{~assign 'gpio_pin' (append 'HAL_GPIO_PIN_' this)~}}
      {{~assign 'gpio_pins' (append @root.gpio_pins @root.gpio_pin)~}}
      {{~assign 'not_first_pin' true~}}
    {{/each}}
  HAL_GPIO_Init(HAL_GPIO{{port}}, {{@root.gpio_pins}}, &gpio_config);

    {{#each exti_cfg}}
      {{#if exti_enabled}}
        {{~assign 'hal_gpio_port' port~}}
        {{~assign 'hal_gpio_pin' pin~}}
        {{#> EXTI fct='exti_gpio_init' layer=@root.current_layer needs=config.needs found_exti=@root.found_exti gpio_port=@root.hal_gpio_port gpio_pin=@root.hal_gpio_pin}}
        {{/EXTI}}
        {{! ~}}
        {{assign 'found_exti' true~}}
      {{/if}}
    {{/each}}
  {{/each}}
{{else if (eq fct 'deinit')}}
  {{! }}
  {{! Generate the GPIO deinit code in pppi_deinit function}}
  {{! }}
  {{! > GPIO_HAL fct='deinit' needs=needs resource='USART1'~}}
  {{! ~}}
  {{!log "GPIO_HAL_partial deinit: gpio_configs"~}}
  {{~assign 'gpio_configs' 'undefined'~}}
  {{~assign 'groupedPinsByPort' 'undefined'~}}
  {{~assign 'resource' resource~}}
  {{#each needs}}
    {{~assign 'getNeedById' (@root.pinoutAPI.getNeedById id)~}}
    {{!log "GPIO_HAL_Partial (init): getNeedById:" (toJSON @root.getNeedById)~}}
    {{~assign 'gpio_configs' (helper_gpio_get_gpioconfig_object @root.getNeedById @root.gpio_configs)~}}
    {{~assign 'groupedPinsByPort' (helper_gpio_group_pins_by_port @root.getNeedById @root.groupedPinsByPort)~}}
  {{/each}}
  /* De-initialize all GPIO pins associated with {{@root.resource}} */
  {{#each @root.groupedPinsByPort}}
  HAL_GPIO_DeInit(HAL_GPIO{{port}}, {{#each pins}}HAL_GPIO_PIN_{{this}}{{#unless @last}} | {{/unless}}{{/each}});

  {{/each}}
  {{#each @root.gpio_configs.list_config_pins}}
    {{#each exti_cfg}}
      {{#if exti_enabled}}
        {{~assign 'hal_gpio_port' port~}}
        {{~assign 'hal_gpio_pin' pin~}}
        {{> EXTI fct='exti_gpio_deinit' layer=@root.current_layer needs=config.needs gpio_port=@root.hal_gpio_port gpio_pin=@root.hal_gpio_pin}}
      {{/if}}
    {{/each}}
  {{/each}}
{{else if (eq fct 'gpio_exti_variables')}}
  {{! }}
  {{! Generate the handle for EXTI inside mx_pppi.c file}}
  {{! }}
  {{! > GPIO_HAL fct='gpio_exti_variables' resource=@root.current_resource~}}
  {{! ~}}
  {{log "GPIO_HAL_partial (gpio_exti_variables) gpio_exti_variables: resource" resource~}}
  {{~assign 'gpio_needs' (@root.pinoutAPI.getAllocatedResourceNeedsByHwInstance resource)~}}
  {{~assign 'gpio_configs' 'undefined'~}}
  {{#each @root.gpio_needs}}
    {{~assign 'getNeedById' (@root.pinoutAPI.getNeedById needId)~}}
    {{~assign 'gpio_configs' (helper_gpio_get_gpioconfig_object @root.getNeedById @root.gpio_configs)~}}
  {{/each}}
  {{#each @root.gpio_configs.list_config_pins}}
    {{#each exti_cfg}}
      {{~log "GPIO_HAL_partial (gpio_exti_variables) gpio_exti_variables: exti_cfg" this~}}
      {{#if exti_enabled}}
        {{~assign 'list_exti' (JSONparse '[]')~}}
        {{#each config.needs}}
          {{~assign 'get_exti_cfg' (@root.ExtiAPI.getNeedById id)~}}
          {{~log "GPIO_HAL_partial (gpio_exti_variables) get_exti_cfg: " @root.get_exti_cfg~}}
          {{~assign 'list_exti' (helper_common_concatenate_elt_in_array @root.get_exti_cfg.resourceId @root.list_exti )}}
          {{~log "GPIO_HAL_partial (gpio_exti_variables) list_exti: " @root.list_exti~}}
        {{/each}}
{{> EXTI fct='exti_gpio_variables' layer='HAL' exti_list=@root.list_exti}}
      {{/if}}
    {{/each}}
  {{/each}}
{{else if (eq fct 'generate_labels')}}
  {{! }}
  {{! Generate HAL defines for GPIO labels inside mx_pppi.h file}}
  {{! }}
  {{! > GPIO_HAL fct='generate_labels' needs=@root.gpio_needs~}}
  {{! ~}}
  {{~assign 'gpio_configs' 'undefined'~}}
  {{#each needs}}
    {{~assign 'getNeedById' (@root.pinoutAPI.getNeedById id)~}}
    {{~assign 'gpio_configs' (helper_gpio_get_gpioconfig_object @root.getNeedById @root.gpio_configs)~}}
  {{/each}}
{{#each @root.gpio_configs.list_config_pins as |config|}}
  {{#each config.pin as |pinValue pinIdx|}}
    {{~assign 'define' '#define'~}}
    {{~assign 'aliases' (helper_gpio_create_aliases
      (lookup config.userLabels pinIdx)
      (lookup config.label_name pinIdx)
    )~}}

/* Primary aliases for GPIO P{{config.port}}{{pinValue}} pin */
    {{#if @root.aliases.master_label}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PORT") 47}} HAL_GPIO{{config.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PIN") 47}} HAL_GPIO_PIN_{{pinValue}}

    {{/if}}
    {{#if (gt (length @root.aliases.other_labels) 0)}}
/* Secondary aliases for GPIO P{{config.port}}{{pinValue}} pin */
      {{#each @root.aliases.other_labels as |label|}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase label) "_GPIO_PORT") 47}} HAL_GPIO{{config.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase label) "_GPIO_PIN") 47}} HAL_GPIO_PIN_{{pinValue}}

      {{/each}}
      {{#with (lookup config.exti_cfg pinIdx) as |exti|}}
        {{#if exti.exti_enabled}}
{{> EXTI fct='exti_gpio_generate_aliases' layer='HAL' needs=config.extiConfig.needs}}
        {{/if}}
      {{/with}}
    {{/if}}
  {{/each}}
{{/each}}
{{else}}
#warning "Step '{{fct}}' not present in partial GPIO_HAL_partial.hbs"
{{/if}}