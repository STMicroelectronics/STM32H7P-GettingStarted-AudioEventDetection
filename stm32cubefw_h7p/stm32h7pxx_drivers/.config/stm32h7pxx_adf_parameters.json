{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:ADF",
  "grammarVersion": "3.1",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "title": "SW Component not implemented",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "default": "This driver configuration is not implemented yet."
            }
          }
        },
        "System": {
          "type": "object",
          "description": "ADF Global Configuration Structure definition.",
          "properties": {
            "gpio": {
              "type": "object",
              "objectType": "need.pinout.signals",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "CCK0"
                },
                {
                  "selector": "CCK1"
                },
                {
                  "selector": "SDI0"
                }
              ]
            }
          }
        }
      }
    }
  }
}
