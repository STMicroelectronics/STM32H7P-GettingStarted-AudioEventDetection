{{~log "PWR_LL_partial generation started"~}}
{{~log "PWR root="@root~}}
{{~helper_pwr_globalize_API @root~}}
{{~assign 'context' (helper_pwr_get_context 'STMicroelectronics::Device:STM32CubeMX2 Config:PWR')~}}
{{~log "PWR_LL_partial generate_main_supply_config: context="@root.context~}}
{{!
 * @file Partial used to generate LL code for PWR:
 * @author GPM Application Team
 * @license
 * Copyright (c) 2025 STMicroelectronics.
 * All rights reserved.
 *
 * This software is licensed under terms that can be found in the LICENSE file
 * in the root directory of this software component.
 * If no LICENSE file comes with this software, it is provided AS-IS.
 *
 *
 * how to use
 * > PWR_LL fct='xxxx' with xxxx:
 *   * generate_main_supply_config
 *   * generate_vos_config
 *   * generate_write_protection_disable
 *   * generate_write_protection_enable
 *   * generate_pull_standby periph="[I3C, XSPI]" gpio="PXXX"(e.g PA1 PC12) pull="[PULL_NO, PULL_UP, PULL_DOWN]"
 *   * exported_functions_init
 *   * exported_functions_deinit
~}}
{{!
############################
##  exported_variables
############################
~}}
{{! Get @root.optim_enable ~}}
{{> SYSTEM fct='system_check_ll_optim'}}
{{!assign 'optim_enable' true~}}
{{! Initialize the context for LL code optimization ~}}
{{~assign 'lut_table'   (helper_pwr_get_lut_table 'V1')~}}
{{~helper_common_initialize_ll_code @root.optim_enable @root.lut_table 'undefined'~}}
{{#if (eq fct 'generate_main_supply_config')}}
{{!
 Generate the PWR LL code to configure the main supply
~}}
{{~log "PWR_LL_partial generate_main_supply_config: supply="@root.context.Additional_configuration.Main_supply_configuration.MCU_main_supply~}}
  {{#if @root.context.Additional_configuration.Main_supply_configuration.MCU_main_supply}}
  /* Configure the Power Supply source */
    {{#if (eq @root.context.Additional_configuration.Main_supply_configuration.MCU_main_supply 'BYPASSED')}}
  LL_PWR_EnableBypass();
    {{/if}}
    {{#if (eq @root.context.Additional_configuration.Main_supply_configuration.MCU_main_supply 'NOT_BYPASSED')}}
  LL_PWR_EnableInternalRegulator();
    {{/if}}
  {{/if}}
{{else if (eq fct 'generate_vos_config')~}}
{{!
 Generate the PWR LL code to configure the voltage scaling
~}}
  {{#with @root.context}}
    {{#with Additional_configuration}}
      {{#with Main_supply_configuration}}
        {{~log "PWR_LL_partial generate_vos_config: context="@root.context.Additional_configuration.Main_supply_configuration.Voltage_scaling~}}
        {{#if Voltage_scaling}}
  /* Configure the Voltage scaling level */
  {{helper_common_gen_ll_code 'LL_PWR_SetRegulatorVoltageScaling' (concat 'LL_PWR_REGU_' Voltage_scaling)}}
          {{#if (not (eq MCU_main_supply 'BYPASSED'))}}
  /* Poll on VOS ready and Active VOS ready flag to reach correct voltage */
  while((LL_PWR_IsActiveFlag_VOS() == 0)||(LL_PWR_IsActiveFlag_ACTVOS() == 0));
          {{/if}}
        {{/if}}
      {{/with}}
    {{/with}}
  {{/with}}
{{else if (eq fct 'generate_write_protection_disable')}}
{{!
 Generate the PWR LL code to disable the RTC/Backup Domain Write protection
}}
  /* Disable Backup Domain Write Protection */
  LL_PWR_DisableBackupDomainWriteProtection();
{{else if (eq fct 'generate_write_protection_enable')}}
{{!
 Generate the PWR LL code to enable the RTC/Backup Domain Write protection
}}
  /* Enable Backup Domain Write Protection */
  LL_PWR_EnableBackupDomainWriteProtection();
{{else if (eq fct 'generate_pull_standby')}}
{{! > PWR_LL fct='generate_pull_standby' periph="[I3C, XSPI]" gpio="PXXX"(e.g PA1 PC12) pull="[PULL_NO, PULL_UP, PULL_DOWN]"}}
{{!
 Generate the PWR HAL code to configure pull of a specific GPIO during standby
~}}
  {{~log "PWR_LL_partial generate_pull_standby input periph ="periph}}
  {{~log "PWR_LL_partial generate_pull_standby input gpio  ="gpio}}
  {{~log "PWR_LL_partial generate_pull_standby input pull ="pull}}
  /* Set GPIO {{gpio}} for peripheral {{periph}} in {{pull}} config, effective only after LL_PWR_EnablePUPDConfig call */
  {{#if (eq periph 'I3C')}}
    {{#if (eq pull 'PULL_NO')}}
  LL_PWR_DisableI3CPullUp(LL_PWR_I3C_PULLUP_{{gpio}});
    {{else if (eq pull 'PULL_UP')}}
  LL_PWR_EnableI3CPullUp(LL_PWR_I3C_PULLUP_{{gpio}});
    {{/if}}
  {{/if}}
  {{#if (eq periph 'XSPI')}}
    {{#if (eq pull 'PULL_NO')}}
  LL_PWR_DisableXSPIPullUp(LL_PWR_XSPI_PULLUP_{{gpio}});
  LL_PWR_DisableXSPIPullDown(LL_PWR_XSPI_PULLUP_{{gpio}});
    {{else if (eq pull 'PULL_UP')}}
  LL_PWR_EnableXSPIPullUp(LL_PWR_XSPI_PULLUP_{{gpio}});
  LL_PWR_DisableXSPIPullDown(LL_PWR_XSPI_PULLUP_{{gpio}});
    {{else if (eq pull 'PULL_DOWN')}}
  LL_PWR_DisableXSPIPullUp(LL_PWR_XSPI_PULLUP_{{gpio}});
  LL_PWR_EnableXSPIPullDown(LL_PWR_XSPI_PULLUP_{{gpio}});
    {{/if}}
  {{/if}}
{{else if (eq fct 'exported_functions_init')}}
{{!
    Generation of initialization function used in LL
}}
system_status_t {{@root.pwr_root_fct_name}}_init(void)
{
  {{#if (length @root.pins_configs)}}
    {{~assign "wkup_pin_conc_max" (helper_pwr_get_max_wakeup_settings_pin_num @root.pins_configs)~}}
    {{#if (gt @root.wkup_pin_conc_max 1)}}
{{! Content to display if length > 1, initialize parameters for wkuppin management~}}
      {{~assign "wkup_pin_init" (helper_pwr_get_ll_wkup_pin_codegen_init 'H7P')~}}
      {{{@root.wkup_pin_init}}}
    {{else}}
{{! nothing to display if length <= 1~}}
    {{/if}}
  {{/if}}
  {{#with Additional_configuration}}
    {{#unless (eq @root.gpio_needs 'undefined')}}
  /****************************************************************************/
  /* GPIO Configuration                                                       */
  /****************************************************************************/
      {{#> GPIO_LL fct='init' needs=@root.gpio_needs resource=@root.current_resource}}
      {{/GPIO_LL}}
    {{/unless}}
    {{#with Main_supply_configuration}}
      {{#if Stop_Voltage_scaling}}
  /****************************************************************************/
  /* Main supply configuration                                                */
  /****************************************************************************/
  /* Stop Voltage scaling configuration */
  {{helper_common_gen_ll_code  'LL_PWR_SetStopRegulatorVoltageScaling' (concat 'LL_PWR_REGU_STOP_' Stop_Voltage_scaling)}};
      {{/if}}
    {{/with}}
    {{#with Voltage_detection_configuration}}
      {{#if Pvd_configuration.enable}}
  /****************************************************************************/
  /* Configuration of PVD (Programmable Voltage Detector)                     */
  /****************************************************************************/
        {{#with Pvd_configuration}}
          {{#if level_selection}}
  /* Configure PVD Level */
  {{helper_common_gen_ll_code 'LL_PWR_SetPVDLevel' (concat 'LL_PWR_PVD' level_selection)}}
          {{/if}}
  /* Enable PVD */
  LL_PWR_EnablePVD();
          {{#if (eq enableEXTI true)}}

  /* Configure PVD EXTI Line */
            {{#> EXTI fct='exti_init' layer=@root.current_layer needs=@root.pvd_exti_needs exti_line=0}}
            {{/EXTI}}
          {{/if}}
        {{/with}}
      {{/if}}
      {{#if Avd_configuration.enable}}

  /****************************************************************************/
  /* Configuration of AVD (Analog Voltage Detector)                           */
  /****************************************************************************/
        {{#with Avd_configuration}}
          {{#if level_selection}}
  /* Configure AVD Level */
  {{helper_common_gen_ll_code 'LL_PWR_SetAVDLevel' (concat 'LL_PWR_AVD' level_selection)}}
          {{/if}}
  /* Enable AVD */
  LL_PWR_EnableAVD();
          {{#if (eq enableEXTI true)}}

  /* Configure AVD EXTI Line */
            {{#> EXTI fct='exti_init' layer=@root.current_layer needs=@root.avd_exti_needs exti_line=0}}
            {{/EXTI}}
          {{/if}}
        {{/with}}
      {{/if}}
      {{#if (eq enableEXTI true)}}
  /* Configure PVD/AVD EXTI Line */
        {{#> EXTI fct='exti_init' layer=@root.current_layer needs=@root.pvd_avd_exti_needs exti_line=16}}
        {{/EXTI}}
      {{/if}}
      {{#if Temperature_vbat_monitoring.enable}}

  /****************************************************************************/
  /* Configuration of VBAT/Temp monitor                                       */
  /****************************************************************************/
        {{#> PWR_LL fct='generate_write_protection_disable'}}
        {{/PWR_LL}}

  /* Enable VBAT/Temp monitoring */
  LL_PWR_EnableMonitoring();

        {{#> PWR_LL fct='generate_write_protection_enable'}}
        {{/PWR_LL}}
      {{/if}}
      {{#if Temperature_vdd_monitoring.enable}}

  /****************************************************************************/
  /* Configuration of VDD/Temp monitor                                        */
  /****************************************************************************/
        {{#> PWR_LL fct='generate_write_protection_disable'}}
        {{/PWR_LL}}

  /* Enable VDD/Temp monitoring */
  LL_PWR_EnableTemperatureVddMonitor();

        {{#> PWR_LL fct='generate_write_protection_enable'}}
        {{/PWR_LL}}
      {{/if}}
    {{/with}}
    {{#with Ram_configuration}}
      {{#if (length @root.sram_configs)}}
  /****************************************************************************/
  /* Configuration of RAM retention                                           */
  /****************************************************************************/
  /* By default, all RAM retention is enabled */
        {{#each @root.sram_configs}}
          {{#unless pageStatus}}
            {{#if fullretention}}
  /* For {{sram}} in {{mode}} mode, memory retention is disabled */
  LL_PWR_DisableMemoryStopRetention(LL_PWR_{{sram}}_{{mode}}_RETENTION);

            {{else}}
              {{#if pageDefinesStr}}
                {{#if enabledPagesStr}}
  /* For {{sram}} in {{mode}} mode, retention is enabled only for pages {{enabledPagesStr}} */
                {{else}}
  /* For {{sram}} in {{mode}} mode, memory retention is disabled on all pages */
                {{/if}}
  uint32_t pages = {{pageDefinesStr}};
  LL_PWR_Disable{{sram}}PagesStopRetention(pages);
              {{/if}}
            {{/if}}
          {{/unless}}
        {{/each}}
      {{/if}}
    {{/with}}
    {{#if Flash_lowpower_configuration.enableFLASHLowPowerMode}}

  /****************************************************************************/
  /* Configuration of FLASH low power mode                                    */
  /****************************************************************************/
  LL_PWR_EnableFlashLowPWRMode();
    {{/if}}
    {{#if NVM_lowpower_configuration.enableNVMLowPowerMode}}

  /****************************************************************************/
  /* Configuration of NVM low power mode                                      */
  /****************************************************************************/
  LL_PWR_EnableNVMLowPWRMode();
    {{/if}}
    {{#if (or (eq Battery_configuration.batteryChargingResistorSelection '1_5K') (eq Battery_configuration.enableBatteryCharging true))}}

  /****************************************************************************/
  /* Configuration of the Battery Charging management                         */
  /****************************************************************************/
  /* Configure Battery charging resistor value */
  {{helper_common_gen_ll_code 'LL_PWR_SetBattChargResistor' (concat 'LL_PWR_BATT_CHARG_RESISTOR_' Battery_configuration.batteryChargingResistorSelection)}};
      {{#if Battery_configuration.enableBatteryCharging}}
  /* Enable Battery charging */
  LL_PWR_EnableBatteryCharging();
      {{/if}}
    {{/if}}
    {{#if (or (eq UCPD_configuration.enableDeadBatteryMode true) (eq UCPD_configuration.enableUCPDConfigRetention true))}}
      {{#with UCPD_configuration}}

  /****************************************************************************/
  /* Configuration of the UCPD (USB Type-C and Power Delivery) PWR features   */
  /****************************************************************************/
        {{#if enableDeadBatteryMode}}
  /* Enable Dead Battery mode */
  LL_PWR_EnableUCPDDeadBattery();
        {{/if}}
        {{#if enableUCPDConfigRetention}}
  /* Enable UCPD configuration retention in Standby Mode */
  LL_PWR_EnableUCPDRetentionStandbyMode();
        {{/if}}
      {{/with}}
    {{/if}}
    {{~assign 'enabled_pins' ''~}}
    {{#with Wakeup_pins_configuration}}
        {{~assign 'pull_availability' (helper_pwr_pull_or_source @root.pins_configs)~}}
        {{~helper_pwr_breakpoint (length @root.pins_configs) @root~}}
        {{#if (length @root.pins_configs)}}

  /****************************************************************************/
  /* Wakeup Pins Configurations                                               */
  /****************************************************************************/
          {{~helper_pwr_breakpoint @root.pull_availability @root}}
          {{#each @root.pins_configs}}
            {{#if (gt pinsnum 1)}}
  {{! Content to display if length > 1, pins concanated management }}
              {{#if @root.pull_availability}}
  /* Configuration of selected Wakeup pins with pull {{pull}} and {{polarity}} polarity */
                {{~assign 'pull_core_code' (helper_pwr_get_ll_wkup_pin_codegen_core 'H7P' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity) (concat 'LL_PWR_WAKEUP_PIN_PULL_' pull))}}
              {{else}}
  /* Configuration of selected Wakeup pins with {{source}} and {{polarity}} polarity */
                {{~assign 'pull_core_code' (helper_pwr_get_ll_wkup_pin_codegen_core 'H7P' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity) '' (concat 'LL_PWR_WAKEUP_PIN_SELECTION_' source))}}
              {{/if~}}
              {{{@root.pull_core_code}}}

            {{else}}
  {{! content to display if length <= 1, pins not concanated management }}
              {{#if @root.pull_availability}}
  /* Configuration of selected Wakeup pins with pull {{pull}} and {{polarity}} polarity */
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPolarity' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPull' pins (concat 'LL_PWR_WAKEUP_PIN_PULL_' pull)}}

              {{else}}
  /* Configuration of selected Wakeup pins with {{source}} and {{polarity}} polarity    */
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPolarity' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeupPinSelection'pins (concat 'LL_PWR_WAKEUP_PIN_SELECTION_' source)}}

              {{/if}}
            {{/if}}
            {{~assign 'enabled_pins' (helper_pwr_concatenate_pins pins @root.enabled_pins)~}}
          {{/each}}
          {{~assign 'enabled_pins' (helper_pwr_reorder_pins @root.enabled_pins)~}}
        {{/if}}
      {{#unless (eq @root.enabled_pins '')}}
  /****************************************************************************/
  /* Enable all configured Wakeup Pins                                        */
  /****************************************************************************/
  LL_PWR_EnableWakeUpPin({{@root.enabled_pins}});

      {{/unless}}
  return SYSTEM_OK;
    {{/with}}
  {{/with}}
}

{{!
############################
##  exported_functions_Deinit
############################
~}}
{{else if (eq fct 'exported_functions_deinit')}}
system_status_t {{@root.pwr_root_fct_name}}_deinit(void)
{
  {{#with Additional_configuration}}
    {{#with Status_pins_configuration}}
      {{#unless (eq @root.gpio_needs 'undefined')}}
  /****************************************************************************/
  /* Status pin GPIO Deinitialization                                         */
  /****************************************************************************/
        {{#> GPIO_LL fct='deinit' needs=@root.gpio_needs resource=@root.current_resource}}
        {{/GPIO_LL}}
      {{/unless}}
    {{/with}}
    {{#unless (eq @root.enabled_pins '')}}
  /****************************************************************************/
  /* Disable all configured Wakeup Pins                                       */
  /****************************************************************************/
  LL_PWR_DisableWakeUpPin({{@root.enabled_pins}});

    {{/unless}}
    {{#with Voltage_detection_configuration}}
      {{#if Pvd_configuration.enable}}
        {{#if (eq Pvd_configuration.enableEXTI true)}}
  /* Deinit PVD EXTI Line */
          {{#> EXTI fct='exti_deinit' layer=@root.current_layer needs=@root.pvd_exti_needs exti_line=0}}
          {{/EXTI}}
        {{/if}}
      {{/if}}
      {{#if Avd_configuration.enable}}
        {{#if (eq Avd_configuration.enableEXTI true)}}
  /* Deinit AVD EXTI Line */
          {{#> EXTI fct='exti_deinit' layer=@root.current_layer needs=@root.avd_exti_needs exti_line=0}}
          {{/EXTI}}
        {{/if}}
      {{/if}}
      {{#if (eq enableEXTI true)}}
  /* Deinit PVD/AVD EXTI Line */
        {{#> EXTI fct='exti_deinit' layer=@root.current_layer needs=@root.pvd_avd_exti_needs exti_line=16}}
        {{/EXTI}}
      {{/if}}
    {{/with}}
  {{/with}}
  return SYSTEM_OK;
}

{{else}}
{{!
 Default case which should not occur
~}}
#warning "Function {{fct}} not present in partial PWR_LL_partial.hbs"
{{/if}}