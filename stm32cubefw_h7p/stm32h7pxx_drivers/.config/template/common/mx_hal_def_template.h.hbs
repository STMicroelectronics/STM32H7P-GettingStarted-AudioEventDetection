/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_HAL_DEF_H
#define MX_HAL_DEF_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{!Manage LL inclusion model if 1 component used LL~}}
#include "stm32_hal.h"
{{#each @root.object_cxt.includes}}
#include "mx_{{lowercase this}}.h"
{{/each}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{assign 'display_instance' ''~}}
{{#each @root.object_cxt.periphs}}
  {{#unless (occurrences  resource 'gpio')}}
    {{#if (eq layer 'LL')}}
      {{#if (length labels)}}
        {{#unless (eq @root.display_instance resource_inst)}}
  /* ***********************************************************
                Aliases to {{resource_inst}} used in LL
    *********************************************************** */
          {{~assign 'display_instance' resource_inst}}
        {{/unless}}
        {{#each labels}}
#define {{this}}  {{../resource}}
        {{/each}}

      {{else}}
  /* *************************************************************
    {{resource_inst}} (LL): No software label has been defined for this peripheral instance
      in the STM32CubeMX2 configuration panel.
      As a result, no aliases are generated for CMSIS instance
    ************************************************************* */

      {{/if}}
    {{/if}}
  {{/unless}}
{{/each}}
/* Exported macros -----------------------------------------------------------*/

/* ########### Aliases to initialization functions ########### */

{{assign 'display_instance' 0~}}
{{#each @root.object_cxt.periphs}}
{{#if (length labels)}}
{{#unless (eq @root.display_instance resource_inst)}}
  /* ***********************************************************
      {{resource_inst}}: aliases for initialization functions
    *********************************************************** */

{{assign 'display_instance' resource_inst~}}
{{/unless}}
/**
  * @brief  Initialize the {{fct_name}} with {{layer}} layer
  *         Name of the User label:
{{#each labels}}
  *                   {{this}}
{{/each}}
{{#if cfg_name}}
  *         Name of the Config label:
  *                   {{cfg_name}}
{{/if}}
{{#if (and (eq layer 'HAL') (not (eq fct_name_gethandle '')))}}
  * @retval hal_{{lowercase component}}_handle_t Pointer on the handle on the {{resource}} instance
{{else if (and (eq layer 'HAL') (eq fct_name_gethandle ''))}}
  * @retval system_status_t Value based on the system_status_t
{{else}}
  * @retval {{resource}} Pointer on the {{resource}}
{{/if}}
  */
{{#each fct_name_aliases}}
#define {{this}}_init {{../fct_name}}_init

{{/each}}
{{else}}
  /* *************************************************************
    {{resource_inst}}: No software label has been defined for this peripheral instance
      in the STM32CubeMX2 configuration panel.
      As a result, no aliases are generated for {{fct_name}}_init
    ************************************************************* */

{{/if}}
{{/each}}
/* ########################################################### */

/* ########### Aliases to De-Initialization functions ########### */

{{assign 'display_instance' 0~}}
{{#each @root.object_cxt.periphs}}
{{#unless (eq resource 'RCC')}}
{{#if (length labels)}}
{{#unless (eq @root.display_instance resource_inst)}}
  /* ***********************************************************
      {{resource_inst}}: aliases for De-Initialization functions
    *********************************************************** */

{{assign 'display_instance' resource_inst~}}
{{/unless}}
/**
  * @brief  De-Initialize the {{fct_name}} with {{layer}} layer
  *         Name of the User label:
{{#each labels}}
  *                   {{this}}
{{/each}}
{{#if cfg_name}}
  *         Name of the Config label:
  *                   {{cfg_name}}
{{/if}}
  */
{{#each fct_name_aliases}}
#define {{this}}_deinit {{../fct_name}}_deinit

{{/each}}
{{else}}
  /* *************************************************************
    {{resource_inst}}: No software label has been defined for this peripheral instance
      in the STM32CubeMX2 configuration panel.
      As a result, no aliases are generated for {{fct_name}}_deinit
    ************************************************************* */

{{/if}}
{{/unless}}
{{/each}}
/* ########################################################### */

/* ########### Aliases to get HAL handle functions ########### */

{{> GPIO_HAL fct='target_gethandle'}}
{{assign 'display_instance' 0~}}
{{#each @root.object_cxt.periphs}}
  {{#if (eq layer 'HAL')}}
    {{#unless (eq fct_name_gethandle '')}}
      {{#if (length labels)}}
      {{#unless (eq @root.display_instance resource_inst)}}
  /* ***********************************************************
      {{resource_inst}}: aliases for get handle functions
    *********************************************************** */
        {{~assign 'display_instance' resource_inst~}}

      {{/unless}}
/**
  * @brief  Get the HAL handle for {{resource}}
  *         Name of the User label:
      {{#each labels}}
  *                   {{this}}
      {{/each}}
  * @retval hal_{{lowercase component}}_handle_t Pointer on the handle on the {{resource}} instance
  */
      {{#each labels}}
#define {{lowercase this}}_gethandle {{../fct_name_gethandle}}_gethandle

      {{/each}}
    {{else}}
  /* *************************************************************
    {{resource_inst}}: No software label has been defined for this peripheral instance
      in the STM32CubeMX2 configuration panel.
      As a result, no aliases are generated for {{fct_name}}_gethandle
    ************************************************************* */

      {{/if}}
    {{/unless}}
  {{/if}}
{{/each}}
/* ########################################################### */

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_HAL_DEF_H */
