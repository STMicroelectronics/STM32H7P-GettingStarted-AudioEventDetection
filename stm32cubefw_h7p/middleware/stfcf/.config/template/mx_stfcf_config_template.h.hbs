#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

#ifndef MX_STFCF_CONFIG_H
#define MX_STFCF_CONFIG_H

/* Includes ------------------------------------------------------------------*/
#include "mx_mbedtls_config.h"
#include "mx_mbedtls_alt_config.h"
{{#with extended_config.kwe_config~}}
{{#if (or kwe_driver_enabled
          psa_kwe_driver_enabled )}}
#include "mx_kwe_config.h"
{{/if}}
{{/with}}
{{#with extended_config.its_config~}}
{{#if its_driver_enabled }}
#include "mx_its_config.h"
{{else}}
/* #include "mx_its_config.h" */
{{/if}}
{{/with~}}
#if defined(STFCF_USER_CONFIG_FILE)
#include STFCF_USER_CONFIG_FILE
#endif /* STFCF_DEFAULT_CONFIG_FILE */

{{#with extended_config.kwe_config~}}
{{#if (or kwe_driver_enabled
          psa_kwe_driver_enabled )}}
#define MBEDTLS_ALLOW_PRIVATE_ACCESS
#include "kwe_psa_driver_key_management.h"
/* Exported constants --------------------------------------------------------*/
#define STFCF_KEY_LOCATION PSA_CRYPTO_KWE_DRIVER_LOCATION
{{else}}
/* Exported constants --------------------------------------------------------*/
#define STFCF_KEY_LOCATION PSA_KEY_LOCATION_LOCAL_STORAGE
{{/if}}
{{/with}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_STFCF_CONFIG_H */
{{/with}}
