{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:VREFBUF",
  "grammarVersion": "3.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "info": {
          "type": "object",
          "title": "Software information",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_VREFBUF_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "resource initialization code generation",
              "description": "generate or not the VREFBUF init code, call it or not at boot",
              "$comment": "generate the init code of your VREFBUF or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },
        "hal_vrefbuf_config_t": {
          "type": "object",
          "title": "VREFBUF instance configuration",
          "properties": {
            "mode": {
              "type": "string",
              "description": "HAL VREFBUF mode definition.",
              "default": "INT_VOLTAGE_REF",
              "oneOf": [
                {
                  "title": "external voltage reference mode",
                  "const": "EXT_VOLTAGE_REF"
                },
                {
                  "title": "internal voltage reference mode",
                  "const": "INT_VOLTAGE_REF"
                },
                {
                  "title": "hold mode",
                  "const": "HOLD"
                }
              ]
            },
            "voltage_scale": {
              "type": "string",
              "description": "VREFBUF voltage scale definition.",
              "default": "2_9V",
              "oneOf": [
                {
                  "title": "2900 mV",
                  "const": "2_9V"
                },
                {
                  "title": "2500 mV",
                  "const": "2_5V"
                },
                {
                  "title": "2048 mV",
                  "const": "2_048V"
                },
                {
                  "title": "1800 mV",
                  "const": "1_8V"
                }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "$hal_vrefbuf_config_t.mode === 'EXT_VOLTAGE_REF' || $hal_vrefbuf_config_t.mode === 'HOLD'",
                  "message": "enable internal voltage reference mode"
                }
              ]
            }
          }
        }
      }
    }
  }
}