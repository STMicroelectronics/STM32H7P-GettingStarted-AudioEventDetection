  {{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
#include "mx_def.h"
{{else}}
#include "stm32_hal.h"
#include "mx_def.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{#if (eq @root.strategy "SW")}}
{{~assign 'pwr_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{~assign 'current_layer' @root.pwr_cxt.info.layer~}}
{{else}}
{{~assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{#each @root.instances}}
  {{#if (eq @root.strategy "SW")}}
    {{~assign 'pwr_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
    {{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
    {{~assign 'current_layer' @root.pwr_cxt.info.layer~}}
  {{else}}
    {{~assign 'current_layer' info.layer~}}
  {{/if}}
/******************************************************************************/
/* Exported functions for PWR in {{@root.current_layer}} layer */
/******************************************************************************/
  {{~assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
