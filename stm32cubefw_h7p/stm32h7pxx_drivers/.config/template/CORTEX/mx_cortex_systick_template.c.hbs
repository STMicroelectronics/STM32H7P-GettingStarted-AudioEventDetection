  HAL_CORTEX_SYSTICK_SetClkSource(HAL_CORTEX_SYSTICK_CLKSOURCE_{{Basic.ClockSource}});

  /* Setup the 1ms HAL timebase */
  HAL_InitTick(HAL_TICK_FREQ_{{Basic.TickFrequency}}, uwTickPrio);
      {{/if}}

  return SYSTEM_OK;
}

