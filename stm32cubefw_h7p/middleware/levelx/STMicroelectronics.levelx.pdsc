<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xmlns:stm32="https://stm32cube.st.com/schemas/stm32cube/1.0.0" schemaVersion="1.7.44" xs:noNamespaceSchemaLocation="PACK.xsd" xs:schemaLocation="https://stm32cube.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd" Dvendor="STMicroelectronics:13" Dname="STM32*">
  <vendor>STMicroelectronics</vendor>
  <name>levelx</name>
  <environments>
    <environment name="STM32Cube">
      <stm32:pack type="MW" friendlyName="levelx" shortDesc="levelx middleware">
        <relocation-info parent="middleware" layer="" element=""/>
      </stm32:pack>
    </environment>
  </environments>
  <ECCN>
    <ECCN-EU>NEC</ECCN-EU>
    <ECCN-US>5D992.c</ECCN-US>
  </ECCN>
  <description>alpha version of cube2 levelx pack</description>
  <repository type="git">https://codex.cro.st.com/plugins/git/stm32cube/mw/levelx</repository>
  <url>https://artifactory.st.com/artifactory/mcdc2embsw-mcd-cube2-packs-prod-local/STMicroelectronics.levelx/</url>
  <license>LICENSE.md</license>
  <releases>
    <release date="2025-10-10" version="0.7.0">
       Add Interface configuration panel for W25N01GVXX and MX66UW1G45G parts
       Add changelog reference check in pdsc to avoid missing release notes
       Add MX66UW1G45G nor polling interface component
       Add W25Q128J nor interface components
    </release>
    <release date="2025-08-18" version="0.6.0">
       Add some metadata into LevelX pack to help pack relocation into IDE project structure
       Update MX25LM51245G nor interfaces
       Add W25N01GVXX nand interface components
       Add a memory open check in the user NOR and NAND APIs to prevent unexpected behavior after flash memory closure
       Rename generator into levelx_mx2codegen
    </release>
    <release date="2025-05-30" version="0.5.0">
       Support CodeGen new grammar 3.1
       Update .json file
       Add mx_levelx_app.c/.h hbs template files
       Update MX25LM51245G and MX66LM1G45G nor interfaces
       Update CMakeLists.txt
    </release>
    <release date="2025-04-28" version="0.4.0">
       Update pack and gpdsc naming
       Update MX25LM51245G and MX66LM1G45G nor interfaces to use memory mapped base address getter function
       CodeGen update: Add Main and Applicative configuration panels and implement progressive view
       Remove double quotes from .bat/.sh scripts
    </release>
    <release date="2025-03-24" version="0.3.1">
       Minor update in PDSC file: using the new version format and adding ECCN
    </release>
    <release date="2025-02-24" version="0.3.0+pack.6.4.1">
       Add .config folder with configuration parameters files: json and hbs files
       Update the declaration of user-friendly name components and entry points
       Add MX25LM51245G nor interface components
       Add MX66LM1G45G nor interface components
    </release>
    <release date="2024-10-21" version="0.2.0+pack.6.4.1">
       Implement RTOS agnostic support features
       Add port files with RTOS and NO RTOS conditions
    </release>
    <release date="2024-09-05" version="0.1.0+pack.6.4.1">
       First LevelX pack alpha version based on the 6.4.1 Release
    </release>
  </releases>
  <changelogs>
    <changelog id="Release Notes" name="st_readme.txt"/>
  </changelogs>
  <keywords>
    <keyword>Cortex-M</keyword>
    <keyword>STMicroelectronics</keyword>
    <keyword>levelX</keyword>
    <keyword>STM32</keyword>
  </keywords>
  <conditions>
    <condition id="Use NOR Flash Core">
      <description>LevelX NOR Flash Core dependency</description>
    </condition>
    <condition id="Use NAND Flash Core">
      <description>LevelX NAND Flash Core dependency</description>
    </condition>
    <condition id="LX NOR Flash Core condition">
      <description>LX NOR Flash Core dependency</description>
      <require Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core"/>
    </condition>
    <condition id="LX MX25LM51245G condition">
      <description>LX MX25LM51245G interface dependency</description>
      <require Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core"/>
      <require Cclass="Board Part" Cgroup="Memory" Csub="MX25LM51245G Core"/>
    </condition>
    <condition id="LX MX66LM1G45G condition">
      <description>LX MX66LM1G45G interface dependency</description>
      <require Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core"/>
      <require Cclass="Board Part" Cgroup="Memory" Csub="MX66LM1G45G Core"/>
    </condition>
    <condition id="LX W25Q128J condition">
      <description>LX W25Q128J interface dependency</description>
      <require Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core"/>
      <require Cclass="Board Part" Cgroup="Memory" Csub="W25Q128J Core"/>
    </condition>
    <condition id="LX DMA OS condition">
      <description>RTOS dependency</description>
      <require Cclass="RTOS" Cgroup="FreeRTOS" Csub="Core"/>
    </condition>
    <condition id="LX DMA NO OS condition">
      <description>NO RTOS dependency</description>
      <deny Cclass="RTOS" Cgroup="FreeRTOS" Csub="Core"/>
    </condition>
    <condition id="USE W25N01GVXX POLLING">
      <description>LX W25N01GVXX POLLING interface dependency</description>
    </condition>
    <condition id="USE W25N01GVXX DMA NO OS">
      <description>LX W25N01GVXX NO OS interface dependency</description>
    </condition>
    <condition id="USE W25N01GVXX DMA OS">
      <description>LX W25N01GVXX DMA OS interface dependency</description>
    </condition>
    <condition id="USE MX66UW1G45G POLLING">
      <description>LX MX66UW1G45G POLLING interface dependency</description>
    </condition>
    <condition id="LX Core condition">
      <description>levelx core dependency</description>
      <require condition="Use NOR Flash Core"/>
      <require condition="Use NAND Flash Core"/>
      <require condition="USE W25N01GVXX POLLING"/>
      <require condition="USE W25N01GVXX DMA NO OS"/>
      <require condition="USE W25N01GVXX DMA OS"/>
      <require condition="USE MX66UW1G45G POLLING"/>
      <accept Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core"/>
      <accept Cclass="File System" Cgroup="LevelX" Csub="NAND Flash Core"/>
    </condition>
  </conditions>
  <generators>
    <!-- This generator is launched if any component referencing this generator by 'id' is selected and the specified <gpdsc> file does not exist -->
    <generator id="levelx_mx2codegen">
      <description>ST Microelectronics: STM32 Cube Code Generator for LevelX Pack</description>
      <exe>
        <command host="win">.config/gen_code.bat</command>
        <command host="linux">.config/gen_code.sh</command>
        <!-- $S = Device Family Pack base folder -->
        <argument>$S</argument>
        <!-- D = Device (Dname/Dvariant as configured by environment) -->
        <argument>$D</argument>
        <!-- Project path and project name (as configured by environment) -->
        <argument>$P</argument>
        <argument>#P</argument>
        <!-- #name of the gpdsc template contained in this PACK and aligned with GPDSC name-->
        <argument>STMicroelectronics.levelx.gpdsc.hbs</argument>
        <!-- passing the generator name-->
        <argument>levelx_mx2codegen</argument>
        <argument>$G</argument>
        <!-- Flag to indicate that this Generator is dry-run capable  -->
        <argument mode="dry-run">--dry-run</argument>
      </exe>
      <!-- workingDir></workingDir -->
      <!-- path is specified either absolute or relative to PDSC or GPDSC file. If not specified it is the project directory configured by the environment -->
      <gpdsc name="$P/mw_levelx_codegen.gpdsc"/>
    </generator>
  </generators>
  <components>
    <component Cclass="File System" Cgroup="LevelX" Csub="NOR Flash Core" condition="Use NOR Flash Core" Cversion="6.4.1" maxInstances="1">
