{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "1.0.0",
  "componentid": "::Device:STM32CubeMX2 Config:EXTI",
  "grammarVersion": "3.1",
  "properties": {
    "parameters": {
      "type": "object",
      "configFor": ["need.exti.lines"],
      "properties": {
        "labels": {
          "type": "array",
          "title": "Label for peripheral instance",
          "description": "Labels allow to create aliases inside mx_gpio_default.h and mx_ppp.h files like '<label>_EXTI_LINE', '<label>_EXTI_TRIGGER' and '<label>_exti_gethandle'. These aliases can be used on application side.",
          "items": {
            "type": "string",
            "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
            "minLength": 0,
            "maxLength": 32,
            "unique": "project",
            "default": ""
          }
        },
        "Basic": {
          "type": "object",
          "title": "Basic configuration",
          "properties": {
            "PinPrivilegeAccess": {
              "type": "boolean",
              "description": "Pin Privilege access",
              "title": "Set privileged access",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.priv_cfg"
                }
              ],
              "default": false
            },
            "trigger": {
              "type": "string",
              "title": "Trigger detection",
              "actions": [
                {
                  "type": "include",
                  "condition": "$resource.configurable === true"
                }
              ],
              "description": "The EXTI Trigger edge to be configured",
              "oneOf": [
                {
                  "title": "Rising edge",
                  "const": "RISING"
                },
                {
                  "title": "Falling edge",
                  "const": "FALLING"
                },
                {
                  "title": "Rising/Falling edge",
                  "const": "RISING_FALLING"
                }
              ],
              "default": "RISING"
            },
            "Interruption": {
              "type": "boolean",
              "description": "Activate the interuption of the line",
              "default": false
            },
            "irq_handler_generation": {
              "type": "boolean",
              "title": "IRQ Handler generation",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$config.Basic.Interruption"
                }
              ]
            },
            "nvicConfig": {
              "title": "NVIC configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$config.Basic.Interruption"
                }
              ],
              "type": "object",
              "objectType": "need.interrupt.lines",
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*"
                }
              ]
            }
          }
        }
      }
    }
  }
}