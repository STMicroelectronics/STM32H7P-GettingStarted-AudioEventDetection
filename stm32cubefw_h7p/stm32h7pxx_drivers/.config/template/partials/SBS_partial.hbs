{{else if (eq fct 'channel_pin_remap')}}
  {{! ~}}
  {{! Generate the enable channel pin remap function ~}}
  {{! > SBS fct='channel_pin_remap'~}}
  {{! ~}}
  {{assign 'layer' info.layer~}}
  {{#if (helper_sbs_any_true Additional.Enable_Channel_Pin_Remap)}}
    {{#with Additional.Enable_Channel_Pin_Remap}}
      {{assign 'adc_pin_remap' ''~}}
      {{assign 'act' false~}}
      {{#if ADC_IN7_to_PB1~}}
      {{assign 'adc_pin_remap' (helper_sbs_concatenate_selections @root.adc_pin_remap @root.layer '_SBS_REMAP_ADC_IN7_TO_PB1' )~}}
      {{assign 'act' true~}}
      {{/if}}
      {{#if ADC_IN6_to_PB0~}}
      {{assign 'adc_pin_remap' (helper_sbs_concatenate_selections @root.adc_pin_remap @root.layer '_SBS_REMAP_ADC_IN6_TO_PB0' )~}}
      {{assign 'act' true~}}
      {{/if}}
      {{#if ADC_IN5_to_PC5~}}
