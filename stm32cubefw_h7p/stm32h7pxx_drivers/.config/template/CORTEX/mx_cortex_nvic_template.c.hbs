/******************************************************************************/
/*                            Systick Handler                                 */
/******************************************************************************/
/**
  * @brief  This function handles SysTick Handler.
  */
void SysTick_Handler(void)
{
  HAL_IncTick();
  HAL_CORTEX_SYSTICK_IRQHandler();
}

{{/if}}
/******************************************************************************/
/*                              NMI Handler                                   */
/******************************************************************************/
/**
  * @brief  This function handles NMI Handler.
  */
void NMI_IRQHandler(void)
{
{{#if nmi_flash}}
  if (HAL_OK == FLASH_NMI_IRQHandler())
  {
    return;
  }
{{/if}}
{{#if nmi_rcc}}
  if (HAL_OK == RCC_NMI_IRQHandler())
  {
    return;
  }
{{/if}}
{{#if nmi_ramcfg_sram1}}
  if (HAL_OK == RAMCFG_SRAM1_NMI_IRQHandler())
  {
    return;
  }
{{/if}}
{{#if nmi_ramcfg_sram2}}
  if (HAL_OK == RAMCFG_SRAM2_NMI_IRQHandler())
  {
    return;
  }
{{/if}}
{{#if nmi_ramcfg_sram3}}
  if (HAL_OK == RAMCFG_SRAM3_NMI_IRQHandler())
  {
    return;
  }
{{/if}}

  // user code if required
  while(1);
}
