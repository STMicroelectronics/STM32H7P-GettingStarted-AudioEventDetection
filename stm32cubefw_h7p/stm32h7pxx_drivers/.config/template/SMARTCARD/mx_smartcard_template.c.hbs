{{assign "strategy" (@root.SWProjectAPI.getSelectedGenerationStrategy)~}}
{{log "strategy" @root.strategy~}}
{{#if (eq @root.strategy "SW")}}
{{assign 'current_resource' 'SMARTCARD'~}}
{{assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:SMARTCARD')~}}
{{assign 'dma_resource' 'STM32CubeMX2 Config:SMARTCARD'~}}
{{else}}
{{assign "strategy" 'HW'~}}
{{#get_myctx~}}
{{#with _myctx~}}
{{!log "SMARTCARD template _myctx:" this~}}
{{assign 'current_resource' resource~}}
{{assign 'dma_resource' resource~}}
{{assign 'instances' instances~}}
{{/with~}}
{{/get_myctx~}}
{{/if}}
{{!log "SMARTCARD template _myctx:" this~}}
{{log "SMARTCARD template current_resource:" @root.current_resource~}}
{{> SYSTEM fct='system_check_ll_optim'}}
