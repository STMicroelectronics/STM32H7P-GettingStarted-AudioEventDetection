{{#each instances~}}
{{~assign 'current_layer' info.layer~}}
/******************************************************************************/
/* Exported functions for SD in {{@root.current_layer}} layer (SW instance {{#if (eq name undefined)}}{{instanceIndex}}{{else}}{{name}}{{/if}}) */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index 'SD')~}}
{{assign 'current_index' (add @root.current_index 1)~}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_sd_handle_t *{{@root.fct_name}}_init(void)
{
  hal_sd_config_t sd_config;
 {{#with additional_view}}
 {{#if (eq Use_Delay_Block true)}}
 {{#if (eq Delay_Block_Config.detection_clock_phase true)}}
  uint32_t max_clock_phase;
 {{/if~}}{{~!Delay_Block_Config.detection_clock_phase~}}
 {{/if~}}{{~!Use_Delay_Block~}}
 {{/with~}}{{~!additional_view}}
{{#if (eq @root.current_resource 'SDMMC1')}}
  if (HAL_SD_Init(&h{{@root.current_resource}}, HAL_SD_CARD_1) != HAL_OK)
  {
    return NULL;
  }
{{else}}
  if (HAL_SD_Init(&h{{@root.current_resource}}, HAL_SD_CARD_2) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{~!root.current_resource}}
{{#with System.GPIO_Configuration}}
  /* SD GPIO Configuration **************************************************/
{{assign 'gpio_needs' 'undefined'~}}
{{#if gpio_std.needs~}}
{{~assign 'gpio_needs' (helper_common_concatenate_needs gpio_std.needs @root.gpio_needs)~}}
{{/if~}}{{~!gpio_std.needs~}}
{{#if gpio_spf1.needs~}}
{{~assign 'gpio_needs' (helper_common_concatenate_needs gpio_spf1.needs @root.gpio_needs)~}}
{{/if~}}{{~!gpio_spf1.needs~}}
{{> GPIO_HAL fct='init' needs=@root.gpio_needs resource=@root.current_resource~}}
{{/with~}}{{~!System.GPIO_Configuration~}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource~}}
{{> SYSTEM component='sd' resource=@root.current_resource}}
{{#with Basic}}
  sd_config.clk_cfg.clk_edge       = {{#if (eq clock_config.clk_edge true)}}HAL_SD_CLOCK_EDGE_RISING{{else}}HAL_SD_CLOCK_EDGE_FALLING{{/if}};
  sd_config.clk_cfg.clk_power_save = {{#if (eq clock_config.clk_power_save true)}}HAL_SD_CLOCK_POWER_SAVE_ENABLE{{else}}HAL_SD_CLOCK_POWER_SAVE_DISABLE{{/if}};
  sd_config.bus_wide               = {{#if (eq bus_wide 1)}}HAL_SD_BUS_WIDE_1BIT{{else}}HAL_SD_BUS_WIDE_4BIT{{/if}};
  sd_config.hw_flow_ctrl           = {{#if (eq hw_flow_ctrl true)}}HAL_SD_HARDWARE_FLOW_CONTROL_ENABLE{{else}}HAL_SD_HARDWARE_FLOW_CONTROL_DISABLE{{/if}};
  {{#if (eq clock_config.Auto_detection_frequency.detection_frequency false)}}
  sd_config.clk_cfg.clk_hz         = {{clock_config.Auto_detection_frequency.Clock_frequency}};
  {{/if~}}{{~!Auto_detection_frequency}}
  sd_config.transceiver            = {{#if (eq transceiver true)}}HAL_SD_TRANSCEIVER_PRESENT{{else}}HAL_SD_TRANSCEIVER_NOT_PRESENT{{/if}};
  sd_config.data_timeout_cycle     = {{#if (eq default_timeout true)}}HAL_SD_DATA_MAX_TIMEOUT{{else}}{{timeout_config.data_timeout_cycle}}{{/if}};
  sd_config.stop_xfer_timeout_ms   = {{#if (eq default_timeout true)}}HAL_SD_STOP_XFER_MAX_TIMEOUT{{else}}{{timeout_config.stop_xfer_timeout_ms}}{{/if}};
  sd_config.erase_timeout_ms       = {{#if (eq default_timeout true)}}HAL_SD_ERASE_MAX_TIMEOUT{{else}}{{timeout_config.erase_timeout_ms}}{{/if}};
  {{assign 'found_SetConfig' true~}}
  if (HAL_SD_SetConfig(&h{{@root.current_resource}}, &sd_config) != HAL_OK)
  {
    return NULL;
  }
  {{/with~}}{{~!Basic~}}
  {{#with additional_view~}}
  {{#if (eq Use_Delay_Block true)~}}
  {{#if (eq Delay_Block_Config.detection_clock_phase true)~}}

  if (HAL_SD_CalculateDlybMaxClockPhase(&h{{@root.current_resource}}, &max_clock_phase) != HAL_OK)
  {
    return NULL;
  }

  if (HAL_SD_SetConfigDlybDelay(&h{{@root.current_resource}}, max_clock_phase) != HAL_OK)
  {
    return NULL;
  }
  {{else~}}

  if (HAL_SD_SetConfigDlybDelay(&h{{@root.current_resource}}, {{Delay_Block_Config.Clock_phase}}) != HAL_OK)
  {
    return NULL;
  }
{{/if~}}{{~!Delay_Block_Config.detection_clock_phase~}}
{{/if~}}{{~!Use_Delay_Block~}}
{{/with~}}{{~!additional_view~}}
{{#if (eq System.nvic_settings.irq_handler_generation false)~}}
{{~assign 'nvic_generate_handler' false~}}
{{/if~}}
{{#if System.nvic_settings.EnableGlobalInterruption~}}
  {{~assign 'found_sd_nvic_ev' true}}
  /* Enable the Event interruption for SD */
{{assign 'nvic_needs' (helper_common_concatenate_needs System.nvic_settings.nvicGlobalInterrupt.needs @root.nvic_needs)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=System.nvic_settings.nvicGlobalInterrupt.needs}}
#warning "Partial CORTEX is not present"
{{/CORTEX}}{{~!CORTEX~}}
{{/if}}{{!System.nvic_settings.EnableGlobalInterruption}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if System.nvic_settings.EnableGlobalInterruption}}
  /* Disable the Event interruption for SD */
{{#> CORTEX fct='deinit' layer=@root.current_layer}}
{{/CORTEX}}
{{/if}}

  (void)HAL_SD_DeInit(&h{{@root.current_resource}});

  HAL_RCC_{{@root.current_resource}}_Reset();
  HAL_RCC_{{@root.current_resource}}_DisableClock();

{{#with System.GPIO_Configuration}}
{{assign 'gpio_needs' 'undefined'}}
{{#if gpio_std.needs}}
{{~assign 'gpio_needs' (helper_common_concatenate_needs gpio_std.needs @root.gpio_needs)~}}
{{/if~}}{{~!gpio_std.needs~}}
{{#if gpio_spf1.needs~}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_spf1.needs @root.gpio_needs)~}}
{{/if~}}{{~!gpio_spf1.needs~}}
{{> GPIO_HAL fct='deinit' needs=@root.gpio_needs resource=@root.current_resource}}
{{/with}}{{~!System.GPIO_Configuration~}}
}

{{/if~}}
{{#if (eq @root.current_layer 'HAL')~}}
{{#if (eq @root.hal_handle_exist 0)~}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_sd_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}

{{/each}}
{{assign 'nvic_context' (helper_cortex_nvic_get_irqline_info_list_legacy @root.NvicAPI @root.nvic_needs @root.current_resource 'SD' @root.function)~}}
