  {
    return NULL;
  }

{{/if}}{{! I2S_IO_configuration.LockIOConfig~}}
{{/with}}{{! Additional~}}
{{#with System}}
{{assign 'gpio_needs' 'undefined'}}
{{#if gpio_ck.needs}}
{{assign 'gpio_needs' (helper_common_concatenate_needs gpio_ck.needs @root.gpio_needs)~}}
{{/if~}}{{!gpio_ck.needs}}
{{#if gpio_ws.needs}}
