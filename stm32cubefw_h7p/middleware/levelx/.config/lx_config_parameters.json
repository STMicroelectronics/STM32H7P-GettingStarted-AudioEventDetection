{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "type": "object",
  "grammarVersion": "3.1",
  "componentid": "FileX system:STM32CubeMX2 Config:LevelX",
  "functions": [
    {
      "path": ".config/template/helpers/levelx_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "title": "LevelX version",
              "$comment": "label associated to the instance, can be overridden at sample level. In this case it becomes read-only.",
              "type": "string",
              "default": "6.4.1",
              "oneOf": [
                {
                  "const": "6.4.1"
                }
              ]
            }
          }
        },
        "Profile": {
          "title": "Profile Configuration",
          "type": "object",
          "properties": {
            "Profile_type": {
              "title": "Profile selection",
              "$comment": "Configuration profiles are predefined configuration settings where flags take default values.",
              "type": "string",
              "oneOf": [
                {
                  "const": "Default",
                  "title": "Default",
                  "description": "(by default): a profile that configures all the flags with their default values"
                },
                {
                  "const": "Low_footprint",
                  "title": "Low footprint",
                  "description": "a profile where the size of final binary is optimized"
                }
              ],
              "default": "Default",
              "description": "a profile that configures all the flags with their default values"
            }
          }
        },
        "Core": {
          "title": "Core configuration",
          "type": "object",
          "properties": {
            "Basic": {
              "title": "Main middleware configuration",
              "type": "object",
              "properties": {
                "LevelX_Core": {
                  "type": "object",
                  "title": "Core Configuration",
                  "properties": {
                    "LX_STANDALONE_ENABLE": {
                      "title": "Use Standalone Mode",
                      "description": "Defined, this macro will enable the standalone mode of LevelX.",
                      "type": "boolean",
                      "default": false,
                      "actions": [
                        {
                          "type": "disable",
                          "condition": "$get('swproject.hasRTOSenabled')"
                        },
                        {
                          "type": "set",
                          "condition": "$get('swproject.hasRTOSenabled')",
                          "computed": {
                            "const": "false"
                          }
                        },
                        {
                          "type": "set",
                          "condition": "!$get('swproject.hasRTOSenabled')",
                          "computed": {
                            "const": "true"
                          }
                        }
                      ]
                    },
                    "LX_THREAD_SAFE_ENABLEE": {
                      "title": "LX_THREAD_SAFE_ENABLE",
                      "description": "Defined, this makes LevelX thread-safe by using an RTOS mutex object throughout the API.",
                      "type": "boolean",
                      "default": false
                    }
                  }
                },
                "NOR_Flash_Support": {
                  "type": "object",
                  "title": "NOR Flash Configuration",
                  "properties": {
                    "NOR_FLASH_ENABLE": {
                      "title": "Use NOR Flash",
                      "description": "Defined, this macro will enable LevelX NOR Flash Configuration.",
                      "type": "boolean",
                      "variables": [
                        {
                          "on": "update-value",
                          "condition": "$value == true",
                          "name": "NOR_Flash",
                          "value": true
                        }
                      ],
                      "default": false
                    },
                    "LX_NOR_SECTOR_SIZE": {
                      "title": "LX_NOR_SECTOR_SIZE",
                      "description": "Define the logical sector size for NOR flash. The sector size is in units of 32-bit words. This sector size should match the sector size used in file system.",
                      "type": "string",
                      "default": "128",
                      "oneOf": [
                        {
                          "const": "128"
                        },
                        {
                          "const": "256"
                        },
                        {
                          "const": "512"
                        },
                        {
                          "const": "1024"
                        }
                      ],
                      "actions": [
                        {
                          "type": "enable",
                          "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                        }
                      ]
                    },
                    "more": {
                      "additionalProperties": false,
                      "type": "object",
                      "properties": {
                        "LX_DIRECT_READ": {
                          "title": "LX_DIRECT_READ",
                          "description": "Defined, this option bypasses the NOR flash driver read routine in favor or reading the NOR memory directly, resulting in a significant performance increase. ",
                          "type": "boolean",
                          "default": false,
                          "actions": [
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ]
                        },
                        "LX_FREE_SECTOR_DATA_VERIFY": {
                          "title": "LX_FREE_SECTOR_DATA_VERIFY",
                          "description": "Defined, this causes the LevelX NOR instance open logic to verify free NOR sectors are all ones.",
                          "type": "boolean",
                          "default": false,
                          "actions": [
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ]
                        },
                        "LX_NOR_DISABLE_EXTENDED_CACHE": {
                          "title": "LX_NOR_DISABLE_EXTENDED_CACHE",
                          "description": "Defined, this disabled the extended NOR cache.",
                          "type": "boolean",
                          "default": false,
                          "actions": [
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ]
                        },
                        "LX_NOR_EXTENDED_CACHE_SIZE": {
                          "title": "LX_NOR_EXTENDED_CACHE_SIZE",
                          "description": "By default this value is 8, which represents a maximum of 8 sectors that can be cached in a NOR instance.",
                          "type": "integer",
                          "default": 8,
                          "minimum": 1,
                          "maximum": 8,
                          "actions": [
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ]
                        },
                        "LX_NOR_SECTOR_MAPPING_CACHE_SIZE": {
                          "title": "LX_NOR_SECTOR_MAPPING_CACHE_SIZE",
                          "description": "By default this value is 16 and defines the logical sector mapping cache size. Large values improve performance, but cost memory. The minimum size is 8 and all values must be a power of 2.",
                          "type": "integer",
                          "actions": [
                            {
                              "type": "error",
                              "condition": "!$common.isPowerOfTwo(Core.Basic.NOR_Flash_Support.LX_NOR_SECTOR_MAPPING_CACHE_SIZE)",
                              "message": "must be a power of two"
                            },
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ],
                          "default": 16,
                          "minimum": 8,
                          "maximum": 1024
                        },
                        "LX_NOR_ENABLE_MAPPING_BITMAP": {
                          "title": "LX_NOR_ENABLE_MAPPING_BITMAP",
                          "description": "Determine if logical sector mapping bitmap should be enabled in extended cache. Cache memory will be allocated to sector mapping bitmap first. One bit can be allocated for each physical sector.",
                          "type": "boolean",
                          "default": false,
                          "actions": [
                            {
                              "type": "exclude",
                              "condition": "$Core.Basic.NOR_Flash_Support.LX_NOR_DISABLE_EXTENDED_CACHE"
                            },
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ]
                        },
                        "LX_NOR_ENABLE_OBSOLETE_COUNT_CACHE": {
                          "title": "LX_NOR_ENABLE_OBSOLETE_COUNT_CACHE",
                          "description": "Determine if obsolete count cache should be enabled in extended cache. Cache memory will be allocated to obsolete count cache after the mapping bitmap if enabled, and the rest of the cache memory is allocated to sector cache.",
                          "type": "boolean",
                          "default": false,
                          "actions": [
                            {
                              "type": "exclude",
                              "condition": "$Core.Basic.NOR_Flash_Support.LX_NOR_DISABLE_EXTENDED_CACHE"
                            },
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ]
                        },
                        "LX_NOR_OBSOLETE_COUNT_CACHE_TYPE": {
                          "title": "LX_NOR_OBSOLETE_COUNT_CACHE_TYPE",
                          "description": "Defines obsolete count cache element size. If number of sectors per block is greater than 256, use USHORT instead of UCHAR.",
                          "type": "string",
                          "default": "UCHAR",
                          "oneOf": [
                            {
                              "const": "UCHAR"
                            },
                            {
                              "const": "USHORT"
                            }
                          ],
                          "actions": [
                            {
                              "type": "enable",
                              "condition": "$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE"
                            }
                          ]
                        }
                      }
                    }
                  }
                },
                "NAND_Flash_Support": {
                  "type": "object",
                  "title": "NAND Flash Configuration",
                  "properties": {
                    "NAND_FLASH_ENABLE": {
                      "title": "Use NAND Flash",
                      "description": "Defined, this macro will enable LevelX NAND Flash Configuration.",
                      "type": "boolean",
                      "variables": [
                        {
                          "on": "update-value",
                          "condition": "$value == true",
                          "name": "NAND_Flash",
                          "value": true
                        }
                      ],
                      "default": true
                    },
                    "LX_NAND_FLASH_MAX_METADATA_BLOCKS": {
                      "title": "LX_NAND_FLASH_MAX_METADATA_BLOCKS",
                      "description": "By default this value is 4, which represents a maximum of 4 blocks that can be allocated for metadata.",
                      "type": "integer",
                      "default": 4,
                      "minimum": 2,
                      "maximum": 65535,
                      "actions": [
                        {
                          "type": "enable",
                          "condition": "$Core.Basic.NAND_Flash_Support.NAND_FLASH_ENABLE"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "Applicative": {
              "title": "Applicative configuration",
              "type": "object",
              "properties": {
                "Generate_LevelX_Init_Code": {
                  "title": "Generate LevelX Init Code",
                  "description": "When Use Standalone Mode is Disabled, this enables the generation of application code to initialize the LevelX stack within the app_levelx_init() function.",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$get('swproject.hasRTOSenabled')"
                    }
                  ]
                },
                "LevelX_App_Task_Entry_Name": {
                  "title": "LevelX Application Task Entry Name",
                  "description": "Specify the name of the main task entry function for the LevelX application.",
                  "type": "string",
                  "default": "lx_main_task_entry",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$Core.Applicative.Generate_LevelX_Init_Code"
                    }
                  ]
                },
                "LevelX_App_Task_Name": {
                  "title": "LevelX Application Task Name",
                  "description": "Specify the task name of the LevelX application.",
                  "type": "string",
                  "default": "lx_main_task",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$Core.Applicative.Generate_LevelX_Init_Code"
                    }
                  ]
                },
                "LevelX_App_Task_Priority": {
                  "title": "LevelX Application Task Priority",
                  "description": "Set the priority value for the LevelX application.",
                  "type": "string",
                  "default": "10",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$Core.Applicative.Generate_LevelX_Init_Code"
                    }
                  ]
                },
                "LevelX_App_Stack_Size": {
                  "title": "LevelX Application Task Stack Size",
                  "description": "Set the stack size for the LevelX application task.",
                  "type": "string",
                  "default": "1024",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$Core.Applicative.Generate_LevelX_Init_Code"
                    }
                  ]
                }
              }
            }
          }
        },
        "interface_config": {
          "type": "array",
          "title": "Interfaces configuration",
          "items": {
            "type": "object",
            "properties": {
              "logical_config": {
                "title": "Interface logical configuration",
                "type": "object",
                "properties": {
                  "interface_type": {
                    "title": "Select the interface type",
                    "type": "string",
                    "description": "Select the interface type",
                    "oneOf": [
                      {
                        "title": "W25N01GVXX NAND Flash Interface",
                        "const": "W25N01GVXX_NAND_Flash_Interface"
                      },
                      {
                        "title": "MX25LM51245G NOR Flash Interface",
                        "const": "MX25LM51245G_NOR_Flash_Interface"
                      },
                      {
                        "title": "MX66LM1G45G NOR Flash Interface",
                        "const": "MX66LM1G45G_NOR_Flash_Interface"
                      },
                      {
                        "title": "MX66UW1G45G NOR Flash Interface",
                        "const": "MX66UW1G45G_NOR_Flash_Interface"
                      },
                      {
                        "title": "W25Q128J NOR Flash Interface",
                        "const": "W25Q128J_NOR_Flash_Interface"
                      },
                      {
                        "title": "NOR Flash SIMULATOR Interface",
                        "const": "NOR_Flash_SIMULATOR_Interface"
                      }
                    ],
                    "default": "W25N01GVXX_NAND_Flash_Interface",
                    "actions": [
                      {
                        "type": "warning",
                        "condition": "($item.logical_config.interface_type == 'MX25LM51245G_NOR_Flash_Interface') && ($item.resources_allocation.hw_selection != 'MX25LM51245G')",
                        "message": "When selecting MX25LM51245G_NOR_Flash_Interface, HW selection must be MX25LM51245G."
                      },
                      {
                        "type": "warning",
                        "condition": "($item.logical_config.interface_type == 'MX66LM1G45G_NOR_Flash_Interface') && ($item.resources_allocation.hw_selection != 'MX66LM1G45G')",
                        "message": "When selecting MX66LM1G45G_NOR_Flash_Interface, HW selection must be MX66LM1G45G."
                      },
                      {
                        "type": "warning",
                        "condition": "($item.logical_config.interface_type == 'MX66UW1G45G_NOR_Flash_Interface') && ($item.resources_allocation.hw_selection != 'MX66UW1G45G')",
                        "message": "When selecting MX66UW1G45G_NOR_Flash_Interface, HW selection must be MX66UW1G45G."
                      },
                      {
                        "type": "warning",
                        "condition": "($item.logical_config.interface_type == 'W25N01GVXX_NAND_Flash_Interface') && ($item.resources_allocation.hw_selection != 'W25N01GVXX')",
                        "message": "When selecting W25N01GVXX_NAND_Flash_Interface, HW selection must be W25N01GVXX."
                      },
                      {
                        "type": "warning",
                        "condition": "($item.logical_config.interface_type == 'W25Q128J_NOR_Flash_Interface') && ($item.resources_allocation.hw_selection != 'W25Q128J')",
                        "message": "When selecting W25Q128J_NOR_Flash_Interface, HW selection must be W25Q128J."
                      },
                      {
                        "type": "warning",
                        "condition": "(($item.logical_config.interface_type == 'MX25LM51245G_NOR_Flash_Interface' || $item.logical_config.interface_type == 'MX66LM1G45G_NOR_Flash_Interface' || $item.logical_config.interface_type == 'MX66UW1G45G_NOR_Flash_Interface' || $item.logical_config.interface_type == 'W25Q128J_NOR_Flash_Interface' || $item.logical_config.interface_type == 'NOR_Flash_SIMULATOR_Interface') && !$Core.Basic.NOR_Flash_Support.NOR_FLASH_ENABLE)",
                        "message": "Warning: Selected NOR Flash Interface but NOR Flash Support is not enabled."
                      },
                      {
                        "type": "warning",
                        "condition": "($item.logical_config.interface_type == 'W25N01GVXX_NAND_Flash_Interface' && !$Core.Basic.NAND_Flash_Support.NAND_FLASH_ENABLE)",
                        "message": "Warning: Selected NAND Flash Interface but NAND Flash Support is not enabled."
                      }
                    ]
                  },
                  "transfer_mode": {
                    "title": "Select the transfer mode",
                    "type": "string",
                    "description": "Select the transfer mode",
                    "oneOf": [
                      {
                        "title": "Polling",
                        "const": "Polling",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "$Core.Basic.LevelX_Core.LX_STANDALONE_ENABLE"
                          }
                        ]
                      },
                      {
                        "title": "DMA NO OS",
                        "const": "DMA_NO_OS",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "$Core.Basic.LevelX_Core.LX_STANDALONE_ENABLE"
                          }
                        ]
                      },
                      {
                        "title": "DMA OS",
                        "const": "DMA_OS",
                        "actions": [
                          {
                            "type": "exclude",
                            "condition": "$Core.Basic.LevelX_Core.LX_STANDALONE_ENABLE"
                          }
                        ]
                      }
                    ],
                    "default": "Polling",
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "$item.logical_config.interface_type == 'NOR_Flash_SIMULATOR_Interface'"
                      }
                    ],
                    "variables": [
                      {
                        "on": "update-value",
                        "condition": "$item.logical_config.interface_type === 'W25N01GVXX_NAND_Flash_Interface' && $value === 'Polling'",
                        "name": "w25n01gvxx_nand_polling",
                        "value": true
                      },
                      {
                        "on": "update-value",
                        "condition": "$item.logical_config.interface_type === 'W25N01GVXX_NAND_Flash_Interface' && $value === 'DMA_NO_OS'",
                        "name": "w25n01gvxx_nand_dma_no_os",
                        "value": true
                      },
                      {
                        "on": "update-value",
                        "condition": "$item.logical_config.interface_type === 'W25N01GVXX_NAND_Flash_Interface' && $value === 'DMA_OS'",
                        "name": "w25n01gvxx_nand_dma_os",
                        "value": true
                      },
                      {
                        "on": "update-value",
                        "condition": "$item.logical_config.interface_type === 'MX66UW1G45G_NOR_Flash_Interface' && $value === 'Polling'",
                        "name": "mx66uw1g45g_nor_polling",
                        "value": true
                      }
                    ]
                  },
                  "NOR_Flash_Flags": {
                    "type": "object",
                    "title": "STM32 LX NOR Flags",
                    "properties": {
                      "STM32_LX_NOR_FLAG_NONE": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_NONE",
                        "default": true,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NOR_Flash_Flags.STM32_LX_NOR_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NOR_FLAG_START_ADDRESS": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_START_ADDRESS",
                        "default": false,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NOR_Flash_Flags.STM32_LX_NOR_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NOR_FLAG_BLOCK_SIZE": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_BLOCK_SIZE",
                        "default": false,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NOR_Flash_Flags.STM32_LX_NOR_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NOR_FLAG_FLASH_SIZE": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_FLASH_SIZE",
                        "default": false,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NOR_Flash_Flags.STM32_LX_NOR_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NOR_FLAG_READ_BUFFER": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_READ_BUFFER",
                        "default": false,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NOR_Flash_Flags.STM32_LX_NOR_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NOR_FLAG_ERASE_ON_INIT": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_ERASE_ON_INIT",
                        "default": false,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NOR_Flash_Flags.STM32_LX_NOR_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NOR_FLAG_CACHE_MAINTENANCE": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_CACHE_MAINTENANCE",
                        "default": false,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NOR_Flash_Flags.STM32_LX_NOR_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NOR_FLAG_ALL": {
                        "type": "boolean",
                        "title": "STM32_LX_NOR_FLAG_ALL",
                        "default": false
                      }
                    },
                    "actions": [
                      {
                        "type": "include",
                        "condition": "(($item.logical_config.interface_type == 'MX25LM51245G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66LM1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66UW1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'W25Q128J_NOR_Flash_Interface'))"
                      }
                    ]
                  },
                  "Op_Timeout": {
                    "title": "NOR Flash Op Timeout",
                    "description": "Defined, LevelX will be used in standalone mode (without RTOS).",
                    "type": "string",
                    "default": "460000U",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "(($item.logical_config.interface_type == 'MX25LM51245G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66LM1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66UW1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'W25Q128J_NOR_Flash_Interface'))"
                      }
                    ]
                  },
                  "interface_mode": {
                    "title": "Interface Mode",
                    "description": "Select the SPI interface mode",
                    "type": "integer",
                    "oneOf": [
                      {
                        "const": 0,
                        "title": "SPI Mode",
                        "description": "SPI_MODE - 1-1-1 commands, Power on H/W default setting"
                      },
                      {
                        "const": 1,
                        "title": "OPI Mode",
                        "description": "OPI_MODE - 8-8-8 commands"
                      }
                    ],
                    "default": 1,
                    "actions": [
                      {
                        "type": "include",
                        "condition": "(($item.logical_config.interface_type == 'MX25LM51245G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66LM1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66UW1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'W25Q128J_NOR_Flash_Interface'))"
                      }
                    ]
                  },
                  "transfer_rate": {
                    "title": "Transfer Rate",
                    "description": "Select transfer rate mode",
                    "type": "integer",
                    "oneOf": [
                      {
                        "const": 0,
                        "title": "Single Transfer Rate (STR)",
                        "description": "STR_TRANSFER"
                      },
                      {
                        "const": 1,
                        "title": "Double Transfer Rate (DTR)",
                        "description": "DTR_TRANSFER"
                      }
                    ],
                    "default": 1,
                    "actions": [
                      {
                        "type": "include",
                        "condition": "(($item.logical_config.interface_type == 'MX25LM51245G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66LM1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'MX66UW1G45G_NOR_Flash_Interface') || ($item.logical_config.interface_type == 'W25Q128J_NOR_Flash_Interface'))"
                      }
                    ]
                  },
                  "NAND_Flash_Flags": {
                    "type": "object",
                    "title": "STM32 LX NAND Flags",
                    "properties": {
                      "STM32_LX_NAND_FLAG_NONE": {
                        "type": "boolean",
                        "title": "STM32_LX_NAND_FLAG_NONE",
                        "default": true,
                        "actions": [
                          {
                            "type": "disable",
                            "condition": " $item.logical_config.NAND_Flash_Flags.STM32_LX_NAND_FLAG_ALL === true"
                          }
                        ]
                      },
                      "STM32_LX_NAND_FLAG_START_BLOCK": {
                        "type": "boolean",
