/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_RCC_H
#define MX_RCC_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
#include "stm32_{{lowercase @root.main_config.info.layer}}.h"
#include "mx_def.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{#if (eq @root.strategy "SW")}}
{{~assign 'rcc_cxt' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{~assign 'current_resource' (@root.peripheralsResourceManagerAPI.getPeripheralBoundToSoftwareInstance this)~}}
{{~assign 'current_layer' @root.rcc_cxt.info.layer~}}
{{else}}
{{~assign 'current_layer' info.layer~}}
{{/if}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{assign 'current_index' 0~}}
{{#with @root.rcc_cxt}}
  {{assign 'current_layer' info.layer~}}
/******************************************************************************/
/* Exported functions for RCC in {{@root.current_layer}} layer */
/******************************************************************************/
  {{assign 'fct_name' (helper_common_get_generated_function_name 'RCC' @root.current_layer @root.config_index)~}}
  {{assign 'config_index' (add @root.config_index 1)~}}
system_status_t {{@root.fct_name}}_init(void);

  {{#if @root.main_config.additional.hse.enable_css}}
hal_status_t RCC_NMI_IRQHandler(void);
  {{/if}}
  {{#if @root.main_config.additional.lse.enable_css}}
hal_status_t LSECSSD_IRQHandler(void);
  {{/if}}
{{/with}}

{{#if (helper_rcc_is_controlled_by_periph @root.main_config)}}
{{! provide an API for resources for controlled by peripherals~}}
  {{#each @root.all_resources}}

system_status_t mx_rcc_{{lowercase this}}_clock_config(void);
system_status_t mx_rcc_{{lowercase this}}_clock_deactivate(void);

  {{/each~}}

  {{#each @root.system_config.pll_list}}
    {{#if (include @root.all_clock_configs this.name)}}
system_status_t mx_rcc_pll{{this.idx}}_config(void);
system_status_t mx_rcc_pll{{this.idx}}_deactivate(void);
      {{#each this.outputs}}
system_status_t mx_rcc_pll{{../this.idx}}_output_{{this}}_config(uint32_t nb_resources);
system_status_t mx_rcc_pll{{../this.idx}}_output_{{this}}_deactivate(void);
      {{/each}}
    {{/if}}

  {{/each~}}

{{else}}
{{! rcc_peripherals_clock_config should be generated for central (0) or custom (2) ~}}
system_status_t mx_rcc_peripherals_clock_config(void);

{{/if~}}

{{#if (not helper_rcc_is_central @root.main_config)}}
  {{#each @root.all_clock_configs}}
    {{#if this.is_external}}

#if defined({{@key}}_VALUE)
    {{else}}

    {{/if}}
system_status_t mx_rcc_{{lowercase @key}}_clock_config(uint32_t nb_resources);
system_status_t mx_rcc_{{lowercase @key}}_clock_deactivate(void);
    {{#if this.is_external}}
#endif /* {{@key}}_VALUE */
    {{/if}}
  {{/each}}
{{/if}}


#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_RCC_H */
