{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:COMP",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/comp_helpers.js",
      "accessor": "common"
    },
    {
      "path": ".config/template/helpers/common_helpers.js",
      "accessor": "com"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "Software information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_COMP_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "actions": [
                {
                  "type": "enable",
                  "condition": "$com.helper_common_display_object($resource)"
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "resource initialization code generation",
              "description": "generate or not the COMP init code, call it or not at boot",
              "$comment": "generate the init code of your COMP or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },
        "comp_mode_1_2": {
          "title": "Windows mode COMP1/2",
          "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...)",
          "type": "string",
          "oneOf": [
            {
              "title": "independent",
              "description": "Comparator instance independent (versus other comparator instances). Default mode.",
              "const": "mode_independent"
            },
            {
              "title": "window",
              "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
              "const": "mode_window"
            }
          ],
          "default": "mode_independent",
          "synchronize": true,
          "actions": [
            {
              "type": "include",
              "condition": "($resource.id == 'COMP1') || ($resource.id == 'COMP2')"
            }
          ],
          "$comment": ""
        },
        "comp_mode_3_4": {
          "title": "Windows mode COMP3/4",
          "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...)",
          "type": "string",
          "oneOf": [
            {
              "title": "independent",
              "description": "Comparator instance independent (versus other comparator instances). Default mode.",
              "const": "mode_independent"
            },
            {
              "title": "window",
              "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
              "const": "mode_window",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "true"
                }
              ]
            }
          ],
          "default": "mode_independent",
          "synchronize": true,
          "actions": [
            {
              "type": "include",
              "condition": "($resource.id == 'COMP3') || ($resource.id == 'COMP4')"
            },
            {
              "type": "disable",
              "condition": "($resource.id == 'COMP4')"
            }
          ]
        },
        "comp_mode_5_6": {
          "title": "Windows mode COMP5/6",
          "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...)",
          "type": "string",
          "oneOf": [
            {
              "title": "independent",
              "description": "Comparator instance independent (versus other comparator instances). Default mode.",
              "const": "mode_independent"
            },
            {
              "title": "window",
              "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
              "const": "mode_window",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "true"
                }
              ]
            }
          ],
          "default": "mode_independent",
          "synchronize": true,
          "actions": [
            {
              "type": "include",
              "condition": "($resource.id == 'COMP5') || ($resource.id == 'COMP6')"
            }
          ]
        },
        "comp_mode_7_8": {
          "title": "Windows mode COMP7/8",
          "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...)",
          "type": "string",
          "oneOf": [
            {
              "title": "independent",
              "description": "Comparator instance independent (versus other comparator instances). Default mode.",
              "const": "mode_independent"
            },
            {
              "title": "window",
              "description": "Combine multiple COMP instances for voltage comparison to 2 thresholds.",
              "const": "mode_window",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "true"
                }
              ]
            }
          ],
          "default": "mode_independent",
          "synchronize": true,
          "actions": [
            {
              "type": "include",
              "condition": "($resource.id == 'COMP7') || ($resource.id == 'COMP8')"
            }
          ]
        },
        "comp_mode": {
          "title": "Mode status",
          "description": "Ability to combine 2 comparator instances for common operation (COMP1 and COMP2, COMP3 and COMP4, ...)",
          "type": "string",
          "default": "mode_independent",
          "actions": [
            {
              "type": "set",
              "computed": {
                "const": "($comp_mode_1_2 ? $comp_mode_1_2 : ($comp_mode_3_4 ? $comp_mode_3_4 : ($comp_mode_5_6 ? $comp_mode_5_6 : ($comp_mode_7_8 ? $comp_mode_7_8 : 'error_window_inst')))).replace('x_', '')"
              }
            },
            {
              "type": "disable",
              "condition": "true"
            }
          ],
          "$comment": ""
        },
        "comp_mode_window_control_inst_main": {
          "title": "Configuration controlling comparator instance",
          "type": "string",
          "default": "COMPx",
          "actions": [
            {
              "type": "set",
              "computed": {
                "const": "'COMP' + $common.helper_comp_get_window_other_instance_nb($resource.id)"
              }
            },
            {
              "type": "disable",
              "condition": "true"
            },
            {
              "type": "include",
              "condition": "($common.helper_comp_is_window_instance_main($resource.id) == true) && ($comp_mode == 'mode_window')"
            }
          ]
        },
        "comp_mode_window_control_inst_sec": {
          "title": "Configuration controlled by comparator instance",
          "type": "string",
          "default": "COMPx",
          "actions": [
            {
              "type": "set",
              "computed": {
                "const": "'COMP' + $common.helper_comp_get_window_other_instance_nb($resource.id)"
              }
            },
            {
              "type": "disable",
              "condition": "true"
            },
            {
              "type": "include",
              "condition": "($common.helper_comp_is_window_instance_main($resource.id) != true) && ($comp_mode == 'mode_window')"
            }
          ]
        },
        "feat_basic": {
          "type": "object",
          "description": "COMP Global configuration.",
          "title": "Comparator instance configuration",
          "properties": {
            "input": {
              "title": "Input",
              "type": "object",
              "properties": {
                "input_plus": {
                  "description": "",
                  "title": "Plus",
                  "$comment": "",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.id",
                    "title": "{{source.replace(/COMP\\d+_INP(\\w+)/g, 'IO$1').replace('DAC1_INT', 'DAC1 channel 1').replace('DAC2_INT', 'DAC1 channel 2').replace(/opamp(\\d+)_int/g, 'OPAMP$1 output')}}",
                    "entity": ["peripheral.interconnect.analog input plus", "peripheralBlock.interconnect.analog input plus"],
                    "where": "($entity.source != 'VSSA') && ($entity.source != 'GND')",
                    "sharing": false
                  },
                  "select": "first"
                },
                "input_minus": {
                  "description": "",
                  "title": "Minus",
                  "$comment": "",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.id",
                    "title": "{{source.replace(/COMP\\d+_INM(\\w+)/g, 'IO$1').replace('VBG', 'VrefInt').replace(/DAC(\\d+)_INT/g, 'DAC1 channel $1').replace(/dac(\\d+)_out(\\d+)/g, 'DAC$1 channel $2').replace('VSENS', 'temperature sensor')}}",
                    "entity": ["peripheral.interconnect.analog input minus", "peripheralBlock.interconnect.analog input minus"],
                    "where": "($entity.source != 'VSSA') && ($entity.source != 'GND')",
                    "sharing": false
                  },
                  "select": "first",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($comp_mode_1_2 === 'mode_window') || ($comp_mode_3_4 === 'mode_window') || ($comp_mode_5_6 === 'mode_window') || ($comp_mode_7_8 === 'mode_window')"
                    }
                  ]
                },
                "window_upper_threshold": {
                  "description": "",
                  "title": "Window upper threshold",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.id",
                    "title": "{{source.replace(/COMP\\d+_INM(\\w+)/g, 'IO$1').replace('VBG', 'VrefInt').replace(/DAC(\\d+)_INT/g, 'DAC1 channel $1').replace(/dac(\\d+)_out(\\d+)/g, 'DAC$1 channel $2').replace('VSENS', 'temperature sensor')}}",
                    "entity": ["peripheral.interconnect.analog input minus", "peripheralBlock.interconnect.analog input minus"],
                    "where": "$entity.source != \"VSSA\"",
                    "sharing": false
                  },
                  "select": "first",
                  "$comment": "Term \"upper\" does not imply voltage value must be higher than the other threshold. This is an arbitrary selection to determine window output level.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($comp_mode_1_2 === 'mode_window') || ($comp_mode_3_4 === 'mode_window') || ($comp_mode_5_6 === 'mode_window') || ($comp_mode_7_8 === 'mode_window')"
                    }
                  ]
                },
                "window_lower_threshold": {
                  "description": "",
                  "title": "Window lower threshold",
                  "type": "object",
                  "objectType": "query",
                  "query": {
                    "parent": "$resource.id",
                    "title": "{{source.replace(/COMP\\d+_INM(\\w+)/g, 'IO$1').replace('VBG', 'VrefInt').replace(/DAC(\\d+)_INT/g, 'DAC1 channel $1').replace(/dac(\\d+)_out(\\d+)/g, 'DAC$1 channel $2').replace('VSENS', 'temperature sensor')}}",
                    "entity": ["peripheral.interconnect.analog input minus", "peripheralBlock.interconnect.analog input minus"],
                    "where": "$entity.source != \"VSSA\"",
                    "sharing": false
                  },
                  "select": "first",
                  "$comment": "Term \"lower\" does not imply voltage value must be lower than the other threshold. This is an arbitrary selection to determine window output level.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($comp_mode_1_2 === 'mode_window') || ($comp_mode_3_4 === 'mode_window') || ($comp_mode_5_6 === 'mode_window') || ($comp_mode_7_8 === 'mode_window')"
                    }
                  ]
                },
                "input_hysteresis": {
                  "type": "string",
                  "description": "Hysteresis applied to input plus, subtracted to input voltage value",
                  "default": "NONE",
                  "oneOf": [
                    {
                      "title": "none",
                      "const": "NONE"
                    },
                    {
                      "title": "10mV",
                      "const": "10MV"
                    },
                    {
                      "title": "20mV",
                      "const": "20MV"
                    },
                    {
                      "title": "30mV",
                      "const": "30MV"
                    },
                    {
                      "title": "40mV",
                      "const": "40MV"
                    },
                    {
                      "title": "50mV",
                      "const": "50MV"
                    },
                    {
                      "title": "60mV",
                      "const": "60MV"
                    },
                    {
                      "title": "70mV",
                      "const": "70MV"
                    }
                  ],
                  "title": "Hysteresis",
                  "$comment": "For electrical characteristics of comparator hysteresis (voltage amplitude), refer to device datasheet."
                }
              }
            },
            "output": {
              "title": "Output",
              "type": "object",
              "properties": {
                "output_polarity": {
                  "type": "string",
                  "description": "Select output logical level corresponding to input analog comparison state.",
                  "default": "NONINVERTED",
                  "oneOf": [
                    {
                      "title": "not inverted",
                      "const": "NONINVERTED"
                    },
                    {
                      "title": "inverted",
                      "const": "INVERTED"
                    }
                  ],
                  "title": "Polarity",
                  "$comment": "Comparator output polarity not inverted:  comparator output at high level when input voltages: plus higher than minus."
                },
                "output_trigger": {
                  "type": "string",
                  "description": "Comparator output trigger to system (wake up, CPU event, interruption).",
                  "oneOf": [
                    {
                      "title": "none",
                      "const": "NONE"
                    },
                    {
                      "title": "rising edge",
                      "const": "RISING"
                    },
                    {
                      "title": "falling edge",
                      "const": "FALLING"
                    },
                    {
                      "title": "rising and falling edges",
                      "const": "RISING_FALLING"
                    }
                  ],
                  "title": "Trigger",
                  "$comment": "When output set to generate a trigger, impact depends on programming model used:\n- with HAL_COMP_Start(): generates a system wake-up event and a CPU event\n- with HAL_COMP_Start_IT(): generates a system wake-up event and a CPU interruption (need to enable interruption, refer to setting below)\n- with LL layer, interruption must be managed using LL EXTI driver.",
                  "default": "RISING",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "COMP_USE_HAL_COMP_EXTI",
                      "computed_value": "($feat_basic.output.output_trigger != 'NONE') && ($info.layer === 'HAL')"
                    }
                  ]
                },
                "window_output_mode": {
                  "type": "string",
                  "description": "Comparator output trigger to system (wake up, CPU).",
                  "oneOf": [
                    {
                      "title": "independent",
                      "const": "INDEPT",
                      "description": "Comparators window output default mode: both comparators output are independent, indicating each their own state.\nNote: To know signal state versus window thresholds, read each comparator output and perform a logical \"exclusive or\" operation."
                    },
                    {
                      "title": "XOR",
                      "const": "XOR",
                      "description": "Comparators window output synthesized on a single comparator output: comparator no more indicating its own state, but window state (XOR: logical \"exclusive or\"). Logical high means monitored signal is within comparators window thresholds. Comparator instance selected corresponds to handle assigned as upper threshold in @ref HAL_COMP_WINDOW_SetHandle().\nNote: impacts only comparator output signal level (propagated to GPIO, EXTI lines, timers, ...), does not impact output digital state (hal_comp_output_level_t) always reflecting each comparator output state. */"
                    }
                  ],
                  "title": "Window output mode",
                  "$comment": "Comparators window output logical operation from both comparators output",
                  "default": "INDEPT",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$comp_mode === 'mode_window'"
                    }
                  ]
                }
              }
            }
          },
          "actions": [
            {
              "type": "disable",
              "condition": "($common.helper_comp_is_window_instance_main($resource.id) != true) && ($comp_mode == 'mode_window')"
            }
          ]
        },
        "feat_opt": {
          "type": "object",
          "description": "",
          "title": "Additional features",
          "properties": {
            "output_blanking_state": {
              "title": "Output blanking",
              "type": "boolean",
              "default": false
            },
            "output_blanking_src": {
              "description": "",
              "title": "Output blanking source",
              "$comment": "",
              "type": "object",
              "objectType": "query",
              "query": {
                "parent": "$resource.id",
                "title": "{{source}}",
                "entity": ["peripheral.interconnect.internal input trigger", "peripheralBlock.interconnect.internal input trigger"],
                "sharing": false
              },
              "select": "first",
              "actions": [
                {
                  "type": "include",
                  "condition": "$feat_opt.output_blanking_state"
                }
              ]
            }
          },
          "actions": [
            {
              "type": "disable",
              "condition": "($common.helper_comp_is_window_instance_main($resource.id) != true) && ($comp_mode == 'mode_window')"
            }
          ]
        },
        "System": {
          "type": "object",
          "title": "System config",
          "properties": {
            "comp_exti_line": {
              "title": "EXTI line config",
              "description": "Comparator uses EXTI line for system wake up and event generation, but does not uses EXTI trigger and interruption setting (disabled in EXTI configuration panel). For comparator interruption, refer to dedicated panel below.",
              "type": "object",
              "objectType": "need.exti.lines",
              "variables": [
                  {
                      "on": "update-value",
                      "name": "HAL_EXTI_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                  }
              ],
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*",
                  "constraints": {
                    "trigger": {
                      "const": "NONE"
                    },
                    "Interruption": {
                      "const": false
                    }
                  }
                }
              ],
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$feat_basic.output.output_trigger === 'NONE'"
                }
              ]
            },
            "comp_gpio": {
              "type": "object",
              "title": "GPIO configuration",
              "properties": {
                "comp_input_plus_gpio_inp1": {
                  "title": "GPIO for comparator input plus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "INP1",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($feat_basic.input.input_plus.source.includes('INP1')) && $get('pinout.peripheralCanBeMapped', $resource.id, 'INP1')) == true"
                    }
                  ]
                },
                "comp_input_plus_gpio_inp2": {
                  "title": "GPIO for comparator input plus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "INP2",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($feat_basic.input.input_plus.source.includes('INP2')) && $get('pinout.peripheralCanBeMapped', $resource.id, 'INP2')) == true"
                    }
                  ]
                },
                "comp_input_plus_gpio_inp3": {
                  "title": "GPIO for comparator input plus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "INP3",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "(($feat_basic.input.input_plus.source.includes('INP3')) && $get('pinout.peripheralCanBeMapped', $resource.id, 'INP3')) == true"
                    }
                  ]
                },
                "comp_input_minus_gpio_inm1": {
                  "title": "GPIO for comparator input minus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "INM1",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($feat_basic.input.input_minus?.source.includes('INM1')) || ($feat_basic.input.window_upper_threshold?.source.includes('INM1')) || ($feat_basic.input.window_lower_threshold.source?.includes('INM1'))) && $get('pinout.peripheralCanBeMapped', $resource.id, 'INM1')) == true"
                    }
                  ]
                },
                "comp_input_minus_gpio_inm2": {
                  "title": "GPIO for comparator input minus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "INM2",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($feat_basic.input.input_minus?.source.includes('INM2')) || ($feat_basic.input.window_upper_threshold?.source.includes('INM2')) || ($feat_basic.input.window_lower_threshold.source?.includes('INM2'))) && $get('pinout.peripheralCanBeMapped', $resource.id, 'INM2')) == true"
                    }
                  ]
                },
                "comp_input_minus_gpio_inm3": {
                  "title": "GPIO for comparator input minus",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "INM3",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        },
                        "pull": {
                          "const": "NO"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "((($feat_basic.input.input_minus?.source.includes('INM3')) || ($feat_basic.input.window_upper_threshold?.source.includes('INM3')) || ($feat_basic.input.window_lower_threshold.source?.includes('INM3'))) && $get('pinout.peripheralCanBeMapped', $resource.id, 'INM3')) == true"
                    }
                  ]
                },
                "comp_output_gpio_status": {
                  "title": "GPIO to comparator output",
                  "description": "Output connection to GPIO (digital mode), optional",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$feat_basic.output.output_trigger === 'NONE'"
                    }
                  ],
                  "$comment": "Comparator output to interrupt and digital state remains always available, whatever output connection to GPIO."
                },
                "comp_output_gpio": {
                  "title": "GPIO for comparator output",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_GPIO_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OUT",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$System.comp_gpio.comp_output_gpio_status === true"
                    }
                  ]
                }
              }
            },
            "EnableInterruption": {
              "type": "boolean",
              "description": "Activation depending on output trigger mode selection (must be different of no trigger)",
              "default": false,
              "actions": [
                {
                  "type": "disable",
                  "condition": "$feat_basic.output.output_trigger === 'NONE'"
                }
              ],
              "$comment": "Output trigger can be enabled without interruption, for event generation."
            },
            "irq_handler_generation": {
              "type": "boolean",
              "title": "IRQ Handler generation",
              "default": true,
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableInterruption && ($info.layer === 'HAL')"
                }
              ]
            },
            "nvicConfig": {
              "title": "NVIC configuration",
              "actions": [
                {
                  "type": "include",
                  "condition": "$System.EnableInterruption"
                }
              ],
              "type": "object",
              "objectType": "need.interrupt.lines",
              "variables": [
                  {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                  }
              ],
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*"
                }
              ]
            }
          }
        }
      }
    }
  }
}