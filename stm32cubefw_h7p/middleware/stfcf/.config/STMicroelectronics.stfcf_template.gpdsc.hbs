<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- ******************************************************************************
 * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
 * Description : Generator PDSC File generated by CodeGen
 ****************************************************************************** -->
{{assign "jsonFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "STFCF"}')~}}
{{assign 'data' (@root.SWConfigurationAPI.getSwInstancesConfiguration @root.jsonFilter)~}}
{{assign "instance_0" @root.data.[0].instanceId~}}
{{log 'instance_0' @root.data.[0].instanceId~}}

{{assign 'MY_SW_Instances' (@root.SWConfigurationAPI.getInstances "STMicroelectronics::Security:STM32CubeMX2 Config:STFCF")~}}
{{log 'MY_SW_Instances' @root.MY_SW_Instances~}}
{{assign 'stfcf_hal' false~}}
{{assign 'stfcf_cryptolib' false~}}
{{assign 'stfcf_mbedtls' false~}}
{{assign 'stfcf_kwe' false~}}

{{#each @root.MY_SW_Instances}}
{{assign 'mystfcf' (@root.SWConfigurationAPI.getInstanceConfiguration this)~}}
{{log "mystfcf" @root.mystfcf~}}
{{log "mystfcf" @root.mystfcf.settings~}}
{{log "mystfcf.settings.parameters" @root.mystfcf.settings.parameters~}}

{{#with @root.mystfcf.settings.parameters.main_config }}

{{log 'MY_SW_Instances' @root.MY_SW_Instances~}}
{{log "alt_hal"   (eq cryptography.cipher.implementation 'alt_hal')}}
{{log "alt_stlib" (eq cryptography.cipher.implementation 'alt_stcryptolib')}}
{{log "mbedtls"   (eq cryptography.cipher.implementation 'mbedtls')}}
{{log "kwe"       (eq cryptography.cipher.implementation 'kwe')}}

{{#if (or (eq cryptography.cipher.implementation 'alt_hal')
          (eq cryptography.asymmetric_encryption.implementation 'alt_hal')
          (eq cryptography.asymmetric_signature.implementation 'alt_hal')
          (eq cryptography.hash.implementation 'alt_hal')
          (eq cryptography.key_agreement.implementation 'alt_hal')
          (eq cryptography.message_authentication_code.implementation 'alt_hal')
          )}}{{assign 'stfcf_hal' true}}{{/if~}}

{{#if (or (eq cryptography.cipher.implementation 'alt_stcryptolib')
          (eq cryptography.asymmetric_encryption.implementation 'alt_stcryptolib')
          (eq cryptography.asymmetric_signature.implementation 'alt_stcryptolib')
          (eq cryptography.hash.implementation 'alt_stcryptolib')
          (eq cryptography.key_agreement.implementation 'alt_stcryptolib')
          (eq cryptography.message_authentication_code.implementation 'alt_stcryptolib')
          (and (eq random.implementation 'alt_stcryptolib') (or (eq random.drbg 'ctr') (eq random.drbg 'hmac') ))
          )}}{{assign 'stfcf_cryptolib' true}}{{/if~}}

{{#if (or (eq cryptography.cipher.implementation 'mbedtls')
          (eq cryptography.asymmetric_encryption.implementation 'mbedtls')
          (eq cryptography.asymmetric_signature.implementation 'mbedtls')
          (eq cryptography.hash.implementation 'mbedtls')
          (eq cryptography.key_agreement.implementation 'mbedtls')
          (eq cryptography.message_authentication_code.implementation 'mbedtls')
          (eq random.implementation 'mbedtls')
          )}}{{assign 'stfcf_mbedtls' true}}{{/if~}}

{{#if (or (eq cryptography.cipher.implementation 'kwe')
          (eq cryptography.asymmetric_encryption.implementation 'kwe')
          (eq cryptography.asymmetric_signature.implementation 'kwe')
          (eq cryptography.hash.implementation 'kwe')
          (eq cryptography.key_agreement.implementation 'kwe')
          (eq cryptography.message_authentication_code.implementation 'kwe')
          (eq random.implementation 'kwe')
          )}}{{assign 'stfcf_kwe' true}}{{/if~}}

{{/with~}}

{{log "mystfcf_hal_selection" @root.stfcf_hal~}}
{{log "mystfcf_cryptolib_selection" @root.stfcf_cryptolib~}}
{{log "mystfcf_mbedtls_selection" @root.stfcf_mbedtls~}}

{{!-- {{/each~}} --}}
<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0" xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  <url>{{@root.pdscAPI.getPackURL}}</url>
  <releases>
    <release version="0.5.0" date="2025-06-11">
      - STFCF GPDSC Model Release
      - Add KWE support
    </release>
  </releases>
  <description>STM32CubeMX2 Code Generation for STM32 Flexible Crypto Framework</description>
  <conditions>
    {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="No STFCF generator, STFCF config condition,
    Mbed TLS Alt HAL condition, Mbed TLS Alt STCryptoLib condition,
    alt aes condition, alt ccm condition, alt chachapoly condition,
    alt cmac condition, alt entropy_hw condition,
    alt drbg condition, alt ecp condition,
    alt gcm condition, alt rsa condition,
    alt sha1 condition, alt sha256 condition" )~}}

    {{{@root.conditions}}}
    <condition id="STFCF config condition">
      <description>STFCF possible implementations</description>
      <deny Cclass="Security" Cgroup="STFCF" Csub="Core"/>
      <require Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{#if @root.stfcf_hal}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      {{!-- workaround --}}
      <require condition="Mbed TLS Alt HAL condition"/> {{/if}}
      {{#if @root.stfcf_cryptolib}}
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{!-- workaround --}}
      <require condition="Mbed TLS Alt STCryptoLib condition"/> {{/if}}
      {{#if @root.stfcf_kwe}}
      <require Cclass="Security" Cgroup="STFCF" Csub="KWE"/> {{/if}}
    </condition>
    <condition id="Mbed TLS Alt STCryptoLib condition">
      <description>Requires STCryptoLib config component</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      {{!-- <require Cclass="Security" Cgroup="STCryptoLib" Csub="CMOX API"/> --}}
      {{#with @root.mystfcf.settings.parameters.extended_config.mbedtls_alt_config }}
      {{#if (or mbedtls_stcryptolib_aes_alt
                mbedtls_stcryptolib_chachapoly_alt
                mbedtls_stcryptolib_gcm_alt
                mbedtls_stcryptolib_cmac_alt
                mbedtls_stcryptolib_sha256_alt
                mbedtls_stcryptolib_ecdsa_alt
                mbedtls_stcryptolib_ecdh_alt
                mbedtls_stcryptolib_ecp_alt
                mbedtls_stcryptolib_rsa_alt
                mbedtls_stcryptolib_drbg_alt)}}
      {{!-- should be bind ? --}}
      <require Cclass="Security" Cgroup="STM32CubeMX2 Config" Csub="STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="Mbed TLS Alt HAL condition">
      <description>Mbed TLS Alt HAL condition</description>
      <require Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt Common"/>
      <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="RNG"/>
      {{!-- Depending on the available crypto hardware IP, only available ones will be displayed: NOT SUPPORTED YET!--}}
      {{!-- THE AES, SAES & CRYP instances will be selected from HW resource OneOf panel--}}
      {{#with @root.mystfcf.settings.parameters.extended_config.mbedtls_alt_config }}
      {{#if (or (eq mbedtls_hal_aes_alt_hw_ip 'aes')
                (eq mbedtls_hal_ccm_alt_hw_ip 'aes')
                (eq mbedtls_hal_gcm_alt_hw_ip 'aes')
                (eq mbedtls_hal_aes_alt_hw_ip 'saes')
                (eq mbedtls_hal_ccm_alt_hw_ip 'saes')
                (eq mbedtls_hal_gcm_alt_hw_ip 'saes') )}}
      {{!-- <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="AES"/> --}} {{!-- IS UP to user to bind it manually --}}
      {{/if}}
      {{#if (or (eq mbedtls_hal_aes_alt_hw_ip 'cryp')
                (eq mbedtls_hal_ccm_alt_hw_ip 'cryp')
                (eq mbedtls_hal_gcm_alt_hw_ip 'cryp') )}}
      {{!-- <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="CRYP"/> --}}
      {{/if}}
      {{#if (or mbedtls_hal_ecdsa_alt
                mbedtls_hal_ecdh_alt
                mbedtls_hal_ecp_alt
                mbedtls_hal_rsa_alt )}}
      {{!-- <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="PKA"/> --}}
      {{/if}}
      {{#if (or mbedtls_hal_sha1_alt
                mbedtls_hal_sha256_alt )}}
      {{!-- <require Cclass="Device" Cgroup="STM32CubeMX2 Config" Csub="HASH"/> --}}
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt aes condition">
      <description>Enable aes_alt implementation</description>
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_aes_alt
                 (not mbedtls_alt_config.mbedtls_hal_aes_alt)
                 (not mbedtls_alt_config.mbedtls_stcryptolib_aes_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/> {{!-- cdt == false => file not generated --}}
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt ccm condition">
      <description>Enable ccm_alt implementation</description>
      {{#with @rootmystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_ccm_alt
                   (not mbedtls_alt_config.mbedtls_hal_ccm_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id=" alt chachapoly condition">
      <description>Enable chachapoly_alt implementation</description>
      <!-- Works only with ALT STCryptoLib -->
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_aes_alt
                (not mbedtls_alt_config.mbedtls_stcryptolib_aes_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt cmac condition">
      <description>Enable cmac_alt implementation</description>
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_cmac_alt
                (not mbedtls_alt_config.mbedtls_stcryptolib_cmac_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt drbg condition">
      <description>Enable drbg_alt implementation</description>
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (not mbedtls_alt_config.mbedtls_stcryptolib_drbg_alt)}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt entropy_hw condition">
      <description>Enable entropy_hw_alt implementation</description>
      <!-- Works only with ALT HAL -->
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (not mbedtls_alt_config.mbedtls_hal_entropy_hardware_alt)}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt ecp condition">
      <description>Enable ecp_alt implementation</description>
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and (or mbedtls_config.alt_imple.modules.mbedtls_ecp_alt
                     mbedtls_config.alt_imple.modules.mbedtls_ecp_internal_alt)
                 (not mbedtls_alt_config.mbedtls_hal_ecp_alt)
                 (not mbedtls_alt_config.mbedtls_stcryptolib_ecp_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt gcm condition">
      <description>Enable aes_alt implementation</description>
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_gcm_alt
                 (not mbedtls_alt_config.mbedtls_hal_gcm_alt)
                 (not mbedtls_alt_config.mbedtls_stcryptolib_gcm_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt rsa condition">
      <description>Enable rsa_alt implementation</description>
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_rsa_alt
                 (not mbedtls_alt_config.mbedtls_hal_rsa_alt)
                 (not mbedtls_alt_config.mbedtls_stcryptolib_rsa_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt sha1 condition">
      <description>Enable sha1_alt implementation</description>
      <!-- Works only with ALT HAL -->
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_sha1_alt
                 (not mbedtls_alt_config.mbedtls_hal_sha1_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      {{/if}}
      {{/with}}
    </condition>
    <condition id="alt sha256 condition">
      <description>Enable sha256_alt implementation</description>
      {{#with @root.mystfcf.settings.parameters.extended_config}}
      {{#if (and mbedtls_config.alt_imple.modules.mbedtls_sha256_alt
                 (not mbedtls_alt_config.mbedtls_hal_sha256_alt)
                 (not mbedtls_alt_config.mbedtls_stcryptolib_sha256_alt))}}
      <deny Cclass="Security" Cgroup="STFCF" Csub="PSA API"/>
      {{else}}
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt HAL"/>
      <accept Cclass="Security" Cgroup="STFCF" Csub="MbedTLS Alt STCryptoLib"/>
      {{/if}}
      {{/with}}
    </condition>
  </conditions>
  {{/each~}}
  <components>
    {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      {{!-- workaround! --}}
      <Pre_Include_Global_h>
/* Enabling global STFCF configuration file */
#define MBEDTLS_CONFIG_FILE "mx_stfcf_config.h"
      </Pre_Include_Global_h>
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>
