{{#if (eq fct 'init')}}
  {{! ~}}
  {{! Generate the GPIO init code in pppi_init function~}}
  {{! > GPIO_LL fct='init' needs=this.needs resource='USART1'~}}
  {{! ~}}
  {{log "GPIO_LL_partial: needs:" needs~}}
  {{! temporary helper in waiting for this one provided by tool~}}
  {{assign 'gpio_configs' 'undefined'~}}
  {{assign 'resource' resource~}}
  {{#each needs}}
    {{! ~}}
    {{assign 'getNeedById' (@root.pinoutAPI.getNeedById id)~}}
    {{!log "GPIO_LL_Partial (init): getNeedById:" (toJSON @root.getNeedById)~}}
    {{assign 'gpio_configs' (helper_gpio_get_gpioconfig_object @root.getNeedById @root.gpio_configs)~}}
  {{/each}}
  {{!log "GPIO_LL_partial(init) gpio_configs:" @root.gpio_configs~}}
  {{assign 'found_signal' true~}}
  {{assign 'first_gpio' true~}}
  {{assign 'gpios_clock' ''~}}
  {{#each @root.gpio_configs.list_port}}
    {{#if (not @root.first_gpio)}}
      {{! ~}}
      {{assign 'gpios_clock' (append @root.gpios_clock ' | ')~}}
    {{/if}}
    {{! ~}}
    {{assign 'gpios_clock' (append @root.gpios_clock 'LL_AHB4_GRP1_PERIPH_GPIO')~}}
    {{assign 'gpios_clock' (append @root.gpios_clock this)~}}
    {{assign 'first_gpio' false~}}
  {{/each}}
  {{#if @root.gpios_clock}}
  /* GPIO Clocks activation */
  LL_AHB4_GRP1_EnableClock({{@root.gpios_clock}});
  {{/if}}

{{assign 'found_exti' false~}}

  {{#each @root.gpio_configs.list_config_pins}}
  /**
    {{@root.resource}} GPIO Configuration

  {{#if (and (gt (length pin) 0) (gt (length signalName) 0) (gt (length label_name) 0))}}
      {{~assign 'sw_labels_found' false~}}
      {{#each pin}}
        {{#if (and (not @root.sw_labels_found) (gt (length (lookup ../label_name @index)) 0))}}
          {{~assign 'sw_labels_found' true~}}
        {{/if}}
      {{/each}}
      {{#if @root.sw_labels_found}}
    [GPIO Pin] ------> [Signal Name] ------> [SW label(s)]
      {{else}}
    [GPIO Pin] ------> [Signal Name]
      {{/if}}

      {{#each pin}}
        {{#if (gt (length (lookup ../label_name @index)) 0)}}
       {{helper_gpio_add_pad_right (concat "P" ../port this) 4}}    ------>   {{lookup ../signalName @index}}   ------>  {{#each (lookup ../label_name @index)}}{{uppercase this}}{{#unless @last}}, {{/unless}}{{/each}}
        {{else}}
       {{helper_gpio_add_pad_right (concat "P" ../port this) 4}}    ------>   {{lookup ../signalName @index}}
        {{/if}}
      {{/each}}
  {{/if}}
    **/

    {{~assign 'gpio_pins' ''~}}
    {{~assign 'not_first_pin' false~}}
    {{#each pin}}
      {{#if @root.not_first_pin}}
        {{~assign 'gpio_pins' (append @root.gpio_pins ' | ')~}}
      {{/if}}
      {{~assign 'gpio_pin' (append 'LL_GPIO_PIN_' this)~}}
      {{~assign 'gpio_pins' (append @root.gpio_pins @root.gpio_pin)~}}
      {{~assign 'not_first_pin' true}}
    {{/each}}

    {{#if output_init_state}}
  /* Initialize the output state */
  LL_GPIO_{{#if (eq output_init_state 'HIGH')}}Set{{else}}Reset{{/if}}OutputPin(GPIO{{port}}, {{@root.gpio_pins}});
    {{/if}}
    {{#if speed}}
  /* Configure IO output speed (Low, Medium, High or Very-High) */
    {{#each pin}}
  LL_GPIO_SetPinSpeed(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_SPEED_FREQ_{{../speed}});
    {{/each}}

    {{/if}}
    {{#if output_type}}
  /* Configure IO output type (Push-Pull or Open-Drain) */
  LL_GPIO_SetPinOutputType(GPIO{{port}}, {{@root.gpio_pins}}, LL_GPIO_OUTPUT_{{output_type}});

    {{/if}}
    {{#if pull}}
  /* Activate the Pull-up, Pull-down resistor, or No pull for the current IO */
    {{#each pin}}
  LL_GPIO_SetPinPull(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_PULL_{{../pull}});
    {{/each}}

    {{/if}}
    {{#if (eq mode 'EVENTOUT')}}
  /* Configure Eventout in Alternate function mapped with the current IO */
    {{#each pin}}
  LL_GPIO_SetAFPin_8_15(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_AF_15);
    {{/each}}

    {{/if}}
    {{#unless (eq af undefined)}}
  /* Configure the Alternate Function in current IO */
    {{#each pin}}
  LL_GPIO_SetAFPin_{{#if (lt this 8)}}0_7{{else}}8_15{{/if}}(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_AF_{{../af}});
    {{/each}}

    {{/unless}}
  /* Configure IO direction mode (Input, Output, Alternate or Analog) */
    {{#each pin}}
  LL_GPIO_SetPinMode(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_MODE_{{#if (eq ../mode 'EVENTOUT')}}ALTERNATE{{else}}{{../mode}}{{/if}});
    {{/each}}

    {{#each exti_cfg}}
      {{#if exti_enabled}}
        {{~assign 'll_gpio_port' port~}}
        {{~assign 'll_gpio_pin' pin~}}
        {{#> EXTI fct='exti_gpio_init' layer='LL' needs=config.needs found_exti=@root.found_exti gpio_port=@root.ll_gpio_port gpio_pin=@root.ll_gpio_pin}}
        {{/EXTI}}
        {{! ~}}
        {{assign 'found_exti' true~}}
      {{/if}}
    {{/each}}
  {{/each}}
{{else if (eq fct 'deinit')}}
  {{! ~}}
  {{! Generate the GPIO deinit code in pppi_deinit function~}}
  {{! ~}}
  {{! > GPIO_LL fct='deinit' needs=needs resource='USART1'~}}
  {{! ~}}
  {{!log "GPIO_LL_partial deinit: gpio_configs"~}}
  {{assign 'gpio_configs' 'undefined'~}}
  {{assign 'resource' resource~}}
  {{#each needs}}
{{! ~}}
    {{assign 'getNeedById' (@root.pinoutAPI.getNeedById id)~}}
    {{!log "GPIO_LL_Partial (init): getNeedById:" (toJSON @root.getNeedById)~}}
    {{assign 'gpio_configs' (helper_gpio_get_gpioconfig_object @root.getNeedById @root.gpio_configs)~}}
  {{/each}}
  {{#each @root.gpio_configs.list_config_pins}}
  /* ### GPIO deinitialization of {{@root.resource}}: {{signalName}} ########################### */
{{!}}
    {{~assign 'gpio_pins' ''~}}
    {{~assign 'not_first_pin' false~}}
    {{#each pin}}
      {{#if @root.not_first_pin}}
        {{~assign 'gpio_pins' (append @root.gpio_pins ' | ')~}}
      {{/if}}
      {{~assign 'gpio_pin' (append 'LL_GPIO_PIN_' this)~}}
      {{~assign 'gpio_pins' (append @root.gpio_pins @root.gpio_pin)~}}
      {{~assign 'not_first_pin' true~}}
    {{/each}}

  /* Configure IO in Analog Mode */
    {{#each pin}}
  LL_GPIO_SetPinMode(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_MODE_ANALOG);
    {{/each}}

  /* Configure the default Alternate Function in current IO */
    {{#each pin}}
  LL_GPIO_SetAFPin_{{#if (lt this 8)}}0_7{{else}}8_15{{/if}}(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_AF_0);
    {{/each}}

  /* Configure the default value for IO Speed */
    {{#each pin}}
  LL_GPIO_SetPinSpeed(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_SPEED_FREQ_LOW);
    {{/each}}

  /* Configure the default value IO Output Type */
  LL_GPIO_SetPinOutputType(GPIO{{port}}, {{@root.gpio_pins}}, LL_GPIO_OUTPUT_PUSHPULL);

  /* Deactivate the Pull-up and Pull-down resistor for the current IO */
    {{#each pin}}
  LL_GPIO_SetPinPull(GPIO{{../port}}, LL_GPIO_PIN_{{this}}, LL_GPIO_PULL_NO);
    {{/each}}

  LL_GPIO_WriteOutputPin(GPIO{{port}}, {{@root.gpio_pins}}, LL_GPIO_PIN_RESET);

    {{#each exti_cfg}}
        {{#if exti_enabled}}
        {{~assign 'll_gpio_port' port~}}
        {{~assign 'll_gpio_pin' pin~}}
        {{> EXTI fct='exti_gpio_deinit' layer='LL' needs=config.needs gpio_port=@root.ll_gpio_port gpio_pin=@root.ll_gpio_pin}}
        {{/if}}
    {{/each}}
  {{/each}}
{{else if (eq fct 'generate_labels')}}
  {{! }}
  {{! Generate LL defines for GPIO labels inside mx_pppi.h file}}
  {{! }}
  {{! > GPIO_LL fct='generate_labels' needs=@root.gpio_needs~}}
  {{! ~}}
  {{~assign 'gpio_configs' 'undefined'~}}
  {{#each needs}}
    {{~assign 'getNeedById' (@root.pinoutAPI.getNeedById id)~}}
    {{~assign 'gpio_configs' (helper_gpio_get_gpioconfig_object @root.getNeedById @root.gpio_configs)~}}
  {{/each}}
{{#each @root.gpio_configs.list_config_pins as |config|}}
  {{#each config.pin as |pinValue pinIdx|}}
    {{~assign 'define' '#define'~}}
    {{~assign 'aliases' (helper_gpio_create_aliases
      (lookup config.userLabels pinIdx)
      (lookup config.label_name pinIdx)
    )~}}

/* Primary aliases for GPIO P{{config.port}}{{pinValue}} pin */
    {{#if @root.aliases.master_label}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PORT") 47}} GPIO{{config.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase @root.aliases.master_label) "_GPIO_PIN") 47}} LL_GPIO_PIN_{{pinValue}}

    {{/if}}
    {{#if (gt (length @root.aliases.other_labels) 0)}}
/* Secondary aliases for GPIO P{{config.port}}{{pinValue}} pin */
      {{#each @root.aliases.other_labels as |label|}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase label) "_GPIO_PORT") 47}} GPIO{{config.port}}
{{@root.define}} {{helper_gpio_add_pad_right (concat (uppercase label) "_GPIO_PIN") 47}} LL_GPIO_PIN_{{pinValue}}

      {{/each}}
      {{#with (lookup config.exti_cfg pinIdx) as |exti|}}
        {{#if exti.exti_enabled}}
{{> EXTI fct='exti_gpio_generate_aliases' layer='LL' needs=config.extiConfig.needs}}
        {{/if}}
      {{/with}}
    {{/if}}
  {{/each}}
{{/each}}
{{else}}
#warning "Step '{{fct}}' not present in partial GPIO_LL_partial.hbs"
{{/if}}
