{{#if (eq @root.strategy "SW")}}
  {{~assign 'file_name' 'LPTIM'~}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:LPTIM')~}}
{{else}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{~assign 'current_resource' resource~}}
      {{~assign 'file_name' resource~}}
      {{~assign 'instances' instances~}}
    {{/with~}}
    {{/get_myctx~}}
{{/if}}
