    {{#if HSI}}

  HAL_RCC_HSI_Enable(HAL_RCC_HSI_DIV_{{@root.system_config.divider.hsi}});{{helper_rcc_set_resource_enabled 'hsi'}}
      {{#unless (helper_rcc_is_central @root.main_config)}}
  RCC_CONSUME_RESOURCE(hsi, 1);
      {{/unless}}
    {{/if~}}

    {{#if HSE}}

  HAL_RCC_HSE_Enable(HAL_RCC_HSE_{{@root.main_config.additional.hse.state}});{{helper_rcc_set_resource_enabled 'hse'}}
      {{#unless (helper_rcc_is_central @root.main_config)}}
  RCC_CONSUME_RESOURCE(hse, 1);
      {{/unless}}
    {{/if~}}

    {{#if CSI}}

  HAL_RCC_CSI_Enable();
      {{#unless (helper_rcc_is_central @root.main_config)}}
  RCC_CONSUME_RESOURCE(csi, 1);
      {{/unless}}
    {{/if~}}

    {{#if PLLCLK}}
{{>RCC fct='generate_pll_src_enable' pll_src=@root.system_config.pll_list.[0].config.src}}
{{>RCC fct='generate_pll_config' pll_info=@root.system_config.pll_list.[0]}}

    {{/if}}


    {{#if PLLCLK}}
{{>RCC fct='generate_pll_enable' pll_idx='1'}}
  HAL_RCC_PLL1_EnableOutput(HAL_RCC_PLL1_SYSCLK);
      {{#unless (helper_rcc_is_central @root.main_config)}}
  RCC_CONSUME_RESOURCE(pll1_output_p, 1);
      {{/unless}}
    {{/if}}

  {{/with~}}

  {{#with @root.system_config}}

    /** Frequency will be increased */
  HAL_FLASH_ITF_SetLatency(HAL_FLASH, HAL_FLASH_ITF_LATENCY_4);

  HAL_FLASH_ITF_SetProgrammingDelay(HAL_FLASH, HAL_FLASH_ITF_PROGRAM_DELAY_2);

  /** Initializes the CPU, AHB and APB busses clocks */
    {{#with prescaler}}
  config_bus.sys_cpu_clk_prescaler  = HAL_RCC_SYSCPUCLK_PRESCALER{{cpu}};
  config_bus.hclk_prescaler  = HAL_RCC_HCLK_PRESCALER{{ahb}};
  config_bus.pclk1_prescaler = HAL_RCC_PCLK_PRESCALER{{apb1}};
  config_bus.pclk2_prescaler = HAL_RCC_PCLK_PRESCALER{{apb2}};
  config_bus.pclk4_prescaler = HAL_RCC_PCLK_PRESCALER{{apb4}};
    {{/with}}

  if (HAL_RCC_SetBusClockConfig(&config_bus) != HAL_OK)
  {
    return SYSTEM_CLOCK_ERROR;
  }

  HAL_RCC_SetSYSCLKSource(HAL_RCC_SYSCLK_SRC_{{clock_source.name}});
  {{/with~}}

  {{#with @root.main_config}}
    {{~#if (and additional.clk_outputs.mco1 additional.clk_outputs.mco2)}}

  /* Enable PIN for MCO1 and MCO2 */
      {{#with system.gpio.mco1}}{{~assign 'rcc_gpio_needs' (helper_common_concatenate_needs needs @root.rcc_gpio_needs)~}}{{/with}}
      {{#with system.gpio.mco2}}{{~assign 'rcc_gpio_needs' (helper_common_concatenate_needs needs @root.rcc_gpio_needs)~}}{{/with}}
    {{~else}}

      {{#if additional.clk_outputs.mco1}}

  /* Enable PIN for MCO1 */
        {{#with system.gpio.mco1}}{{assign 'rcc_gpio_needs' (helper_common_concatenate_needs needs @root.rcc_gpio_needs)~}}{{/with}}
      {{/if}}
      {{#if additional.clk_outputs.mco2}}

  /* Enable PIN for MCO2 */
        {{#with system.gpio.mco2}}{{assign 'rcc_gpio_needs' (helper_common_concatenate_needs needs @root.rcc_gpio_needs)~}}{{/with}}
      {{/if}}
    {{/if}}
{{> GPIO_HAL fct='init' needs=@root.rcc_gpio_needs resource='RCC'}}

    {{#if additional.clk_outputs.mco1}}
  HAL_RCC_SetConfigMCO(HAL_RCC_MCO1_SRC_{{@root.system_config.clk_outputs.mco1.src}}, HAL_RCC_MCO1_PRESCALER{{@root.system_config.clk_outputs.mco1.div}});
    {{/if}}
    {{#if additional.clk_outputs.mco2}}
  HAL_RCC_SetConfigMCO(HAL_RCC_MCO2_SRC_{{@root.system_config.clk_outputs.mco2.src}}, HAL_RCC_MCO2_PRESCALER{{@root.system_config.clk_outputs.mco2.div}});
    {{/if}}
    {{#if additional.hse.enable_css}}

  /*
   *  Enable the Clock Security System: The CSSI is linked to
   *  the Cortex-M33 NMI (Non-Maskable Interrupt) exception vector.
   */
  HAL_RCC_HSE_EnableCSS();
    {{/if}}
    {{#if additional.lse.enable_css}}

  /* Enable the LSE Clock Security System */
  HAL_RCC_LSE_EnableCSS();
{{> EXTI fct='exti_init' layer=@root.current_layer needs=additional.lse.css_interruption.needs found_exti=true exti_line='58'}}
    {{/if}}

    {{#if additional.hsi.enable_in_stop_mode}}
  HAL_RCC_HSI_EnableInStopMode();
    {{/if}}
  {{/with}}

  return SYSTEM_OK;
}
