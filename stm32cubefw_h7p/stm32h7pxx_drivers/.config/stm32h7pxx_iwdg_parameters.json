{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:IWDG",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/iwdg_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "labels": {
              "title": "label",
              "type": "array",
              "items": {
                "pattern": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
                "type": "string"
              }
            },
            "layer": {
              "title": "Software Layer",
              "type": "string",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_IWDG_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "resource initialization code generation",
              "type": "string",
              "description": "generate or not the IWDG init code, call it or not at boot",
              "$comment": "generate the init code of your IWDG or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },
        "Applicative": {
          "type": "object",
          "title": "IWDG Calculator",
          "properties": {
            "Note": {
              "title": "Note",
              "type": "string",
              "default": "The purpose of this panel is to help the user during the IWDG configuration. It does not generate any code apart from NVIC interruption enabling.",
              "actions": [
                {
                  "type": "enable",
                  "condition": "true"
                }
              ]
            },
            "ClockFrequency": {
              "description": "LSI frequency ",
              "title": "Clock Frequency (Hz)",
              "type": "string",
              "default": 0,
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$get('clock.frequency', 'LSI')"
                  }
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "IWDG_FREQ",
                  "condition": "true",
                  "computed_value": "$get('clock.frequency', 'LSI')"
                }
              ]
            },
            "Unit": {
              "comment": "Should not be there, need to be replaced by Core value.",
              "type": "string",
              "title": "IWDG configuration time unit",
              "description": "Unit selection for IWDG times (microseconds, milliseconds, seconds).",
              "default": "HAL_IWDG_TIME_UNIT_MS",
              "oneOf": [
                {
                  "title": "us",
                  "const": "HAL_IWDG_TIME_UNIT_US"
                },
                {
                  "title": "ms",
                  "const": "HAL_IWDG_TIME_UNIT_MS"
                },
                {
                  "title": "s",
                  "const": "HAL_IWDG_TIME_UNIT_S"
                }
              ],
              "actions": [
                {
                  "type": "warning",
                  "message": "The user is adviced to use another unit if more resolution is needed.",
                  "condition": "$Applicative.Unit !== 'HAL_IWDG_TIME_UNIT_US'"
                }
              ]
            },
            "AllowedMin": {
              "type": "integer",
              "title": "Allowed Min",
              "description": "Minimum time allowed before a IWDG reset, rounded to upper integer value.",
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "title": "'Allowed Min ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                  }
                },
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$common.helper_iwdg_get_min_allowed_time($get('envVar.value', 'IWDG_FREQ'), $Applicative.Unit)"
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            },
            "AllowedMax": {
              "type": "integer",
              "description": "Maximum time allowed before a IWDG reset, rounded to upper integer value.",
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "title": "'Allowed Max ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                  }
                },
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$common.helper_iwdg_get_max_allowed_time($get('envVar.value', 'IWDG_FREQ'), $Applicative.Unit)"
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            },
            "MaxTime": {
              "type": "object",
              "title": "Max time (reset time)",
              "description": "Maximum time duration before reset is triggered by the IWDG if the counter is not refreshed.",
              "properties": {
                "InputMaxTime": {
                  "type": "integer",
                  "title": "IWDG Maximum time User Input",
                  "description": "Maximum time input from the user.",
                  "default": 0,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'IWDG Maximum time User Input ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "error",
                      "message": "Value is not within the IWDG capabilities boundaries.",
                      "condition": "$Applicative.MaxTime.InputMaxTime < $Applicative.AllowedMin || $Applicative.MaxTime.InputMaxTime > $Applicative.AllowedMax"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "IWDG_PRESCALER",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_iwdg_compute_prescaler($get('envVar.value', 'IWDG_FREQ'), $Applicative.MaxTime.InputMaxTime, $Applicative.Unit)"
                    },
                    {
                      "on": "update-value",
                      "name": "IWDG_STEP",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_iwdg_compute_step($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $Applicative.Unit)"
                    },
                    {
                      "on": "update-value",
                      "name": "IWDG_RELOAD",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_iwdg_compute_reload($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $Applicative.MaxTime.InputMaxTime, $Applicative.Unit)"
                    }
                  ]
                },
                "ActualMaxTime": {
                  "type": "number",
                  "title": "Actual Maximum time",
                  "description": "Actual Maximum time before reset.",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'Actual Maximum time ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "include",
                      "condition": "($Applicative.MaxTime.InputMaxTime <= $Applicative.AllowedMax)"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_iwdg_adjust_time($get('envVar.value', 'IWDG_STEP'), $Applicative.MaxTime.InputMaxTime, $Applicative.Unit)"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "true"
                    }
                  ]
                }
              }
            },
            "MinTime": {
              "type": "object",
              "title": "Min time (window time)",
              "description": "Minimum time duration before IWDG refresh is allowed (window).",
              "properties": {
                "WindowEnable": {
                  "type": "boolean",
                  "description": "If the box is checked, the IWDG window is enabled and a minimum time before IWDG refresh is required.",
                  "default": false
                },
                "InputMinTime": {
                  "type": "integer",
                  "title": "IWDG Minimum time User Input",
                  "description": "Minimum time input from the user.",
                  "default": 0,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'IWDG Minimum time User Input ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "include",
                      "condition": "$Applicative.MinTime.WindowEnable == true"
                    },
                    {
                      "type": "error",
                      "message": "Value is not within the IWDG capabilities boundaries.",
                      "condition": "$Applicative.MinTime.InputMinTime < $Applicative.AllowedMin || $Applicative.MinTime.InputMinTime >= $Applicative.MaxTime.InputMaxTime"
                    }
                  ]
                },
                "ActualMinTime": {
                  "type": "number",
                  "title": "Actual Minimum time",
                  "description": "Actual Minimum time before refresh is allowed.",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'Actual Minimum time ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "include",
                      "condition": "($Applicative.MinTime.WindowEnable == true) && ($Applicative.MinTime.InputMinTime < $Applicative.MaxTime.InputMaxTime)"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_iwdg_adjust_time($get('envVar.value', 'IWDG_STEP'), $Applicative.MinTime.InputMinTime, $Applicative.Unit)"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "true"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "IWDG_WINDOW",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_iwdg_compute_param($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $get('envVar.value', 'IWDG_RELOAD'), $Applicative.MinTime.InputMinTime, $Applicative.Unit)"
                    }
                  ]
                }
              }
            },
            "EarlyWakeup": {
              "type": "object",
              "description": "Time of Early Wakeup interrupt generation.",
              "properties": {
                "EWIEnable": {
                  "type": "boolean",
                  "title": "Early Wakeupt Interrupt enable",
                  "description": "If the box is checked, the IWDG Early Wakeup Interrupt is enabled.",
                  "default": false
                },
                "InputEWITime": {
                  "type": "integer",
                  "title": "IWDG Early Wakeup Interrupt time",
                  "description": "Early Wakeup time User Input.",
                  "default": 0,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'IWDG Early Wakeup Interrupt time ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "include",
                      "condition": "$Applicative.EarlyWakeup.EWIEnable == true"
                    },
                    {
                      "type": "error",
                      "message": "Value is not within the IWDG capabilities boundaries.",
                      "condition": "$Applicative.EarlyWakeup.InputEWITime >= $Applicative.MaxTime.InputMaxTime"
                    }
                  ]
                },
                "ActualEWITime": {
                  "type": "number",
                  "title": "Actual Early Wakeup time",
                  "description": "Actual Early Wakeup generation helper_iwdg_get_min_allowed_time.",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'Actual Early Wakeup time ('+$common.helper_iwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "include",
                      "condition": "($Applicative.EarlyWakeup.EWIEnable == true) && ($Applicative.EarlyWakeup.InputEWITime < $Applicative.MaxTime.InputMaxTime)"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_iwdg_adjust_time($get('envVar.value', 'IWDG_STEP'), $Applicative.EarlyWakeup.InputEWITime, $Applicative.Unit)"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "true"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "IWDG_EWI",
                      "condition": "($value !== undefined) && ($value >= $get('envVar.value', 'IWDG_STEP'))",
                      "computed_value": "$common.helper_iwdg_compute_param($get('envVar.value', 'IWDG_FREQ'), $get('envVar.value', 'IWDG_PRESCALER'), $get('envVar.value', 'IWDG_RELOAD'), $Applicative.EarlyWakeup.InputEWITime, $Applicative.Unit)"
                    }
                  ]
                }
              }
            }
          }
        },
        "System": {
          "type": "object",
          "title": "System configuration",
          "properties": {
            "NVIC_Settings": {
              "type": "object",
              "properties": {
                "EnableInterruption": {
                  "title": "Interruption",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ Handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$System.NVIC_Settings.EnableInterruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvicConfig": {
                  "title": "NVIC configuration",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                      {
                          "on": "update-value",
                          "name": "HAL_CORTEX_PROJECT_USE_HAL",
                          "condition": "$info.layer === 'HAL'",
                          "semaphore": true
                      }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$System.NVIC_Settings.EnableInterruption"
                    }
                  ]
                }
              }
            }
          }
        },
        "RunTime": {
          "type": "object",
          "title": "Runtime Peripheral Configuration",
          "properties": {
            "Start": {
              "type": "boolean",
              "title": "Start function generation",
              "description": "If the box is checked, a function to start the IWDG using the values inputed in the interface is generated.",
              "default": false
            }
          }
        }
      }
    }
  }
}