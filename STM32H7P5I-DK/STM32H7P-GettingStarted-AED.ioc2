"File: STM32H7P-GettingStarted-AED.csolution.yml" = """
# yaml-language-server: $schema=https://raw.githubusercontent.com/Open-CMSIS-Pack/devtools/schemas/projmgr/2.11.0/tools/projmgr/schemas/csolution.schema.json
solution:
  target-types:
    - type: STM32H7P5I-DK
      board: STM32H7P5I-DK:DK32H7P5I$CR1
      device: STM32H7P5IIK6Q
  output-dirs:
    tmpdir: build/tmp
    outdir: $SolutionDir()$/build/$Project$.$BuildType$
  generators:
    base-dir: $ProjectDir()$/generated
    options:
      - generator: stm32h7pxx_hal_mx2codegen
        path: $ProjectDir()$/generated/hal
      - generator: syscalls_mx2codegen
        path: $ProjectDir()$/generated/utilities
      - generator: mw_hsp_engine_mx2codegen
        path: $ProjectDir()$/generated/middleware
      - generator: basic_stdio_mx2codegen
        path: $ProjectDir()$/generated/utilities
      - generator: led_mx2codegen
        path: $ProjectDir()$/generated/parts
      - generator: st7315_mx2codegen
        path: $ProjectDir()$/generated/parts
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  projects:
    - project: project/STM32H7P-GettingStarted-AED.cproject.yml
  packs:
    - pack: STMicroelectronics::basic_stdio@2.1.0
    - pack: STMicroelectronics::button_hw-part@2.2.0
    - pack: STMicroelectronics::cmm-4030dt-261075l-tr_hw-part@2.0.0
    - pack: STMicroelectronics::CMSIS@6.3.0
    - pack: STMicroelectronics::crystal_hw-part@2.3.1
    - pack: STMicroelectronics::esd_hw-part@2.2.0
    - pack: STMicroelectronics::gjx-2864tswbg09_hw-part@2.0.1
    - pack: STMicroelectronics::hsp_engine@2.0.0
    - pack: STMicroelectronics::led_hw-part@2.5.0
    - pack: STMicroelectronics::led_part_drivers@2.2.0
    - pack: STMicroelectronics::level-shifter_hw-part@2.1.0
    - pack: STMicroelectronics::mx25lm51245_hw-part@2.1.0
    - pack: STMicroelectronics::potentiometer_hw-part@2.1.0
    - pack: STMicroelectronics::st-link_hw-part@2.1.0
    - pack: STMicroelectronics::st7315_part_drivers@2.0.0
    - pack: STMicroelectronics::st7315-g5_hw-part@2.0.2
    - pack: STMicroelectronics::stm32cubemx2_templates_no_os_stm32h7p@2.0.0
    - pack: STMicroelectronics::stm32h7p5i-dk_hw-board@2.0.0
    - pack: STMicroelectronics::stm32h7pxx_dfp@2.0.0
    - pack: STMicroelectronics::stm32h7pxx_hal_drivers@2.0.0
    - pack: STMicroelectronics::syscalls@2.0.2
    - pack: STMicroelectronics::tcpp01-m12_hw-part@2.1.0
"""
