{{!--
  Partial used for HAL COMP:
  how to use
  > COMP_HAL fct='xxxx' with xxxx:
    * init
    * deinit
--}}
{{!==================== partial function: init ====================~}}
{{#if (eq fct 'init')}}
  if (HAL_COMP_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{#if (eq comp_mode "mode_independent")}}
  hal_comp_config_t comp_config;
  comp_config.input_plus = HAL_COMP_INPUT_PLUS_{{helper_comp_transform_input_name feat_basic.input.input_plus.source}};
  comp_config.input_minus = HAL_COMP_INPUT_MINUS_{{helper_comp_transform_input_name feat_basic.input.input_minus.source}};
  comp_config.input_hysteresis = HAL_COMP_INPUT_HYSTERESIS_{{feat_basic.input.input_hysteresis~}};
  comp_config.output_polarity = HAL_COMP_OUTPUT_POLARITY_{{feat_basic.output.output_polarity~}};
#if defined(USE_HAL_COMP_EXTI) && (USE_HAL_COMP_EXTI == 1)
  comp_config.output_trigger = HAL_COMP_OUTPUT_TRIG_{{feat_basic.output.output_trigger~}};
#endif /* USE_HAL_COMP_EXTI */
  if (HAL_COMP_SetConfig(&h{{uppercase @root.current_resource~}}, &comp_config) != HAL_OK)
  {
    return NULL;
  }

{{#with feat_opt~}}
{{#if output_blanking_state}}

  if (HAL_COMP_SetOutputBlanking(&h{{uppercase @root.current_resource~}}, HAL_COMP_OUTPUT_BLANK_{{helper_comp_transform_blk_src_name output_blanking_src.source}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{/with~}}{{!feat_opt}}
{{else}}
{{#if (eq (helper_comp_is_window_instance_main @root.current_resource) false)}}
  /* Window mode: configuration performed by other comparator:
     COMP{{helper_comp_get_window_other_instance_nb @root.current_resource}}
  */
{{else}}
  /* Window mode configuration
     Note: Window mode activated under condition of USE_HAL_COMP_WINDOW_MODE defined in hal_conf.h */
  /* Get other comparator handle */
  hal_comp_handle_t* p_handle_other_comp = mx_comp{{helper_comp_get_window_other_instance_nb @root.current_resource~}}_hal_gethandle();

  /* Link handles */
  if (HAL_COMP_WINDOW_SetHandle(&h{{uppercase @root.current_resource~}}, p_handle_other_comp) != HAL_OK)
  {
    return NULL;
  }

  hal_comp_window_config_t comp_window_config;
  comp_window_config.input = HAL_COMP_INPUT_PLUS_{{helper_comp_transform_input_name feat_basic.input.input_plus.source}};
  comp_window_config.upper_threshold = HAL_COMP_INPUT_MINUS_{{helper_comp_transform_input_name feat_basic.input.window_upper_threshold.source}};
  comp_window_config.lower_threshold = HAL_COMP_INPUT_MINUS_{{helper_comp_transform_input_name feat_basic.input.window_lower_threshold.source}};
  comp_window_config.input_hysteresis = HAL_COMP_INPUT_HYSTERESIS_{{feat_basic.input.input_hysteresis~}};
  comp_window_config.output_polarity = HAL_COMP_OUTPUT_POLARITY_{{feat_basic.output.output_polarity~}};
#if defined(USE_HAL_COMP_EXTI) && (USE_HAL_COMP_EXTI == 1)
  comp_window_config.output_trigger = HAL_COMP_OUTPUT_TRIG_{{feat_basic.output.output_trigger~}};
#endif /* USE_HAL_COMP_EXTI */
  //comp_window_config.window_output_mode = ...;
  if (HAL_COMP_WINDOW_SetConfig(&h{{uppercase @root.current_resource~}}, &comp_window_config) != HAL_OK)
  {
    return NULL;
  }

{{#with feat_opt~}}
{{#if output_blanking_state}}

  if (HAL_COMP_WINDOW_SetOutputBlanking(&h{{uppercase @root.current_resource~}}, HAL_COMP_OUTPUT_BLANK_{{helper_comp_transform_blk_src_name output_blanking_src.source}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{!output_blanking_state}}
{{/with~}}{{!feat_opt}}
{{/if~}} {{!helper_comp_is_window_instance_main}}
{{/if~}}{{!comp_mode}}
{{!==================== partial function: deinit ====================~}}
{{else if (eq fct 'deinit')}}
  (void)HAL_COMP_DeInit(&h{{uppercase @root.current_resource}});
{{else}}
#warning "step {{fct}} in partial COMP_HAL not managed"
{{/if}}
