{{~assign 'current_resource' 'RCC'~}}
{{#if (eq @root.strategy "SW")}}
  {{~assign 'instances' (@root.SWConfigurationAPI.getInstances 'STMicroelectronics::Device:STM32CubeMX2 Config:RCC')~}}
  {{~log 'instances' @root.instances~}}
  {{~assign 'rcc_cxt'(@root.SWConfigurationAPI.getSwInstanceConfiguration instances.[0])~}}
{{else}}
  {{#get_myctx~}}
    {{#with _myctx~}}
      {{log "RCC template _myctx:" this~}}
      {{~assign 'rcc_cxt' instances.[0]~}}
    {{/with~}}
  {{/get_myctx~}}
{{/if}}
{{~helper_rcc_init_codegen @root}}
{{~assign 'main_config' @root.rcc_cxt ~}}
{{~assign 'all_resources' (helper_rcc_get_all_resources) ~}}
{{~assign 'all_clock_configs' (helper_rcc_get_all_perifs_clock_config @root.all_resources) ~}}
/**
