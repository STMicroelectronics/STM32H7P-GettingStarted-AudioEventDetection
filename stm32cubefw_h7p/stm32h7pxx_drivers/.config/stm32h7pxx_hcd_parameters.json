{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:HCD",
  "grammarVersion": "3.1",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/common_helpers.js",
      "accessor": "com"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "Info",
          "properties": {
            "labels": {
              "title": "Label",
              "type": "object",
              "properties": {
                "layer": {
                  "title": "Layer",
                  "type": "string",
                  "default": "HAL",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$com.helper_common_display_object($resource)"
                    }
                  ]
                }
              }
            },
            "items": {
              "type": "string",
              "title": "Item",
              "default": "^([a-zA-Z_][a-zA-Z0-9_]{1,31})?$",
              "minLength": 0,
              "maxLength": 32
            },
            "init_type": {
              "title": "resource initialization code generation",
              "type": "string",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ],
              "default": "HCD"
            }
          }
        },
        "Basic": {
          "title": "Main peripheral configuration",
          "type": "object",
          "properties": {
            "Core_mode": {
              "type": "string",
              "default": "Host",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            },
            "Core_Speed": {
              "type": "string",
              "oneOf": [
                {
                  "const": "SPEED_FS"
                },
                {
                  "const": "SPEED_HS"
                },
                {
                  "const": "SPEED_HS_IN_FS"
                }
              ],
              "default": "SPEED_FS"
            },
            "PHY interface": {
              "type": "string",
              "oneOf": [
                {
                  "const": "PHY_EMBEDDED_FS"
                },
                {
                  "const": "PHY_EMBEDDED_HS"
                },
                {
                  "const": "PHY_EXTERNAL_ULPI"
                }
              ],
              "default": "PHY_EMBEDDED_FS"
            },
            "DMA state": {
              "type": "string",
              "oneOf": [
                {
                  "const": "Enable"
                },
                {
                  "const": "Disable"
                }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "$resource.name == 'USB_DRD'"
                }
              ],
              "default": "Disable"
            }
          }
        },
        "Additional": {
          "type": "object",
          "properties": {
            "UCPD_for_VBUS_management": {
              "type": "string",
              "oneOf": [
                {
                  "const": "Enable"
                },
                {
                  "const": "Disable"
                }
              ],
              "default": "Disable"
            },
            "UCPD_Link": {
              "type": "string",
              "oneOf": [
                {
                  "const": "UCPD_Link"
                }
              ],
              "actions": [
                {
                  "type": "disable",
                  "condition": "$Additional.UCPD_for_VBUS_management === 'Disable'"
                }
              ],
              "default": "UCPD_Link"
            }
          }
        },
        "Applicative": {
          "type": "object",
          "properties": {
            "USB_Middleware": {
              "type": "string",
              "oneOf": [
                {
                  "const": "Enable"
                },
                {
                  "const": "Disable"
                }
              ],
              "default": "Disable"
            },
            "MW USB Host Link": {
              "type": "string",
              "oneOf": [
                {
                  "const": "MW USB Host Link"
                }
              ],
              "default": "MW USB Host Link",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$Applicative.USB_Middleware === 'Disable' && ($Basic.Core_mode.Host === false)"
                }
              ]
            }
          }
        },
        "System": {
          "type": "object",
          "properties": {
            "GPIO": {
              "type": "object",
              "properties": {
                "DP": {
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "DP",
                      "constraints": {
                        "Mode": {
                          "const": "ANALOG"
                        },
                        "Pull": {
                          "const": "No pull-up and no pull-down"
                        },
                        "Speed": {
                          "const": "Very High"
                        }
                      }
                    }
                  ]
                },
                "DM": {
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "DM",
                      "constraints": {
                        "Mode": {
                          "const": "ANALOG"
                        },
                        "Pull": {
                          "const": "No pull-up and no pull-down"
                        },
                        "Speed": {
                          "const": "Very High"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "USB Global interrupt": {
              "type": "object",
              "objectType": "need.interrupt.lines",
              "owner": "$resource.name",
              "needs": [
                {
                  "selector": "GLOBAL INTERRUPT"
                }
              ]
            }
          }
        }
      }
    }
  }
}
