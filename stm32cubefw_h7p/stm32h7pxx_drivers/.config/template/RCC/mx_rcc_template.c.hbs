/**
  * Configure PLL{{this.idx}} (all factors {{#each this.factors}}{{this}}, {{/each}}{{#each this.outputs}}{{this}}{{#if (not @last)}}, {{/if}}{{/each}}) and activate it.
  * Only PLL{{this.idx}} is enabled, not the PLL{{this.idx}} outputs.
  */
system_status_t mx_rcc_pll{{this.idx}}_config(void)
{
  if (RCC_IS_RESOURCE_FREE(pll{{this.idx}}))
  {
    /* Enable the oscillator used as input of the PLL{{this.idx}} */
        {{#if (eq this.config.src 'HSI')}}
    if (mx_rcc_hsi_clock_config(1) != SYSTEM_OK)
    {
      return SYSTEM_CLOCK_ERROR;
    }
        {{/if}}
        {{#if (eq this.config.src 'HSE')}}
    if (mx_rcc_hse_clock_config(1) != SYSTEM_OK)
    {
      return SYSTEM_CLOCK_ERROR;
    }
        {{/if}}

    /* Configure and enable PLL{{this.idx}} */
  {{>RCC fct='generate_pll_config' pll_info=this}}
  {{>RCC fct='generate_pll_enable' pll_idx=this.idx}}
  }

  return SYSTEM_OK;
}

/**
  * Deactivate PLL{{this.idx}}
  */
system_status_t mx_rcc_pll{{this.idx}}_deactivate(void)
{
  /* Deactivation is possible only on the outputs are free */
  if (RCC_IS_RESOURCE_FREE(pll{{this.idx}}p)
      && RCC_IS_RESOURCE_FREE(pll{{this.idx}}q)
      && RCC_IS_RESOURCE_FREE(pll{{this.idx}}r))
  {
    RCC_RELEASE_RESOURCE(pll{{this.idx}});
    if (HAL_RCC_PLL{{this.idx}}_Disable() != HAL_OK)
    {
      return SYSTEM_CLOCK_ERROR;
    }

    /* Deactivate the oscillator used as input of the PLL{{this.idx}} */
        {{#if (eq this.src 'HSI')}}
    if (mx_rcc_hsi_clock_deactivate() != SYSTEM_OK)
    {
      return SYSTEM_CLOCK_ERROR;
    }
        {{/if}}
        {{#if (eq this.src 'HSI')}}
    if (mx_rcc_hse_clock_deactivate() != SYSTEM_OK)
    {
      return SYSTEM_CLOCK_ERROR;
    }
        {{/if}}
  }

  return SYSTEM_OK;
}
