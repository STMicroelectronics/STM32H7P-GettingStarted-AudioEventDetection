{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:WWDG",
  "grammarVersion": "3.7",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/wwdg_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "Software information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Label for peripheral instance",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "pattern": "^([a-zA-Z][a-zA-Z0-9_]{1,31})?$",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Layer",
              "type": "string",
              "oneOf": [
                {
                  "const": "HAL"
                },
                {
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_WWDG_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "title": "resource initialization code generation",
              "type": "string",
              "description": "generate or not the WWDG init code, call it or not at boot",
              "$comment": "generate the init code of your WWDG or not (enabled/disabled), call it automatically at startup or not (called/enabled)",
              "oneOf": [
                {
                  "const": "called"
                },
                {
                  "const": "enabled"
                },
                {
                  "const": "disabled"
                }
              ],
              "default": "called"
            }
          }
        },
        "Applicative": {
          "type": "object",
          "title": "Applicative configuration",
          "properties": {
            "Note": {
              "title": "Note",
              "type": "string",
              "default": "The purpose of this panel is to help the user during the WWDG configuration. It does not generate any code apart from NVIC interruption enabling.",
              "actions": [
                {
                  "type": "enable",
                  "condition": "true"
                }
              ]
            },
            "ClockFrequency": {
              "description": "PCLK 1 frequency ",
              "title": "Clock frequency (Hz)",
              "type": "string",
              "default": "0",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true"
                },
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$get('clock.frequency', 'APB1_Peripheral_Clock')"
                  }
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "WWDG_FREQ",
                  "condition": "true",
                  "computed_value": "$get('clock.frequency', 'APB1_Peripheral_Clock')"
                }
              ]
            },
            "Unit": {
              "comment": "Should not be there, need to be replaced by Core value.",
              "type": "string",
              "title": "Configuration time unit",
              "description": "Unit selection for WWDG times (microseconds, milliseconds, seconds).",
              "default": "HAL_WWDG_TIME_UNIT_MS",
              "oneOf": [
                {
                  "title": "us",
                  "const": "HAL_WWDG_TIME_UNIT_US"
                },
                {
                  "title": "ms",
                  "const": "HAL_WWDG_TIME_UNIT_MS"
                },
                {
                  "title": "s",
                  "const": "HAL_WWDG_TIME_UNIT_S"
                }
              ],
              "actions": [
                {
                  "type": "warning",
                  "message": "The user is adviced to use another unit if more resolution is needed.",
                  "condition": "$Applicative.Unit !== 'HAL_WWDG_TIME_UNIT_US'"
                }
              ]
            },
            "AllowedMin": {
              "type": "integer",
              "title": "Allowed minimum",
              "description": "Minimum time allowed before a WWDG reset, rounded to upper integer value.",
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "title": "'Allowed minimum ('+$common.helper_wwdg_stringify_unit($Applicative.Unit)+')'"
                  }
                },
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$common.helper_wwdg_get_min_allowed_time($get('envVar.value', 'WWDG_FREQ'), $Applicative.Unit)"
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            },
            "AllowedMax": {
              "type": "integer",
              "description": "Maximum time allowed before a WWDG reset, rounded to upper integer value.",
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "title": "'Allowed maximum ('+$common.helper_wwdg_stringify_unit($Applicative.Unit)+')'"
                  }
                },
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "const": "$common.helper_wwdg_get_max_allowed_time($get('envVar.value', 'WWDG_FREQ'), $Applicative.Unit)"
                  }
                },
                {
                  "type": "disable",
                  "condition": "true"
                }
              ]
            },
            "MaxTime": {
              "type": "object",
              "title": "Maximum time (reset time)",
              "description": "Maximum time duration before reset is triggered by the WWDG if the counter is not refreshed.",
              "properties": {
                "InputMaxTime": {
                  "type": "integer",
                  "title": "Maximum time user input",
                  "description": "Maximum time input from the user.",
                  "default": 0,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'Maximum time user input ('+$common.helper_wwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "error",
                      "message": "Value is not within the WWDG capabilities boundaries.",
                      "condition": "$Applicative.MaxTime.InputMaxTime < $Applicative.AllowedMin || $Applicative.MaxTime.InputMaxTime > $Applicative.AllowedMax"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "WWDG_PRESCALER",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_wwdg_compute_prescaler($get('envVar.value', 'WWDG_FREQ'),$Applicative.MaxTime.InputMaxTime,$Applicative.Unit)"
                    },
                    {
                      "on": "update-value",
                      "name": "WWDG_STEP",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_wwdg_compute_step($get('envVar.value', 'WWDG_FREQ'), $get('envVar.value', 'WWDG_PRESCALER'), $Applicative.Unit)"
                    },
                    {
                      "on": "update-value",
                      "name": "WWDG_RELOAD",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_wwdg_compute_reload($get('envVar.value', 'WWDG_FREQ'), $get('envVar.value', 'WWDG_PRESCALER'), $Applicative.MaxTime.InputMaxTime, $Applicative.Unit)"
                    }
                  ]
                },
                "ActualMaxTime": {
                  "type": "number",
                  "title": "Actual maximum time",
                  "description": "Actual Maximum time before reset.",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'Actual maximum time ('+$common.helper_wwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "include",
                      "condition": "($Applicative.MaxTime.InputMaxTime <= $Applicative.AllowedMax)"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_wwdg_adjust_time($get('envVar.value', 'WWDG_STEP'), $Applicative.MaxTime.InputMaxTime, $Applicative.Unit)"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "true"
                    }
                  ]
                }
              }
            },
            "MinTime": {
              "type": "object",
              "title": "Minimum time (window time)",
              "description": "Minimum time duration before WWDG refresh is allowed (window).",
              "properties": {
                "InputMinTime": {
                  "type": "integer",
                  "title": "Minimum time user input",
                  "description": "Minimum time input from the user.",
                  "default": 0,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'Minimum time user input ('+$common.helper_wwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "error",
                      "message": "Value is not within the capabilities boundaries.",
                      "condition": "$Applicative.MinTime.InputMinTime > $Applicative.MaxTime.InputMaxTime || $Applicative.MinTime.InputMinTime < $Applicative.AllowedMin  "
                    }
                  ]
                },
                "ActualMinTime": {
                  "type": "number",
                  "title": "Actual minimum time",
                  "description": "Actual minimum time before refresh is allowed.",
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "title": "'Actual minimum time ('+$common.helper_wwdg_stringify_unit($Applicative.Unit)+')'"
                      }
                    },
                    {
                      "type": "include",
                      "condition": "($Applicative.MinTime.InputMinTime < $Applicative.MaxTime.InputMaxTime)"
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$common.helper_wwdg_adjust_time($get('envVar.value', 'WWDG_STEP'), $Applicative.MinTime.InputMinTime, $Applicative.Unit)"
                      }
                    },
                    {
                      "type": "disable",
                      "condition": "true"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "WWDG_WINDOW",
                      "condition": "$value !== undefined",
                      "computed_value": "$common.helper_wwdg_compute_param($get('envVar.value', 'WWDG_FREQ'), $get('envVar.value', 'WWDG_PRESCALER'), $get('envVar.value', 'WWDG_RELOAD'), $Applicative.MinTime.InputMinTime, $Applicative.Unit)"
                    }
                  ]
                }
              }
            }
          }
        },
        "System": {
          "type": "object",
          "title": "System",
          "properties": {
              "nvicSettings": {
                "type": "object",
                "title": "NVIC settings",
                "properties": {
                  "EnableInterruption": {
                    "type": "boolean",
                    "title": "Interruption",
                    "default": false,
                    "description": "Enable wakeup interruption."
                  },
                  "irq_handler_generation": {
                    "type": "boolean",
                    "title": "IRQ Handler generation",
                    "default": true,
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.nvicSettings.EnableInterruption && $info.layer === 'HAL'"
                      }
                    ]
                  },
                  "nvicConfig": {
                    "title": "NVIC configuration",
                    "type": "object",
                    "objectType": "need.interrupt.lines",
                    "variables": [
                      {
                        "on": "update-value",
                        "name": "HAL_CORTEX_PROJECT_USE_HAL",
                        "condition": "$info.layer === 'HAL'",
                        "semaphore": true
                      }
                    ],
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "*"
                      }
                    ],
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$System.nvicSettings.EnableInterruption"
                      }
                    ]
                  }
                }
              }
            }
          },
        "RunTime": {
          "type": "object",
          "title": "Applicative services",
          "properties": {
            "Start": {
              "type": "boolean",
              "title": "Start function generation",
              "description": "If the box is checked, a function to start the WWDG using the values inputed in the interface is generated.",
              "default": false
            }
          }
        }
      }
    }
  }
}
