~}}
{{#if (eq fct 'system_check_isr_model')}}
{{! Check the model applied for IRQ handler code generation                        ~}}
{{!  > SYSTEM fct='system_check_isr_model'                                         ~}}
{{! return the value of the flag 'isr_handler' inside a variable @root.isr_handler ~}}
{{!                                                                                ~}}
{{assign "jsonFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "System"}')~}}
{{assign 'system_ctxt' (@root.SWConfigurationAPI.getSwInstancesConfiguration @root.jsonFilter)~}}
{{!log 'SYSTEM_partial: system_ctxt=' (toJSON @root.system_ctxt)~}}
{{assign 'isr_handler' @root.system_ctxt.[0].code_generation.isr_handler~}}
{{log 'SYSTEM_partial: isr_handler=' @root.isr_handler~}}
{{else if (eq fct 'system_check_ll_optim')}}
{{! Check if user wants to optimize the LL code                        ~}}
{{!  > SYSTEM fct='system_check_ll_optim'                                         ~}}
{{! return the value of the flag 'optim_enable' inside a variable @root.optim_enable ~}}
{{!                                                                                ~}}
{{assign "jsonFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "System"}')~}}
{{assign 'system_ctxt' (@root.SWConfigurationAPI.getSwInstancesConfiguration @root.jsonFilter)~}}
{{!log 'SYSTEM_partial: system_ctxt=' (toJSON @root.system_ctxt)~}}
{{assign 'optim_enable' @root.system_ctxt.[0].code_generation.optim_enable~}}
{{log 'SYSTEM_partial: optim_enable=' @root.optim_enable~}}
{{else if (eq fct 'gpio_pwr_activation')}}
{{! Generate PWR clock activation for GPIOG pin1 or pin0                           ~}}
{{!  > SYSTEM fct='gpio_pwr_activation' port=port pin=pin                          ~}}
{{!                                                                                ~}}
{{! clock_activation != HAL_CLK_ENABLE_PERIPH_PWR_SYSTEM: pwr clock need to be configured inside application ~}}
{{!log 'SYSTEM_partial.hbs (fct=gpio_pwr_activation): core_ctxt=' @root.core_ctxt 'port=' port 'pin=' pin~}}
{{#if (lt @root.core_ctxt 2)}}
{{#if (and (eq port 'G') (gt pin 1))}}
  /* Clock activation model is different than HAL_CLK_ENABLE_PERIPH_PWR_SYSTEM  */
  /* PWR activation is needed for GPIOG pin {{pin}}                                   */
  LL_AHB3_GRP1_EnableClock(LL_AHB3_GRP1_PERIPH_PWR);

  /* The isolation must be removed before using any I/O from PG[15:2], by
    setting the IO2SV bit in the PWR_SVMCR register, once the VDDIO2 supply is present. */
  LL_PWR_EnableVddIO2();
{{/if}}
{{/if}}
{{else}}
{{! Generate RCC clock activation inside mx_pppi.c depending of ppp_clk_enable_model option  ~}}
{{!   => if ppp_clk_enable_model=== HAL_CLK_ENABLE_NO, RCC clock activation for PPP is done inside mx_pppi_init function  ~}}
{{!  > SYSTEM component='uart' resource=@root.current_resource                               ~}}
{{!                                                                                          ~}}
{{assign "jsonFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "CORE"}')~}}
{{assign 'core_ctxt' (@root.SWConfigurationAPI.getSwInstancesConfiguration @root.jsonFilter)~}}
{{assign 'core_ctxt' (helper_common_if_rcc_clock_activated @root.core_ctxt.[0] component)~}}
{{!log 'SYSTEM_partial.hbs: core_ctxt=' @root.core_ctxt~}}
{{! clock_activation == HAL_CLK_ENABLE_NO: RCC and pwr clock need to be configured inside application ~}}
{{#if (eq @root.core_ctxt 0)}}
  {{assign 'found_RCC_EnableClock' true~}}
  HAL_RCC_{{resource}}_EnableClock();
{{#if (eq resource 'SAES')}}
  /* Enable RNG clock is mandatory for SAES */
  HAL_RCC_RNG_EnableClock();
{{/if}}

{{/if}}
{{/if}}
